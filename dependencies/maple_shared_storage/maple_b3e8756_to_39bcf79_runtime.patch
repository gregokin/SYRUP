+    caller_ledger: SedimentLedgerState,
+    process: int,
+    actual_mass_by_cell_class_kg: MapleArray,
+    numerical_residual_by_cell_class_kg: MapleArray,
+    mass_resolution_kg: float,
+    *,
+    foreign_arrays: tuple = (),
