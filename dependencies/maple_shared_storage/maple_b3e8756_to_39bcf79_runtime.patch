index 0000000000000000000000000000000000000000..c3e48ed4797bc19a7fc1e9148e24f0c432c532ea
--- /dev/null
+++ b/src/maple/core/backend/prefix_cell_reductions.py
@@ -0,0 +1,1276 @@
+"""Deep-prefix packets: exact NumPy-order committed-height totals from a bounded summary plus the resident window.
+
+Purpose (CW-E1, diagnostic only). A voxel column of `nv` voxels x `nc` classes has `n = nv * nc` FP64 terms in
+C order (`i = v * nc + c`). Its height total is NumPy's contiguous pairwise sum of those `n` terms
+(`numpy_pairwise_order.ORDER_ID`: eight lanes per leaf of at most 128 terms, recursive split aligned to eight,
+`-0.0` leaf identity for tiny leaves, `+0.0` outer identity). A window-resident representation keeps only `W`
+voxels of a column on the hot path (the surface window at integer voxel `base`), with the deep prefix
+`[0, base * nc)` in the physical deep store and nothing above `(base + W) * nc` (empty voxels). This module
+reproduces the EXACT NumPy total of the whole column from
+
+  * a per-cell packet of `depth(n) + 8` FP64 words: the completed left-subtree sums along the root-to-leaf path
+    of the prefix boundary, plus the eight lane accumulators (or one sequential scalar) of the leaf that holds
+    the boundary (the root's algorithmic proof `agent_handoffs/tasks/conservative_water/prefix_reduction_probe.py`,
+    3818 raw-byte checks; `nv = 306, nc = 6` needs 12 words = 96 bytes per cell), and
+  * the resident window `(W, nc)`,
+
+with NO read of the deep store and no full-column array. Everything beyond the window is treated as zero,
+which the ENCODER enforces on the full column it is given (a packet is refused for a column with mass above its
+window).
+
+Authority. Packets are diagnostic summaries of committed deep mass. They never invent, reconstruct or move
+mass, never enter a class budget, and are not an inventory: the physical deep store remains the sole mass
+authority.
+
+Binding and ownership (the contract of `PrefixPacketBinding`, modelled on the reference runtime's surface-cache
+binding; in this tree the analogue is `core/types/voxel.py`'s `VoxelWindowCache` over `ArrayBinding`):
+
+  * A binding names ONE exact packet array object through MAPLE's `ArrayBinding` identity and ONE exact base
+    array object it was encoded for, keeps a frozen copy of that base's values, and records the order, the
+    NumPy version the order was qualified under, the geometry `(n, nv, nc, W, depth, P)`, the grid shape, the
+    namespace, the base dtype and an optional external deep-store version / generation. Every derived field is
+    cross-validated at construction (`dataclasses.replace` included) and again before each decode, so a forged
+    depth / packet width / term count / geometry / dtype / shape / encoded base is refused by name
+    (`PrefixPacketError`) before any native kernel is reached.
+  * A DIFFERENT packet object is refused even when its bytes match: after a re-encode or advance the caller
+    binds the new packet (a new binding); the old binding stays valid for the old packet only. A resident
+    window mutation with the deep store and base unchanged reuses packet and binding (the window is not bound).
+  * Read-only / trust. `bind_prefix_packets` takes ownership of the packet: on NumPy it clears the packet's
+    writeable flag (enforced by the interpreter, as the surface-exchange constructor does for the mass array it
+    builds) and an untrusted decode requires that flag to still be clear. On CuPy there is no writeable flag and
+    no enforcement is possible; the decoder does NOT pretend otherwise and requires `trusted=True`, by which the
+    caller declares that it owns the whole chain of states since the encode (the contract the surface cache uses
+    for its `trusted=True`). `trusted=True` relaxes the read-only requirement only; identity and metadata checks
+    always run. The caller's base array is never frozen: the bound base object is accepted without a read when
+    it is read-only or trusted, otherwise its values are compared with the frozen copy in ONE counted flag read
+    (with the range check folded into the same read), so an equal-valued replacement base is accepted and a
+    moved or forged base is refused.
+  * Nothing is persisted here. A production integration (B3c) must bind the packet to the deep-store manifest
+    digest / generation through `version` / `generation` and re-encode (or advance) after any deep change.
+
+Implementations. `encode_prefix` / `encode_prefix_tiled` and `advance_prefix` are HOST operations on bounded
+chunks of full columns (genesis / miss re-encode) or of leaving window values (upward base shift without a
+deep read); they run the compiled Numba kernels when Numba is importable and the Python reference otherwise
+(the encoder is not a hot path). `decode_height` is the hot path: NumPy inputs require the compiled Numba
+kernel (no Python-loop fallback), CuPy inputs run a RawKernel specialised per (device, n, depth, base dtype)
+with round-to-nearest `__dadd_rn` adds, no FMA, the same explicit tree traversal as `cell_reductions.py`; there
+is no CPU fallback for device inputs. Bases are signed int32 (the accepted B3 `WindowedVoxelColumnState.base`)
+or int64, read natively on both backends without a full-domain cast. The pure-Python reference
+(`decode_height_reference`) exists for qualification and tests only.
+"""
+from __future__ import annotations
+
+import hashlib
+from dataclasses import dataclass
+from typing import Any
+
+import numpy as np
+
+from maple.core.backend import (
+    MixedArrayNamespaceError,
+    array_namespace,
+    freeze,
+    is_array,
+    to_bool,
+)
+from maple.core.backend.numpy_pairwise_order import (
+    ORDER_ID,
+    QUALIFIED_MAX_TERMS,
+    NumpyReductionOrderMismatch,
+    qualify_numpy_order,
+)
+from maple.core.types.voxel import ArrayBinding
+
+__all__ = [
+    "LANES",
+    "LEAF",
+    "MAX_ENCODE_CELLS",
+    "SUPPORTED_BASE_DTYPES",
+    "PrefixPacketBinding",
+    "PrefixPacketError",
+    "advance_prefix",
+    "advance_prefix_reference",
+    "bind_prefix_packets",
+    "decode_height",
+    "decode_height_reference",
+    "encode_prefix",
+    "encode_prefix_reference",
+    "encode_prefix_tiled",
+    "numba_available",
+    "packet_bytes_per_cell",
+    "packet_terms",
+    "prefix_depth",
+    "prefix_reduction_provenance",
+]
+
+LEAF = 128
+LANES = 8
+MAX_DEPTH = 32  # fixed traversal stack; the qualified 32768 terms need 8 levels
+MAX_ENCODE_CELLS = 65536  # a chunk of full columns the encoder accepts at once (bounded genesis / miss re-encode)
+IMPLEMENTATIONS = ("auto", "numba", "reference")
+SUPPORTED_BASE_DTYPES = ("int32", "int64")
+NAMESPACES = ("numpy", "cupy")
+OPTIONS = ("--fmad=false", "--prec-div=true", "--prec-sqrt=true", "--ftz=false")
+THREADS = 128
+MAX_BLOCKS = 512
+_CUDA_BASE_T = {"int32": "int", "int64": "long long"}
+
+_COUNTERS = {"encodes": 0, "advances": 0, "cpu_decodes": 0, "cuda_decodes": 0, "reference_decodes": 0,
+             "refusals": 0, "base_identity_hits": 0, "base_value_reads": 0, "last_cells": 0,
+             "last_packet_bytes": 0, "last_window_bytes": 0, "last_scratch_bytes": 0, "last_output_bytes": 0}
+_KERNELS: dict[tuple[int, int, int, str], Any] = {}
+_NUMBA: Any = None
+
+
+class PrefixPacketError(ValueError):
+    """Invalid, stale, foreign or malformed packet / binding / inputs. Raised before any output exists and before
+    any native kernel is launched; nothing is modified."""
+
+
+def _refuse(message: str) -> PrefixPacketError:
+    _COUNTERS["refusals"] += 1
+    return PrefixPacketError(message)
+
+
+# --- tree geometry -----------------------------------------------------------------------------------------------------
+def _half(n: int) -> int:
+    return (n // 2) - ((n // 2) % 8)
+
+
+def _is_int(value: Any) -> bool:
+    return isinstance(value, (int, np.integer)) and not isinstance(value, (bool, np.bool_))
+
+
+def _strict_int(value: Any, name: str, minimum: int) -> int:
+    if not _is_int(value) or int(value) < minimum:
+        raise PrefixPacketError(f"{name} must be an int >= {minimum}, got {value!r}")
+    return int(value)
+
+
+def prefix_depth(n_terms: int) -> int:
+    """Number of internal levels of NumPy's pairwise tree over `n_terms` contiguous terms (0 for a single leaf)."""
+    n = _strict_int(n_terms, "n_terms", 0)
+    if n <= LEAF:
+        return 0
+    left = _half(n)
+    return 1 + max(prefix_depth(left), prefix_depth(n - left))
+
+
+def packet_terms(n_terms: int) -> int:
+    """FP64 words per cell: one per internal level of the boundary path plus the eight leaf lanes."""
+    return prefix_depth(n_terms) + LANES
+
+
+def packet_bytes_per_cell(nv: int, nc: int) -> int:
+    return 8 * packet_terms(_strict_int(nv, "nv", 1) * _strict_int(nc, "nc", 1))
+
+
+def _is_enforced_read_only(array: Any) -> bool:
+    """NumPy with the writeable flag cleared: the one backend where in-place mutation is refused by the
+    interpreter (the rule of `core/types/voxel.py` and `maple.core.backend.is_frozen`)."""
+    return isinstance(array, np.ndarray) and not array.flags.writeable
+
+
+# --- Python reference (qualification and tests; also the encoder / advance when Numba is absent) --------------------------
+def _leaf_sum(get, start: int, n: int) -> float:
+    if n < LANES:
+        value = -0.0
+        for k in range(n):
+            value = value + get(start + k)
+        return value
+    r = [get(start + j) for j in range(LANES)]
+    end = n - n % LANES
+    for k in range(LANES, end, LANES):
+        for j in range(LANES):
+            r[j] = r[j] + get(start + k + j)
+    value = ((r[0] + r[1]) + (r[2] + r[3])) + ((r[4] + r[5]) + (r[6] + r[7]))
+    for k in range(end, n):
+        value = value + get(start + k)
+    return value
+
+
+def _tree_sum(get, start: int, n: int) -> float:
+    if n <= LEAF:
+        return _leaf_sum(get, start, n)
+    left = _half(n)
+    return _tree_sum(get, start, left) + _tree_sum(get, start + left, n - left)
+
+
+def _encode_leaf_reference(get, start: int, count: int, q: int, packet, levels: int) -> None:
+    """Leaf accumulators over the deep positions `[start, start + q)` of the leaf `[start, start + count)`."""
+    rounded = count - count % LANES
+    if count < LANES or q >= rounded:
+        if count < LANES:
+            value = -0.0
+            for k in range(q):
+                value = value + get(start + k)
+        else:
+            value = _leaf_sum(get, start, rounded)
+            for k in range(rounded, q):
+                value = value + get(start + k)
+        packet[levels] = value
+        return
+    for j in range(LANES):
+        if j >= q:
+            continue
+        value = get(start + j)
+        for k in range(j + LANES, q, LANES):
+            value = value + get(start + k)
+        packet[levels + j] = value
+
+
+def _encode_cell_reference(get, n: int, p: int, levels: int, packet) -> None:
+    start, count, level = 0, n, 0
+    while count > LEAF:
+        left = _half(count)
+        if p >= start + left:
+            packet[level] = _tree_sum(get, start, left)
+            start, count = start + left, count - left
+        else:
+            count = left
+        level += 1
+    _encode_leaf_reference(get, start, count, p - start, packet, levels)
+
+
+def _decode_leaf_reference(packet, levels: int, future, start: int, count: int, q: int) -> float:
+    rounded = count - count % LANES
+    if count < LANES or q >= rounded:
+        value = float(packet[levels])
+        for k in range(q, count):
+            value = value + future(start + k)
+        return value
+    r = [float(packet[levels + j]) if j < q else future(start + j) for j in range(LANES)]
+    for k in range(LANES, rounded, LANES):
+        for j in range(LANES):
+            if k + j >= q:
+                r[j] = r[j] + future(start + k + j)
+    value = ((r[0] + r[1]) + (r[2] + r[3])) + ((r[4] + r[5]) + (r[6] + r[7]))
+    for k in range(rounded, count):
+        value = value + future(start + k)
+    return value
+
+
+def _decode_node_reference(packet, levels: int, start: int, count: int, level: int, p: int, future, stop: int) -> float:
+    """The tree sum of node `[start, start + count)` from the packet path and the future accessor (no outer +0)."""
+    if count > LEAF:
+        left = _half(count)
+        if p >= start + left:
+            return float(packet[level]) + _decode_node_reference(packet, levels, start + left, count - left, level + 1,
+                                                                 p, future, stop)
+        right = 0.0 if start + left >= stop else _tree_sum(future, start + left, count - left)
+        return _decode_node_reference(packet, levels, start, left, level + 1, p, future, stop) + right
+    return _decode_leaf_reference(packet, levels, future, start, count, p - start)
+
+
+def _decode_cell_reference(packet, levels: int, n: int, p: int, window) -> float:
+    stop = p + len(window)
+
+    def future(i):
+        return float(window[i - p]) if i < stop else 0.0
+
+    return 0.0 + _decode_node_reference(packet, levels, 0, n, 0, p, future, stop)
+
+
+def _advance_cell_reference(old, levels: int, n: int, p: int, p2: int, leaving, new) -> None:
+    """New packet for prefix `p2 >= p` from the old packet and the leaving values `[p, p2)` (no deep read)."""
+    def lv(i):
+        return float(leaving[i - p])
+
+    shared = True  # the old boundary path still shares the current node
+    start, count, level = 0, n, 0
+    while count > LEAF:
+        left = _half(count)
+        if p2 >= start + left:
+            if shared and p >= start + left:
+                new[level] = old[level]
+            elif shared:
+                # the old path went left here: that left subtree is old-deep (packet path) plus leaving values
+                new[level] = _decode_node_reference(old, levels, start, left, level + 1, p, lv, p2)
+                shared = False
+            else:
+                new[level] = _tree_sum(lv, start, left)  # entirely leaving values
+            start, count = start + left, count - left
+        else:
+            count = left
+        level += 1
+    q2 = p2 - start
+    if not shared:
+        _encode_leaf_reference(lv, start, count, q2, new, levels)
+        return
+    q = p - start
+    rounded = count - count % LANES
+    if count < LANES or q >= rounded:
+        value = float(old[levels])
+        for k in range(q, q2):
+            value = value + lv(start + k)
+        new[levels] = value
+        return
+    r = [float(old[levels + j]) if j < q else (lv(start + j) if j < q2 else 0.0) for j in range(LANES)]
+    if q2 >= rounded:
+        for k in range(LANES, rounded, LANES):
+            for j in range(LANES):
+                if k + j >= q:
+                    r[j] = r[j] + lv(start + k + j)
+        value = ((r[0] + r[1]) + (r[2] + r[3])) + ((r[4] + r[5]) + (r[6] + r[7]))
+        for k in range(rounded, q2):
+            value = value + lv(start + k)
+        new[levels] = value
+        return
+    for k in range(LANES, rounded, LANES):
+        for j in range(LANES):
+            if q <= k + j < q2:
+                r[j] = r[j] + lv(start + k + j)
+    for j in range(LANES):
+        new[levels + j] = r[j] if j < q2 else 0.0
+
+
+# --- compiled host kernels (Numba) --------------------------------------------------------------------------------------
+def numba_available() -> bool:
+    try:
+        import numba  # noqa: F401
+    except Exception:  # noqa: BLE001 - an availability probe answers, never raises
+        return False
+    return True
+
+
+def _build_numba(numba):
+    jit = numba.njit(cache=False, fastmath=False, nogil=True, boundscheck=False, error_model="numpy")
+
+    @jit
+    def fut(win, p, stop, i):
+        if i < stop:
+            return win[i - p]
+        return 0.0
+
+    @jit
+    def leaf_future(win, p, stop, start, n):
+        if n < 8:
+            value = -0.0
+            for k in range(n):
+                value = value + fut(win, p, stop, start + k)
+            return value
+        r = np.empty(8, np.float64)
+        for j in range(8):
+            r[j] = fut(win, p, stop, start + j)
+        end = n - n % 8
+        k = 8
+        while k < end:
+            for j in range(8):
+                r[j] = r[j] + fut(win, p, stop, start + k + j)
+            k += 8
+        value = ((r[0] + r[1]) + (r[2] + r[3])) + ((r[4] + r[5]) + (r[6] + r[7]))
+        for k in range(end, n):
+            value = value + fut(win, p, stop, start + k)
+        return value
+
+    @jit
+    def tree_future(win, p, stop, start, n):
+        if start >= stop:
+            return 0.0
+        if n <= 128:
+            return leaf_future(win, p, stop, start, n)
+        starts = np.empty(32, np.int64)
+        lengths = np.empty(32, np.int64)
+        left = np.empty(32, np.float64)
+        stage = np.empty(32, np.int64)
+        sp = 0
+        starts[0] = start
+        lengths[0] = n
+        stage[0] = 0
+        value = -0.0
+        while sp >= 0:
+            count = lengths[sp]
+            if starts[sp] >= stop:  # a subtree of zeros sums to +0.0 exactly (every leaf there has >= 8 terms)
+                value = 0.0
+                sp -= 1
+            elif count <= 128:
+                value = leaf_future(win, p, stop, starts[sp], count)
+                sp -= 1
+            else:
+                half = (count // 2) - ((count // 2) % 8)
+                if stage[sp] == 0:
+                    stage[sp] = 1
+                    begin = starts[sp]
+                    sp += 1
+                    starts[sp] = begin
+                    lengths[sp] = half
+                    stage[sp] = 0
+                elif stage[sp] == 1:
+                    left[sp] = value
+                    stage[sp] = 2
+                    begin = starts[sp] + half
+                    sp += 1
+                    starts[sp] = begin
+                    lengths[sp] = count - half
+                    stage[sp] = 0
+                else:
+                    value = left[sp] + value
+                    sp -= 1
+        return value
+
+    @jit
+    def leaf_decode(packet, levels, win, p, stop, start, count, q):
+        rounded = count - count % 8
+        if count < 8 or q >= rounded:
+            value = packet[levels]
+            for k in range(q, count):
+                value = value + fut(win, p, stop, start + k)
+            return value
+        r = np.empty(8, np.float64)
+        for j in range(8):
+            if j < q:
+                r[j] = packet[levels + j]
+            else:
+                r[j] = fut(win, p, stop, start + j)
+        k = 8
+        while k < rounded:
+            for j in range(8):
+                if k + j >= q:
+                    r[j] = r[j] + fut(win, p, stop, start + k + j)
+            k += 8
+        value = ((r[0] + r[1]) + (r[2] + r[3])) + ((r[4] + r[5]) + (r[6] + r[7]))
+        for k in range(rounded, count):
+            value = value + fut(win, p, stop, start + k)
+        return value
+
+    @jit
+    def decode_node(packet, levels, start, count, level, win, p, stop):
+        pend = np.empty(32, np.float64)
+        depth = 0
+        while count > 128:
+            left = (count // 2) - ((count // 2) % 8)
+            if p >= start + left:
+                pend[depth] = packet[level]
+                start = start + left
+                count = count - left
+            else:
+                pend[depth] = tree_future(win, p, stop, start + left, count - left)
+                count = left
+            level += 1
+            depth += 1
+        value = leaf_decode(packet, levels, win, p, stop, start, count, p - start)
+        d = depth - 1
+        while d >= 0:
+            value = pend[d] + value
+            d -= 1
+        return value
+
+    @jit
+    def decode_cells(resident2, base, packet2, nc, n, levels, out):
+        cells = out.shape[0]
+        wt = resident2.shape[1]
+        for cell in range(cells):
+            p = np.int64(base[cell]) * nc
+            out[cell] = 0.0 + decode_node(packet2[cell], levels, 0, n, 0, resident2[cell], p, p + wt)
+
+    @jit
+    def leaf_row(row, start, n):
+        if n < 8:
+            value = -0.0
+            for k in range(n):
+                value = value + row[start + k]
+            return value
+        r = np.empty(8, np.float64)
+        for j in range(8):
+            r[j] = row[start + j]
+        end = n - n % 8
+        k = 8
+        while k < end:
+            for j in range(8):
+                r[j] = r[j] + row[start + k + j]
+            k += 8
+        value = ((r[0] + r[1]) + (r[2] + r[3])) + ((r[4] + r[5]) + (r[6] + r[7]))
+        for k in range(end, n):
+            value = value + row[start + k]
+        return value
+
+    @jit
+    def tree_row(row, start, n):
+        if n <= 128:
+            return leaf_row(row, start, n)
+        starts = np.empty(32, np.int64)
+        lengths = np.empty(32, np.int64)
+        left = np.empty(32, np.float64)
+        stage = np.empty(32, np.int64)
+        sp = 0
+        starts[0] = start
+        lengths[0] = n
+        stage[0] = 0
+        value = -0.0
+        while sp >= 0:
+            count = lengths[sp]
+            if count <= 128:
+                value = leaf_row(row, starts[sp], count)
+                sp -= 1
+            else:
+                half = (count // 2) - ((count // 2) % 8)
+                if stage[sp] == 0:
+                    stage[sp] = 1
+                    begin = starts[sp]
+                    sp += 1
+                    starts[sp] = begin
+                    lengths[sp] = half
+                    stage[sp] = 0
+                elif stage[sp] == 1:
+                    left[sp] = value
+                    stage[sp] = 2
+                    begin = starts[sp] + half
+                    sp += 1
+                    starts[sp] = begin
+                    lengths[sp] = count - half
+                    stage[sp] = 0
+                else:
+                    value = left[sp] + value
+                    sp -= 1
+        return value
+
+    @jit
+    def encode_leaf_row(row, start, count, q, packet, levels):
+        rounded = count - count % 8
+        if count < 8 or q >= rounded:
+            if count < 8:
+                value = -0.0
+                for k in range(q):
+                    value = value + row[start + k]
+            else:
+                value = leaf_row(row, start, rounded)
+                for k in range(rounded, q):
+                    value = value + row[start + k]
+            packet[levels] = value
+            return
+        for j in range(8):
+            if j >= q:
+                continue
+            value = row[start + j]
+            k = j + 8
+            while k < q:
+                value = value + row[start + k]
+                k += 8
+            packet[levels + j] = value
+
+    @jit
+    def encode_cells(columns2, base, nc, n, levels, packet2):
+        cells = packet2.shape[0]
+        for cell in range(cells):
+            row = columns2[cell]
+            packet = packet2[cell]
+            for j in range(packet.shape[0]):
+                packet[j] = 0.0
+            p = np.int64(base[cell]) * nc
+            start = 0
+            count = n
+            level = 0
+            while count > 128:
+                left = (count // 2) - ((count // 2) % 8)
+                if p >= start + left:
+                    packet[level] = tree_row(row, start, left)
+                    start = start + left
+                    count = count - left
+                else:
+                    count = left
+                level += 1
+            encode_leaf_row(row, start, count, p - start, packet, levels)
+
+    @jit
+    def advance_cells(old2, base, new_base, leaving2, nc, n, levels, new2):
+        cells = new2.shape[0]
+        for cell in range(cells):
+            old = old2[cell]
+            new = new2[cell]
+            for j in range(new.shape[0]):
+                new[j] = 0.0
+            lv = leaving2[cell]
+            p = np.int64(base[cell]) * nc
+            p2 = np.int64(new_base[cell]) * nc
+            shared = True
+            start = 0
+            count = n
+            level = 0
+            while count > 128:
+                left = (count // 2) - ((count // 2) % 8)
+                if p2 >= start + left:
+                    if shared and p >= start + left:
+                        new[level] = old[level]
+                    elif shared:
+                        new[level] = decode_node(old, levels, start, left, level + 1, lv, p, p2)
+                        shared = False
+                    else:
+                        new[level] = tree_future(lv, p, p2, start, left)
+                    start = start + left
+                    count = count - left
+                else:
+                    count = left
+                level += 1
+            q2 = p2 - start
+            if not shared:
+                # the whole leaf prefix [start, p2) is leaving values: encode it from the accessor
+                rounded = count - count % 8
+                if count < 8 or q2 >= rounded:
+                    if count < 8:
+                        value = -0.0
+                        for k in range(q2):
+                            value = value + fut(lv, p, p2, start + k)
+                    else:
+                        value = leaf_future(lv, p, p2, start, rounded)
+                        for k in range(rounded, q2):
+                            value = value + fut(lv, p, p2, start + k)
+                    new[levels] = value
+                else:
+                    for j in range(8):
+                        if j >= q2:
+                            continue
+                        value = fut(lv, p, p2, start + j)
+                        k = j + 8
+                        while k < q2:
+                            value = value + fut(lv, p, p2, start + k)
+                            k += 8
+                        new[levels + j] = value
+                continue
+            q = p - start
+            rounded = count - count % 8
+            if count < 8 or q >= rounded:
+                value = old[levels]
+                for k in range(q, q2):
+                    value = value + fut(lv, p, p2, start + k)
+                new[levels] = value
+                continue
+            r = np.empty(8, np.float64)
+            for j in range(8):
+                if j < q:
+                    r[j] = old[levels + j]
+                elif j < q2:
+                    r[j] = fut(lv, p, p2, start + j)
+                else:
+                    r[j] = 0.0
+            if q2 >= rounded:
+                k = 8
+                while k < rounded:
+                    for j in range(8):
+                        if k + j >= q:
+                            r[j] = r[j] + fut(lv, p, p2, start + k + j)
+                    k += 8
+                value = ((r[0] + r[1]) + (r[2] + r[3])) + ((r[4] + r[5]) + (r[6] + r[7]))
+                for k in range(rounded, q2):
+                    value = value + fut(lv, p, p2, start + k)
+                new[levels] = value
+                continue
+            k = 8
+            while k < rounded:
+                for j in range(8):
+                    if k + j >= q and k + j < q2:
+                        r[j] = r[j] + fut(lv, p, p2, start + k + j)
+                k += 8
+            for j in range(8):
+                if j < q2:
+                    new[levels + j] = r[j]
+                else:
+                    new[levels + j] = 0.0
+
+    return {"decode_cells": decode_cells, "encode_cells": encode_cells, "advance_cells": advance_cells}
+
+
+def _compiled():
+    global _NUMBA
+    if _NUMBA is None:
+        try:
+            import numba
+        except Exception:  # noqa: BLE001 - absence is a documented refusal below, never a silent fallback
+            _NUMBA = False
+        else:
+            _NUMBA = _build_numba(numba)
+    return _NUMBA or None
+
