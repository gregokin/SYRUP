@@ -0,0 +1,51 @@
+"""Exact left-to-right host prefix folds, compiled without reassociation.
+
+No geometry, transfer, inventory convention or tolerance changes. Every class
+uses the existing voxel-order additions; room uses the existing per-voxel
+max(capacity-total,0) then voxel-order additions. Scratch is bounded by the
+caller's chunk. Optional acceleration of host metadata, never a GPU exchange
+kernel or hydraulic fallback.
+"""
+from __future__ import annotations
+
+import numpy as np
+
+_KERNELS = None
+
+
+def kernels():
+    global _KERNELS
+    if _KERNELS is None:
+        try:
+            import numba
+        except ImportError:
+            _KERNELS = False
+        else:
+            jit=numba.njit(cache=False,fastmath=False,nogil=True,error_model='numpy')
+
+            @jit
+            def by_class(columns,prefix):
+                k,_nv,nc=columns.shape
+                out=np.zeros((k,nc),np.float64)
+                for i in range(k):
+                    for v in range(prefix[i]):
+                        for c in range(nc):
+                            out[i,c]=out[i,c]+columns[i,v,c]
+                return out
+
+            @jit
+            def room(totals,prefix,capacity):
+                out=np.zeros(totals.shape[0],np.float64)
+                for i in range(totals.shape[0]):
+                    value=0.0
+                    for v in range(prefix[i]):
+                        delta=capacity-totals[i,v]
+                        # np.maximum propagates NaN. Python/Numba max may
+                        # choose zero instead, which would hide invalid state.
+                        positive=delta if np.isnan(delta) or delta > 0.0 else 0.0
+                        value=value+positive
+                    out[i]=value
+                return out
+
+            _KERNELS={'by_class':by_class,'room':room}
+    return _KERNELS or None
