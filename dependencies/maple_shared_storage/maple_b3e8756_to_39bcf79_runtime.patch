+def export_version(version: DeepStoreVersion, destination_dir: str | Path, *,
+                   max_store_bytes: int | None = None) -> str:
+    """Copy a version -- its manifest and EVERY referenced chunk file --
+    into another store directory (created if absent, or required to carry
+    the same header), verifying each copied file's digest as it is
+    streamed. Files already present under their content-addressed names
+    are not rewritten. Returns the manifest digest, which is the same in
+    both stores (path-independent identity). The source is not modified.
+    For a v2 version the referenced files are exactly its bases and
+    overlays (each distinct file once); no ancestor manifest is copied, so
+    the exported version loads without its ancestors (local integrity
+    only, see `load_version`).
+
+    Capacity (CW-B106C1). The governing cap is the destination's PERSISTENT
+    descriptor cap when the destination already holds a `store.json`
+    (never raised), further reduced by an explicit `max_store_bytes` when
+    that is stricter. A fresh destination is initialised with the explicit
+    cap, else the source store's cap (the inherited initialisation rule).
+    The preflight counts the destination's current files plus every
+    referenced chunk/overlay file it lacks (each distinct file once) PLUS
+    the selected manifest's bytes unless that manifest is already present,
+    and refuses before ANY file is created -- for a fresh destination not
+    even the empty descriptor is written. On success the only descriptor
+    that may be new is that empty, version-less `store.json`, which is
+    preparation, not committed version data."""
+    if not isinstance(version, DeepStoreVersion):
+        raise ValueError("export_version expects a DeepStoreVersion")
+    destination = Path(destination_dir)
+    h = version.header
+    explicit = None if max_store_bytes is None else _require_int(max_store_bytes, "max_store_bytes", minimum=1)
+    if _store_json_path(destination).exists():
+        existing = _read_store_json(destination)
+        if existing["header_digest"] != h.digest():
+            raise ValueError(
+                f"{destination} already holds a deep store with a different header "
+                f"({existing['header_digest'][:16]}... vs {h.digest()[:16]}...)"
+            )
+        descriptor_cap = int(existing["max_store_bytes"])
+        prepared = False
+    else:
+        descriptor_cap = explicit if explicit is not None else int(_read_store_json(version.store_dir)["max_store_bytes"])
+        prepared = True
+    cap = descriptor_cap if explicit is None else min(descriptor_cap, explicit)
+    files: dict[str, tuple[Path, Path, str, int]] = {}
+    for ref in version.chunks:
+        slot = version.slot_files(ref.index)
+        base = _chunk_path(destination, slot.base_sha256)
+        files.setdefault(base.name, (_chunk_path(version.store_dir, slot.base_sha256), base,
+                                     slot.base_sha256, ref.nbytes))
+        if slot.overlay is not None:
+            ov = _overlay_path(destination, slot.overlay.sha256)
+            files.setdefault(ov.name, (_overlay_path(version.store_dir, slot.overlay.sha256), ov,
+                                       slot.overlay.sha256, slot.overlay.nbytes))
+    manifest_bytes = version.manifest_path.read_bytes()
+    if _sha256_bytes(manifest_bytes) != version.manifest_digest:
+        raise ValueError("source manifest does not hash to its digest; export refused")
+    manifest_target = _manifest_path(destination, version.manifest_digest)
+    on_disk, _, _ = _scan_store_bytes(destination)
+    chunk_need = sum(size for _src, target, _sha, size in files.values() if not target.exists())
+    manifest_need = 0 if manifest_target.exists() else len(manifest_bytes)
+    if on_disk + chunk_need + manifest_need > cap:
+        raise ValueError(
+            f"export_version refused: {chunk_need} bytes of chunk/overlay files and {manifest_need} manifest "
+            f"bytes would raise {destination} from {on_disk} bytes above its cap {cap} (destination descriptor "
+            f"cap {descriptor_cap}{'' if explicit is None else f', explicit bound {explicit}'}"
+            f"{', not yet created' if prepared else ''}); nothing was written"
+        )
+    _init_store_dir(destination, h, descriptor_cap)
+    for source, target, sha, size in files.values():
+        if not target.exists():
+            _copy_file_verified(source, target, expected_sha256=sha, expected_size=size)
+    written = _write_bytes_once(manifest_target, manifest_bytes, expected_sha256=version.manifest_digest)
+    _bump("bytes_written", written)
+    return version.manifest_digest
+
+
+def _copy_file_verified(source: Path, target: Path, *, expected_sha256: str, expected_size: int) -> None:
+    """Streamed copy with digest verification of the bytes written
+    (bounded buffer); atomic publish; never overwrites."""
+    if target.exists():
+        return
+    target.parent.mkdir(parents=True, exist_ok=True)
+    tmp = target.with_name(f".{target.name}.{os.getpid()}.{threading.get_ident()}.tmp")
+    digest = hashlib.sha256()
+    size = 0
+    try:
+        with open(source, "rb") as src, open(tmp, "wb") as dst:
+            while True:
+                piece = src.read(_HASH_BLOCK_BYTES)
+                if not piece:
+                    break
+                digest.update(piece)
+                size += len(piece)
+                dst.write(piece)
+            dst.flush()
+            os.fsync(dst.fileno())
+        if size != expected_size or digest.hexdigest() != expected_sha256:
+            raise ValueError(f"source file {source} does not match its recorded digest/size; export refused")
+        os.chmod(tmp, 0o444)
+        os.replace(tmp, target)
+    except BaseException:
+        if tmp.exists():
+            os.unlink(tmp)
+        raise
+    _bump("bytes_written", size)
+
+
+def process_memory_report() -> dict[str, int | str | None]:
+    """The calling process's ACTUAL memory figures from `/proc/self/status`
+    (Linux), in bytes: `rss_bytes` (VmRSS), `rss_file_bytes` (RssFile:
+    resident pages of file-backed mappings -- where touched chunk mappings
+    show up), `rss_anon_bytes` (RssAnon: heap/array buffers),
+    `rss_shmem_bytes`, `vm_size_bytes`. `None` for any figure the platform
+    does not expose; `source` names the file read or `None`. Measured,
+    never estimated; a separate-process observation (the root's RSS
+    subprocess) remains the authoritative test."""
+    keys = {"VmRSS": "rss_bytes", "RssFile": "rss_file_bytes", "RssAnon": "rss_anon_bytes",
+            "RssShmem": "rss_shmem_bytes", "VmSize": "vm_size_bytes"}
+    out: dict[str, int | str | None] = {name: None for name in keys.values()}
+    out["source"] = None
+    try:
+        with open("/proc/self/status", encoding="ascii", errors="replace") as handle:
+            for line in handle:
+                label, _, rest = line.partition(":")
+                if label in keys:
+                    parts = rest.split()
+                    if len(parts) >= 2 and parts[1] == "kB" and parts[0].isdigit():
+                        out[keys[label]] = int(parts[0]) * 1024
+        out["source"] = "/proc/self/status"
+    except OSError:
+        pass
+    return out
+
+
+def deep_store_report(version: DeepStoreVersion) -> dict[str, Any]:
+    """Disk, mapping, transient-buffer and process-RSS accounting, kept
+    SEPARATE and never summed into one figure:
+
+    * disk: `store_disk_bytes` / `store_chunk_files` / `store_version_
+      files` (everything on disk under the store, all versions incl.
+      orphans, one directory scan), `version_referenced_bytes` (this
+      version's chunk slots), `logical_dense_bytes` (what the dense
+      array WOULD be; never allocated), `max_store_bytes`;
+    * this handle's OWN mappings: `mapping_cache_chunks` (cap),
+      `cached_chunk_memmaps`, `mapped_bytes_cached` (bytes of mappings it
+      currently references), `mapped_bytes_bound` (cap x largest chunk).
+      Views retained by callers are not visible here and are theirs;
+    * transient host copies: `transient_buffer_bytes_bound` (one chunk:
+      builder buffer / journal copy / validation reconstruction) and
+      `gather_bytes_bound_default`;
+    * the process: `process_memory` from `process_memory_report()` --
+      actual VmRSS / RssFile / RssAnon, in which touched pages of LIVE
+      file-backed mappings DO appear (RssFile). Not estimated.
+    * `counters`: the bounded tallies, incl. mappings opened/evicted.
+    """
+    h = version.header
+    on_disk, n_chunk_files, n_version_files = _scan_store_bytes(version.store_dir)
+    cap = int(_read_store_json(version.store_dir)["max_store_bytes"])
+    return {
+        "store_dir": str(version.store_dir),
+        "version_id": version.version_id,
+        "manifest_digest": version.manifest_digest,
+        "n_chunks": version.n_chunks,
+        "chunk_columns": h.chunk_columns,
+        "chunk_bytes_max": h.chunk_bytes_max,
+        "version_referenced_bytes": version.referenced_bytes(),
+        "logical_dense_bytes": h.logical_bytes,
+        "store_disk_bytes": on_disk,
+        "store_chunk_files": n_chunk_files,
+        "store_version_files": n_version_files,
+        "max_store_bytes": cap,
+        "mapping_cache_chunks": version.mapping_cache_chunks,
+        "cached_chunk_memmaps": version.cached_chunk_memmaps,
+        "mapped_bytes_cached": version.mapped_bytes_cached,
+        "mapped_bytes_bound": version.mapped_bytes_bound,
+        "transient_buffer_bytes_bound": h.chunk_bytes_max,
+        "gather_bytes_bound_default": DEFAULT_MAX_GATHER_COLUMNS * h.column_bytes,
+        "process_memory": process_memory_report(),
+        "counters": read_deep_store_counters(),
+    } | _overlay_report_fields(version)
+
+
+def _overlay_report_fields(version: DeepStoreVersion) -> dict[str, Any]:
+    """Extra keys for a v2 version only (a v1 report is unchanged)."""
+    if version.format_version == 1:
+        return {}
+    h = version.header
+    overlays = [version.slot_files(i).overlay for i in range(version.n_chunks)]
+    present = [ov for ov in overlays if ov is not None]
+    return {
+        "format": DEEP_STORE_FORMAT_V2,
+        "encoding": version.encoding,
+        "logical_manifest_digest": version.logical_manifest_digest,
+        "overlay_max_bytes": version.overlay_max_bytes,
+        "version_overlay_slots": len(present),
+        "version_overlay_bytes": sum(ov.nbytes for ov in present),
+        "version_overlay_records": sum(ov.n_records for ov in present),
+        "version_base_bytes": sum(ref.nbytes for ref in version.chunks),
+        "overlay_counters": read_overlay_counters(),
+        # CW-B106C1 qualification of the inherited `transient_buffer_bytes_bound`
+        # (kept unchanged): it is ONE chunk destination buffer per operation,
+        # NOT the total temporary peak of a v2 operation. Only per-component
+        # bounds that follow directly from this version's metadata are given;
+        # no whole-process peak is claimed.
+        "transient_buffer_bytes_bound_scope": (
+            "one materialization/journal chunk buffer per operation (chunk_bytes_max); not a total "
+            "temporary peak: iterator overlap, merge keys, encoded overlay, mapped files and the "
+            "file-verification read buffer can coexist with it"
+        ),
+        "iterator_materialized_buffers_bound": 2,
+        "iterator_materialized_bytes_bound": 2 * h.chunk_bytes_max,
+        "iterator_bound_scope": (
+            "iter_chunks over overlaid slots: the generator holds no reference to a yielded block; a "
+            "consumer that keeps only the previous block has at most two materialized blocks alive; a "
+            "consumer that retains more blocks owns them"
+        ),
+        "publication_component_bounds_bytes": {
+            "slot_buffer": h.chunk_bytes_max,
+            "merged_keys_int64": 8 * h.chunk_columns * h.n_voxels,
+            "encoded_overlay_max": max(overlay_slot_bound_bytes(ref.nbytes, None) for ref in version.chunks),
+            "file_verification_read_buffer": _HASH_BLOCK_BYTES,
+        },
+        "publication_component_bounds_scope": (
+            "separate per-component bounds for one overlay publication step (they may coexist; the "
+            "journal arrays, numpy temporaries of the key union and mapped base/overlay pages are not "
+            "included); not a measured or whole-process peak"
+        ),
+    }
+
+
+def deep_store_file_report(store_dir: str | Path, *, with_references: bool = False) -> dict[str, Any]:
+    """Physical file inventory of a store by one directory scan: raw chunk
+    files `<sha>.f64`, overlay files `<sha>.ovl.f64`, in-flight/orphaned
+    `.tmp` files (NOT counted by the cap scan), other files, and version
+    manifests, with byte totals. With `with_references=True` every manifest
+    (v1 or v2) is parsed -- metadata only, its own hash checked -- and the
+    files referenced by NO parseable manifest are reported as orphans (an
+    I/O failure during publication can leave such files; they are reported,
+    never deleted here). Unparseable/invalid manifests are counted."""
+    store_dir = Path(store_dir)
+    out: dict[str, Any] = {name: 0 for name in (
+        "raw_chunk_files", "raw_chunk_bytes", "overlay_files", "overlay_bytes", "tmp_files", "tmp_bytes",
+        "other_files", "version_files", "version_bytes")}
+    names: dict[str, tuple[str, int]] = {}
+    chunks = _chunks_dir(store_dir)
+    if chunks.is_dir():
+        with os.scandir(chunks) as it:
+            for entry in it:
+                if not entry.is_file():
+                    continue
+                size = entry.stat().st_size
+                stem = entry.name.split(".", 1)[0]
+                if entry.name.endswith(".tmp"):
+                    out["tmp_files"] += 1
+                    out["tmp_bytes"] += size
+                elif entry.name.endswith(_OVERLAY_SUFFIX) and _is_hex_digest(stem) \
+                        and entry.name == stem + _OVERLAY_SUFFIX:
+                    out["overlay_files"] += 1
+                    out["overlay_bytes"] += size
+                    names[entry.name] = ("overlay", size)
+                elif entry.name == stem + _CHUNK_SUFFIX and _is_hex_digest(stem):
+                    out["raw_chunk_files"] += 1
+                    out["raw_chunk_bytes"] += size
+                    names[entry.name] = ("raw", size)
+                else:
+                    out["other_files"] += 1
+    versions = _versions_dir(store_dir)
+    manifests: list[Path] = []
+    if versions.is_dir():
+        with os.scandir(versions) as it:
+            for entry in it:
+                if entry.is_file() and entry.name.endswith(".json"):
+                    out["version_files"] += 1
+                    out["version_bytes"] += entry.stat().st_size
+                    manifests.append(Path(entry.path))
+                elif entry.is_file() and entry.name.endswith(".tmp"):
+                    out["tmp_files"] += 1
+                    out["tmp_bytes"] += entry.stat().st_size
+    if with_references:
+        referenced: set[str] = set()
+        invalid = 0
+        for mpath in manifests:
+            try:
+                data = mpath.read_bytes()
+                if _sha256_bytes(data) + ".json" != mpath.name:
+                    raise ValueError("manifest does not hash to its name")
+                raw = json.loads(data)
+                if raw.get("format") == DEEP_STORE_FORMAT:
+                    for entry in raw["chunks"]:
+                        referenced.add(entry["sha256"] + _CHUNK_SUFFIX)
+                elif raw.get("format") == DEEP_STORE_FORMAT_V2:
+                    for entry in raw["chunks"]:
+                        referenced.add(entry["base_sha256"] + _CHUNK_SUFFIX)
+                        if entry["overlay"] is not None:
+                            referenced.add(entry["overlay"]["sha256"] + _OVERLAY_SUFFIX)
+                else:
+                    raise ValueError("unknown format")
+            except (OSError, ValueError, KeyError, TypeError, AttributeError):
+                invalid += 1
+        orphans = {n: v for n, v in names.items() if n not in referenced}
+        out.update({
+            "invalid_manifests": invalid,
+            "orphan_raw_chunk_files": sum(1 for kind, _ in orphans.values() if kind == "raw"),
+            "orphan_raw_chunk_bytes": sum(size for kind, size in orphans.values() if kind == "raw"),
+            "orphan_overlay_files": sum(1 for kind, _ in orphans.values() if kind == "overlay"),
+            "orphan_overlay_bytes": sum(size for kind, size in orphans.values() if kind == "overlay"),
+        })
+    return out
