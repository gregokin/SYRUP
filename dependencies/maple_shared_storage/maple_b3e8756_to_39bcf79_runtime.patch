+        ledger.process_totals_kg, ledger.process_totals_compensation_kg, process_increment_kg
+    )
+    del process_increment_kg
+    positive_increment_kg = xp.where(residual_kg > 0, residual_kg, 0.0)
+    negative_increment_kg = xp.where(residual_kg < 0, -residual_kg, 0.0)
+    new_residual_positive_kg, new_residual_positive_comp_kg = _kahan_add(
+        ledger.numerical_residual_positive_kg[0], ledger.numerical_residual_positive_compensation_kg[0],
