@@ -0,0 +1,65 @@
+"""The water-depth commit stage on a RESIDENT-WINDOW bed (CW-B3c).
+
+`make_water_depth_commit_callback` (the dense stage) diagnoses the
+committed bed elevation through `diagnose_combined_surface_state`, which
+needs a dense column. This factory builds the same two-phase stage for a
+windowed bed: the elevation comes from the EXACT packet-decoded height
+(`windowed_committed_surface_elevation_m`), the depth rule is the same
+`apply_depth_after_bed_change`, the result box is the same
+`WaterCommitResult` (pending until the caller publishes), and the bed is
+returned UNCHANGED (the candidate objects, never the caller's). The
+callback is marked as a windowed stage, which is what
+`commit_windowed_topography` requires of any non-identity stage.
+"""
+
+from __future__ import annotations
+
+from maple.core.backend import MapleArray
+from maple.core.parameters.geometry import GeometrySpec
+from maple.core.types.active_layer import ActiveLayerState
+from maple.core.types.voxel import WindowedVoxelColumnState
+from maple.core.types.water import WaterState
+from maple.surface.topographic_commit.windowed_commit import (
+    WindowedLifecycleStageCallback,
+    windowed_committed_surface_elevation_m,
+    windowed_lifecycle_stage,
+)
+from maple.water.commit_callback import WaterCommitResult
+from maple.water.depth import apply_depth_after_bed_change
+
+__all__ = ["make_windowed_water_depth_commit_callback"]
+
+
+def make_windowed_water_depth_commit_callback(
+    water: WaterState,
+    geometry: GeometrySpec,
+    committed_elevation_before_m: MapleArray,
+    *,
+    depth_update_rule: str = "constant_free_surface",
+    trusted_packet: bool = False,
+) -> tuple[WindowedLifecycleStageCallback, WaterCommitResult]:
+    """Build the windowed `water_callback` and its two-phase result box.
+    `committed_elevation_before_m` is the committed elevation captured
+    immediately before the commit, exactly as for the dense factory."""
+    box = WaterCommitResult(water=water)
+
+    @windowed_lifecycle_stage
+    def _water_callback(
+        column: WindowedVoxelColumnState,
+        active_layer: ActiveLayerState,
+        stage_geometry: GeometrySpec,
+        mass_resolution_kg: float,
+    ) -> tuple[WindowedVoxelColumnState, ActiveLayerState]:
+        elevation_m = windowed_committed_surface_elevation_m(
+            column, active_layer, stage_geometry, trusted_packet=trusted_packet,
+        )
+        delta_z_bed_m = elevation_m - committed_elevation_before_m
+        update = apply_depth_after_bed_change(box.water.depth_m, delta_z_bed_m, stage_geometry, depth_update_rule)
+        box._pending_depth_update = update
+        box._pending_water = WaterState(
+            depth_m=update.new_depth_m,
+            mobile_mass_by_cell_class_kg=box.water.mobile_mass_by_cell_class_kg,
+        )
+        return column, active_layer
+
+    return _water_callback, box
diff --git a/src/maple/water/windowed_step.py b/src/maple/water/windowed_step.py
new file mode 100644
index 0000000000000000000000000000000000000000..9a260a870d7d5d8ca2146411d4ee805ba2bce269
--- /dev/null
+++ b/src/maple/water/windowed_step.py
@@ -0,0 +1,614 @@
+"""One conservative water accounting step on a RESIDENT-WINDOW bed
+(CW-B3b): `maple.water.step.apply_water_process_demand`, step for step,
+with the dense exchange routines replaced by the windowed transaction.
+
+Identical order of operations (availability cap -> erosion -> availability
+-> mobile -> deposition cap -> deposition -> availability -> export cap ->
+ledger x2 -> ground truth -> validation), identical shared machinery for
+everything that is not the bed itself (`cap_demand_by_availability`,
+`update_availability_after_*`, `accumulate_process_transfer`,
+`validate_water_process_result`), and the GENUINE `WaterState`,
+`SedimentLedgerState`, `SedimentAvailabilityState` and result types.
+
+What differs, and only this
+---------------------------
+* The bed is a `WindowedVoxelColumnState`; ONE working window copy is
+  made for the whole step (the erosion output is never exposed, so the
+  deposition call continues on the same private working bed).
+* Misses go to real gathered full columns in bounded batches on the host;
+  deep-store writes are NOT performed here: the step returns a
+  `DeepJournal` in an opaque receipt, and `publish_windowed_result`
+  applies it (copy-on-write version, or exact identity for an empty
+  journal). Until publication the result's column is bound to the
+  caller's version with a PENDING journal: its cheap validator passes;
+  the streamed full validator must run after publication.
+* `bed_change_by_class_kg` is always the touched-storage measurement
+  (active after - before over every cell, plus the stored change over
+  exactly the touched window slots and gathered miss columns), and the
+  validator's inventory scale is the resident totals + deep totals +
+  active layer, so no whole `(ny, nx, n_voxels, n_classes)` array exists.
+
+Memory: working window + totals + metadata copies (resident size), one
+miss batch at a time (`max_gather_columns` columns), the compact or
+dense ledger's own two accumulation passes (B1 semantics unchanged), the
+usual `(ny, nx, n_classes)` demand/result arrays. No full dense array.
+
+Height caveat: nothing here derives a routing-compatible height; the
+windowed elevation remains a diagnostic class fold (see
+`WindowedVoxelColumnState.height_packet`).
+
+Shared-storage S2/S4 adaptations of the reference (MAPLE 24c6 runtime,
+`docs/shared-storage/adoption-plan.md`): the PUBLIC path (S2) updates the
+ledger (dense seven-channel or, since S3, process-compact) through the
+public `accumulate_process_transfer` twice (gross removal, then gross
+deposition), exactly as the dense water step does; the fixed-capacity
+policy is required at the public boundary and the deep store's class ids
+are compared with the configured grain classes in ORDER before any
+working array exists. S4 adds the PRIVATE owned scaffolding reached only
+from the paired transaction (`maple.water.windowed_transaction`): with an
+internal owner the working bed is ADOPTED from the transaction's private
+post-pickup column, the post-pickup availability and the erosion-stage
+active layer are handed over in single-use holders through THIN wrappers
+of the unchanged public bodies, and both ledger accumulations may donate
+into transaction-private ledgers when the accumulate helper proves it
+(exact allocating public fallback otherwise, reason recorded). The public
+path is byte-for-byte the S2 path: `_owned is None` selects exactly its
+statements. The reference's public operation order and results are the
+oracle for every differential test.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+from dataclasses import dataclass
+from typing import Any
+
+import numpy as np
+
+from maple.core.backend import (
+    all_finite,
+    any_negative,
+    freeze,
+    read_transfer_counters,
+    resolve_operand_namespace,
+    to_float,
+)
+from maple.core.parameters.geometry import GeometrySpec
+from maple.core.parameters.grain_classes import GrainClassSet
+from maple.core.types.active_layer import ActiveLayerState
+from maple.core.types.sediment_availability import SedimentAvailabilityState
+from maple.core.types.sediment_ledger import SedimentLedgerState, process_index
+from maple.core.types.voxel import WindowedVoxelColumnState
+from maple.core.types.water import WaterState
+from maple.coupling.sediment_ledger.accumulate import accumulate_process_transfer
+from maple.surface.active_layer.windowed_exchange import (
+    _windowed_update_active_layer_after_deposition_held,
+    windowed_update_active_layer_after_deposition,
+    windowed_update_active_layer_after_erosion,
+)
+from maple.surface.availability.exchange import (
+    _update_availability_after_deposition_held,
+    _update_availability_after_erosion_held,
+    cap_demand_by_availability,
+    update_availability_after_deposition,
+    update_availability_after_erosion,
+)
+from maple.surface.availability.validation import require_valid_availability_pair
+from maple.surface.voxels.deep_store import (
+    DEFAULT_MAX_JOURNAL_RECORDS,
+    DeepJournal,
+    read_deep_store_counters,
+)
+from maple.surface.voxels.windowed_inventory import (
+    require_fixed_windowed_capacity,
+    with_window_cache,
+)
+from maple.surface.voxels.windowed_transfer import (
+    DEFAULT_EXCHANGE_GATHER_COLUMNS,
+    WindowedWorkingBed,
+    begin_windowed_transaction,
+    working_bed_journal,
+)
+from maple.water.interfaces import WaterProcessDemand, WaterProcessResult
+from maple.water.step import _optional_domain_array, zero_face_flux
+from maple.water.validation import validate_water_process_result
+
+
+class _OwnerHeld:
+    """S4 PRIVATE: the placeholder the paired transaction passes as
+    `sediment_availability` when its internal owner holds the post-pickup
+    availability (single use); never accepted by the public step."""
+
+    __slots__ = ()
+
+    def __repr__(self) -> str:
+        return "<owner-held availability>"
+
+
+_OWNER_HELD = _OwnerHeld()
+
+__all__ = [
+    "WindowedExchangeReceipt",
+    "WindowedWaterProcessResult",
+    "apply_windowed_water_process_demand",
+    "pending_deep_journal",
+    "publish_windowed_result",
+]
+
+
+class WindowedExchangeReceipt:
+    """OPAQUE (non-dataclass, non-container) host record carried by a
+    `WindowedWaterProcessResult`: the pending `DeepJournal` and the
+    exchange report. Opaque so the backend tree walkers never treat the
+    host journal arrays as resident leaves of a device result."""
+
+    __slots__ = ("journal", "report")
+
+    def __init__(self, journal: DeepJournal, report: dict[str, Any]) -> None:
+        self.journal = journal
+        self.report = report
+
+    def __repr__(self) -> str:
+        return f"WindowedExchangeReceipt(records={self.journal.n_records}, report_keys={len(self.report)})"
+
+
+@dataclass(frozen=True)
+class WindowedWaterProcessResult(WaterProcessResult):
+    """A `WaterProcessResult` whose `new_voxel_column` is a
+    `WindowedVoxelColumnState` bound to the CALLER's deep-store version
+    with a pending journal in `exchange_receipt`. Never mislabelled as
+    dense: the type says so, the column carries no `mass_kg`."""
+
+    exchange_receipt: Any = None
+
+
+def pending_deep_journal(result: WindowedWaterProcessResult) -> DeepJournal:
+    if not isinstance(result, WindowedWaterProcessResult) or not isinstance(result.exchange_receipt,
+                                                                            WindowedExchangeReceipt):
+        raise ValueError("expected a WindowedWaterProcessResult carrying a WindowedExchangeReceipt")
+    return result.exchange_receipt.journal
+
+
+def publish_windowed_result(
+    result: WindowedWaterProcessResult,
+    geometry: GeometrySpec,
+    mass_resolution_kg: float,
+    *,
+    max_records: int = DEFAULT_MAX_JOURNAL_RECORDS,
+    encoding: str = "full",
+    overlay_max_bytes: int | None = None,
+) -> WindowedVoxelColumnState:
+    """Apply the result's pending journal to its bound version (copy-on-
+    write; the caller's version and every retained version are
+    unchanged) and return the column REBOUND to the new version. An empty
+    journal is the exact identity: the same column object, no disk
+    activity. A journal refusal (capacity, packing, disk cap) raises with
+    nothing published and the result untouched. `encoding` /
+    `overlay_max_bytes` are forwarded unchanged to `publish_pending_column`
+    (default `"full"`); unsupported options are refused even for an empty
+    journal."""
+    from maple.surface.voxels.windowed_pending import publish_pending_column
+
+    journal = pending_deep_journal(result)
+    column = result.new_voxel_column
+    if column.pending_deep is None and journal.n_records:
+        raise ValueError("result lost its unpublished deep-journal binding")
+    if column.pending_deep is not None and column.pending_deep.journal is not journal:
+        raise ValueError("exchange receipt does not own this column's pending journal")
+    return publish_pending_column(column, geometry, mass_resolution_kg, max_records=max_records,
+                                  encoding=encoding, overlay_max_bytes=overlay_max_bytes)
+
+
+def apply_windowed_water_process_demand(
+    voxel_column: WindowedVoxelColumnState,
+    active_layer: ActiveLayerState,
+    water: WaterState,
+    ledger: SedimentLedgerState,
+    demand: WaterProcessDemand,
+    geometry: GeometrySpec,
+    grain_classes: GrainClassSet,
+    mass_resolution_kg: float,
+    *,
+    sediment_availability: SedimentAvailabilityState | None = None,
+    initial_available_fraction: np.ndarray | None = None,
+    adapter_name: str = "prescribed",
+    detachment_integration: str = "rate_times_dt",
+    trust_window_cache: bool = False,
+    max_gather_columns: int = DEFAULT_EXCHANGE_GATHER_COLUMNS,
+    max_journal_records: int = DEFAULT_MAX_JOURNAL_RECORDS,
+) -> WindowedWaterProcessResult:
+    """Apply one water-process demand on a windowed bed. See the module
+    docstring; argument semantics are those of `apply_water_process_
+    demand` with `trust_window_cache` in place of `trust_surface_cache`
+    and the bed change always measured from the touched storage. The
+    caller's column, active layer, water, ledger, availability and deep
+    store are never written, on success or on any failure; the returned
+    column is a logically accepted PENDING state bound to the caller's
+    version, published only by `publish_windowed_result`."""
+    require_fixed_windowed_capacity(geometry, operation="apply_windowed_water_process_demand")
+    return _apply_windowed_water_process_demand(
+        voxel_column, active_layer, water, ledger, demand, geometry, grain_classes, mass_resolution_kg,
+        sediment_availability=sediment_availability, initial_available_fraction=initial_available_fraction,
+        adapter_name=adapter_name, detachment_integration=detachment_integration,
+        trust_window_cache=trust_window_cache, max_gather_columns=max_gather_columns,
+        max_journal_records=max_journal_records, _owned=None,
+    )
+
+
+def _apply_windowed_water_process_demand(
+    voxel_column: WindowedVoxelColumnState,
+    active_layer: ActiveLayerState,
+    water: WaterState,
+    ledger: SedimentLedgerState,
+    demand: WaterProcessDemand,
+    geometry: GeometrySpec,
+    grain_classes: GrainClassSet,
+    mass_resolution_kg: float,
+    *,
+    sediment_availability: SedimentAvailabilityState | None,
+    initial_available_fraction: np.ndarray | None,
+    adapter_name: str,
+    detachment_integration: str,
+    trust_window_cache: bool,
+    max_gather_columns: int,
+    max_journal_records: int,
+    _owned: Any = None,
+) -> WindowedWaterProcessResult:
+    """The ONE implementation of `apply_windowed_water_process_demand`
+    (stage order, validations, arithmetic and publication as the public
+    reference path). `_owned is None` is the public step, statement for
+    statement the S2 path. S4: the private paired transaction
+    (`maple.water.windowed_transaction`) passes its internal deposit-phase
+    owner, which changes exactly these scaffolding points: the working bed
+    is ADOPTED from the transaction's private post-pickup column instead
+    of copied (after the owner's own overlap proof; public copying begin
+    otherwise), the post-pickup availability and the erosion-stage layer
+    are handed over in single-use holders through thin wrappers of the
+    unchanged public bodies, the FIRST ledger accumulation may donate into
+    the transaction's private post-pickup ledger and the SECOND into the
+    first's private result (exact allocating fallback otherwise), with the
+    ownership guards comparing against the transaction caller's ledger plus
+    every caller / borrowed / callback array. Every validation -- demand,
+    class order, growth policy, namespace and the availability pair
+    (owner-held included) -- runs BEFORE any owned mutation."""
+    if _owned is not None:  # S4: the owner hands over the post-pickup availability (single use)
+        sediment_availability = _owned.take_availability(sediment_availability)
+    elif sediment_availability is _OWNER_HELD:
+        raise TypeError("the owner-held availability placeholder is private to the paired transaction")
+    if not isinstance(voxel_column, WindowedVoxelColumnState):
+        raise TypeError("apply_windowed_water_process_demand requires a WindowedVoxelColumnState")
+    ny, nx = geometry.ny, geometry.nx
+    n_classes = len(grain_classes.classes)
+    shape = (ny, nx, n_classes)
+    class_ids = tuple(grain_class.class_id for grain_class in grain_classes.classes)
+    xp = resolve_operand_namespace(
+        voxel_column, active_layer, water, ledger, demand, sediment_availability, initial_available_fraction,
+    )
+    transfers_at_entry = read_transfer_counters()
+    deep_at_entry = read_deep_store_counters()
+
+    requested_removal = xp.asarray(demand.requested_removal_by_cell_class_kg, dtype=np.float64)
+    requested_deposition = xp.asarray(demand.requested_deposition_by_cell_class_kg, dtype=np.float64)
+    for name, array in (("requested_removal_by_cell_class_kg", requested_removal),
+                        ("requested_deposition_by_cell_class_kg", requested_deposition)):
+        if array.shape != shape:
+            raise ValueError(f"demand.{name} shape {array.shape} != expected {shape}")
+        if not all_finite(array):
+            raise ValueError(f"demand.{name} contains non-finite values")
+        if any_negative(array):
+            raise ValueError(f"demand.{name} must be >= 0 everywhere (a magnitude)")
+    if voxel_column.window_kg.shape[-1] != n_classes:
+        raise ValueError(
+            f"windowed column has {voxel_column.window_kg.shape[-1]} classes but grain_classes has {n_classes}"
+        )
+    # Every SUPPLIED optional demand term is validated BEFORE the working bed
+    # exists. CW-B67: an ABSENT term keeps its `None` sentinel here; the same
+    # helper builds its exact dense zero array immediately before the term's
+    # first numeric use (stage 4 / stage 7), so it is not live through erosion.
+    boundary_input = demand.boundary_input_by_cell_class_kg
+    if boundary_input is not None:
+        boundary_input = _optional_domain_array(
+            boundary_input, shape, "demand.boundary_input_by_cell_class_kg", xp)
+    requested_export = demand.boundary_export_by_cell_class_kg
+    if requested_export is not None:
+        requested_export = _optional_domain_array(
+            requested_export, shape, "demand.boundary_export_by_cell_class_kg", xp)
+    # S2 correction 1: the EXISTING native preflight for the optional
+    # `(sediment_availability, initial_available_fraction)` pair -- the one
+    # the avalanche entry points call -- runs here, BEFORE the cap and before
+    # any working array: both pools (shape, FP64, finite, nonnegative) and
+    # their closure against the active layer, and the fraction (required
+    # whenever the pair is given, `(ny, nx, n_classes)` FP64, finite, in
+    # [0, 1]) even where the fallback would not be used. `None` returns at
+    # once. It reads the operands in their own namespace (no transfer, no
+    # whole-volume scan). The direct dense water step does not run this
+    # preflight (a pre-existing dense boundary gap, reported separately);
+    # this new public path honours the native contract rather than inherit
+    # that gap, so it is STRICTER than the dense step for malformed pairs.
+    require_valid_availability_pair(
+        sediment_availability, initial_available_fraction, active_layer, mass_resolution_kg,
+    )
+
+    # --- 1. availability cap -----------------------------------------------
+    capped_removal, availability_shortfall = cap_demand_by_availability(requested_removal, sediment_availability)
+    # CW-B44: the full shortfall array is reported only as its class sum.
+    # It is the cap's own new array (`zeros_like` or `requested - capped`),
+    # never a caller or result array; the same reduction is taken here and
+    # the array is released.
+    availability_shortfall_by_class_kg = availability_shortfall.sum(axis=(0, 1))
+    del availability_shortfall
+
+    # --- working bed: the ONE window copy of this step ----------------------
+    # The begin refuses, BEFORE any copy, a deep store whose class ids differ
+    # from the configured grain classes in order, a stale/sibling binding, a
+    # malformed pending binding and an enabled growth policy.
+    bed: WindowedWorkingBed = (begin_windowed_transaction if _owned is None else _owned.begin)(
+        voxel_column, geometry, mass_resolution_kg, trust_window_cache=trust_window_cache,
+        max_gather_columns=max_gather_columns, max_journal_records=max_journal_records, class_ids=class_ids,
+    )
+    active_layer_mass_before = active_layer.mass_kg
+    mobile_before = water.mobile_mass_by_cell_class_kg
+
+    # --- 2. erosion (shared active-layer arithmetic, windowed replenishment) --
+    new_layer, erosion_result = windowed_update_active_layer_after_erosion(
+        bed, active_layer, capped_removal, geometry, mass_resolution_kg,
+    )
+    actual_removal = erosion_result.actual_removed_mass_by_class_kg
+    # CW-B44: `capped_removal` was last read by the erosion call above. It is
+    # either the cap's own new array (released here) or, without availability,
+    # the same object as `requested_removal` (only this name is dropped; the
+    # array stays alive as the result's requested removal).
+    del capped_removal
+
+    # --- 3. availability after erosion --------------------------------------
+    working_availability = sediment_availability
+    if working_availability is not None:
+        if _owned is None:
+            working_availability = update_availability_after_erosion(
+                working_availability, active_layer_mass_before, erosion_result, initial_available_fraction,
+            )
+        else:  # S4: the private post-pickup availability is handed over; no name of this frame holds it
+            availability_holder = [working_availability]
+            working_availability = sediment_availability = None
+            working_availability = _update_availability_after_erosion_held(
+                availability_holder, active_layer_mass_before, erosion_result, initial_available_fraction,
+            )
+            del availability_holder
+    if _owned is not None:
+        # S4: the private post-pickup availability's last read was the update
+        # above; only this frame held it, so it is released here (and, being
+        # dead, leaves the later foreign sets).
+        sediment_availability = None
+    # CW-B44: the availability update above is the erosion result's last
+    # whole-object read. Keep the two arrays still needed (`actual_removal`
+    # for the mobile pool, ledger and result; the residual for the ledger),
+    # take the EXISTING result reductions of the rest, and release the
+    # object: its shortfall, replenished mass and post-erosion active-layer
+    # mass are erosion-call allocations no caller, result or later step holds.
+    erosion_residual = erosion_result.numerical_residual_mass_by_class_kg
+    shortfall_by_class_kg = erosion_result.shortfall_mass_by_class_kg.sum(axis=(0, 1))
+    numerical_residual_by_class_kg = erosion_residual.sum(axis=(0, 1))
+    erosion_replenishment_residual_sum_kg = erosion_result.replenishment_numerical_residual_total_mass_kg.sum()
+    del erosion_result
+
+    # --- 4. mobile pool ------------------------------------------------------
+    if boundary_input is None:  # CW-B67: the absent default, built at first use
+        boundary_input = _optional_domain_array(None, shape, "demand.boundary_input_by_cell_class_kg", xp)
+    mobile_after_pickup = mobile_before + actual_removal + boundary_input
+    # CW-B44: last full read of `boundary_input` (the step's own zero array
+    # when the demand omits it, otherwise only a name for the caller's demand
+    # array, which stays alive through `demand`); its class sum is reported.
+    boundary_input_by_class_kg = boundary_input.sum(axis=(0, 1))
+    del boundary_input
+
+    # --- 5. deposition capped at the mobile load -----------------------------
+    deposition = xp.minimum(requested_deposition, mobile_after_pickup)
+    if _owned is None:
+        new_layer, deposition_result = windowed_update_active_layer_after_deposition(
+            bed, new_layer, deposition, geometry, mass_resolution_kg,
+        )
+    else:  # S4: the erosion-stage layer is handed over, so it dies inside the deposition after the mixing
+        layer_holder = [new_layer]
+        new_layer = None
+        new_layer, deposition_result = _windowed_update_active_layer_after_deposition_held(
+            bed, layer_holder, deposition, geometry, mass_resolution_kg,
+        )
+        del layer_holder
+    mobile_after_deposition = mobile_after_pickup - deposition
+    # CW-B29: `mobile_after_pickup` is this step's own new array (neither a
+    # caller array nor any result/receipt field); the line above is its last
+    # read, so its storage is released before the ledger accumulations.
+    # CW-B44: likewise the name `deposition` (the step's own `xp.minimum`
+    # output); when the deposition call kept it as `deposited_mass_by_class_kg`
+    # it stays alive through `deposited` below, otherwise it is released.
+    del mobile_after_pickup, deposition
+
+    # --- 6. availability after deposition ------------------------------------
+    if working_availability is not None:
+        if _owned is None:
+            working_availability = update_availability_after_deposition(working_availability, deposition_result)
+        else:  # S4: this step's own post-erosion availability is handed over (dead before the closure)
+            availability_holder = [working_availability]
+            working_availability = None
+            working_availability = _update_availability_after_deposition_held(availability_holder, deposition_result)
+            del availability_holder
+    # CW-B44: the deposition result's last whole-object read. Keep the
+    # deposited mass (result field and the second ledger update), take the
+    # EXISTING reductions, release the object (its buried mass is a private
+    # deposition-call allocation; its post-deposition mass is `new_layer`'s).
+    deposited = deposition_result.deposited_mass_by_class_kg
+    deposited_mass_by_class_kg = deposited.sum(axis=(0, 1))
+    deposition_residual_sum_kg = deposition_result.numerical_residual_total_mass_kg.sum()
+    del deposition_result
+
+    # --- 7. boundary export --------------------------------------------------
+    if requested_export is None:  # CW-B67: the absent default, built at first use
+        requested_export = _optional_domain_array(None, shape, "demand.boundary_export_by_cell_class_kg", xp)
+    boundary_export = xp.minimum(requested_export, mobile_after_deposition)
+    mobile_after = mobile_after_deposition - boundary_export
+    # CW-B29: last reads of `mobile_after_deposition` (a private new array)
+    # and of `requested_export` (a private zero array when the demand omits
+    # it, otherwise only a name for the caller's demand array, which stays
+    # alive through `demand`). Released before the ledger accumulations.
+    # CW-B44: `boundary_export` is the step's own `xp.minimum` output and is
+    # reported only as its class sum; released here as well.
+    boundary_export_by_class_kg = boundary_export.sum(axis=(0, 1))
+    del mobile_after_deposition, requested_export, boundary_export
+
+    # --- 8. ledger, both gross directions: the dense step's own two calls ----
+    # Removal first (negative direction), then deposition (positive). Two
+    # PUBLIC calls on the seven-channel dense ledger, never one netted array;
+    # burial's own residual is a per-cell scalar and is reported in
+    # `numerical_residual_scalar_kg`, exactly as in `maple.water.step`.
+    water_channel = process_index("water_erosion_deposition")
+    if _owned is None:
+        working_ledger = accumulate_process_transfer(
+            ledger, water_channel, -actual_removal, -erosion_residual, mass_resolution_kg,
+        )
+    else:  # S4: the same accumulation, donated into the transaction's private post-pickup ledger when proven
+        from maple.core.backend import array_leaves as _leaves
+
+        working_ledger = _owned.first_accumulation(
+            ledger, water_channel, -actual_removal, -erosion_residual,
+            mass_resolution_kg,
+            foreign_arrays=_leaves(
+                voxel_column, active_layer, water, demand, sediment_availability, initial_available_fraction,
+                new_layer, working_availability, bed.window_kg,
+                bed.window_totals_kg, bed.base, bed.deep_by_class_kg, bed.deep_total_kg, bed.deep_room_kg,
+                bed.packet, bed.journal_cells, bed.journal_voxels, bed.journal_values, mobile_after,
+                requested_removal, requested_deposition, actual_removal, deposited,
+                availability_shortfall_by_class_kg, shortfall_by_class_kg, numerical_residual_by_class_kg,
+                erosion_replenishment_residual_sum_kg, boundary_input_by_class_kg, deposited_mass_by_class_kg,
+                deposition_residual_sum_kg, boundary_export_by_class_kg,
+            ),
+        )
+    # CW-B44: the first accumulation was the residual's last read (its class
+    # sum was taken above); it is an erosion-call allocation, released here.
+    del erosion_residual
+    if _owned is None:
+        working_ledger = accumulate_process_transfer(
+            working_ledger, water_channel, deposited, xp.zeros(shape, dtype=np.float64), mass_resolution_kg,
+        )
+    else:
+        # S4: `working_ledger` is this frame's private, freshly produced
+        # intermediate (never exposed, frozen or seen by a callback), so the
+        # second accumulation may write into its arrays so that no third
+        # ledger is RETAINED (the helper's Kahan temporaries are still
+        # allocated and released inside the call). Ownership is PROVEN
+        # inside the helper
+        # (type, layout, writeability, namespace and memory ranges against
+        # the transaction caller's ledger and every array below, including
+        # the opaque packet and pending-journal buffers); otherwise the
+        # original allocating public call runs and the reason is recorded.
+        from maple.core.backend import array_leaves as _leaves
+        from maple.coupling.sediment_ledger.accumulate import _accumulate_water_transfer_into_owned
+
+        working_ledger, second_blocker = _accumulate_water_transfer_into_owned(
+            working_ledger, _owned.caller_ledger, water_channel, deposited,
+            xp.zeros(shape, dtype=np.float64), mass_resolution_kg,
+            foreign_arrays=_leaves(
+                voxel_column, active_layer, water, demand, sediment_availability, initial_available_fraction,
+                new_layer, working_availability, bed.window_kg,
+                bed.window_totals_kg, bed.base, bed.deep_by_class_kg, bed.deep_total_kg, bed.deep_room_kg,
+                bed.packet, bed.journal_cells, bed.journal_voxels, bed.journal_values, mobile_after,
+                requested_removal, requested_deposition, actual_removal, deposited,
+                availability_shortfall_by_class_kg, shortfall_by_class_kg, numerical_residual_by_class_kg,
+                erosion_replenishment_residual_sum_kg, boundary_input_by_class_kg, deposited_mass_by_class_kg,
+                deposition_residual_sum_kg, boundary_export_by_class_kg,
+            ) + _owned.second_foreign(),
+        )
+        _owned.record_second(second_blocker)
+
+    # --- 9. publish the working bed into a NEW windowed column ---------------
+    journal = working_bed_journal(bed)
+    freeze(bed.window_kg)
+    freeze(bed.window_totals_kg)
+    new_column = WindowedVoxelColumnState(
+        window_kg=bed.window_kg, base=bed.base, deep_by_class_kg=bed.deep_by_class_kg,
+        deep_total_kg=bed.deep_total_kg, deep_room_kg=bed.deep_room_kg, n_voxels=bed.n_voxels,
+        deep_store=voxel_column.deep_store, generation=voxel_column.generation,
+        manifest_digest=voxel_column.manifest_digest,
+    )
+    new_column = with_window_cache(new_column)
+    if bed.packet is not None:
+        # CW-B3c: bind the maintained packet grid to the NEW column (pending
+        # version identity; publication rebinds to the published one).
+        from maple.surface.voxels.windowed_prefix import attach_prefix_packets
+
+        new_column = attach_prefix_packets(new_column, bed.packet)
+    from maple.surface.voxels.windowed_pending import attach_pending_journal
+
+    new_column = attach_pending_journal(new_column, journal)
+    bed_change_by_class_kg = (new_layer.mass_kg - active_layer_mass_before).sum(axis=(0, 1)) + bed.voxel_delta_by_class_kg
+    bed_inventory_scale_kg = to_float(
+        bed.window_totals_kg.sum() + bed.deep_total_kg.sum() + new_layer.mass_kg.sum()
+    )
+    new_water = WaterState(depth_m=water.depth_m, mobile_mass_by_cell_class_kg=mobile_after)
+
+    transfers_delta = read_transfer_counters().delta(transfers_at_entry)
+    deep_now = read_deep_store_counters()
+    report = {key: value for key, value in bed.counters.items() if not key.endswith("_at_begin")}
+    report.update({
+        "journal_records": journal.n_records,
+        "journal_records_before_dedupe": bed.pending_records(),
+        "window_voxels": int(bed.window_kg.shape[2]),
+        "resident_window_bytes": int(bed.window_kg.nbytes),
+        "max_gather_columns": int(max_gather_columns),
+        "max_journal_records": int(max_journal_records),
+        # An ESTIMATE of this step's transient resident bytes from the arrays it
+        # actually allocated (two window copies, the totals, the largest miss
+        # batch); a diagnostic only, never a preflight or admission figure.
+        "transient_bytes_estimate": int(
+            2 * bed.window_kg.nbytes + bed.window_totals_kg.nbytes
+            + bed.counters.get("miss_batch_bytes_peak", 0)
+        ),
+        "deep_store_counters_delta": {k: deep_now[k] - deep_at_entry[k] for k in deep_now},
+        # ACTUAL MAPLE transfer tallies for this step (to_host/to_device
+        # counted calls); the *_bytes_to_* keys above are the author's own
+        # sizes of what was asked to move and are identical on a host bed.
+        "transfer_counters_delta": dataclasses.asdict(transfers_delta),
+        "deep_writes_performed_here": 0,
+    })
+    if _owned is not None:
+        # S4: truthful account of what the owner actually did (begin mode,
+        # each accumulation donated or the fallback reason).
+        report["paired_transaction"] = _owned.describe()
+    receipt = WindowedExchangeReceipt(
+        journal if new_column.pending_deep is None else new_column.pending_deep.journal, report)
+
+    result = WindowedWaterProcessResult(
+        new_voxel_column=new_column,
+        new_active_layer=new_layer,
+        new_water=new_water,
+        new_ledger=working_ledger,
+        new_sediment_availability=working_availability,
+        adapter_name=adapter_name,
+        detachment_integration=detachment_integration,
+        requested_removal_by_cell_class_kg=requested_removal,
+        actual_removal_by_cell_class_kg=actual_removal,
+        deposition_by_cell_class_kg=deposited,
+        requested_removal_by_class_kg=requested_removal.sum(axis=(0, 1)),
+        actual_removal_by_class_kg=actual_removal.sum(axis=(0, 1)),
+        availability_shortfall_by_class_kg=availability_shortfall_by_class_kg,
+        shortfall_by_class_kg=shortfall_by_class_kg,
+        numerical_residual_by_class_kg=numerical_residual_by_class_kg,
+        deposited_mass_by_class_kg=deposited_mass_by_class_kg,
+        bed_change_by_class_kg=bed_change_by_class_kg,
+        mobile_mass_before_by_class_kg=mobile_before.sum(axis=(0, 1)),
+        mobile_mass_after_by_class_kg=mobile_after.sum(axis=(0, 1)),
+        boundary_input_by_class_kg=boundary_input_by_class_kg,
+        boundary_export_by_class_kg=boundary_export_by_class_kg,
+        face_flux=(demand.face_flux if demand.face_flux is not None
+                   else zero_face_flux(ny, nx, n_classes, namespace=xp)),
+        numerical_residual_scalar_kg=to_float(
+            erosion_replenishment_residual_sum_kg
+            + deposition_residual_sum_kg
+        ),
+        hydraulic_diagnostics=demand.hydraulic_diagnostics,
+        exchange_receipt=receipt,
+    )
+    validate_water_process_result(
+        result, ny=ny, nx=nx, n_classes=n_classes, mass_resolution_kg=mass_resolution_kg,
+        bed_inventory_scale_kg=bed_inventory_scale_kg,
+    )
+    return result
