+        (("cells_packet_terms", 1, 0), ("cells_voxels_classes", 1, 1), ("cells_voxels", 0, 1), ("cells", 1, 3)),
+        _E1_ENCODE_PROVENANCE),
+    "e1_advance": ScratchBound(
+        (("cells_packet_terms", 2, 1), ("cells_window_classes", 0, 1), ("cells", 4, 4)), _E1_ADVANCE_PROVENANCE),
+    "cheap_column_validator.numpy": ScratchBound(
+        (("cells_window_classes", 0, 2), ("cells_classes", 0, 3), ("cells", 1, 12)), _CHEAP_VALIDATOR_PROVENANCE),
+    "cheap_column_validator.cupy": ScratchBound(
+        (("cells_window_classes", 0, 2), ("cells_classes", 0, 3), ("cells", 1, 12)), _CHEAP_VALIDATOR_PROVENANCE),
+    "availability_pair_validator.numpy": ScratchBound(
+        (("cells_classes", 6, 8),), _AVAILABILITY_VALIDATOR_PROVENANCE),
+    "availability_pair_validator.cupy": ScratchBound(
+        (("cells_classes", 6, 8),), _AVAILABILITY_VALIDATOR_PROVENANCE),
+    "ledger_validators.numpy": ScratchBound(
+        (("cells_voxels_classes", 1, 3),), _LEDGER_VALIDATORS_PROVENANCE),
+    "ledger_validators.cupy": ScratchBound(
+        (("cells_voxels_classes", 1, 3),), _LEDGER_VALIDATORS_PROVENANCE),
+    "step_wrapper_validators.numpy": ScratchBound(
+        (("cells_classes", 0, 4), ("cells", 5, 3)), _STEP_WRAPPER_PROVENANCE),
+    "step_wrapper_validators.cupy": ScratchBound(
+        (("cells_classes", 0, 4), ("cells", 5, 3)), _STEP_WRAPPER_PROVENANCE),
+})
+
+
+def required_scratch_bounds(namespace: str, *, has_availability: bool) -> tuple[str, ...]:
+    """The `KERNEL_SCRATCH_BOUNDS` keys a plan for `namespace` needs."""
+    keys = [f"extract_kernel.{namespace}", f"deposit_kernel.{namespace}", f"proportional_vector.{namespace}",
+            f"result_validator.{namespace}", "e1_encode", "e1_advance", f"cheap_column_validator.{namespace}",
+            f"ledger_validators.{namespace}", f"step_wrapper_validators.{namespace}"]
+    if has_availability:
+        keys.append(f"availability_pair_validator.{namespace}")
+    return tuple(keys)
+
+
+def _scratch_bytes(bound: ScratchBound, sizes: Mapping[str, int], *, key: str) -> int:
+    total = 0
+    for shape_key, n_fp64, n_bool in bound.terms:
+        if shape_key not in sizes:
+            raise WindowedAdmissionError(f"scratch bound {key!r} names shape {shape_key!r} the planner cannot size")
+        total += sizes[shape_key] * (FP64 * n_fp64 + n_bool)
+    return total
+
+
+# ---------------------------------------------------------------------------
+# Validation helpers (Python ints only; refuse before any arithmetic)
+# ---------------------------------------------------------------------------
+
+
+def _int(value: Any, name: str, *, minimum: int, maximum: int | None = None) -> int:
+    """A non-Boolean Python or NumPy INTEGER SCALAR, normalized to `int`. Arrays of every shape (including
+    zero-dimensional), floats, complex numbers, strings and Booleans are refused by name."""
+    if isinstance(value, (bool, np.bool_)) or not isinstance(value, (int, np.integer)):
+        raise WindowedAdmissionError(f"{name} must be a non-Boolean integer, got {value!r}")
+    value = int(value)
+    if value < minimum or (maximum is not None and value > maximum):
+        bound = f"[{minimum}, {maximum}]" if maximum is not None else f">= {minimum}"
+        raise WindowedAdmissionError(f"{name} must lie in {bound}, got {value}")
+    return value
+
+
+def _choice(value: Any, name: str, choices: tuple) -> str:
+    """An enum given as a plain string scalar; arrays, bytes and other types are refused (a generic membership
+    test would let `np.asarray(["numpy"])` pass)."""
+    if not isinstance(value, str) or value not in choices:
+        raise WindowedAdmissionError(f"{name} must be one of {choices}, got {value!r}")
+    return str(value)
+
+
+def _flag(value: Any, name: str) -> bool:
+    if not isinstance(value, (bool, np.bool_)):
+        raise WindowedAdmissionError(f"{name} must be a bool, got {value!r}")
+    return bool(value)
+
+
+def _exact_fraction(value: Any, name: str) -> Fraction:
+    """`safety_fraction` as the EXACT rational of the given scalar: Python `int` / `float`, NumPy integer / floating
+    scalars and `Fraction`. A NumPy floating scalar is converted through ITS OWN exact integer ratio
+    (`as_integer_ratio()` of the float16 / float32 / float64 / longdouble value itself -- never through a Python
+    `float` downcast, which on this platform would silently round an 80-bit `np.longdouble` to 53 bits: S5B
+    correction 2), so `np.float32(0.1)` is the rational of that float32, not of the decimal 0.1, and a longdouble
+    just above 1 is refused as out of range rather than rounded to 1. Booleans, complex numbers, strings, arrays
+    (any shape) and non-finite or out-of-range values are refused by name BEFORE any query."""
+    if isinstance(value, (bool, np.bool_)):
+        raise WindowedAdmissionError(f"{name} must be a real number in (0, 1], got {value!r}")
+    if isinstance(value, Fraction):
+        fraction = value
+    elif isinstance(value, (int, np.integer)):
+        fraction = Fraction(int(value))
+    elif isinstance(value, float):
+        if not math.isfinite(value):
+            raise WindowedAdmissionError(f"{name} must be finite, got {value!r}")
+        fraction = Fraction(value)  # exact: Python's Fraction(float) uses the float's own integer ratio
+    elif isinstance(value, np.floating):
+        if not bool(np.isfinite(value)):  # the scalar's own finiteness, at its own precision
+            raise WindowedAdmissionError(f"{name} must be finite, got {value!r}")
+        numerator, denominator = value.as_integer_ratio()  # exact at the scalar's own precision (longdouble included)
+        fraction = Fraction(int(numerator), int(denominator))
+    else:
+        raise WindowedAdmissionError(f"{name} must be a real number in (0, 1], got {value!r}")
+    if not 0 < fraction <= 1:
+        raise WindowedAdmissionError(f"{name} must lie in (0, 1], got {value!r}")
+    return fraction
+
+
+def _pair(host: int = 0, device: int = 0) -> tuple[int, int]:
+    return (int(host), int(device))
+
+
+def _sum(*pairs: tuple[int, int]) -> tuple[int, int]:
+    return (sum(p[0] for p in pairs), sum(p[1] for p in pairs))
+
+
+def _max(*pairs: tuple[int, int]) -> tuple[int, int]:
+    """Componentwise maximum (host and device peaks are tracked separately)."""
+    return (max(p[0] for p in pairs), max(p[1] for p in pairs))
+
+
+def _scale(pair: tuple[int, int], factor: int) -> tuple[int, int]:
+    return (pair[0] * factor, pair[1] * factor)
+
+
+# ---------------------------------------------------------------------------
+# The plan
+# ---------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class WindowedStepPlan:
+    """Immutable, transparent result of `windowed_transaction_bytes`.
+
+    `new_*_bytes_peak` is the admitted figure: the maximum over the ordered
+    stages (`stages`) of simultaneous NEW native-array bytes, host and
+    device separately. `caller_live_*_bytes` is INFORMATIONAL: what the
+    caller already holds (an availability reading already excludes it, so
+    it is never subtracted from availability). `advisory_owned_*` (paired
+    only) is what the owner's adoption and donation WOULD save; admission
+    never reads it. `terms` lists every named term, `stages` the per-stage
+    peaks, `bound_provenance` the scratch derivations used, `unbounded_
+    terms` the required scratch keys absent from `KERNEL_SCRATCH_BOUNDS`
+    (a non-empty tuple makes the plan inadmissible), `excluded` what lies
+    outside the bound, `inputs` the validated planner inputs (admission
+    recomputes the plan from them to check integrity)."""
+
+    path: str
+    namespace: str
+    caller_live_host_bytes: int
+    caller_live_device_bytes: int
+    new_host_bytes_peak: int
+    new_device_bytes_peak: int
+    peak_stage_host: str
+    peak_stage_device: str
+    advisory_owned_host_bytes_peak: int | None
+    advisory_owned_device_bytes_peak: int | None
+    mapped_bytes_max: int
+    stages: Mapping[str, tuple[int, int]]
+    terms: Mapping[str, int]
+    bound_provenance: Mapping[str, str]
+    unbounded_terms: tuple[str, ...]
+    excluded: tuple[str, ...] = field(default=EXCLUDED)
+    inputs: Mapping[str, Any] = field(default_factory=lambda: MappingProxyType({}))
+
+    def __post_init__(self) -> None:
+        _choice(self.path, "path", PATHS)
+        _choice(self.namespace, "namespace", NAMESPACES)
+        for name in ("caller_live_host_bytes", "caller_live_device_bytes", "new_host_bytes_peak",
+                     "new_device_bytes_peak", "mapped_bytes_max"):
+            _int(getattr(self, name), name, minimum=0)
+        if not self.stages:
+            raise WindowedAdmissionError("a plan needs at least one stage")
+        host_peak = max(h for h, _d in self.stages.values())
+        device_peak = max(d for _h, d in self.stages.values())
+        if (self.new_host_bytes_peak, self.new_device_bytes_peak) != (host_peak, device_peak):
+            raise WindowedAdmissionError("plan peaks do not equal the maximum over its stages")
+        if self.stages[self.peak_stage_host][0] != host_peak or self.stages[self.peak_stage_device][1] != device_peak:
+            raise WindowedAdmissionError("plan peak stage names do not match the stage table")
+        for name in ("advisory_owned_host_bytes_peak", "advisory_owned_device_bytes_peak"):
+            value = getattr(self, name)
+            if (value is None) != (self.path == "public"):
+                raise WindowedAdmissionError(f"{name} must be None exactly for the public path")
+            if value is not None:
+                _int(value, name, minimum=0)
+        if self.advisory_owned_host_bytes_peak is not None and (
+                self.advisory_owned_host_bytes_peak > self.new_host_bytes_peak
+                or self.advisory_owned_device_bytes_peak > self.new_device_bytes_peak):
+            raise WindowedAdmissionError("the advisory owned figure can never exceed the admitted figure")
+        if not isinstance(self.unbounded_terms, tuple) or not all(isinstance(t, str) for t in self.unbounded_terms):
+            raise WindowedAdmissionError("unbounded_terms must be a tuple of names")
+        if self.namespace == "numpy" and self.new_device_bytes_peak != 0:
+            raise WindowedAdmissionError("a numpy plan has no device bytes")
+
+    @property
+    def admissible(self) -> bool:
+        """False when a required scratch term is unbounded (admission then refuses by name)."""
+        return not self.unbounded_terms
+
+
+def _signature(plan: WindowedStepPlan) -> tuple:
+    return (plan.path, plan.namespace, plan.caller_live_host_bytes, plan.caller_live_device_bytes,
+            plan.new_host_bytes_peak, plan.new_device_bytes_peak, plan.peak_stage_host, plan.peak_stage_device,
+            plan.advisory_owned_host_bytes_peak, plan.advisory_owned_device_bytes_peak, plan.mapped_bytes_max,
+            tuple(sorted(plan.stages.items())), tuple(sorted(plan.terms.items())), plan.unbounded_terms)
+
+
+# ---------------------------------------------------------------------------
+# The planner
+# ---------------------------------------------------------------------------
+
+
+def windowed_transaction_bytes(
+    *,
+    ny: int,
+    nx: int,
+    n_classes: int,
+    n_voxels: int,
+    window_voxels: int,
+    packet_terms: int,
+    base_itemsize: int,
+    ledger_present_processes: int,
+    has_availability: bool,
+    has_boundary_input: bool,
+    has_boundary_export: bool,
+    has_face_flux: bool,
+    max_gather_columns: int,
+    max_journal_records: int,
+    pending_records: int,
+    chunk_bytes_max: int,
+    overlay_bytes_max: int,
+    mapping_cache_chunks: int,
+    namespace: str,
+    path: str,
+) -> WindowedStepPlan:
+    """Conservative NEW-bytes plan of one windowed water transaction.
+
+    Inputs are the SAME options the driver passes to the step (`max_gather_
+    columns`, `max_journal_records` -- taken explicitly, no default, so the
+    plan and the step agree) plus the validated shapes: `packet_terms` is
+    `0` when the column carries no prefix packets, else exactly the E1
+    `packet_terms(n_voxels * n_classes)`; `base_itemsize` is 4 (int32) or
+    8 (int64); `ledger_present_processes` is the number of stored ledger
+    channels (`N_LEDGER_PROCESSES` for the dense ledger, fewer for a
+    compact one); `pending_records` is the COUNT of journal records the
+    input column carries (`0 <= pending_records <= max_journal_records`,
+    the step's own refusal rule); `chunk_bytes_max`, `overlay_bytes_max`,
+    `mapping_cache_chunks` describe the deep-store version's mapping cache
+    (`DeepStoreVersion.header.chunk_bytes_max`, the largest overlay or 0,
+    `DeepStoreVersion.mapping_cache_chunks`). Option domains are the
+    source's own: `max_gather_columns` in `[1, MAX_EXCHANGE_GATHER_COLUMNS]`,
+    `max_journal_records` any nonnegative integer (a LIMIT; `0` is valid),
+    `window_voxels <= n_voxels`. `DEFAULT_MAX_JOURNAL_RECORDS` is only what
+    the step uses when ITS caller omits the option; it is not a cap and no
+    upper sanity bound is invented here (a large limit yields a large plan;
+    Python integers do not overflow).
+
+    Pure: no model array, device, file or domain-cell loop; refuses every
+    malformed input by name before any arithmetic."""
+    # --- validation, before any arithmetic ---------------------------------------------------------------------
+    ny = _int(ny, "ny", minimum=1)
+    nx = _int(nx, "nx", minimum=1)
+    n_classes = _int(n_classes, "n_classes", minimum=1)
+    n_voxels = _int(n_voxels, "n_voxels", minimum=1)
+    window_voxels = _int(window_voxels, "window_voxels", minimum=1, maximum=n_voxels)
+    try:  # the NATIVE storage rule (core/types/voxel.py): W >= MIN_WINDOW_VOXELS unless W == n_voxels
+        window_voxels = int(resolve_window_voxels(window_voxels, n_voxels))
+    except ValueError as exc:
+        raise WindowedAdmissionError(f"window_voxels: {exc}") from None
+    packet_terms = _int(packet_terms, "packet_terms", minimum=0)
+    if packet_terms:
+        from maple.core.backend.prefix_cell_reductions import packet_terms as e1_packet_terms
+
+        expected = int(e1_packet_terms(n_voxels * n_classes))
+        if packet_terms != expected:
+            raise WindowedAdmissionError(
+                f"packet_terms must be 0 (no packets) or exactly packet_terms(n_voxels * n_classes) = {expected}, "
+                f"got {packet_terms}")
+    base_itemsize = _int(base_itemsize, "base_itemsize", minimum=min(BASE_ITEMSIZES), maximum=max(BASE_ITEMSIZES))
+    if base_itemsize not in BASE_ITEMSIZES:
+        raise WindowedAdmissionError(f"base_itemsize must be one of {BASE_ITEMSIZES} (int32 / int64), got {base_itemsize}")
+    ledger_present_processes = _int(ledger_present_processes, "ledger_present_processes", minimum=1,
+                                    maximum=N_LEDGER_PROCESSES)
+    has_availability = _flag(has_availability, "has_availability")
+    has_boundary_input = _flag(has_boundary_input, "has_boundary_input")
+    has_boundary_export = _flag(has_boundary_export, "has_boundary_export")
+    has_face_flux = _flag(has_face_flux, "has_face_flux")
+    max_gather_columns = _int(max_gather_columns, "max_gather_columns", minimum=1, maximum=MAX_EXCHANGE_GATHER_COLUMNS)
+    max_journal_records = _int(max_journal_records, "max_journal_records", minimum=0)
+    pending_records = _int(pending_records, "pending_records", minimum=0, maximum=max_journal_records)
+    chunk_bytes_max = _int(chunk_bytes_max, "chunk_bytes_max", minimum=0)
+    overlay_bytes_max = _int(overlay_bytes_max, "overlay_bytes_max", minimum=0)
+    mapping_cache_chunks = _int(mapping_cache_chunks, "mapping_cache_chunks", minimum=1)
+    namespace = _choice(namespace, "namespace", NAMESPACES)
+    path = _choice(path, "path", PATHS)
+    inputs = MappingProxyType({
+        "ny": ny, "nx": nx, "n_classes": n_classes, "n_voxels": n_voxels, "window_voxels": window_voxels,
+        "packet_terms": packet_terms, "base_itemsize": base_itemsize,
+        "ledger_present_processes": ledger_present_processes, "has_availability": has_availability,
+        "has_boundary_input": has_boundary_input, "has_boundary_export": has_boundary_export,
+        "has_face_flux": has_face_flux, "max_gather_columns": max_gather_columns,
+        "max_journal_records": max_journal_records, "pending_records": pending_records,
+        "chunk_bytes_max": chunk_bytes_max, "overlay_bytes_max": overlay_bytes_max,
+        "mapping_cache_chunks": mapping_cache_chunks, "namespace": namespace, "path": path,
+    })
+
+    # --- scratch bounds (frozen constant only; absent -> unbounded, never guessed) -------------------------------
+    bounds_table = KERNEL_SCRATCH_BOUNDS
+    required = required_scratch_bounds(namespace, has_availability=has_availability)
+    unbounded = tuple(key for key in required if key not in bounds_table)
+    provenance = {key: bounds_table[key].provenance for key in required if key in bounds_table}
+
+    def scratch(key: str, sizes: Mapping[str, int]) -> int:
+        if key not in bounds_table:
+            return 0  # recorded in `unbounded_terms`; the plan is then inadmissible
+        return _scratch_bytes(bounds_table[key], sizes, key=key)
+
+    # --- counts (all Python ints) ------------------------------------------------------------------------------
+    device = namespace == "cupy"
+
+    def bed(n: int) -> tuple[int, int]:  # arrays in the bed's namespace
+        return (0, n) if device else (n, 0)
+
+    def host(n: int) -> tuple[int, int]:  # host-only arrays (deep store, journal, E1)
+        return (n, 0)
+
+    C = ny * nx
+    K, W, V, P, I, G, J, R = (n_classes, window_voxels, n_voxels, packet_terms, base_itemsize, max_gather_columns,
+                              max_journal_records, pending_records)
+    N = N_LEDGER_PROCESSES
+    PL = ledger_present_processes
+    D = C * K * FP64            # one (ny, nx, K) FP64 array
+    c8 = C * FP64               # one (ny, nx) FP64 array
+    cb = C                      # one (ny, nx) bool array
+    Wn = C * W * K * FP64       # the resident window
+    Tt = C * W * FP64           # per-slot totals
+    Pk = C * P * FP64           # packet grid (0 without packets)
+    Bs = C * I                  # base / encoded_base
+    rec = 2 * INT64 + K * FP64  # one journal record (cell, voxel, values)
+    # Journal records that can exist in the working bed: the caller's limit J, and what the step can append on
+    # top of the R carried records (at most V per miss cell and one per spilled cell, every cell).
+    Jn = min(J, R + C * (V + 1))
+    Jb = Jn * rec
+    k = min(G, C)               # one miss batch
+    kVK = k * V * K * FP64
+    kWK = k * W * K * FP64
+    kK = k * K * FP64
+    kP = k * P * FP64
+    k8 = k * FP64
+    L = 8 * PL * D + 2 * D + C * K * INT64 + 2 * N * K * FP64  # ledger_storage_bytes(..., present).total_bytes
+    face = 0 if has_face_flux else (2 * ny * (nx + 1) * K + 2 * (ny + 1) * nx * K) * FP64
+    largest_checked = max(C * K, ny * (nx + 1) * K, (ny + 1) * nx * K)
+
+    def sizes(cells: int, voxels: int) -> dict[str, int]:
+        return {"cells_voxels_classes": cells * voxels * K, "cells_voxels": cells * voxels,
+                "cells_classes": cells * K, "cells": cells, "cells_packet_terms": cells * P,
+                "cells_window_classes": cells * W * K, "largest_checked_array": largest_checked, "classes": K}
+
+    terms: dict[str, int] = {}
+
+    def term(name: str, pair: tuple[int, int]) -> tuple[int, int]:
+        terms[f"{name}.host"], terms[f"{name}.device"] = pair
+        return pair
+
+    # --- caller-live inputs (informational; never subtracted from an availability reading) ----------------------
+    caller_live = _sum(
+        bed(Wn + Bs + D + 2 * c8 + Tt + Pk + (Bs if P else 0)),  # column: window, base, deep metadata, cache, packets
+        host(R * rec),                                            # carried pending journal
+        bed(D),                                                   # active layer
+        bed(c8 + D),                                              # water: depth, mobile
+        bed(3 * D if has_availability else 0),                    # availability pair + fraction
+        bed(2 * D + (D if has_boundary_input else 0) + (D if has_boundary_export else 0)),  # demand
+        bed(L),                                                   # ledger
+    )
+    term("caller_live", caller_live)
+
+    # --- shared building blocks ---------------------------------------------------------------------------------
+    resident = term("begin.resident_set", bed(Wn + Tt + Bs + D + 2 * c8 + Pk + K * FP64))
+    journal_segments = term("journal.segments_retained", host(Jb))
+    ledger_bytes = term("ledger.one_ledger", bed(L))
+    wrapper_masks = term("wrappers.validation_masks",
+                         bed(scratch(f"step_wrapper_validators.{namespace}", sizes(C, V))))
+
+    def miss_batch_peak(kernel_key: str, request_bytes: int) -> tuple[int, int]:
+        """One miss batch of `k` full columns (`_run_miss_batches`, `gather_working_columns`,
+        `_publish_miss_columns`) INCLUDING the right-hand-side overlap of the previous iteration's `before`,
+        `sub` and `after` (rebinding happens after the new gather is built)."""
+        host_part = (
+            kVK                                  # gather_columns output = `before` (overlaid in place)
+            + kWK                                # window rows brought to the host (copy on a device bed)
+            + kVK                                # `after` host copy (a view on a host bed; counted anyway)
+            + kVK                                # `(after - before)` temporary
+            + k * V * FP64                       # totals_after
+            + 3 * k * V + k * V * K              # occupied / changed / record masks, `after != before` (k,V,K) bool
+            + k8 + k * 4 + k * W * INT64         # top, new_base, slots
+            + kWK                                # new_window
+            + kK + 2 * k8                        # deep_by_class, deep_room, deep_total
+            + 2 * k * V * INT64 + kVK            # journal ci/vi and values (worst case: every voxel recorded)
+            + kP + scratch("e1_encode", sizes(k, V))  # packet rows re-encoded
+            + 2 * kVK                            # previous iteration's `before` and `after` (RHS overlap)
+            + 3 * Jn * INT64                     # `_apply_pending_records` idx/safe/hit per segment
+            + 3 * C * INT64                      # rows_h, cols_h, cells_flat (bounded by the miss count <= C)
+        )
+        bed_part = (
+            kVK                                  # `sub`, the kernel's in-place operand
+            + scratch(kernel_key, sizes(k, V))   # the dense batched kernel's own temporaries on (k,1,V,K)
+            + request_bytes + k8                 # request rows, device index
+            + kVK                                # previous iteration's `sub` (RHS overlap)
+            + kWK + kP                           # `_up` transients of new_window and packet rows
+            + 2 * C * INT64                      # rows_all / cols_all
+        )
+        return _sum(host(host_part), bed(bed_part))
+
+    def fast_peak(kernel_key: str) -> tuple[int, int]:
+        """`_run_fast_cells`: all-fast `before = window.copy()` or subset `sub` + `before` (at most two window
+        copies), plus the kernel's temporaries on (C,1,W,K)."""
+        return bed(2 * Wn + scratch(kernel_key, sizes(C, W)) + 2 * c8)
+
+    groups = bed(2 * (D + 3 * c8 + cb))          # per-batch results retained + `_assemble` outputs
+    extract_classification = bed(Tt + c8 + 7 * cb)
+    extract_kernel = f"extract_kernel.{namespace}"
+    deposit_kernel = f"deposit_kernel.{namespace}"
+    extraction = term("exchange.extraction_peak", _sum(
+        extract_classification, _max(miss_batch_peak(extract_kernel, k8), fast_peak(extract_kernel)), groups))
+    spill = term("exchange.spill_peak", _sum(
+        host(Wn + 3 * D + 9 * c8 + D + 2 * Pk + scratch("e1_advance", sizes(C, V))),
+        bed(4 * cb + 2 * c8 + Wn + Tt + D + 3 * c8)))
+    deposit_classification = bed(c8 + 2 * Tt + 8 * cb)
+    deposition_exchange = term("exchange.deposition_peak", _sum(
+        deposit_classification, _max(miss_batch_peak(deposit_kernel, kK), fast_peak(deposit_kernel)), groups))
+    availability_update = term("availability.update_transient",
+                               bed(16 * D + 2 * C * K) if has_availability else _pair())
+    ledger_call = term("ledger.accumulation_transient", _sum(
+        bed(17 * PL * D),                                        # named (P,C,K) locals + Kahan temporaries
+        bed(scratch(f"ledger_validators.{namespace}", sizes(C, PL))),
+        bed(5 * D + 2 * C * K * INT64 + C * K),                  # (C,K) pending Kahan + touches + touched mask
+        bed(3 * D + 2 * C * K if PL < N else 0),                 # compact: zero_slice, fold temporaries, sign masks
+    ))
+    publication_journal = term("publication.journal_transient", host(5 * Jb + 8 * Jn * INT64))
+    result_validation = term("publication.result_validator",
+                             bed(scratch(f"result_validator.{namespace}", sizes(C, V))))
+    face_flux = term("publication.zero_face_flux", bed(face))
+
+    # --- the public step, stage by stage ------------------------------------------------------------------------
+    optional_demand = (D if has_boundary_input else 0) + (D if has_boundary_export else 0)
+    r_entry = term("entry.demand_canonicalization", bed(2 * D + optional_demand))  # conservative: copies assumed
+    stages: dict[str, tuple[int, int]] = {}
+    stages["entry"] = _sum(r_entry, wrapper_masks)
+    cap_scratch = bed(scratch(f"availability_pair_validator.{namespace}", sizes(C, V))) if has_availability else _pair()
+    r_cap = _sum(r_entry, bed(D))                                            # capped removal retained
+    stages["availability_cap"] = _sum(r_cap, bed(D), cap_scratch)            # + shortfall transient
+    begin_scratch = bed(scratch(f"cheap_column_validator.{namespace}", sizes(C, V)))
+    r_begin = _sum(r_cap, resident, journal_segments)
+    stages["begin"] = _sum(r_begin, begin_scratch)
+    erosion_inner = _sum(bed(7 * D + 7 * c8 + C * K + 4 * cb), extraction, wrapper_masks)
+    stages["erosion"] = _sum(r_begin, erosion_inner)
+    r_erosion_result = _sum(r_begin, bed(5 * D + 2 * c8 + cb))              # result object + new layer live
+    stages["availability_after_erosion"] = _sum(r_erosion_result, availability_update)
+    r_after_erosion = _sum(r_begin, bed(3 * D), bed(2 * D if has_availability else 0))
+    stages["mobile_pool"] = _sum(r_after_erosion, bed(D), bed(0 if has_boundary_input else D))
+    r_mobile = _sum(r_after_erosion, bed(D))
+    deposition_inner = _sum(
+        bed(D + 3 * c8 + D + scratch(f"proportional_vector.{namespace}", sizes(C, V))),
+        _max(spill, deposition_exchange), wrapper_masks)
+    stages["deposition"] = _sum(r_mobile, bed(D), deposition_inner)
+    r_deposition = _sum(r_mobile, bed(3 * D + 2 * c8))
+    stages["availability_after_deposition"] = _sum(r_deposition, availability_update)
+    stages["export"] = _sum(r_deposition, bed(3 * D))
+    r_export = _sum(r_deposition, bed(D))
+    stages["ledger"] = _sum(r_export, ledger_bytes, bed(D), ledger_call)      # first ledger live during the second
+    r_ledger = _sum(r_export, _scale(ledger_bytes, 2))                       # RHS overlap of the two ledgers
+    stages["publication"] = _sum(
+        r_ledger, publication_journal, bed(Tt + Bs + D + C * P + 2 * cb), host(Jb), face_flux, result_validation)
+    public_peak = _max(*stages.values())
+    term("public.peak", public_peak)
+    term("public.result_retained", _sum(r_export, ledger_bytes, resident, bed(Tt + Bs), host(Jb), face_flux))
+
+    # --- the paired path: ALWAYS the allocating fallback -------------------------------------------------------
+    advisory: tuple[int, int] | None = None
+    if path == "paired":
+        phase_p_retained = term("paired.phase_p_retained_private_set",
+                                _sum(resident, bed(Tt + Bs + 4 * D), host(Jb), ledger_bytes))
+        callback = term("paired.callback_returned_arrays", bed(c8 + 3 * D + optional_demand))
+        for name in list(stages):
+            stages[f"phase_d.{name}"] = _sum(phase_p_retained, callback, stages[name])
+        for name in ("entry", "availability_cap", "begin", "erosion", "availability_after_erosion", "mobile_pool",
+                     "deposition", "availability_after_deposition", "export", "ledger", "publication"):
+            stages[f"phase_p.{name}"] = stages.pop(name)
+        paired_peak = _max(*stages.values())
+        term("paired.peak_allocating_fallback", paired_peak)
+        saving = _sum(resident, bed(Tt), ledger_bytes)                       # adoption of the private column + cache
+        floor_ = _sum(phase_p_retained, callback)                            # totals, one retained ledger (donation)
+        advisory = (max(paired_peak[0] - saving[0], floor_[0]), max(paired_peak[1] - saving[1], floor_[1]))
+        term("paired.advisory_owned_peak", advisory)
+
+    stages_view = MappingProxyType(dict(stages))
+    host_peak = max(h for h, _d in stages.values())
+    device_peak = max(d for _h, d in stages.values())
+    peak_stage_host = next(name for name, (h, _d) in stages.items() if h == host_peak)
+    peak_stage_device = next(name for name, (_h, d) in stages.items() if d == device_peak)
+    return WindowedStepPlan(
+        path=path, namespace=namespace,
+        caller_live_host_bytes=caller_live[0], caller_live_device_bytes=caller_live[1],
+        new_host_bytes_peak=host_peak, new_device_bytes_peak=device_peak,
+        peak_stage_host=peak_stage_host, peak_stage_device=peak_stage_device,
+        advisory_owned_host_bytes_peak=None if advisory is None else advisory[0],
+        advisory_owned_device_bytes_peak=None if advisory is None else advisory[1],
+        mapped_bytes_max=mapping_cache_chunks * (chunk_bytes_max + overlay_bytes_max),
+        stages=stages_view, terms=MappingProxyType(dict(terms)), bound_provenance=MappingProxyType(provenance),
+        unbounded_terms=unbounded, excluded=EXCLUDED, inputs=inputs,
+    )
+
+
+# ---------------------------------------------------------------------------
+# Admission
+# ---------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class AdmissionDecision:
+    """The structured outcome of `admit_windowed_transaction`. `admitted=False` carries a `reason` naming the
+    refusal; `*_required_bytes` is the admitted figure plus the driver's reserve; `*_margin_bytes` is
+    `floor(safety_fraction * available) - required` (negative when refused for insufficiency); `safety_fraction`
+    is the exact rational used for the comparison. A decision is not a reservation."""
+
+    admitted: bool
+    reason: str
+    plan: WindowedStepPlan
+    host_available_bytes: int | None
+    device_available_bytes: int | None
+    host_required_bytes: int
+    device_required_bytes: int
+    host_margin_bytes: int | None
+    device_margin_bytes: int | None
+    safety_fraction: str
+
+
+def _query(fn: Callable[[], Any], what: str) -> tuple[int | None, str | None]:
+    """Call an injected read-only availability query; any failure, non-integer or negative result is a named
+    refusal (fail closed), never an exception that escapes the decision."""
+    try:
+        value = fn()
+    except Exception as exc:  # noqa: BLE001 -- a raising query is a refusal reason, by contract
+        return None, f"{what} availability query raised {type(exc).__name__}: {exc}"
+    if value is None:
+        return None, f"{what} availability is unknown (query returned None)"
+    if isinstance(value, (bool, np.bool_)) or not isinstance(value, (int, np.integer)):
+        return None, f"{what} availability query returned a non-integer {value!r}"
+    value = int(value)
+    if value < 0:
+        return None, f"{what} availability query returned a negative value {value}"
+    return value, None
+
+
+def admit_windowed_transaction(
+    plan: WindowedStepPlan,
+    *,
+    host_available_bytes_fn: Callable[[], Any] | None = None,
+    device_available_bytes_fn: Callable[[], Any] | None = None,
+    safety_fraction: float = 0.5,
+    reserve_host_bytes: int = 0,
+    reserve_device_bytes: int = 0,
+) -> AdmissionDecision:
+    """Decide whether `plan` may run against INJECTED availability readings.
+
+    Admits iff `plan.new_host_bytes_peak + reserve_host_bytes <= safety_fraction * host_available` and, for a
+    `"cupy"` plan, the same on the device with the driver's EFFECTIVE-FREE device query (no default exists; a
+    device plan without one is refused). The comparison is exact rational arithmetic on Python integers (no
+    float rounding at the threshold); `safety_fraction` may be a Python or NumPy real scalar or a `Fraction` and
+    is converted to the exact rational of the value given. Refuses, with a named reason: a plan with `unbounded_terms`, an unknown
+    (`None`), raising, non-integer or negative query result, a missing device query, insufficient availability.
+    Malformed driver inputs (a forged or inconsistent plan, a `safety_fraction` outside `(0, 1]`, a negative or
+    non-integer reserve) raise `WindowedAdmissionError`. API convention for a HOST-ONLY (`"numpy"`) plan: it has
+    no device requirement, so a nonzero `reserve_device_bytes` or an injected `device_available_bytes_fn` is a
+    contradiction and raises `WindowedAdmissionError` BEFORE any query -- nothing a driver asks for is silently
+    ignored. Plan a `"cupy"` namespace to reserve or query device memory.
+
+    `host_available_bytes_fn=None` lazily uses the existing reclaim-aware
+    `maple.aeolian.cohorts.capacity.default_available_memory_bytes` (a read-only OS read). Reserves are the
+    driver's own figures for what lies outside the plan (`plan.excluded`); they make nothing a guarantee. The
+    decision allocates no model array, writes nothing and mutates no state; it is NOT a reservation and protects
+    nothing unless the driver calls it before the transaction."""
+    if not isinstance(plan, WindowedStepPlan):
+        raise WindowedAdmissionError(f"plan must be a WindowedStepPlan, got {type(plan).__name__}")
+    if _signature(windowed_transaction_bytes(**plan.inputs)) != _signature(plan):
+        raise WindowedAdmissionError("plan integrity check failed: the plan does not match its own inputs")
+    fraction = _exact_fraction(safety_fraction, "safety_fraction")  # exact rational; no rounding at the threshold
+    reserve_host_bytes = _int(reserve_host_bytes, "reserve_host_bytes", minimum=0)
+    reserve_device_bytes = _int(reserve_device_bytes, "reserve_device_bytes", minimum=0)
+    if host_available_bytes_fn is not None and not callable(host_available_bytes_fn):
+        raise WindowedAdmissionError("host_available_bytes_fn must be callable or None")
+    if device_available_bytes_fn is not None and not callable(device_available_bytes_fn):
+        raise WindowedAdmissionError("device_available_bytes_fn must be callable or None")
+    if plan.namespace != "cupy" and reserve_device_bytes:
+        raise WindowedAdmissionError(
+            f"reserve_device_bytes={reserve_device_bytes} on a host-only ({plan.namespace}) plan: the plan has no "
+            "device requirement and the reserve would be silently ignored; plan the 'cupy' namespace to reserve "
+            "device memory (refused before any query)")
+    if plan.namespace != "cupy" and device_available_bytes_fn is not None:
+        raise WindowedAdmissionError(
+            f"device_available_bytes_fn given for a host-only ({plan.namespace}) plan: it would never be consulted; "
+            "pass None, or plan the 'cupy' namespace (refused before any query)")
+
+    host_required = plan.new_host_bytes_peak + reserve_host_bytes
+    device_required = plan.new_device_bytes_peak + reserve_device_bytes
+
+    def decision(admitted: bool, reason: str, host_avail: int | None, device_avail: int | None) -> AdmissionDecision:
+        def margin(avail: int | None, required: int) -> int | None:
+            if avail is None:
+                return None
+            return (fraction.numerator * avail) // fraction.denominator - required
+
+        return AdmissionDecision(
+            admitted=admitted, reason=reason, plan=plan, host_available_bytes=host_avail,
+            device_available_bytes=device_avail, host_required_bytes=host_required,
+            device_required_bytes=device_required, host_margin_bytes=margin(host_avail, host_required),
+            device_margin_bytes=margin(device_avail, device_required) if plan.namespace == "cupy" else None,
+            safety_fraction=str(fraction))
+
+    if plan.unbounded_terms:  # refused by name BEFORE any query
+        return decision(False, "plan has unbounded required scratch terms: " + ", ".join(plan.unbounded_terms),
+                        None, None)
+    if host_available_bytes_fn is None:
+        from maple.aeolian.cohorts.capacity import default_available_memory_bytes
+
+        host_available_bytes_fn = default_available_memory_bytes
+    host_avail, failure = _query(host_available_bytes_fn, "host")
+    if failure is not None:
+        return decision(False, failure, None, None)
+    device_avail: int | None = None
+    if plan.namespace == "cupy":
+        if device_available_bytes_fn is None:
+            return decision(False, "device plan without an injected effective-free device query (no default "
+                                   "device query exists; nothing is invented)", host_avail, None)
+        device_avail, failure = _query(device_available_bytes_fn, "device")
+        if failure is not None:
+            return decision(False, failure, host_avail, None)
+    # Exact integer comparison of required > fraction * available.
+    if host_required * fraction.denominator > fraction.numerator * host_avail:
+        return decision(False, f"insufficient host memory: {host_required} B required (peak {plan.new_host_bytes_peak}"
+                               f" + reserve {reserve_host_bytes}) exceeds {fraction} * {host_avail} B available",
+                        host_avail, device_avail)
+    if plan.namespace == "cupy" and device_required * fraction.denominator > fraction.numerator * device_avail:
+        return decision(False, f"insufficient device memory: {device_required} B required (peak "
+                               f"{plan.new_device_bytes_peak} + reserve {reserve_device_bytes}) exceeds {fraction} * "
+                               f"{device_avail} B available", host_avail, device_avail)
+    return decision(True, f"admitted ({plan.path} path, {plan.namespace}; peak stage host "
+                          f"{plan.peak_stage_host!r}); a decision, not a reservation", host_avail, device_avail)
