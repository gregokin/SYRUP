index 0000000000000000000000000000000000000000..dec44194824af133c87ccb5d5ecb3a6f156da95d
--- /dev/null
+++ b/src/maple/core/backend/cell_reductions.py
@@ -0,0 +1,151 @@
+"""Cell totals with NumPy's contiguous FP64 reduction order on CUDA.
+
+Height reductions can decide a D4 tie even when the mass difference is only
+roundoff. The CPU branch is the original ndarray.sum expression. The CUDA
+branch reproduces its pairwise tree without moving or copying the column.
+Non-contiguous device inputs retain their original namespace sum; exact
+NumPy-order qualification is explicitly limited to C-contiguous FP64 inputs.
+This changes no stored sediment, physical law or conservation bound.
+"""
+from __future__ import annotations
+
+import hashlib
+from typing import Any
+
+import numpy as np
+
+from maple.core.backend import array_namespace
+from maple.core.backend.numpy_pairwise_order import (
+    ORDER_ID,
+    QUALIFIED_MAX_TERMS,
+    qualify_numpy_order,
+)
+
+OPTIONS = ("--fmad=false", "--prec-div=true", "--prec-sqrt=true", "--ftz=false")
+THREADS = 128
+MAX_BLOCKS = 512
+MAX_TERMS = (1 << 31) - 1
+_KERNELS: dict[tuple[int, int], Any] = {}
+_COUNTERS = {"cuda_calls": 0, "noncontiguous_fallbacks": 0}
+
+_SOURCE = r'''
+// NumPy's contiguous FP64 pairwise summation: eight lanes per leaf,
+// leaves <=128 terms, recursive split aligned to eight. Explicit stack
+// avoids device recursion. The outer reduction starts from +0.0.
+__device__ __forceinline__ double leaf_sum(const double* a, long long start, long long n) {
+    if (n < 8) {
+        double value = -0.0;
+        for (long long k = 0; k < n; ++k)
+            value = __dadd_rn(value, a[start + k]);
+        return value;
+    }
+    double r[8];
+    #pragma unroll
+    for (int j = 0; j < 8; ++j) r[j] = a[start + j];
+    long long k = 8;
+    for (; k < n - (n % 8); k += 8) {
+        #pragma unroll
+        for (int j = 0; j < 8; ++j)
+            r[j] = __dadd_rn(r[j], a[start + k + j]);
+    }
+    const double first = __dadd_rn(__dadd_rn(r[0], r[1]), __dadd_rn(r[2], r[3]));
+    const double second = __dadd_rn(__dadd_rn(r[4], r[5]), __dadd_rn(r[6], r[7]));
+    double value = __dadd_rn(first, second);
+    for (; k < n; ++k) value = __dadd_rn(value, a[start + k]);
+    return value;
+}
+__device__ __forceinline__ double row_sum(const double* a, long long n) {
+    if (n <= 128) return __dadd_rn(0.0, leaf_sum(a, 0, n));
+    long long starts[32], lengths[32];
+    double left[32];
+    unsigned char stage[32];
+    int sp = 0;
+    starts[0] = 0; lengths[0] = n; stage[0] = 0;
+    double value = -0.0;
+    while (sp >= 0) {
+        const long long count = lengths[sp];
+        if (count <= 128) {
+            value = leaf_sum(a, starts[sp], count);
+            --sp;
+        } else {
+            const long long half = (count / 2) - ((count / 2) % 8);
+            if (stage[sp] == 0) {
+                stage[sp] = 1;
+                const long long begin = starts[sp];
+                ++sp; starts[sp] = begin; lengths[sp] = half; stage[sp] = 0;
+            } else if (stage[sp] == 1) {
+                left[sp] = value; stage[sp] = 2;
+                const long long begin = starts[sp] + half;
+                ++sp; starts[sp] = begin; lengths[sp] = count - half; stage[sp] = 0;
+            } else {
+                value = __dadd_rn(left[sp], value);
+                --sp;
+            }
+        }
+    }
+    return __dadd_rn(0.0, value);
+}
+extern "C" __global__ void numpy_cell_total(
+    const double* input, double* output, long long cells, long long terms) {
+    const long long stride = (long long)blockDim.x * gridDim.x;
+    for (long long cell = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+         cell < cells; cell += stride)
+        output[cell] = row_sum(input + cell * terms, CELL_TERMS);
+}
+'''
+
+
+def sum_per_cell_numpy_order(array: Any, *, trailing_axes: int):
+    """Sum a (ny,nx,nc) or (ny,nx,nv,nc) FP64 array to (ny,nx).
+
+    CPU arithmetic is unchanged. C-contiguous CUDA inputs use a fixed-order
+    kernel, with at most 65536 threads and a fixed 32-entry traversal stack.
+    Other device layouts keep the previous device sum without a hidden full
+    contiguous copy. No host/device transfer or floating-point atomic is used.
+    """
+    if (isinstance(trailing_axes, (bool, np.bool_))
+            or not isinstance(trailing_axes, (int, np.integer)) or trailing_axes not in (1, 2)):
+        raise ValueError("trailing_axes must be 1 or 2")
+    xp = array_namespace(array)
+    axes = (-1,) if trailing_axes == 1 else (-2, -1)
+    if xp is np:
+        return array.sum(axis=axes)
+    if array.ndim != 2 + trailing_axes or array.dtype != np.float64:
+        raise ValueError("device cell reduction requires a 3-D or 4-D FP64 array")
+    if getattr(xp, "__name__", None) != "cupy":
+        raise ValueError("cell reduction supports NumPy or CuPy")
+    if not array.flags.c_contiguous:
+        _COUNTERS["noncontiguous_fallbacks"] += 1
+        return array.sum(axis=axes)
+    terms = int(np.prod(array.shape[2:], dtype=np.int64))
+    if terms > MAX_TERMS:
+        raise ValueError("cell reduction exceeds the fixed traversal-stack bound")
+    qualify_numpy_order(terms, trailing_shape=array.shape[2:])
+    cells = int(array.shape[0]) * int(array.shape[1])
+    device = int(array.device.id)
+    with xp.cuda.Device(device):
+        output = xp.empty(array.shape[:2], dtype=np.float64)
+        if not cells:
+            return output
+        key = (device, terms)
+        kernel = _KERNELS.get(key)
+        if kernel is None:
+            source = f"#define CELL_TERMS {terms}\n" + _SOURCE
+            kernel = xp.RawKernel(source, "numpy_cell_total", options=OPTIONS, backend="nvrtc")
+            _KERNELS[key] = kernel
+        kernel((min(MAX_BLOCKS, (cells + THREADS - 1) // THREADS),), (THREADS,),
+               (array, output, np.int64(cells), np.int64(terms)))
+        _COUNTERS["cuda_calls"] += 1
+    return output
+
+
+def cell_reduction_provenance() -> dict[str, Any]:
+    """Metadata only; importing/querying this record does not query CUDA."""
+    return {"kernel_sha256": hashlib.sha256(_SOURCE.encode()).hexdigest(),
+            "numpy_version": np.__version__, "compile_options": list(OPTIONS),
+            "threads": THREADS, "max_blocks": MAX_BLOCKS, "max_terms": QUALIFIED_MAX_TERMS,
+            "traversal_stack_max_terms": MAX_TERMS,
+            "order_id": ORDER_ID, "qualified_max_terms": QUALIFIED_MAX_TERMS,
+            "specialization": "input device and per-cell term count; fixed-order small leaf avoids traversal stack",
+            "counters": dict(_COUNTERS),
+            "qualified_layout": "C-contiguous FP64 3-D/4-D; other device layouts use original device sum"}
diff --git a/src/maple/core/backend/numpy_pairwise_order.py b/src/maple/core/backend/numpy_pairwise_order.py
