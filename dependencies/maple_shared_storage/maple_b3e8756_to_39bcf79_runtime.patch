+# --- CUDA decoder ----------------------------------------------------------------------------------------------------------
+_SOURCE = r'''
+// Exact NumPy contiguous FP64 pairwise order (eight lanes, leaves <= 128, split aligned to eight) decoded from a
+// deep-prefix packet and the resident window. fut() reads the window and returns +0.0 above it. Round-to-nearest
+// adds only (__dadd_rn), no FMA; -0.0 leaf identity for tiny leaves; +0.0 outer identity; explicit stack.
+// BASE_T is the native base dtype (int for int32, long long for int64): no cast kernel, no host round trip.
+__device__ __forceinline__ double fut(const double* win, long long p, long long stop, long long i) {
+    return (i < stop) ? win[i - p] : 0.0;
+}
+__device__ __forceinline__ double leaf_future(const double* win, long long p, long long stop, long long start, long long n) {
+    if (n < 8) {
+        double value = -0.0;
+        for (long long k = 0; k < n; ++k) value = __dadd_rn(value, fut(win, p, stop, start + k));
+        return value;
+    }
+    double r[8];
+    #pragma unroll
+    for (int j = 0; j < 8; ++j) r[j] = fut(win, p, stop, start + j);
+    long long k = 8;
+    for (; k < n - (n % 8); k += 8) {
+        #pragma unroll
+        for (int j = 0; j < 8; ++j) r[j] = __dadd_rn(r[j], fut(win, p, stop, start + k + j));
+    }
+    const double first = __dadd_rn(__dadd_rn(r[0], r[1]), __dadd_rn(r[2], r[3]));
+    const double second = __dadd_rn(__dadd_rn(r[4], r[5]), __dadd_rn(r[6], r[7]));
+    double value = __dadd_rn(first, second);
+    for (; k < n; ++k) value = __dadd_rn(value, fut(win, p, stop, start + k));
+    return value;
+}
+__device__ double tree_future(const double* win, long long p, long long stop, long long start, long long n) {
+    if (start >= stop) return 0.0;
+    if (n <= 128) return leaf_future(win, p, stop, start, n);
+    long long starts[32], lengths[32];
+    double left[32];
+    unsigned char stage[32];
+    int sp = 0;
+    starts[0] = start; lengths[0] = n; stage[0] = 0;
+    double value = -0.0;
+    while (sp >= 0) {
+        const long long count = lengths[sp];
+        if (starts[sp] >= stop) {
+            value = 0.0;
+            --sp;
+        } else if (count <= 128) {
+            value = leaf_future(win, p, stop, starts[sp], count);
+            --sp;
+        } else {
+            const long long half = (count / 2) - ((count / 2) % 8);
+            if (stage[sp] == 0) {
+                stage[sp] = 1;
+                const long long begin = starts[sp];
+                ++sp; starts[sp] = begin; lengths[sp] = half; stage[sp] = 0;
+            } else if (stage[sp] == 1) {
+                left[sp] = value; stage[sp] = 2;
+                const long long begin = starts[sp] + half;
+                ++sp; starts[sp] = begin; lengths[sp] = count - half; stage[sp] = 0;
+            } else {
+                value = __dadd_rn(left[sp], value);
+                --sp;
+            }
+        }
+    }
+    return value;
+}
+__device__ double leaf_decode(const double* packet, const double* win, long long p, long long stop,
+                              long long start, long long count, long long q) {
+    const long long rounded = count - (count % 8);
+    if (count < 8 || q >= rounded) {
+        double value = packet[LEVELS];
+        for (long long k = q; k < count; ++k) value = __dadd_rn(value, fut(win, p, stop, start + k));
+        return value;
+    }
+    double r[8];
+    #pragma unroll
+    for (int j = 0; j < 8; ++j) r[j] = (j < q) ? packet[LEVELS + j] : fut(win, p, stop, start + j);
+    for (long long k = 8; k < rounded; k += 8) {
+        #pragma unroll
+        for (int j = 0; j < 8; ++j)
+            if (k + j >= q) r[j] = __dadd_rn(r[j], fut(win, p, stop, start + k + j));
+    }
+    const double first = __dadd_rn(__dadd_rn(r[0], r[1]), __dadd_rn(r[2], r[3]));
+    const double second = __dadd_rn(__dadd_rn(r[4], r[5]), __dadd_rn(r[6], r[7]));
+    double value = __dadd_rn(first, second);
+    for (long long k = rounded; k < count; ++k) value = __dadd_rn(value, fut(win, p, stop, start + k));
+    return value;
+}
+__device__ double decode_cell(const double* packet, const double* win, long long p, long long stop) {
+    double pend[32];
+    long long start = 0, count = TERMS;
+    int level = 0;
+    while (count > 128) {
+        const long long left = (count / 2) - ((count / 2) % 8);
+        if (p >= start + left) {
+            pend[level] = packet[level];
+            start += left; count -= left;
+        } else {
+            pend[level] = tree_future(win, p, stop, start + left, count - left);
+            count = left;
+        }
+        ++level;
+    }
+    double value = leaf_decode(packet, win, p, stop, start, count, p - start);
+    for (int lv = level - 1; lv >= 0; --lv) value = __dadd_rn(pend[lv], value);
+    return __dadd_rn(0.0, value);
+}
+extern "C" __global__ void prefix_height_decode(
+    const double* resident, const BASE_T* base, const double* packet, double* output,
+    long long cells, long long window_terms, long long nc) {
+    const long long stride = (long long)blockDim.x * gridDim.x;
+    for (long long cell = (long long)blockIdx.x * blockDim.x + threadIdx.x; cell < cells; cell += stride) {
+        const long long p = (long long)base[cell] * nc;
+        output[cell] = decode_cell(packet + cell * PACKET_TERMS, resident + cell * window_terms, p, p + window_terms);
+    }
+}
+'''
+
+
+# --- binding ----------------------------------------------------------------------------------------------------------
+def _namespace_name(xp) -> str:
+    name = getattr(xp, "__name__", "")
+    if name not in NAMESPACES:
+        raise PrefixPacketError(f"unsupported array namespace {name!r}")
+    return name
+
+
+def _array_namespace_name(array: Any) -> str:
+    return _namespace_name(array_namespace(array))
+
+
+def _require(array: Any, name: str, shape: tuple[int, ...], dtypes) -> None:
+    """Shape / dtype / contiguity of ONE array by metadata only (no element read, no transfer)."""
+    if not is_array(array):
+        raise PrefixPacketError(f"{name} must be a NumPy/CuPy array, got {type(array).__name__}")
+    if tuple(array.shape) != tuple(shape):
+        raise PrefixPacketError(f"{name} shape {tuple(array.shape)} != {tuple(shape)}")
+    accepted = tuple(np.dtype(d) for d in (dtypes if isinstance(dtypes, tuple) else (dtypes,)))
+    if array.dtype not in accepted:
+        raise PrefixPacketError(f"{name} must be {' or '.join(str(d) for d in accepted)}, got {array.dtype}")
+    if not array.flags.c_contiguous:
+        raise PrefixPacketError(f"{name} must be C-contiguous (no hidden copy is made)")
+
+
+def _gate(n_terms: int, nv: int, nc: int) -> None:
+    """The runtime NumPy order gate of the accepted helper, at the actual trailing shape; a mismatch is refused
+    by name (`NumpyReductionOrderMismatch`), never worked around."""
+    if n_terms > QUALIFIED_MAX_TERMS:
+        raise PrefixPacketError(f"nv * nc = {n_terms} exceeds the qualified {QUALIFIED_MAX_TERMS}-term bound")
+    qualify_numpy_order(n_terms, trailing_shape=(nv, nc))
+
+
+@dataclass(frozen=True, eq=False)
+class PrefixPacketBinding:
+    """What a packet grid is valid for (module docstring, "Binding and ownership").
+
+    `packet` and `base` are MAPLE `ArrayBinding` identities of the exact packet array object and the exact base
+    array object given to `bind_prefix_packets`; `encoded_base` is a frozen copy of that base's values in the
+    packet's namespace; `version` / `generation` are the caller's external deep-store identity (optional,
+    explicit; a production integration must set them). Every derived field is cross-validated in
+    `__post_init__`, so `dataclasses.replace` with inconsistent metadata is refused, and again by the decoder.
+    A binding is immutable; a stale one is replaced by `bind_prefix_packets` after re-encoding / advancing.
+    """
+
+    order_id: str
+    numpy_version: str
+    n_terms: int
+    nv: int
+    nc: int
+    window_voxels: int
+    depth: int
+    packet_terms: int
+    shape: tuple[int, int]
+    namespace: str
+    base_dtype: str
+    packet: ArrayBinding
+    base: ArrayBinding
+    encoded_base: Any
+    version: str | None = None
+    generation: int | None = None
+
+    def __post_init__(self) -> None:
+        self.validate()
+
+    def validate(self) -> None:
+        """Refuse any malformed or internally inconsistent metadata by name, by metadata reads only (no element
+        read, no transfer). Raises `PrefixPacketError`; nothing is modified."""
+        if not isinstance(self.order_id, str) or not isinstance(self.numpy_version, str):
+            raise PrefixPacketError("binding order_id and numpy_version must be strings")
+        for name in ("n_terms", "nv", "nc", "window_voxels", "depth", "packet_terms"):
+            if not _is_int(getattr(self, name)):
+                raise PrefixPacketError(f"binding {name} must be an int, got {getattr(self, name)!r}")
+        if self.nv < 1 or self.nc < 1:
+            raise PrefixPacketError(f"binding nv and nc must be >= 1, got nv={self.nv} nc={self.nc}")
+        if not 1 <= self.window_voxels <= self.nv:
+            raise PrefixPacketError(f"binding window_voxels {self.window_voxels} not in [1, nv={self.nv}]")
+        if self.n_terms != self.nv * self.nc:
+            raise PrefixPacketError(f"binding n_terms {self.n_terms} != nv * nc = {self.nv * self.nc}")
+        if self.n_terms > QUALIFIED_MAX_TERMS:
+            raise PrefixPacketError(f"binding n_terms {self.n_terms} exceeds the qualified {QUALIFIED_MAX_TERMS}")
+        expected_depth = prefix_depth(self.n_terms)
+        if self.depth != expected_depth:
+            raise PrefixPacketError(f"binding depth {self.depth} != prefix_depth({self.n_terms}) = {expected_depth}")
+        if self.packet_terms != self.depth + LANES:
+            raise PrefixPacketError(f"binding packet_terms {self.packet_terms} != depth + {LANES} = {self.depth + LANES}")
+        if (not isinstance(self.shape, tuple) or len(self.shape) != 2
+                or not all(_is_int(v) and v >= 1 for v in self.shape)):
+            raise PrefixPacketError(f"binding shape must be a (ny, nx) tuple of ints >= 1, got {self.shape!r}")
+        if self.namespace not in NAMESPACES:
+            raise PrefixPacketError(f"binding namespace {self.namespace!r} not in {NAMESPACES}")
+        if self.base_dtype not in SUPPORTED_BASE_DTYPES:
+            raise PrefixPacketError(f"binding base_dtype {self.base_dtype!r} not in {SUPPORTED_BASE_DTYPES}")
+        if not isinstance(self.packet, ArrayBinding) or not isinstance(self.base, ArrayBinding):
+            raise PrefixPacketError("binding packet and base must be ArrayBinding identities")
+        ny, nx = self.shape
+        _require(self.packet.array, "bound packet", (ny, nx, self.packet_terms), np.float64)
+        _require(self.base.array, "bound base", (ny, nx), self.base_dtype)
+        _require(self.encoded_base, "binding encoded_base", (ny, nx), self.base_dtype)
+        for name, array in (("bound packet", self.packet.array), ("bound base", self.base.array),
+                            ("binding encoded_base", self.encoded_base)):
+            if _array_namespace_name(array) != self.namespace:
+                raise PrefixPacketError(f"{name} is not in the binding namespace {self.namespace!r}")
+        if self.version is not None and not isinstance(self.version, str):
+            raise PrefixPacketError("binding version must be a str or None")
+        if self.generation is not None and (not _is_int(self.generation) or self.generation < 0):
+            raise PrefixPacketError("binding generation must be an int >= 0 or None")
+
+    def describes(self, packet: Any) -> bool:
+        """True only for the exact packet array object this binding was built for (identity, not bytes)."""
+        return self.packet.array is packet
+
+    @property
+    def packet_bytes(self) -> int:
+        return 8 * self.packet_terms * self.shape[0] * self.shape[1]
+
+    def summary(self) -> dict[str, Any]:
+        return {"order_id": self.order_id, "numpy_version": self.numpy_version, "n_terms": self.n_terms,
+                "nv": self.nv, "nc": self.nc, "window_voxels": self.window_voxels, "depth": self.depth,
+                "packet_terms": self.packet_terms, "packet_bytes_per_cell": 8 * self.packet_terms,
+                "shape": list(self.shape), "namespace": self.namespace, "base_dtype": self.base_dtype,
+                "packet_read_only_enforced": _is_enforced_read_only(self.packet.array),
+                "version": self.version, "generation": self.generation,
+                "authority": "diagnostic summary of committed deep mass; never mass"}
+
+
+def bind_prefix_packets(packet: Any, base: Any, *, nv: int, nc: int, window_voxels: int,
+                        version: str | None = None, generation: int | None = None) -> PrefixPacketBinding:
+    """Bind a `(ny, nx, depth + 8)` packet grid to the `(ny, nx)` int32 / int64 base it was encoded for.
+
+    Takes ownership of `packet`: on NumPy its writeable flag is cleared (enforced). The caller's `base` is not
+    modified; its identity is recorded and its values are copied into a frozen `encoded_base` in the packet's
+    namespace. Refuses shape / dtype / namespace / range inconsistencies before building anything; ONE counted
+    flag read (packet finite, base in range) on a device. Nothing is transferred."""
+    nv, nc, w = _strict_int(nv, "nv", 1), _strict_int(nc, "nc", 1), _strict_int(window_voxels, "window_voxels", 1)
+    if w > nv:
+        raise PrefixPacketError(f"window_voxels {w} exceeds nv {nv}")
+    if version is not None and not isinstance(version, str):
+        raise PrefixPacketError("version must be a str or None")
+    if generation is not None:
+        generation = _strict_int(generation, "generation", 0)
+    n = nv * nc
+    _gate(n, nv, nc)
+    terms = packet_terms(n)
+    if not is_array(packet) or getattr(packet, "ndim", 0) != 3:
+        raise PrefixPacketError("packet must be a (ny, nx, depth + 8) array")
+    ny, nx = int(packet.shape[0]), int(packet.shape[1])
+    if ny < 1 or nx < 1:
+        raise PrefixPacketError("packet grid must hold at least one cell")
+    _require(packet, "packet", (ny, nx, terms), np.float64)
+    _require(base, "base", (ny, nx), tuple(SUPPORTED_BASE_DTYPES))
+    try:
+        xp = array_namespace(packet, base)
+    except MixedArrayNamespaceError as exc:
+        raise PrefixPacketError(f"packet and base are in mixed namespaces: {exc}") from None
+    name = _namespace_name(xp)
+    in_range = xp.all((base >= 0) & (base <= nv - w))
+    if not to_bool(xp.all(xp.isfinite(packet)) & in_range):  # one counted read on a device
+        raise PrefixPacketError(f"packet must be finite everywhere and base must lie in [0, nv - window_voxels] "
+                                f"= [0, {nv - w}]")
+    encoded = freeze(xp.array(base, copy=True))
+    freeze(packet)  # ownership: enforced read-only on NumPy; a documented no-op on CuPy (trusted decode required)
+    return PrefixPacketBinding(order_id=ORDER_ID, numpy_version=np.__version__, n_terms=n, nv=nv, nc=nc,
+                               window_voxels=w, depth=terms - LANES, packet_terms=terms, shape=(ny, nx),
+                               namespace=name, base_dtype=str(base.dtype), packet=ArrayBinding(packet),
+                               base=ArrayBinding(base), encoded_base=encoded, version=version,
+                               generation=generation)
+
+
+# --- encoder (host, bounded chunks) -----------------------------------------------------------------------------------
+def _check_columns(columns: Any, base: Any, window_voxels: int) -> tuple[int, int, int, int]:
+    if not isinstance(columns, np.ndarray) or columns.ndim != 3:
+        raise PrefixPacketError("columns must be a host NumPy (k, nv, nc) array (the encoder is a bounded host operation)")
+    k, nv, nc = (int(v) for v in columns.shape)
+    if k < 1 or nv < 1 or nc < 1:
+        raise PrefixPacketError("columns must have k, nv, nc >= 1")
+    if k > MAX_ENCODE_CELLS:
+        raise PrefixPacketError(f"encode chunk of {k} cells exceeds MAX_ENCODE_CELLS = {MAX_ENCODE_CELLS}; "
+                                "encode in bounded chunks (encode_prefix_tiled)")
+    _require(columns, "columns", (k, nv, nc), np.float64)
+    if not isinstance(base, np.ndarray):
+        raise PrefixPacketError("base must be a host NumPy (k,) int32 / int64 array")
+    _require(base, "base", (k,), tuple(SUPPORTED_BASE_DTYPES))
+    w = _strict_int(window_voxels, "window_voxels", 1)
+    if w > nv:
+        raise PrefixPacketError(f"window_voxels {w} exceeds nv {nv}")
+    if np.any((base < 0) | (base > nv - w)):
+        raise PrefixPacketError(f"base must lie in [0, nv - window_voxels] = [0, {nv - w}]")
+    if not np.all(np.isfinite(columns)):
+        raise PrefixPacketError("columns must be finite everywhere")
+    above = np.arange(nv)[None, :] >= (base.astype(np.int64) + w)[:, None]
+    if np.any(columns[above]):
+        raise PrefixPacketError("a column holds mass above its window (base + window_voxels); the packet model "
+                                "requires empty voxels there; re-base the window before encoding")
+    return k, nv, nc, w
+
+
+def _implementation(implementation: str, *, what: str):
+    if implementation not in IMPLEMENTATIONS:
+        raise PrefixPacketError(f"implementation must be one of {IMPLEMENTATIONS}, got {implementation!r}")
+    if implementation == "reference":
+        return None
+    compiled = _compiled()
+    if compiled is None:
+        if implementation == "numba":
+            raise PrefixPacketError(f"implementation 'numba' requested for {what} but Numba is not importable")
+        return None
+    return compiled
+
+
+def encode_prefix(columns: np.ndarray, base: np.ndarray, *, window_voxels: int,
+                  implementation: str = "auto") -> np.ndarray:
+    """Packets `(k, depth + 8)` for a bounded chunk of FULL host columns `(k, nv, nc)` and their window bases
+    (genesis, or a miss re-encode of actually gathered columns). The deep prefix is read here and only here;
+    `columns` is not modified. Returns a new, caller-owned packet array (writable until bound). Numba when
+    importable (or requested), else the Python reference."""
+    k, nv, nc, _w = _check_columns(columns, base, window_voxels)
+    n = nv * nc
+    _gate(n, nv, nc)
+    levels = prefix_depth(n)
+    terms = levels + LANES
+    packet = np.zeros((k, terms), dtype=np.float64)
+    compiled = _implementation(implementation, what="encode_prefix")
+    columns2 = columns.reshape(k, n)
+    if compiled is not None:
+        compiled["encode_cells"](columns2, base, np.int64(nc), np.int64(n), np.int64(levels), packet)
+    else:
+        for cell in range(k):
+            row = columns2[cell]
+            _encode_cell_reference(lambda i, row=row: float(row[i]), n, int(base[cell]) * nc, levels, packet[cell])
+    _COUNTERS["encodes"] += 1
+    return packet
+
+
+def encode_prefix_reference(columns: np.ndarray, base: np.ndarray, *, window_voxels: int) -> np.ndarray:
+    return encode_prefix(columns, base, window_voxels=window_voxels, implementation="reference")
+
+
+def encode_prefix_tiled(columns: np.ndarray, base: np.ndarray, *, window_voxels: int,
+                        implementation: str = "auto", chunk_cells: int = MAX_ENCODE_CELLS) -> np.ndarray:
+    """`encode_prefix` over a column set of any size in bounded chunks of at most `chunk_cells` columns (a
+    Python loop over CHUNKS, never over cells). Each chunk is validated and encoded independently; the full
+    packet `(k, depth + 8)` is the only allocation of the whole size."""
+    chunk = _strict_int(chunk_cells, "chunk_cells", 1)
+    if chunk > MAX_ENCODE_CELLS:
+        raise PrefixPacketError(f"chunk_cells {chunk} exceeds MAX_ENCODE_CELLS = {MAX_ENCODE_CELLS}")
+    if not isinstance(columns, np.ndarray) or columns.ndim != 3 or not isinstance(base, np.ndarray) or base.ndim != 1:
+        raise PrefixPacketError("columns must be a host NumPy (k, nv, nc) array and base a host (k,) array")
+    k = int(columns.shape[0])
+    if k < 1 or int(base.shape[0]) != k:
+        raise PrefixPacketError("columns and base must describe the same k >= 1 cells")
+    parts = [encode_prefix(np.ascontiguousarray(columns[i:i + chunk]), np.ascontiguousarray(base[i:i + chunk]),
+                           window_voxels=window_voxels, implementation=implementation)
+             for i in range(0, k, chunk)]
+    return parts[0] if len(parts) == 1 else np.concatenate(parts, axis=0)
+
+
+def advance_prefix(packet: np.ndarray, base: np.ndarray, new_base: np.ndarray, leaving: np.ndarray, *,
+                   nv: int, nc: int, window_voxels: int, implementation: str = "auto") -> np.ndarray:
+    """Packets for an UPWARD base shift (`new_base >= base`, shift <= window_voxels) from the current packets and
+    the OLD resident window `leaving` `(k, window_voxels, nc)` whose first `shift * nc` entries per cell leave
+    the window and become deep. No deep read: the completed subtrees the shift closes are reconstructed from the
+    packet path and the leaving values, exactly as a re-encode of the full column would compute them. Host,
+    bounded chunk, int32 / int64 bases; returns a NEW caller-owned packet (the old packet, its binding and the
+    inputs are not modified; the caller binds the new packet)."""
+    nv, nc, w = _strict_int(nv, "nv", 1), _strict_int(nc, "nc", 1), _strict_int(window_voxels, "window_voxels", 1)
+    if w > nv:
+        raise PrefixPacketError(f"window_voxels {w} exceeds nv {nv}")
+    n = nv * nc
+    _gate(n, nv, nc)
+    levels = prefix_depth(n)
+    terms = levels + LANES
+    if not isinstance(packet, np.ndarray) or packet.ndim != 2:
+        raise PrefixPacketError("packet must be a host NumPy (k, depth + 8) array")
+    k = int(packet.shape[0])
+    if k < 1 or k > MAX_ENCODE_CELLS:
+        raise PrefixPacketError(f"advance chunk must hold 1..{MAX_ENCODE_CELLS} cells")
+    _require(packet, "packet", (k, terms), np.float64)
+    for name, array in (("base", base), ("new_base", new_base)):
+        if not isinstance(array, np.ndarray):
+            raise PrefixPacketError(f"{name} must be a host NumPy (k,) int32 / int64 array")
+        _require(array, name, (k,), tuple(SUPPORTED_BASE_DTYPES))
+    if not isinstance(leaving, np.ndarray):
+        raise PrefixPacketError("leaving must be the host NumPy (k, window_voxels, nc) old resident window")
+    _require(leaving, "leaving", (k, w, nc), np.float64)
+    if not np.all(np.isfinite(packet)) or not np.all(np.isfinite(leaving)):
+        raise PrefixPacketError("packet and leaving must be finite everywhere")
+    if np.any((base < 0) | (base > nv - w)) or np.any((new_base < 0) | (new_base > nv - w)):
+        raise PrefixPacketError(f"base and new_base must lie in [0, {nv - w}]")
+    shift = new_base.astype(np.int64) - base.astype(np.int64)
+    if np.any(shift < 0) or np.any(shift > w):
+        raise PrefixPacketError("advance_prefix handles upward shifts of at most window_voxels per cell")
+    new = np.zeros((k, terms), dtype=np.float64)
+    compiled = _implementation(implementation, what="advance_prefix")
+    leaving2 = leaving.reshape(k, w * nc)
+    if compiled is not None:
+        compiled["advance_cells"](packet, base, new_base, leaving2, np.int64(nc), np.int64(n), np.int64(levels), new)
+    else:
+        for cell in range(k):
+            _advance_cell_reference(packet[cell], levels, n, int(base[cell]) * nc, int(new_base[cell]) * nc,
+                                    leaving2[cell], new[cell])
+    _COUNTERS["advances"] += 1
+    return new
+
+
+def advance_prefix_reference(packet, base, new_base, leaving, *, nv, nc, window_voxels) -> np.ndarray:
+    return advance_prefix(packet, base, new_base, leaving, nv=nv, nc=nc, window_voxels=window_voxels,
+                          implementation="reference")
+
+
+# --- decoder (hot path) ------------------------------------------------------------------------------------------------
+def _check_decode_inputs(resident: Any, base: Any, packet: Any, binding: Any, version, generation, trusted: bool):
+    """Every refusal of the decode contract, in this order, all before any native kernel: binding type and
+    cross-validated metadata; reduction order and NumPy version; external version / generation; packet IDENTITY;
+    resident / base / packet shape, dtype, contiguity; one namespace equal to the binding's; read-only / trust;
+    runtime order gate; base identity or ONE counted value-and-range read. Returns the namespace."""
+    if not isinstance(binding, PrefixPacketBinding):
+        raise _refuse("binding must be the PrefixPacketBinding of these packets (bind_prefix_packets)")
+    try:
+        binding.validate()
+    except PrefixPacketError as exc:
+        raise _refuse(f"malformed binding metadata: {exc}") from None
+    if binding.order_id != ORDER_ID:
+        _COUNTERS["refusals"] += 1
+        raise NumpyReductionOrderMismatch(
+            f"packets were encoded for reduction order {binding.order_id!r}; this decoder implements {ORDER_ID!r}")
+    if binding.numpy_version != np.__version__:
+        _COUNTERS["refusals"] += 1
+        raise NumpyReductionOrderMismatch(
+            f"packets were encoded under NumPy {binding.numpy_version}; the running NumPy is {np.__version__}; "
+            "re-encode after re-qualifying the order")
+    if version != binding.version or generation != binding.generation:
+        raise _refuse("stale packets: the deep-store version / generation differs from the binding; re-encode "
+                      "(or advance) before decoding")
+    if not binding.describes(packet):
+        raise _refuse("foreign packet object: the binding names a different packet array (identity, not bytes); "
+                      "bind the packet you decode (re-encode or advance, then bind_prefix_packets)")
+    ny, nx = binding.shape
+    w, nc = binding.window_voxels, binding.nc
+    try:
+        _require(resident, "resident", (ny, nx, w, nc), np.float64)
+        _require(base, "base", (ny, nx), binding.base_dtype)
+        _require(packet, "packet", (ny, nx, binding.packet_terms), np.float64)
+    except PrefixPacketError as exc:
+        raise _refuse(str(exc)) from None
+    try:
+        xp = array_namespace(resident, base, packet, binding.encoded_base, binding.base.array)
+    except MixedArrayNamespaceError as exc:
