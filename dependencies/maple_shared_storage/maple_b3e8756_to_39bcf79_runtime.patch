+"""Active-layer erosion/deposition against a RESIDENT-WINDOW column
+(CW-B3b): `update_active_layer_after_erosion` / `_after_deposition` step
+for step, with the dense whole-array copy and selective kernels replaced
+by the windowed transaction kernels of `surface/voxels/windowed_transfer`.
+
+The active-layer arithmetic is the dense module's own private kernels
+(`_remove_mass_from_active_layer`, `_add_mass_to_active_layer`), the
+proportional burial vector is `make_proportional_mass_vector`, the
+mass-resolution split and the underfilled classification are the same
+expressions, and the results are the GENUINE `ActiveLayerErosionResult` /
+`ActiveLayerDepositionResult` types, so `surface/availability/exchange.py`
+consumes them unchanged. These routines operate on a transaction-owned
+`WindowedWorkingBed` (never on the caller's state) and perform the cheap
+contract checks; the trusted-boundary partition check for a windowed bed
+is `validate_windowed_column_full` plus `check_active_layer_state`.
+"""
+
+from __future__ import annotations
+
+from maple.core.backend import MapleArray, array_namespace, is_device_array
+from maple.core.parameters.geometry import GeometrySpec
+from maple.core.types.active_layer import ActiveLayerState
+from maple.surface.active_layer._request import canonicalize_domain_class_mass_request
+from maple.surface.active_layer.capacity import compute_active_layer_target_mass_kg
+from maple.surface.active_layer.exchange import (
+    ActiveLayerDepositionResult,
+    ActiveLayerErosionResult,
+    _add_mass_to_active_layer,
+    _remove_mass_from_active_layer,
+)
+from maple.surface.active_layer.validation import check_active_layer_state
+from maple.surface.voxels._numerics import (
+    _make_proportional_mass_vector_device_scratch,
+    le_within_tolerance_array,
+    make_proportional_mass_vector,
+)
+from maple.surface.voxels.windowed_transfer import (
+    WindowedWorkingBed,
+    windowed_deposit_inplace,
+    windowed_extract_inplace,
+)
+
+__all__ = [
+    "check_active_layer_windowed_shape_compatibility",
+    "windowed_update_active_layer_after_deposition",
+    "windowed_update_active_layer_after_erosion",
+]
+
+
+def check_active_layer_windowed_shape_compatibility(
+    active_layer: ActiveLayerState, bed: WindowedWorkingBed, geometry: GeometrySpec, mass_resolution_kg: float
+) -> None:
+    """The windowed analogue of `check_active_layer_voxel_shape_
+    compatibility`: the active layer's own cheap checks, grid agreement
+    with the working bed, and class-count agreement."""
+    check_active_layer_state(active_layer, geometry, mass_resolution_kg)
+    ny, nx, _width, nc = bed.shape
+    if active_layer.mass_kg.shape[:2] != (ny, nx):
+        raise ValueError(
+            f"active_layer.mass_kg horizontal shape {active_layer.mass_kg.shape[:2]} does not match the "
+            f"windowed column {(ny, nx)}"
+        )
+    if active_layer.mass_kg.shape[-1] != nc:
+        raise ValueError(
+            f"active_layer has {active_layer.mass_kg.shape[-1]} grain classes but the windowed column has "
+            f"{nc} -- both must describe the same grain-class set"
+        )
+    array_namespace(active_layer.mass_kg, bed.window_kg)
+
+
+def windowed_update_active_layer_after_erosion(
+    bed: WindowedWorkingBed,
+    active_layer: ActiveLayerState,
+    requested_removal_mass_by_class_kg: MapleArray,
+    geometry: GeometrySpec,
+    mass_resolution_kg: float,
+) -> tuple[ActiveLayerState, ActiveLayerErosionResult]:
+    """Selective removal from the active layer, then bulk replenishment from
+    the resident window / gathered columns. Mutates `bed`; returns the new
+    active layer and the genuine erosion result."""
+    check_active_layer_windowed_shape_compatibility(active_layer, bed, geometry, mass_resolution_kg)
+    ny, nx, n_classes = active_layer.mass_kg.shape
+    requested = canonicalize_domain_class_mass_request(
+        requested_removal_mass_by_class_kg, expected_shape=(ny, nx, n_classes),
+        name="requested_removal_mass_by_class_kg",
+    )
+    xp = array_namespace(active_layer.mass_kg, bed.window_kg, requested)
+    target_mass_kg = compute_active_layer_target_mass_kg(geometry)
+    active_before_total_kg = active_layer.mass_kg.sum(axis=-1)
+
+    new_active_mass_kg, actual_removed_kg, unmet_kg = _remove_mass_from_active_layer(
+        active_layer.mass_kg, requested
+    )
+    resolved = unmet_kg > mass_resolution_kg
+    shortfall_kg = xp.where(resolved, unmet_kg, 0.0)
+    residual_kg = xp.where(resolved, 0.0, unmet_kg)
+    # CW-B97: device-only scratch ownership. `unmet_kg` / `resolved` are this frame's own arrays, dead after the
+    # split above; `new_active_mass_kg` is the removal kernel's own NEW `active - actual` array, read only by the
+    # deficit sum before the replenishment, so the sum below is written into it (same elementwise IEEE addition,
+    # same operand order). The CPU path keeps the original statements.
+    device = is_device_array(new_active_mass_kg)
+    if device:
+        del unmet_kg, resolved
+
+    deficit_kg = target_mass_kg - new_active_mass_kg.sum(axis=-1)
+    replenish_request = xp.maximum(deficit_kg, 0.0)
+    extraction = windowed_extract_inplace(bed, replenish_request)
+    replenished = extraction.actual_mass_by_class_kg
+    if (
+        device
+        and new_active_mass_kg.dtype == replenished.dtype == xp.float64
+        and new_active_mass_kg.shape == replenished.shape
+        and new_active_mass_kg.flags.c_contiguous
+    ):
+        xp.add(new_active_mass_kg, replenished, out=new_active_mass_kg)
+    else:
+        new_active_mass_kg = new_active_mass_kg + replenished
+    del replenished
+
+    final_totals_kg = new_active_mass_kg.sum(axis=-1)
+    underfilled_fp64 = ~le_within_tolerance_array(
+        target_mass_kg, final_totals_kg, scale_kg=xp.maximum(target_mass_kg, final_totals_kg)
+    )
+    underfilled_model = (target_mass_kg - final_totals_kg) > mass_resolution_kg
+    underfilled_mask = underfilled_fp64 & underfilled_model
+
+    new_active_layer = ActiveLayerState(mass_kg=new_active_mass_kg)
+    check_active_layer_state(new_active_layer, geometry, mass_resolution_kg)
+    result = ActiveLayerErosionResult(
+        actual_removed_mass_by_class_kg=actual_removed_kg,
+        shortfall_mass_by_class_kg=shortfall_kg,
+        numerical_residual_mass_by_class_kg=residual_kg,
+        replenished_mass_by_class_kg=extraction.actual_mass_by_class_kg,
+        active_layer_mass_before_kg=active_before_total_kg,
+        active_layer_mass_after_kg=final_totals_kg,
+        active_layer_mass_after_by_class_kg=new_active_mass_kg,
+        underfilled_mask=underfilled_mask,
+        replenishment_shortfall_total_mass_kg=extraction.shortfall_total_mass_kg,
+        replenishment_numerical_residual_total_mass_kg=extraction.numerical_residual_total_mass_kg,
+    )
+    return new_active_layer, result
+
+
+def windowed_update_active_layer_after_deposition(
+    bed: WindowedWorkingBed,
+    active_layer: ActiveLayerState,
+    deposited_mass_by_class_kg: MapleArray,
+    geometry: GeometrySpec,
+    mass_resolution_kg: float,
+) -> tuple[ActiveLayerState, ActiveLayerDepositionResult]:
+    """Mix the deposit into the active layer, then bury the proportional
+    excess into the resident window / gathered columns. Mutates `bed`; a
+    resolved capacity failure raises from the kernel with the caller's
+    state untouched (the working bed is private)."""
+    # CW-B79: the one implementation is the private holder body below; this caller keeps its own reference.
+    return _windowed_update_active_layer_after_deposition_held(
+        bed, [active_layer], deposited_mass_by_class_kg, geometry, mass_resolution_kg,
+    )
+
+
+def _windowed_update_active_layer_after_deposition_held(
+    bed: WindowedWorkingBed,
+    layer_holder: list,
+    deposited_mass_by_class_kg: MapleArray,
+    geometry: GeometrySpec,
+    mass_resolution_kg: float,
+) -> tuple[ActiveLayerState, ActiveLayerDepositionResult]:
+    """CW-B79 PRIVATE (not exported): `windowed_update_active_layer_after_deposition` with the incoming active layer
+    handed over in a ONE-element list, popped here. Every statement, check and expression is the public function's;
+    the only addition is that this frame drops its name for the incoming layer after its last read (the mixing
+    below), so a layer nobody else holds is released before the burial."""
+    if not isinstance(layer_holder, list) or len(layer_holder) != 1:
+        raise TypeError("layer_holder must be a one-element list (single-use handoff)")
+    active_layer = layer_holder.pop()
+    check_active_layer_windowed_shape_compatibility(active_layer, bed, geometry, mass_resolution_kg)
+    ny, nx, n_classes = active_layer.mass_kg.shape
+    deposited = canonicalize_domain_class_mass_request(
+        deposited_mass_by_class_kg, expected_shape=(ny, nx, n_classes), name="deposited_mass_by_class_kg",
+    )
+    xp = array_namespace(active_layer.mass_kg, bed.window_kg, deposited)
+    target_mass_kg = compute_active_layer_target_mass_kg(geometry)
+    active_before_total_kg = active_layer.mass_kg.sum(axis=-1)
+
+    mixed = _add_mass_to_active_layer(active_layer.mass_kg, deposited)
+    del active_layer  # CW-B79: last read above (the before-total and the mixing)
+    total_kg = mixed.sum(axis=-1)
+    excess_kg = xp.maximum(total_kg - target_mass_kg, 0.0)
+    if is_device_array(mixed):  # CW-B96: identical values, fewer full class-grid temporaries on the device
+        intended = _make_proportional_mass_vector_device_scratch(excess_kg, mixed)
+    else:
+        intended = make_proportional_mass_vector(excess_kg, mixed)
+    burial = windowed_deposit_inplace(bed, intended)
+    new_active_mass_kg = mixed - burial.actual_mass_by_class_kg
+
+    new_active_layer = ActiveLayerState(mass_kg=new_active_mass_kg)
+    check_active_layer_state(new_active_layer, geometry, mass_resolution_kg)
+    result = ActiveLayerDepositionResult(
+        deposited_mass_by_class_kg=deposited,
+        buried_mass_by_class_kg=burial.actual_mass_by_class_kg,
+        active_layer_mass_before_kg=active_before_total_kg,
+        active_layer_mass_after_kg=new_active_mass_kg.sum(axis=-1),
+        active_layer_mass_after_by_class_kg=new_active_mass_kg,
+        numerical_residual_total_mass_kg=burial.numerical_residual_total_mass_kg,
+    )
+    return new_active_layer, result
