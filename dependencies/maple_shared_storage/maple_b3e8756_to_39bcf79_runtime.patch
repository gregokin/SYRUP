index 0000000000000000000000000000000000000000..bfc137122e902eda2f384cf7ecf8b3c25034832d
--- /dev/null
+++ b/src/maple/core/backend/numpy_pairwise_order.py
@@ -0,0 +1,103 @@
+"""Measured qualification of the FP64 contiguous cell-reduction order.
+
+This host model is a small numerical probe, never a host hydraulic solver or
+sediment authority. Published sums include NumPy's +0 identity; internal small
+leaves start with -0, as its pairwise source does. Window summaries can reuse
+the same tree definition. An upgrade changing its order is refused explicitly.
+"""
+from __future__ import annotations
+
+import numpy as np
+
+ORDER_ID = "numpy-fp64-pairwise8-leaf128/1"
+QUALIFIED_MAX_TERMS = 32768
+PROBE_EXTENTS = (0, 1, 3, 6, 7, 8, 9, 31, 32, 127, 128, 129, 256, 1836,
+                 8192, 12288, 16384, 24576, 32768)
+_VERIFIED: set[tuple[str, tuple[int, ...]]] = set()
+
+
+class NumpyReductionOrderMismatch(ValueError):
+    """The running NumPy has a different reduction order; no fallback."""
+
+
+def pairwise_half(n: int) -> int:
+    return (n // 2) - ((n // 2) % 8)
+
+
+def pairwise_leaf(row, start: int, n: int) -> float:
+    if n < 8:
+        result = -0.0
+        for k in range(n):
+            result += float(row[start + k])
+        return result
+    lanes = [float(row[start + j]) for j in range(8)]
+    end = n - n % 8
+    for k in range(8, end, 8):
+        for j in range(8):
+            lanes[j] += float(row[start + k + j])
+    result = ((lanes[0] + lanes[1]) + (lanes[2] + lanes[3])) + (
+        (lanes[4] + lanes[5]) + (lanes[6] + lanes[7]))
+    for k in range(end, n):
+        result += float(row[start + k])
+    return result
+
+
+def pairwise_tree(row, start: int, n: int) -> float:
+    if n <= 128:
+        return pairwise_leaf(row, start, n)
+    left = pairwise_half(n)
+    return pairwise_tree(row, start, left) + pairwise_tree(row, start + left, n - left)
+
+
+def modelled_numpy_sum(row) -> float:
+    return 0.0 + pairwise_tree(row, 0, len(row))
+
+
+def qualify_numpy_order(n_terms: int, *, trailing_shape: tuple[int, ...] | None = None,
+                        force: bool = False) -> dict:
+    """Check actual requested extent and a fixed boundary battery, once/version.
+
+    Scratch is at most 2*32768 FP64 values. Failed or oversized qualification
+    is refused before CUDA launch. Both one and two contiguous trailing-axis
+    layouts are tested, with positive, signed, zero and negative-zero values.
+    """
+    if (isinstance(n_terms, (bool, np.bool_)) or not isinstance(n_terms, (int, np.integer))
+            or not 0 <= int(n_terms) <= QUALIFIED_MAX_TERMS):
+        raise NumpyReductionOrderMismatch("cell reduction extent exceeds the qualified 32768-term limit")
+    shape = (int(n_terms),) if trailing_shape is None else tuple(trailing_shape)
+    if (len(shape) not in (1, 2) or any(isinstance(n, (bool, np.bool_))
+            or not isinstance(n, (int, np.integer)) or n < 0 for n in shape)
+            or int(np.prod(shape, dtype=np.int64)) != n_terms):
+        raise NumpyReductionOrderMismatch("invalid contiguous trailing shape for cell reduction")
+    shape = tuple(int(n) for n in shape)
+    layouts = [(n,) for n in sorted(set(PROBE_EXTENTS) | {int(n_terms)})]
+    if shape not in layouts:
+        layouts.append(shape)
+    if force:
+        _VERIFIED.clear()
+    for layout in layouts:
+        n = int(np.prod(layout, dtype=np.int64))
+        key = (np.__version__, layout)
+        if key in _VERIFIED:
+            continue
+        rng = np.random.default_rng(61219 + n)
+        for kind in ("positive", "signed", "zero", "negative_zero"):
+            data = rng.random((2, n)) * 10. ** rng.uniform(-50., 50., size=(2, n))
+            if kind == "signed":
+                data[0, ::2] *= -1.
+                data[1, 1::2] *= -1.
+            elif kind == "zero":
+                data.fill(0.)
+            elif kind == "negative_zero":
+                data.fill(-0.)
+            expected = data.sum(axis=-1)
+            coalesced = data.reshape((2, *layout)).sum(
+                axis=tuple(range(1, 1 + len(layout))))
+            got = np.array([modelled_numpy_sum(row) for row in data], dtype=np.float64)
+            if got.tobytes() != expected.tobytes() or got.tobytes() != coalesced.tobytes():
+                raise NumpyReductionOrderMismatch(
+                    f"NumPy {np.__version__} cell reduction order mismatch: shape={layout}, kind={kind}")
+        _VERIFIED.add(key)
+    return {"numpy_version": np.__version__, "order_id": ORDER_ID,
+            "extent": int(n_terms), "trailing_shape": list(shape), "byte_exact": True,
+            "qualified_max_terms": QUALIFIED_MAX_TERMS}
