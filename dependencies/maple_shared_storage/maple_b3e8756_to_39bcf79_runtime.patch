index 92cabd9477e636e12ae2172bba4022ff7ad2bc74..db4af764581ea74d7dd6045c8061350d9f6f573a 100644
--- a/src/maple/surface/voxels/_numerics.py
+++ b/src/maple/surface/voxels/_numerics.py
@@ -359,3 +359,66 @@ def make_proportional_mass_vector(
     corrected = vector + xp.where(is_largest, residual[..., None], 0.0)
     correction_is_safe = xp.all(corrected >= 0.0, axis=-1, keepdims=True) & (weight_sum > 0)  # (..., 1)
     return xp.where(correction_is_safe, corrected, vector)
+
+
+def _make_proportional_mass_vector_device_scratch(
+    total_mass_kg: MapleArray, class_weights: MapleArray
+) -> MapleArray:
+    """PRIVATE (not exported; shared-storage S2, adopted from the reference
+    runtime's CW-B96): `make_proportional_mass_vector` for a CuPy float64
+    C-contiguous `(..., n_classes)` class_weights and a float64
+    C-contiguous `total_mass_kg` of shape `class_weights.shape[:-1]`,
+    holding at most two full class grids instead of four.
+
+    Every value is produced by the public function's own operation, on the
+    same operands, in the same order: the same weight sum, the same
+    `divide_where` CuPy branch (guarded denominator, quotient, 0.0 fill
+    where the row weight is not positive), the same product, argmax
+    one-hot, residual, `where`, sum, safety test and final selection. The
+    only difference is ownership: the quotient buffer is overwritten in
+    place by the fill and then the product (`proportions` is dead once
+    `vector` exists), and the `where` temporary is overwritten in place by
+    `vector + temporary` (`corrected`) and then by the final selection.
+    Only this function's own buffers are written; `total_mass_kg` and
+    `class_weights` are never mutated and the result aliases neither. No
+    scalar is read back to the host.
+
+    Any other input (NumPy, another dtype or layout, a broadcasting total)
+    is delegated unchanged to `make_proportional_mass_vector`. The dense
+    production paths never call this helper; only the windowed exchange
+    does, on a device bed.
+    """
+    xp = array_namespace(total_mass_kg, class_weights)
+    if (
+        xp is np
+        or not isinstance(total_mass_kg, xp.ndarray)
+        or not isinstance(class_weights, xp.ndarray)
+        or class_weights.ndim < 1
+        or class_weights.dtype != np.float64
+        or total_mass_kg.dtype != np.float64
+        or total_mass_kg.shape != class_weights.shape[:-1]
+        or not class_weights.flags.c_contiguous
+        or not total_mass_kg.flags.c_contiguous
+    ):
+        return make_proportional_mass_vector(total_mass_kg, class_weights)
+    weight_sum = class_weights.sum(axis=-1, keepdims=True)
+    has_weight = weight_sum > 0
+    # divide_where's CuPy branch: the quotient, then its zeros_like fill where the weight sum is not positive.
+    guarded_denominator = xp.where(has_weight, weight_sum, 1.0)
+    vector = class_weights / guarded_denominator
+    del guarded_denominator, weight_sum
+    xp.copyto(vector, 0.0, where=~has_weight)
+    xp.multiply(vector, total_mass_kg[..., None], out=vector)  # proportions * total_mass_kg[..., None]
+
+    n_classes = class_weights.shape[-1]
+    largest_idx = xp.argmax(class_weights, axis=-1)  # (...,)
+    is_largest = xp.arange(n_classes) == largest_idx[..., None]  # (..., n_classes) one-hot
+    del largest_idx
+
+    residual = total_mass_kg - vector.sum(axis=-1)  # (...,)
+    corrected = xp.where(is_largest, residual[..., None], 0.0)
+    del is_largest, residual
+    xp.add(vector, corrected, out=corrected)  # vector + where(...)
+    correction_is_safe = xp.all(corrected >= 0.0, axis=-1, keepdims=True) & has_weight  # (..., 1)
+    xp.copyto(corrected, vector, where=~correction_is_safe)  # where(correction_is_safe, corrected, vector)
+    return corrected
diff --git a/src/maple/surface/voxels/deep_store.py b/src/maple/surface/voxels/deep_store.py
new file mode 100644
index 0000000000000000000000000000000000000000..5446b419e2ff35230301e64503145d813040700f
--- /dev/null
+++ b/src/maple/surface/voxels/deep_store.py
@@ -0,0 +1,2688 @@
+"""Immutable, versioned, file-backed storage of the FULL voxel stratigraphy
+(CW-B3a; design corrected report sections 4 and 5).
+
+What this is
+------------
+A `DeepStoreVersion` is an OPAQUE, IMMUTABLE host handle naming one
+complete logical `(ny, nx, n_voxels, n_classes)` FP64 column set:
+
+* a `DeepStoreHeader` (grid, voxel count, classes, window width, geometry
+  scalars, datum, class ids, chunk geometry) that every reader binds to;
+* a chunk table: the flattened cells `cell_flat = iy * nx + ix` are cut
+  into chunks of `chunk_columns` consecutive cells; each chunk is ONE
+  read-only, CONTENT-ADDRESSED file `chunks/<sha256>.f64` holding the
+  C-order little-endian FP64 block `(n_cells_in_chunk, n_voxels,
+  n_classes)`;
+* provenance: a monotone `version_id` along its chain, the parent's id
+  and manifest digest, and a SHA-256 `journal_digest` chain over every
+  journal applied since genesis.
+
+Every version is published as ONE canonical-JSON manifest
+`versions/<sha256 of the manifest bytes>.json`. Nothing under `chunks/`
+or `versions/` is ever rewritten or deleted by this module: a later
+version shares every untouched chunk file with its parent and adds only
+the chunk files it changed (copy-on-write), so a retained older version
+-- an initial state, a paused checkpoint item, the accepted state during
+an attempt -- keeps its exact physical truth for as long as its files
+exist. Garbage collection is DEFERRED and explicit (no API here deletes
+anything); disk growth is bounded by `max_store_bytes` recorded in
+`store.json`, and a publication that would exceed it is REFUSED before
+any file is written.
+
+Memory contract
+---------------
+No function in this module ever allocates a full `(ny, nx, n_voxels,
+n_classes)` array except `DeepStoreVersion.to_dense(max_bytes=...)`, which
+refuses BEFORE allocating when the array would exceed the caller's
+explicit byte limit (it exists for small differential tests, never for
+production). The streaming builder holds at most ONE chunk buffer; journal
+application holds at most ONE chunk copy at a time; gathers are bounded
+by an explicit `max_columns`.
+
+Chunk files are read through read-only `numpy.memmap`s (`mode="r"`, so
+the mapping is not writeable and no writable view ever reaches a caller).
+A handle keeps at most `mapping_cache_chunks` mappings (declared LRU,
+default `DEFAULT_MAPPING_CACHE_CHUNKS`); opening one more evicts the
+least recently used ENTRY by dropping the cache's reference only -- a
+mapping is never closed by hand, so a view already yielded to a reader
+(or held by an older version's own cache) stays valid until its last
+reference goes away. Touched pages of a file-backed mapping DO count
+towards the process RSS on Linux for as long as the mapping is alive;
+they are released when the mapping object is finalised, which the cache
+cap guarantees for the handle's OWN references and which a caller that
+retains a view or a full `iter_chunks` list defers by its own choice.
+`deep_store_report` therefore reports, separately: disk bytes; this
+handle's cached mapping count and bytes (and the cap); the transient
+host-copy buffer bound; and the process's actual `VmRSS` / `RssFile` /
+`RssAnon` from `/proc/self/status` when available (`process_memory_
+report`). No claim is made that the OS evicts resident pages of a live
+mapping on its own.
+
+Trust and verification
+----------------------
+Publishing validates DATA, not only digests: every sealed chunk passes
+the dense MAPLE validator `check_voxel_column_state` (finite, nonnegative,
+no overfill, packed bottom-up) on exactly that chunk, with the case's own
+geometry and mass resolution. Loading (`load_version`) verifies the
+manifest digest, then EVERY referenced chunk file's size and SHA-256 by a
+streamed read, then (by default) the same data validator on every chunk,
+and only then returns a usable handle; a wrong header / geometry / class
+binding is refused before any chunk is read.
+
+Counters
+--------
+`read_deep_store_counters()` reports bounded scalar tallies (gathers,
+columns and bytes read, chunks sealed, bytes written, versions published
+and loaded, memmaps opened) beside `maple.core.backend.
+read_transfer_counters()`; nothing here grows with history.
+`columns_read` / `bytes_read` count LOGICAL column bytes delivered to a
+reader, never physical file bytes. Overlay activity (CW-B106) is counted
+only by the separate `read_overlay_counters()`; the key set and the v1
+meaning of the global counters are unchanged (`bytes_written` keeps
+meaning "bytes actually written into a store", overlay files included).
+
+Opt-in exact overlays (CW-B106, format `maple-deep-store/2`)
+-------------------------------------------------------------
+`apply_journal(..., encoding="overlay")` publishes a v2 manifest whose
+slots each hold ONE raw base chunk file (the unchanged v1 format) plus at
+most ONE canonical cumulative overlay `chunks/<sha256>.ovl.f64` of exact
+final class vectors. A publication merges the slot's old overlay keys and
+this journal's keys (last write wins: the journal value) and copies the
+values as raw `<f8` bits from the materialized slot -- no arithmetic, no
+tolerance dropping, no equality filtering, no delta chain. When the encoded
+overlay exceeds the slot's own bound `min(overlay_max_bytes, slot_raw_bytes
+* OVERLAY_MAX_FRACTION)` the slot is KEYFRAMED: the materialized chunk is
+sealed as a new raw base and the slot has no overlay. The default encoding
+remains `"full"` (v1): byte-identical files, manifests, digests and
+counters. A v2 version carries a recursive LOGICAL manifest digest equal
+to the digest a `"full"` publication of the same journal sequence would
+have had; physical manifest parents stay separate. A `"full"` (v1) child
+of a v2 parent is refused; v1 -> v2 is allowed.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import struct
+import threading
+from collections import OrderedDict
+from collections.abc import Iterable, Iterator
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+from maple.core.backend import is_array, is_device_array, to_host
+from maple.core.parameters.geometry import GeometrySpec
+from maple.core.types.voxel import VoxelColumnState, resolve_window_voxels
+from maple.surface.voxels._numerics import le_within_tolerance_array
+from maple.surface.voxels.diagnostics import check_voxel_column_state
+
+__all__ = [
+    "DEEP_STORE_ENCODINGS",
+    "DEEP_STORE_FORMAT",
+    "DEEP_STORE_FORMAT_V2",
+    "DEFAULT_CHUNK_COLUMNS",
+    "DEFAULT_MAPPING_CACHE_CHUNKS",
+    "DEFAULT_MAX_GATHER_COLUMNS",
+    "DEFAULT_MAX_JOURNAL_RECORDS",
+    "MAX_CHUNK_COLUMNS",
+    "MIN_CHUNK_COLUMNS",
+    "OVERLAY_HEADER_BYTES",
+    "OVERLAY_MAGIC",
+    "OVERLAY_MAX_FRACTION",
+    "OVERLAY_MAX_VOXELS",
+    "DeepChunkRef",
+    "DeepJournal",
+    "DeepOverlayRef",
+    "DeepSlotFiles",
+    "DeepStoreBuilder",
+    "DeepStoreHeader",
+    "DeepStoreVersion",
+    "JournalCapacityError",
+    "build_deep_store_from_blocks",
+    "deep_store_file_report",
+    "deep_store_report",
+    "empty_journal",
+    "export_version",
+    "load_version",
+    "overlay_file_nbytes",
+    "overlay_slot_bound_bytes",
+    "process_memory_report",
+    "read_deep_store_counters",
+    "read_overlay_counters",
+    "reset_deep_store_counters",
+    "reset_overlay_counters",
+]
+
+DEEP_STORE_FORMAT = "maple-deep-store/1"
+#: Manifest format of an opt-in overlay version (CW-B106). The store
+#: descriptor `store.json` keeps `DEEP_STORE_FORMAT`.
+DEEP_STORE_FORMAT_V2 = "maple-deep-store/2"
+#: Supported `apply_journal` encodings; `"full"` is the default (v1).
+DEEP_STORE_ENCODINGS = ("full", "overlay")
+_CHUNK_DTYPE = np.dtype("<f8")
+_CHUNK_SUFFIX = ".f64"
+_OVERLAY_SUFFIX = ".ovl.f64"
+_LAYOUT = "C(cell_flat, voxel, class)"
+_HASH_BLOCK_BYTES = 8 * 1024 * 1024
+
+#: Overlay file layout (little-endian): fixed 192-byte header
+#: [magic 8 | store header digest 32 | base sha256 32 | result logical
+#: sha256 32 | chunk_index u4 | n_cells u4 | cell_start u8 | n_voxels u4 |
+#: n_classes u4 | n_records u8 | value dtype code u4 | index dtype code u4 |
+#: reserved 48 zero], then CSR `cell_offsets (n_cells+1) <u4`, `voxel
+#: (n_records) <u2`, zero padding of the WHOLE prefix to 8 bytes, then
+#: `values (n_records, n_classes) <f8`. Exact size: `overlay_file_nbytes`.
+OVERLAY_MAGIC = b"MDSOVL01"
+OVERLAY_HEADER_BYTES = 192
+_OVERLAY_STRUCT = struct.Struct("<8s32s32s32sIIQIIQII48s")
+_OVERLAY_VALUE_CODE_F8 = 1
+_OVERLAY_INDEX_CODE_U2 = 1
+#: `<u2` voxel index: overlays are refused for taller columns.
+OVERLAY_MAX_VOXELS = 65535
+#: Per-slot overlay bound as a fraction (numerator, denominator) of THAT
+#: slot's raw bytes; the effective bound is also capped by the explicit
+#: `overlay_max_bytes`. Integer arithmetic only (deterministic).
+OVERLAY_MAX_FRACTION = (1, 4)
+assert _OVERLAY_STRUCT.size == OVERLAY_HEADER_BYTES
+
+#: Chunk geometry bounds (root direction: configurable 64-1024 columns).
+MIN_CHUNK_COLUMNS = 64
+MAX_CHUNK_COLUMNS = 1024
+DEFAULT_CHUNK_COLUMNS = 256
+#: Bound on one gather (Chastre: 4096 x 306 x 6 x 8 B = 60 MB).
+DEFAULT_MAX_GATHER_COLUMNS = 4096
+#: Bound on one journal (design section 4.3).
+DEFAULT_MAX_JOURNAL_RECORDS = 1_000_000
+#: Declared LRU cap on the read-only chunk mappings ONE handle keeps alive
+#: (Chastre, 1024-column chunks: 8 x 15 MB = 120 MB of mapping bound).
+DEFAULT_MAPPING_CACHE_CHUNKS = 8
+
+
+# ---------------------------------------------------------------------------
+# Counters (bounded scalars)
+# ---------------------------------------------------------------------------
+
+_COUNTER_LOCK = threading.Lock()
+_COUNTER_NAMES = (
+    "gather_calls",
+    "columns_read",
+    "bytes_read",
+    "chunks_sealed",
+    "bytes_written",
+    "versions_published",
+    "versions_loaded",
+    "chunk_memmaps_opened",
+    "chunk_memmaps_evicted",
+)
+_COUNTS: dict[str, int] = {name: 0 for name in _COUNTER_NAMES}
+
+
+def _bump(name: str, amount: int = 1) -> None:
+    with _COUNTER_LOCK:
+        _COUNTS[name] += int(amount)
+
+
+def read_deep_store_counters() -> dict[str, int]:
+    """A copy of the bounded scalar tallies (never a history)."""
+    with _COUNTER_LOCK:
+        return dict(_COUNTS)
+
+
+def reset_deep_store_counters() -> None:
+    with _COUNTER_LOCK:
+        for name in _COUNTS:
+            _COUNTS[name] = 0
+
+
+# Separate, bounded overlay tallies (CW-B106). Physical overlay bytes here;
+# the global counters above keep their v1 key set and meaning.
+_OVERLAY_COUNTER_NAMES = (
+    "overlay_publications",
+    "overlay_files_written",
+    "overlay_files_deduplicated",
+    "overlay_bytes_written",
+    "keyframes_sealed",
+    "overlay_files_opened",
+    "overlay_bytes_mapped",
+    "overlay_slot_materializations",
+    "overlay_records_applied",
+)
+_OVERLAY_COUNTS: dict[str, int] = {name: 0 for name in _OVERLAY_COUNTER_NAMES}
+
+
+def _bump_overlay(name: str, amount: int = 1) -> None:
+    with _COUNTER_LOCK:
+        _OVERLAY_COUNTS[name] += int(amount)
+
+
+def read_overlay_counters() -> dict[str, int]:
+    """A copy of the bounded overlay tallies (never a history)."""
+    with _COUNTER_LOCK:
+        return dict(_OVERLAY_COUNTS)
+
+
+def reset_overlay_counters() -> None:
+    with _COUNTER_LOCK:
+        for name in _OVERLAY_COUNTS:
+            _OVERLAY_COUNTS[name] = 0
+
+
+class JournalCapacityError(ValueError):
+    """The windowed transaction's application-order journal append cap
+    (`windowed_transfer._require_journal_room`) would be exceeded. A
+    `ValueError` with the unchanged legacy message plus structured record
+    counts, so a caller can recognize THIS refusal without parsing text.
+    Raised by that guard only; every other cap or data refusal stays an
+    ordinary failure."""
+
+    def __init__(self, message: str, *, current_records: int, new_records: int, max_records: int) -> None:
+        super().__init__(message)
+        self.current_records = int(current_records)
+        self.new_records = int(new_records)
+        self.max_records = int(max_records)
+
+    def __reduce__(self):  # keyword-only fields survive pickling
+        return (_rebuild_journal_capacity_error,
+                (str(self), self.current_records, self.new_records, self.max_records))
+
+
+def _rebuild_journal_capacity_error(message: str, current: int, new: int, maximum: int) -> JournalCapacityError:
+    return JournalCapacityError(message, current_records=current, new_records=new, max_records=maximum)
+
+
+# ---------------------------------------------------------------------------
+# Canonical JSON and hashing
+# ---------------------------------------------------------------------------
+
+
+def _canonical_json_bytes(obj: Any) -> bytes:
+    return json.dumps(obj, sort_keys=True, separators=(",", ":"), allow_nan=False).encode("utf-8")
+
+
+def _sha256_bytes(data: bytes | memoryview) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def _sha256_file(path: Path) -> tuple[str, int]:
+    """Streamed digest and size of a file (bounded read buffer)."""
+    digest = hashlib.sha256()
+    size = 0
+    with open(path, "rb") as handle:
+        while True:
+            piece = handle.read(_HASH_BLOCK_BYTES)
+            if not piece:
+                break
+            digest.update(piece)
+            size += len(piece)
+    return digest.hexdigest(), size
+
+
+def _is_hex_digest(value: Any) -> bool:
+    return isinstance(value, str) and len(value) == 64 and all(c in "0123456789abcdef" for c in value)
+
+
+def _require_int(value: Any, name: str, *, minimum: int | None = None) -> int:
+    if isinstance(value, bool) or not isinstance(value, (int, np.integer)):
+        raise ValueError(f"{name} must be a non-Boolean integer, got {value!r}")
+    out = int(value)
+    if minimum is not None and out < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {out}")
+    return out
+
+
+def _require_finite_float(value: Any, name: str, *, positive: bool = False) -> float:
+    if isinstance(value, bool) or not isinstance(value, (int, float, np.integer, np.floating)):
+        raise ValueError(f"{name} must be a real number, got {value!r}")
+    out = float(value)
+    if not np.isfinite(out):
+        raise ValueError(f"{name} must be finite, got {out!r}")
+    if positive and out <= 0.0:
+        raise ValueError(f"{name} must be > 0, got {out!r}")
+    return out
+
+
+# ---------------------------------------------------------------------------
+# Header
+# ---------------------------------------------------------------------------
+
+_HEADER_KEYS = (
+    "ny", "nx", "n_voxels", "n_classes", "window_voxels",
+    "dx_m", "dy_m", "voxel_dz_m", "bulk_density_kg_m3", "datum_offset_m",
+    "class_ids", "chunk_columns", "dtype", "layout",
+)
+
+
+@dataclass(frozen=True)
+class DeepStoreHeader:
+    """Everything a reader must agree on before touching a chunk. JSON-safe
+    scalars and a tuple of class ids only; immutable."""
+
+    ny: int
+    nx: int
+    n_voxels: int
+    n_classes: int
+    window_voxels: int
+    dx_m: float
+    dy_m: float
+    voxel_dz_m: float
+    bulk_density_kg_m3: float
+    datum_offset_m: float
+    class_ids: tuple[str, ...]
+    chunk_columns: int
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "ny", _require_int(self.ny, "ny", minimum=1))
+        object.__setattr__(self, "nx", _require_int(self.nx, "nx", minimum=1))
+        object.__setattr__(self, "n_voxels", _require_int(self.n_voxels, "n_voxels", minimum=1))
+        object.__setattr__(self, "n_classes", _require_int(self.n_classes, "n_classes", minimum=1))
+        object.__setattr__(
+            self, "window_voxels", resolve_window_voxels(self.window_voxels, self.n_voxels)
+        )
+        for name in ("dx_m", "dy_m", "voxel_dz_m", "bulk_density_kg_m3"):
+            object.__setattr__(self, name, _require_finite_float(getattr(self, name), name, positive=True))
+        object.__setattr__(
+            self, "datum_offset_m", _require_finite_float(self.datum_offset_m, "datum_offset_m")
+        )
+        ids = self.class_ids
+        if isinstance(ids, (str, bytes)) or not isinstance(ids, (tuple, list)):
+            raise ValueError("class_ids must be a tuple of class id strings")
+        ids = tuple(ids)
+        if len(ids) != self.n_classes or any(not isinstance(c, str) or not c for c in ids):
+            raise ValueError(
+                f"class_ids must be {self.n_classes} nonempty strings (one per class, in class "
+                f"order), got {ids!r}"
+            )
+        if len(set(ids)) != len(ids):
+            raise ValueError(f"class_ids must be distinct, got {ids!r}")
+        object.__setattr__(self, "class_ids", ids)
+        chunk = _require_int(self.chunk_columns, "chunk_columns", minimum=1)
+        if chunk < MIN_CHUNK_COLUMNS or chunk > MAX_CHUNK_COLUMNS:
+            raise ValueError(
+                f"chunk_columns must lie in [{MIN_CHUNK_COLUMNS}, {MAX_CHUNK_COLUMNS}], got {chunk}"
+            )
+        object.__setattr__(self, "chunk_columns", chunk)
+
+    # --- derived geometry ---
+    @property
+    def n_cells(self) -> int:
+        return self.ny * self.nx
+
+    @property
+    def n_chunks(self) -> int:
+        return (self.n_cells + self.chunk_columns - 1) // self.chunk_columns
+
+    @property
+    def column_bytes(self) -> int:
+        return self.n_voxels * self.n_classes * _CHUNK_DTYPE.itemsize
+
+    @property
+    def logical_bytes(self) -> int:
+        """Bytes of the dense `(ny, nx, n_voxels, n_classes)` array this
+        store stands for. Reported; never allocated here."""
+        return self.n_cells * self.column_bytes
+
+    @property
+    def chunk_bytes_max(self) -> int:
+        return self.chunk_columns * self.column_bytes
+
+    def chunk_extent(self, index: int) -> tuple[int, int]:
+        """`(cell_start, n_cells)` of chunk `index`."""
+        index = _require_int(index, "chunk index", minimum=0)
+        if index >= self.n_chunks:
+            raise ValueError(f"chunk index {index} out of range [0, {self.n_chunks})")
+        start = index * self.chunk_columns
+        return start, min(self.chunk_columns, self.n_cells - start)
+
+    @property
+    def capacity_kg(self) -> float:
+        return self.bulk_density_kg_m3 * self.dx_m * self.dy_m * self.voxel_dz_m
+
+    # --- geometry binding ---
+    @classmethod
+    def from_geometry(
+        cls,
+        geometry: GeometrySpec,
+        *,
+        n_voxels: int,
+        class_ids: tuple[str, ...],
+        window_voxels: int = 4,
+        datum_offset_m: float = 0.0,
+        chunk_columns: int = DEFAULT_CHUNK_COLUMNS,
+    ) -> DeepStoreHeader:
+        return cls(
+            ny=geometry.ny, nx=geometry.nx, n_voxels=n_voxels, n_classes=len(tuple(class_ids)),
+            window_voxels=window_voxels, dx_m=geometry.dx_m, dy_m=geometry.dy_m,
+            voxel_dz_m=geometry.voxel_dz_m, bulk_density_kg_m3=geometry.bulk_density_kg_m3,
+            datum_offset_m=datum_offset_m, class_ids=tuple(class_ids), chunk_columns=chunk_columns,
+        )
+
+    def geometry_mismatches(self, geometry: GeometrySpec) -> list[str]:
+        """Exact (not tolerant) disagreements with a `GeometrySpec`."""
+        out: list[str] = []
+        for name in ("ny", "nx", "dx_m", "dy_m", "voxel_dz_m", "bulk_density_kg_m3"):
+            mine = getattr(self, name)
+            theirs = getattr(geometry, name)
+            if type(mine)(theirs) != mine:
+                out.append(f"{name}: header {mine!r} != geometry {theirs!r}")
+        return out
+
+    def require_geometry(self, geometry: GeometrySpec, *, operation: str) -> None:
+        mismatches = self.geometry_mismatches(geometry)
+        if mismatches:
+            raise ValueError(f"{operation}: deep-store header does not bind to this geometry: "
+                             + "; ".join(mismatches))
+
+    def require_class_ids(self, class_ids: Iterable[str], *, operation: str) -> None:
+        ids = tuple(class_ids)
+        if ids != self.class_ids:
+            raise ValueError(
+                f"{operation}: class ordering {ids!r} does not match the deep-store header's "
+                f"{self.class_ids!r}; the store is bound to one class ordering"
+            )
+
+    # --- JSON ---
+    def to_json_dict(self) -> dict[str, Any]:
+        return {
+            "ny": self.ny, "nx": self.nx, "n_voxels": self.n_voxels, "n_classes": self.n_classes,
+            "window_voxels": self.window_voxels, "dx_m": self.dx_m, "dy_m": self.dy_m,
+            "voxel_dz_m": self.voxel_dz_m, "bulk_density_kg_m3": self.bulk_density_kg_m3,
+            "datum_offset_m": self.datum_offset_m, "class_ids": list(self.class_ids),
+            "chunk_columns": self.chunk_columns, "dtype": _CHUNK_DTYPE.str, "layout": _LAYOUT,
+        }
+
+    @classmethod
+    def from_json_dict(cls, raw: Any) -> DeepStoreHeader:
+        if not isinstance(raw, dict):
+            raise ValueError("deep-store header must be a JSON object")
+        unknown = set(raw) - set(_HEADER_KEYS)
+        missing = set(_HEADER_KEYS) - set(raw)
+        if unknown or missing:
+            raise ValueError(
+                f"deep-store header keys mismatch: missing {sorted(missing)}, unknown {sorted(unknown)}"
+            )
+        if raw["dtype"] != _CHUNK_DTYPE.str or raw["layout"] != _LAYOUT:
+            raise ValueError(
+                f"deep-store header declares dtype/layout {raw['dtype']!r}/{raw['layout']!r}; this "
+                f"reader supports only {_CHUNK_DTYPE.str!r}/{_LAYOUT!r}"
+            )
+        for name in ("ny", "nx", "n_voxels", "n_classes", "window_voxels", "chunk_columns"):
+            if isinstance(raw[name], bool) or not isinstance(raw[name], int):
+                raise ValueError(f"deep-store header field {name} must be a JSON integer")
+        for name in ("dx_m", "dy_m", "voxel_dz_m", "bulk_density_kg_m3", "datum_offset_m"):
+            if isinstance(raw[name], bool) or not isinstance(raw[name], (int, float)):
+                raise ValueError(f"deep-store header field {name} must be a JSON number")
+        if not isinstance(raw["class_ids"], list):
+            raise ValueError("deep-store header field class_ids must be a JSON list")
+        return cls(
+            ny=raw["ny"], nx=raw["nx"], n_voxels=raw["n_voxels"], n_classes=raw["n_classes"],
+            window_voxels=raw["window_voxels"], dx_m=float(raw["dx_m"]), dy_m=float(raw["dy_m"]),
+            voxel_dz_m=float(raw["voxel_dz_m"]),
+            bulk_density_kg_m3=float(raw["bulk_density_kg_m3"]),
+            datum_offset_m=float(raw["datum_offset_m"]), class_ids=tuple(raw["class_ids"]),
+            chunk_columns=raw["chunk_columns"],
+        )
+
+    def digest(self) -> str:
+        return _sha256_bytes(_canonical_json_bytes(self.to_json_dict()))
+
+
+# ---------------------------------------------------------------------------
+# Chunk references
+# ---------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class DeepChunkRef:
+    """One immutable chunk: where it sits in the cell order and which
+    content-addressed file holds it. Carries no array."""
+
+    index: int
+    cell_start: int
+    n_cells: int
+    sha256: str
+    nbytes: int
+
+    def to_json_dict(self) -> dict[str, Any]:
+        return {"index": self.index, "cell_start": self.cell_start, "n_cells": self.n_cells,
+                "sha256": self.sha256, "nbytes": self.nbytes}
+
+
+def _chunk_refs_from_json(raw: Any, header: DeepStoreHeader) -> tuple[DeepChunkRef, ...]:
+    if not isinstance(raw, list) or len(raw) != header.n_chunks:
+        raise ValueError(
+            f"manifest chunk table must list exactly {header.n_chunks} chunks, got "
+            f"{len(raw) if isinstance(raw, list) else type(raw).__name__}"
+        )
+    refs: list[DeepChunkRef] = []
+    for index, entry in enumerate(raw):
+        if not isinstance(entry, dict) or set(entry) != {"index", "cell_start", "n_cells", "sha256", "nbytes"}:
+            raise ValueError(f"manifest chunk entry {index} is malformed: {entry!r}")
+        start, n_cells = header.chunk_extent(index)
+        for name, expected in (("index", index), ("cell_start", start), ("n_cells", n_cells),
+                               ("nbytes", n_cells * header.column_bytes)):
+            value = entry[name]
+            if isinstance(value, bool) or not isinstance(value, int) or value != expected:
+                raise ValueError(
+                    f"manifest chunk entry {index}: {name} must be {expected}, got {value!r}"
+                )
+        if not _is_hex_digest(entry["sha256"]):
+            raise ValueError(f"manifest chunk entry {index}: sha256 is not a 64-hex digest")
+        refs.append(DeepChunkRef(index, start, n_cells, entry["sha256"], n_cells * header.column_bytes))
+    return tuple(refs)
+
+
+# ---------------------------------------------------------------------------
+# Overlay slots (CW-B106, manifest v2)
+# ---------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class DeepOverlayRef:
+    """One content-addressed overlay file `chunks/<sha256>.ovl.f64`."""
+
+    sha256: str
+    nbytes: int
+    n_records: int
+
+    def to_json_dict(self) -> dict[str, Any]:
+        return {"sha256": self.sha256, "nbytes": self.nbytes, "n_records": self.n_records}
+
+
+@dataclass(frozen=True)
+class DeepSlotFiles:
+    """The physical files of one v2 slot: its raw base chunk and at most
+    one overlay. With no overlay the base IS the logical chunk."""
+
+    base_sha256: str
+    overlay: DeepOverlayRef | None
+
+
+def _align8(value: int) -> int:
+    return (value + 7) // 8 * 8
+
+
+def overlay_file_nbytes(n_cells: int, n_records: int, n_classes: int) -> int:
+    """Exact overlay file size: `align8(192 + 4*(n_cells+1) + 2*n_records)
+    + 8*n_records*n_classes` (Python integers; no overflow)."""
+    n_cells, n_records, n_classes = int(n_cells), int(n_records), int(n_classes)
+    return _align8(OVERLAY_HEADER_BYTES + 4 * (n_cells + 1) + 2 * n_records) + 8 * n_records * n_classes
+
+
+def overlay_slot_bound_bytes(slot_nbytes: int, overlay_max_bytes: int | None) -> int:
+    """The deterministic per-slot overlay bound: `floor(slot_nbytes *
+    OVERLAY_MAX_FRACTION)`, further capped by `overlay_max_bytes` when
+    given. A merged overlay larger than this keyframes the slot."""
+    num, den = OVERLAY_MAX_FRACTION
+    bound = int(slot_nbytes) * num // den
+    if overlay_max_bytes is not None:
+        bound = min(bound, int(overlay_max_bytes))
+    return bound
+
+
+def _resolve_encoding(encoding: Any, overlay_max_bytes: Any, header: DeepStoreHeader,
+                      *, operation: str) -> tuple[str, int | None]:
+    """Validate explicit encoding options. Unsupported settings RAISE; there
+    is no silent fallback to another encoding."""
+    if not isinstance(encoding, str) or encoding not in DEEP_STORE_ENCODINGS:
+        raise ValueError(f"{operation}: encoding must be one of {DEEP_STORE_ENCODINGS}, got {encoding!r}")
+    if encoding == "full":
+        if overlay_max_bytes is not None:
+            raise ValueError(f"{operation}: overlay_max_bytes is supported only with encoding='overlay'")
+        return encoding, None
+    if overlay_max_bytes is not None:
+        overlay_max_bytes = _require_int(overlay_max_bytes, "overlay_max_bytes", minimum=1)
+    if header.n_voxels > OVERLAY_MAX_VOXELS:
+        raise ValueError(
+            f"{operation}: encoding='overlay' supports n_voxels <= {OVERLAY_MAX_VOXELS} (<u2 voxel index), "
+            f"got {header.n_voxels}; no fallback encoding is applied"
+        )
+    return encoding, overlay_max_bytes
+
+
+def _v2_chunk_refs_from_json(
+    raw: Any, header: DeepStoreHeader,
+) -> tuple[tuple[DeepChunkRef, ...], tuple[DeepSlotFiles, ...]]:
+    """Parse a v2 chunk table. Every size/index guard is integer metadata
+    only (no file is opened). `DeepChunkRef.sha256` is the LOGICAL slot
+    digest; `DeepSlotFiles` names the physical files. Every overlay must
+    satisfy the FORMAT bound `overlay_slot_bound_bytes(slot, None)` (its
+    own slot's fraction): a manifest's `overlay_max_bytes` governs only the
+    overlays that publication emitted, while untouched slots legitimately
+    carry overlays emitted earlier under a larger explicit cap."""
+    if not isinstance(raw, list) or len(raw) != header.n_chunks:
+        raise ValueError(
+            f"manifest chunk table must list exactly {header.n_chunks} chunks, got "
+            f"{len(raw) if isinstance(raw, list) else type(raw).__name__}"
+        )
+    keys = {"index", "cell_start", "n_cells", "nbytes", "logical_sha256", "base_sha256", "overlay"}
+    refs: list[DeepChunkRef] = []
+    slots: list[DeepSlotFiles] = []
+    for index, entry in enumerate(raw):
+        if not isinstance(entry, dict) or set(entry) != keys:
+            raise ValueError(f"manifest chunk entry {index} is malformed: {entry!r}")
+        start, n_cells = header.chunk_extent(index)
+        nbytes = n_cells * header.column_bytes
+        for name, expected in (("index", index), ("cell_start", start), ("n_cells", n_cells), ("nbytes", nbytes)):
+            value = entry[name]
+            if isinstance(value, bool) or not isinstance(value, int) or value != expected:
+                raise ValueError(f"manifest chunk entry {index}: {name} must be {expected}, got {value!r}")
+        for name in ("logical_sha256", "base_sha256"):
+            if not _is_hex_digest(entry[name]):
+                raise ValueError(f"manifest chunk entry {index}: {name} is not a 64-hex digest")
+        overlay = entry["overlay"]
+        if overlay is None:
+            if entry["base_sha256"] != entry["logical_sha256"]:
+                raise ValueError(f"manifest chunk entry {index}: without an overlay the base must be the logical chunk")
+            slot = DeepSlotFiles(entry["base_sha256"], None)
+        else:
+            if not isinstance(overlay, dict) or set(overlay) != {"sha256", "nbytes", "n_records"}:
+                raise ValueError(f"manifest chunk entry {index}: overlay entry is malformed: {overlay!r}")
+            if not _is_hex_digest(overlay["sha256"]):
+                raise ValueError(f"manifest chunk entry {index}: overlay sha256 is not a 64-hex digest")
+            for name in ("nbytes", "n_records"):
+                if isinstance(overlay[name], bool) or not isinstance(overlay[name], int):
+                    raise ValueError(f"manifest chunk entry {index}: overlay {name} must be a JSON integer")
+            n_records = overlay["n_records"]
+            if n_records < 1 or n_records > n_cells * header.n_voxels:
+                raise ValueError(
+                    f"manifest chunk entry {index}: overlay n_records {n_records} outside [1, {n_cells * header.n_voxels}]"
+                )
+            exact = overlay_file_nbytes(n_cells, n_records, header.n_classes)
+            if overlay["nbytes"] != exact:
+                raise ValueError(f"manifest chunk entry {index}: overlay nbytes {overlay['nbytes']} != exact size {exact}")
+            bound = overlay_slot_bound_bytes(nbytes, None)
+            if exact > bound:
+                raise ValueError(f"manifest chunk entry {index}: overlay of {exact} bytes exceeds the slot bound {bound}")
+            slot = DeepSlotFiles(entry["base_sha256"], DeepOverlayRef(overlay["sha256"], exact, n_records))
+        refs.append(DeepChunkRef(index, start, n_cells, entry["logical_sha256"], nbytes))
+        slots.append(slot)
+    return tuple(refs), tuple(slots)
+
+
+def _v2_chunk_json(ref: DeepChunkRef, slot: DeepSlotFiles) -> dict[str, Any]:
+    return {"index": ref.index, "cell_start": ref.cell_start, "n_cells": ref.n_cells, "nbytes": ref.nbytes,
+            "logical_sha256": ref.sha256, "base_sha256": slot.base_sha256,
+            "overlay": None if slot.overlay is None else slot.overlay.to_json_dict()}
+
+
+class _OverlayView:
+    """Validated read-only views of one mapped overlay file (zero-copy into
+    the mapping, except the small int64 CSR copy)."""
+
+    __slots__ = ("mapping", "n_records", "nbytes", "offsets", "values", "voxels")
+
+    def __init__(self, mapping: np.memmap, offsets: np.ndarray, voxels: np.ndarray, values: np.ndarray) -> None:
+        self.mapping = mapping
+        self.nbytes = int(mapping.nbytes)
+        self.offsets = offsets  # (n_cells+1,) int64 host copy
+        self.voxels = voxels  # (n_records,) <u2 view of the mapping
+        self.values = values  # (n_records, n_classes) <f8 view of the mapping
+        self.n_records = int(voxels.shape[0])
+
+    def local_keys(self, n_voxels: int) -> np.ndarray:
+        rows = np.repeat(np.arange(self.offsets.shape[0] - 1, dtype=np.int64), np.diff(self.offsets))
+        return rows * np.int64(n_voxels) + self.voxels.astype(np.int64)
+
+    def apply_all(self, out: np.ndarray) -> None:
+        """Assign every record into the slot buffer `out` (raw bits)."""
+        if self.n_records:
+            rows = np.repeat(np.arange(self.offsets.shape[0] - 1, dtype=np.intp), np.diff(self.offsets))
+            out[rows, self.voxels] = self.values
+            _bump_overlay("overlay_records_applied", self.n_records)
+
+    def apply_rows(self, out: np.ndarray, dest: np.ndarray, local: np.ndarray) -> None:
+        """Assign the records of slot-local cells `local` into `out[dest]`."""
+        starts = self.offsets[local]
+        counts = self.offsets[local + 1] - starts
+        total = int(counts.sum())
+        if total:
+            first = np.cumsum(counts) - counts
+            rec = np.arange(total, dtype=np.int64) + np.repeat(starts - first, counts)
+            out[np.repeat(dest, counts), self.voxels[rec]] = self.values[rec]
+            _bump_overlay("overlay_records_applied", total)
+
+
+class _SlotMapping:
+    """One cache entry: the base mapping and (v2) the overlay views."""
+
+    __slots__ = ("base", "overlay")
+
+    def __init__(self, base: np.memmap, overlay: _OverlayView | None) -> None:
+        self.base = base
+        self.overlay = overlay
+
+    @property
+    def nbytes(self) -> int:
+        return int(self.base.nbytes) + (0 if self.overlay is None else self.overlay.nbytes)
+
+
+def _open_overlay(store_dir: Path, header: DeepStoreHeader, ref: DeepChunkRef, slot: DeepSlotFiles) -> _OverlayView:
+    """Open and STRUCTURALLY validate one overlay file. Every size, header,
+    reserved-byte and dtype check happens on the stat size and the fixed
+    192-byte header BEFORE the file is mapped; CSR/voxel/padding/value
+    checks follow on the (bounded, exactly sized) mapping before any
+    record is applied."""
+    ov = slot.overlay
+    assert ov is not None
+    path = _overlay_path(store_dir, ov.sha256)
+    if not path.is_file():
+        raise ValueError(f"chunk {ref.index} overlay file is missing: {path}")
+    size = path.stat().st_size
+    exact = overlay_file_nbytes(ref.n_cells, ov.n_records, header.n_classes)
+    if size != ov.nbytes or size != exact:
+        raise ValueError(f"chunk {ref.index} overlay {path} has {size} bytes; manifest says {ov.nbytes}, exact {exact}")
+    bound = overlay_slot_bound_bytes(ref.nbytes, None)  # format bound (see `_v2_chunk_refs_from_json`)
+    if size > bound:
+        raise ValueError(f"chunk {ref.index} overlay {path} exceeds the slot bound {bound}")
+    with open(path, "rb") as handle:
+        head = handle.read(OVERLAY_HEADER_BYTES)
+    if len(head) != OVERLAY_HEADER_BYTES:
+        raise ValueError(f"chunk {ref.index} overlay {path}: truncated header")
+    (magic, store_digest, base_sha, result_sha, chunk_index, n_cells, cell_start, n_voxels, n_classes,
+     n_records, value_code, index_code, reserved) = _OVERLAY_STRUCT.unpack(head)
+    expected = (
+        ("magic", magic, OVERLAY_MAGIC),
+        ("header digest", store_digest, bytes.fromhex(header.digest())),
+        ("base sha256", base_sha, bytes.fromhex(slot.base_sha256)),
+        ("result logical sha256", result_sha, bytes.fromhex(ref.sha256)),
+        ("chunk_index", chunk_index, ref.index), ("n_cells", n_cells, ref.n_cells),
+        ("cell_start", cell_start, ref.cell_start), ("n_voxels", n_voxels, header.n_voxels),
+        ("n_classes", n_classes, header.n_classes), ("n_records", n_records, ov.n_records),
+        ("value dtype code", value_code, _OVERLAY_VALUE_CODE_F8),
+        ("index dtype code", index_code, _OVERLAY_INDEX_CODE_U2),
+        ("reserved bytes", reserved, bytes(48)),
+    )
+    for name, got, want in expected:
+        if got != want:
+            raise ValueError(f"chunk {ref.index} overlay {path}: {name} mismatch")
+    n = ov.n_records
+    vox_off = OVERLAY_HEADER_BYTES + 4 * (ref.n_cells + 1)
+    val_off = _align8(vox_off + 2 * n)
+    mapping = np.memmap(path, dtype=np.uint8, mode="r", shape=(size,))
+    offsets_u4 = np.frombuffer(mapping, dtype="<u4", count=ref.n_cells + 1, offset=OVERLAY_HEADER_BYTES)
+    voxels = np.frombuffer(mapping, dtype="<u2", count=n, offset=vox_off)
+    values = np.frombuffer(mapping, dtype="<f8", count=n * header.n_classes, offset=val_off).reshape(
+        n, header.n_classes)
+    if np.any(mapping[vox_off + 2 * n:val_off]):
+        raise ValueError(f"chunk {ref.index} overlay {path}: nonzero padding")
+    offsets = offsets_u4.astype(np.int64)
+    if offsets[0] != 0 or offsets[-1] != n or bool(np.any(np.diff(offsets) < 0)):
+        raise ValueError(f"chunk {ref.index} overlay {path}: invalid cell CSR offsets")
+    if n and int(voxels.max()) >= header.n_voxels:
+        raise ValueError(f"chunk {ref.index} overlay {path}: voxel index out of range")
+    view = _OverlayView(mapping, offsets, voxels, values)
+    if n > 1 and bool(np.any(np.diff(view.local_keys(header.n_voxels)) <= 0)):
+        raise ValueError(f"chunk {ref.index} overlay {path}: voxels not strictly increasing within a cell")
+    if not bool(np.all(np.isfinite(values))) or bool(np.any(values < 0.0)):
+        raise ValueError(f"chunk {ref.index} overlay {path}: values must be finite and nonnegative")
+    _bump_overlay("overlay_files_opened")
+    _bump_overlay("overlay_bytes_mapped", size)
+    return view
+
+
+def _encode_overlay(header: DeepStoreHeader, ref: DeepChunkRef, *, base_sha256: str, logical_sha256: str,
+                    keys: np.ndarray, buffer: np.ndarray) -> bytearray:
+    """Canonical overlay bytes for the sorted unique slot-local keys
+    `local_cell * n_voxels + voxel`, values copied as raw bits from the
+    materialized slot `buffer`. Header reserved bytes and padding are
+    zero (bytearray zero-initialised)."""
+    nv, nc = header.n_voxels, header.n_classes
+    n = int(keys.shape[0])
+    size = overlay_file_nbytes(ref.n_cells, n, nc)
+    out = bytearray(size)
+    out[:OVERLAY_HEADER_BYTES] = _OVERLAY_STRUCT.pack(
+        OVERLAY_MAGIC, bytes.fromhex(header.digest()), bytes.fromhex(base_sha256), bytes.fromhex(logical_sha256),
+        ref.index, ref.n_cells, ref.cell_start, nv, nc, n, _OVERLAY_VALUE_CODE_F8, _OVERLAY_INDEX_CODE_U2,
+        bytes(48),
+    )
+    local_cell = keys // nv
+    vox_off = OVERLAY_HEADER_BYTES + 4 * (ref.n_cells + 1)
+    val_off = _align8(vox_off + 2 * n)
+    np.frombuffer(out, dtype="<u4", count=ref.n_cells + 1, offset=OVERLAY_HEADER_BYTES)[:] = np.searchsorted(
+        local_cell, np.arange(ref.n_cells + 1, dtype=np.int64), side="left")
+    np.frombuffer(out, dtype="<u2", count=n, offset=vox_off)[:] = keys % nv
+    np.take(buffer.reshape(ref.n_cells * nv, nc), keys, axis=0,
+            out=np.frombuffer(out, dtype="<f8", count=n * nc, offset=val_off).reshape(n, nc))
+    return out
+
+
+# ---------------------------------------------------------------------------
+# Store directory helpers
+# ---------------------------------------------------------------------------
+
+
+def _chunks_dir(store_dir: Path) -> Path:
+    return store_dir / "chunks"
+
+
+def _versions_dir(store_dir: Path) -> Path:
+    return store_dir / "versions"
+
+
+def _chunk_path(store_dir: Path, sha256: str) -> Path:
+    return _chunks_dir(store_dir) / f"{sha256}{_CHUNK_SUFFIX}"
+
+
+def _overlay_path(store_dir: Path, sha256: str) -> Path:
+    return _chunks_dir(store_dir) / f"{sha256}{_OVERLAY_SUFFIX}"
+
+
+def _manifest_path(store_dir: Path, manifest_digest: str) -> Path:
+    return _versions_dir(store_dir) / f"{manifest_digest}.json"
+
+
+def _store_json_path(store_dir: Path) -> Path:
+    return store_dir / "store.json"
+
+
+def _scan_store_bytes(store_dir: Path) -> tuple[int, int, int]:
+    """`(total_bytes, n_chunk_files, n_version_files)` by one directory
+    scan (bounded by the number of files; no file content is read).
+    Overlay files `*.ovl.f64` end in `.f64` and are therefore counted (as
+    chunk files) under the same cap semantics; `.tmp` files are not."""
+    total = 0
+    n_chunks = 0
+    n_versions = 0
+    chunks = _chunks_dir(store_dir)
+    if chunks.is_dir():
+        with os.scandir(chunks) as it:
+            for entry in it:
+                if entry.is_file() and entry.name.endswith(_CHUNK_SUFFIX):
+                    total += entry.stat().st_size
+                    n_chunks += 1
+    versions = _versions_dir(store_dir)
+    if versions.is_dir():
+        with os.scandir(versions) as it:
+            for entry in it:
+                if entry.is_file() and entry.name.endswith(".json"):
+                    total += entry.stat().st_size
+                    n_versions += 1
+    return total, n_chunks, n_versions
+
+
+def _write_bytes_once(path: Path, data: bytes | memoryview, *, expected_sha256: str) -> int:
+    """Write an immutable file atomically (temp + replace) unless a file of
+    that content-addressed name already exists. Returns bytes actually
+    written (0 when deduplicated). The published file is made read-only."""
+    if path.exists():
+        return 0
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_name(f".{path.name}.{os.getpid()}.{threading.get_ident()}.tmp")
+    try:
+        with open(tmp, "wb") as handle:
+            handle.write(data)
+            handle.flush()
+            os.fsync(handle.fileno())
+        digest, _ = _sha256_file(tmp)
+        if digest != expected_sha256:
+            raise OSError(f"written bytes do not hash to {expected_sha256}: got {digest}")
+        os.chmod(tmp, 0o444)
+        os.replace(tmp, path)
+    except BaseException:
+        if tmp.exists():
+            os.unlink(tmp)
+        raise
+    return len(data)
+
+
+def _init_store_dir(store_dir: Path, header: DeepStoreHeader, max_store_bytes: int) -> dict[str, Any]:
+    """Create `store.json` or require the existing one to match."""
+    store_dir.mkdir(parents=True, exist_ok=True)
+    _chunks_dir(store_dir).mkdir(exist_ok=True)
+    _versions_dir(store_dir).mkdir(exist_ok=True)
+    path = _store_json_path(store_dir)
+    wanted = {
+        "format": DEEP_STORE_FORMAT, "kind": "store", "header": header.to_json_dict(),
+        "header_digest": header.digest(), "max_store_bytes": int(max_store_bytes),
+    }
+    if path.exists():
+        existing = _read_store_json(store_dir)
+        if existing["header_digest"] != wanted["header_digest"]:
+            raise ValueError(
+                f"{store_dir} already holds a deep store with a different header "
+                f"({existing['header_digest'][:16]}... vs {wanted['header_digest'][:16]}...)"
+            )
+        return existing
+    data = _canonical_json_bytes(wanted)
+    _write_bytes_once(path, data, expected_sha256=_sha256_bytes(data))
+    return wanted
+
+
+def _read_store_json(store_dir: Path) -> dict[str, Any]:
+    path = _store_json_path(store_dir)
+    if not path.is_file():
+        raise ValueError(f"{store_dir} is not a deep store (no store.json)")
+    raw = json.loads(path.read_bytes())
+    if not isinstance(raw, dict) or raw.get("format") != DEEP_STORE_FORMAT or raw.get("kind") != "store":
+        raise ValueError(f"{path} is not a {DEEP_STORE_FORMAT} store descriptor")
+    header = DeepStoreHeader.from_json_dict(raw.get("header"))
+    if raw.get("header_digest") != header.digest():
+        raise ValueError(f"{path}: header_digest does not match its header")
+    cap = raw.get("max_store_bytes")
+    if isinstance(cap, bool) or not isinstance(cap, int) or cap <= 0:
+        raise ValueError(f"{path}: max_store_bytes must be a positive integer, got {cap!r}")
+    return raw
+
+
+def _validate_block_data(
+    block: np.ndarray, header: DeepStoreHeader, geometry: GeometrySpec, mass_resolution_kg: float,
+    *, what: str,
+) -> None:
+    """The DATA check every published chunk passes: the dense MAPLE
+    validator on exactly this block (finite, nonnegative, no overfill,
+    packed bottom-up), with the case's own geometry and resolution."""
+    n = block.shape[0]
+    column = VoxelColumnState(mass_kg=block.reshape(1, n, header.n_voxels, header.n_classes))
+    try:
+        check_voxel_column_state(column, geometry, mass_resolution_kg)
+    except ValueError as exc:
+        raise ValueError(f"{what}: {exc}") from exc
+
+
+# ---------------------------------------------------------------------------
+# Journal
+# ---------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class DeepJournal:
+    """An ordered, CANONICAL set of voxel writes `(cell_flat, voxel) ->
+    values_kg[n_classes]` destined for `DeepStoreVersion.apply_journal`.
+
+    Canonical means: host arrays, `cell_flat`/`voxel` int64 and
+    `values_kg` FP64 `(n, n_classes)`, keys strictly increasing in
+    `(cell_flat, voxel)` lexicographic order (so no duplicates), every
+    value finite and nonnegative, every record's class total within the
+    MAPLE capacity tolerance. Build one with `DeepJournal.from_records`
+    (which SORTS an unsorted input and REFUSES duplicates) or
+    `empty_journal`. A journal never references a version: it is applied
+    to one.
+    """
+
+    cell_flat: np.ndarray  # (n,) int64
+    voxel: np.ndarray  # (n,) int64
+    values_kg: np.ndarray  # (n, n_classes) fp64
+    header_digest: str
+
+    @property
+    def n_records(self) -> int:
+        return int(self.cell_flat.shape[0])
+
+    @classmethod
+    def from_records(
+        cls,
+        cell_flat: Any,
+        voxel: Any,
+        values_kg: Any,
+        *,
+        header: DeepStoreHeader,
+        max_records: int = DEFAULT_MAX_JOURNAL_RECORDS,
+    ) -> DeepJournal:
+        """Validate, canonicalize (sort by `(cell_flat, voxel)`) and bind a
+        journal to `header`. Refuses before building on any violation;
+        never mutates its inputs (device inputs are copied to the host
+        through the counted `to_host`)."""
+        max_records = _require_int(max_records, "max_records", minimum=0)
+        cells = _host_int_vector(cell_flat, "cell_flat")
+        voxels = _host_int_vector(voxel, "voxel")
+        if not is_array(values_kg):
+            raise ValueError(f"values_kg must be an array, got {type(values_kg).__name__}")
+        values = to_host(values_kg)
+        n = cells.shape[0]
+        if voxels.shape[0] != n:
+            raise ValueError(f"cell_flat and voxel must have the same length, got {n} and {voxels.shape[0]}")
+        if n > max_records:
+            raise ValueError(
+                f"journal has {n} records, above max_records={max_records}; this is a hard "
+                "limit of the attempt, never silently truncated"
+            )
+        if values.ndim != 2 or values.shape != (n, header.n_classes):
+            raise ValueError(
+                f"values_kg must have shape {(n, header.n_classes)}, got {values.shape}"
+            )
+        if values.dtype != np.float64:
+            raise ValueError(f"values_kg must be float64, got {values.dtype}")
+        if n and (cells.min() < 0 or cells.max() >= header.n_cells):
+            raise ValueError(f"cell_flat out of range [0, {header.n_cells})")
+        if n and (voxels.min() < 0 or voxels.max() >= header.n_voxels):
+            raise ValueError(f"voxel out of range [0, {header.n_voxels})")
+        if not np.all(np.isfinite(values)):
+            raise ValueError("values_kg contains NaN or Inf")
+        if n and values.min() < 0.0:
+            raise ValueError("values_kg contains negative mass")
+        totals = values.sum(axis=-1)
+        capacity = header.capacity_kg
+        local_scale = np.maximum(1.0, np.maximum(totals, capacity))
+        if n and bool(np.any(~le_within_tolerance_array(totals, capacity, scale_kg=local_scale))):
+            raise ValueError("a journal record's class total exceeds the voxel capacity")
+        key = cells.astype(np.int64) * np.int64(header.n_voxels) + voxels.astype(np.int64)
+        order = np.argsort(key, kind="stable")
+        sorted_key = key[order]
+        if n > 1 and bool(np.any(np.diff(sorted_key) == 0)):
+            raise ValueError(
+                "journal contains duplicate (cell_flat, voxel) records; a journal is a SET of "
+                "final voxel values, so two writes to one voxel are ambiguous and refused"
+            )
+        return cls(
+            cell_flat=np.ascontiguousarray(cells[order], dtype=np.int64),
+            voxel=np.ascontiguousarray(voxels[order], dtype=np.int64),
+            values_kg=np.ascontiguousarray(values[order], dtype=np.float64),
+            header_digest=header.digest(),
+        )
+
+    def require_canonical(self, header: DeepStoreHeader) -> None:
+        """Re-check (cheaply) that this journal is canonical for `header`;
+        a journal built by hand or mutated after construction is refused."""
+        if self.header_digest != header.digest():
+            raise ValueError("journal is bound to a different deep-store header")
+        n = self.n_records
+        for name, arr, dtype in (("cell_flat", self.cell_flat, np.int64), ("voxel", self.voxel, np.int64)):
+            if not isinstance(arr, np.ndarray) or arr.dtype != dtype or arr.shape != (n,):
+                raise ValueError(f"journal.{name} must be a host int64 vector of length {n}")
+        if (not isinstance(self.values_kg, np.ndarray) or self.values_kg.dtype != np.float64
+                or self.values_kg.shape != (n, header.n_classes)):
+            raise ValueError(f"journal.values_kg must be a host float64 array of shape {(n, header.n_classes)}")
+        if n and (self.cell_flat.min() < 0 or self.cell_flat.max() >= header.n_cells):
+            raise ValueError(f"journal.cell_flat out of range [0, {header.n_cells})")
+        if n and (self.voxel.min() < 0 or self.voxel.max() >= header.n_voxels):
+            raise ValueError(f"journal.voxel out of range [0, {header.n_voxels})")
+        key = self.cell_flat * np.int64(header.n_voxels) + self.voxel
+        if n > 1 and bool(np.any(np.diff(key) <= 0)):
+            raise ValueError("journal records are not strictly increasing in (cell_flat, voxel)")
+        if not np.all(np.isfinite(self.values_kg)):
+            raise ValueError("journal.values_kg contains NaN or Inf")
+        if n and self.values_kg.min() < 0.0:
+            raise ValueError("journal.values_kg contains negative mass")
+
+    def canonical_bytes(self) -> bytes:
+        """The bytes hashed into the version's journal digest chain."""
+        head = _canonical_json_bytes({"n": self.n_records, "header_digest": self.header_digest})
+        return (head + b"\n" + self.cell_flat.astype("<i8").tobytes() + self.voxel.astype("<i8").tobytes()
+                + self.values_kg.astype("<f8").tobytes())
+
+
+def empty_journal(header: DeepStoreHeader) -> DeepJournal:
+    return DeepJournal(
+        cell_flat=np.zeros((0,), dtype=np.int64), voxel=np.zeros((0,), dtype=np.int64),
+        values_kg=np.zeros((0, header.n_classes), dtype=np.float64), header_digest=header.digest(),
+    )
+
+
+def _host_int_vector(value: Any, name: str) -> np.ndarray:
+    if not is_array(value):
+        raise ValueError(f"{name} must be an integer array, got {type(value).__name__}")
+    arr = to_host(value)
+    if arr.ndim != 1:
+        raise ValueError(f"{name} must be 1-D, got shape {arr.shape}")
+    if arr.dtype.kind not in "iu" or arr.dtype == np.bool_:
+        raise ValueError(f"{name} must have an integer dtype, got {arr.dtype}")
+    return arr.astype(np.int64, copy=False)
+
+
+# ---------------------------------------------------------------------------
+# Version handle
+# ---------------------------------------------------------------------------
+
+
+class DeepStoreVersion:
+    """IMMUTABLE handle to one published version. Opaque to the backend
+    tree walkers (not an array/dataclass/tuple/list/dict). Every method
+    is read-only on this version; `apply_journal` returns a NEW version.
+
+    Identity is the `manifest_digest` (content-addressed and
+    path-independent); `version_id` is the chain depth from genesis
+    (unique along one chain, not across branches). A v2 (overlay) version
+    additionally carries `logical_manifest_digest`, the digest the
+    equivalent `"full"` (v1) lineage would have; for a v1 version the two
+    are the same.
+    """
+
+    __slots__ = (
+        "_chunks",
+        "_format",
+        "_header",
+        "_journal_digest",
+        "_logical_manifest_digest",
+        "_logical_parent_manifest_digest",
+        "_manifest_digest",
+        "_mapping_cache_chunks",
+        "_memmap_lock",
+        "_memmaps",
+        "_overlay_max_bytes",
+        "_parent_manifest_digest",
+        "_parent_version_id",
+        "_slot_files",
+        "_store_dir",
+        "_version_id",
+    )
+
+    def __init__(
+        self,
+        store_dir: Path,
+        header: DeepStoreHeader,
+        *,
+        version_id: int,
+        parent_version_id: int | None,
+        parent_manifest_digest: str | None,
+        journal_digest: str,
+        manifest_digest: str,
+        chunks: tuple[DeepChunkRef, ...],
+        mapping_cache_chunks: int = DEFAULT_MAPPING_CACHE_CHUNKS,
+        slot_files: tuple[DeepSlotFiles, ...] | None = None,
+        logical_manifest_digest: str | None = None,
+        logical_parent_manifest_digest: str | None = None,
+        overlay_max_bytes: int | None = None,
+    ) -> None:
+        self._store_dir = Path(store_dir)
+        self._header = header
+        self._version_id = version_id
+        self._parent_version_id = parent_version_id
+        self._parent_manifest_digest = parent_manifest_digest
+        self._journal_digest = journal_digest
+        self._manifest_digest = manifest_digest
+        self._chunks = chunks
+        self._mapping_cache_chunks = _require_int(mapping_cache_chunks, "mapping_cache_chunks", minimum=1)
+        if slot_files is None:  # v1: the logical chunk file is the only file of each slot
+            self._format = 1
+            self._slot_files = None
+            self._logical_manifest_digest = manifest_digest
+            self._logical_parent_manifest_digest = parent_manifest_digest
+            self._overlay_max_bytes = None
+        else:
+            if len(slot_files) != len(chunks) or not _is_hex_digest(logical_manifest_digest):
+                raise ValueError("internal: v2 handle needs one slot per chunk and a logical manifest digest")
+            self._format = 2
+            self._slot_files = tuple(slot_files)
+            self._logical_manifest_digest = logical_manifest_digest
+            self._logical_parent_manifest_digest = logical_parent_manifest_digest
+            self._overlay_max_bytes = overlay_max_bytes
+        # Declared LRU of this handle's OWN mapping references (not state:
+        # two handles of one version may cache differently and agree on
+        # every byte). Insertion order = recency; see `_slot_mapping`.
+        self._memmaps: OrderedDict[int, _SlotMapping] = OrderedDict()
+        self._memmap_lock = threading.Lock()
+
+    # --- immutability of the Python object ---
+    def __setattr__(self, name: str, value: Any) -> None:
+        # `_memmap_lock` is the LAST slot `__init__` assigns; once it exists
+        # the handle is sealed. (`hasattr` on an unassigned slot is False.)
+        if hasattr(self, "_memmap_lock"):
+            raise AttributeError("DeepStoreVersion is immutable")
+        object.__setattr__(self, name, value)
+
+    def __repr__(self) -> str:
+        return (f"DeepStoreVersion(id={self._version_id}, manifest={self._manifest_digest[:12]}..., "
+                f"chunks={len(self._chunks)}, store={str(self._store_dir)!r})")
+
+    # --- properties ---
+    @property
+    def store_dir(self) -> Path:
+        return self._store_dir
+
+    @property
+    def header(self) -> DeepStoreHeader:
+        return self._header
+
+    @property
+    def version_id(self) -> int:
+        return self._version_id
+
+    @property
+    def parent_version_id(self) -> int | None:
+        return self._parent_version_id
+
+    @property
+    def parent_manifest_digest(self) -> str | None:
+        """The PHYSICAL parent manifest (what this manifest names)."""
+        return self._parent_manifest_digest
+
+    @property
+    def journal_digest(self) -> str:
+        return self._journal_digest
+
+    @property
+    def manifest_digest(self) -> str:
+        return self._manifest_digest
+
+    @property
+    def format_version(self) -> int:
+        """1 (`maple-deep-store/1`) or 2 (`maple-deep-store/2`, overlays)."""
+        return self._format
+
+    @property
+    def encoding(self) -> str:
+        """`"full"` for a v1 version, `"overlay"` for a v2 version."""
+        return "full" if self._format == 1 else "overlay"
+
+    @property
+    def overlay_max_bytes(self) -> int | None:
+        return self._overlay_max_bytes
+
+    @property
+    def logical_manifest_digest(self) -> str:
+        """Recursive logical identity: for v1 the manifest digest; for v2
+        the digest of the v1 manifest an all-`"full"` lineage of the same
+        journals would have published."""
+        return self._logical_manifest_digest
+
+    @property
+    def logical_parent_manifest_digest(self) -> str | None:
+        return self._logical_parent_manifest_digest
+
+    @property
+    def manifest_path(self) -> Path:
+        return _manifest_path(self._store_dir, self._manifest_digest)
+
+    @property
+    def chunks(self) -> tuple[DeepChunkRef, ...]:
+        """Chunk references; `sha256` is the LOGICAL chunk digest (for v1
+        also the file name)."""
+        return self._chunks
+
+    @property
+    def n_chunks(self) -> int:
+        return len(self._chunks)
+
+    def slot_files(self, index: int) -> DeepSlotFiles:
+        """The physical files of slot `index` (v1: the chunk, no overlay)."""
+        if self._slot_files is None:
+            return DeepSlotFiles(self._chunks[index].sha256, None)
+        return self._slot_files[index]
+
+    def base_path(self, index: int) -> Path:
+        return _chunk_path(self._store_dir, self.slot_files(index).base_sha256)
+
+    def overlay_path(self, index: int) -> Path | None:
+        overlay = self.slot_files(index).overlay
+        return None if overlay is None else _overlay_path(self._store_dir, overlay.sha256)
+
+    def chunk_path(self, ref: DeepChunkRef) -> Path:
+        """The raw file holding the logical chunk. Refused for an overlaid
+        v2 slot (no single file holds it; see `base_path`/`overlay_path`)."""
+        if self._slot_files is not None and self._slot_files[ref.index].overlay is not None:
+            raise ValueError(f"chunk {ref.index} is an overlaid v2 slot; no single file holds its logical bytes")
+        return _chunk_path(self._store_dir, ref.sha256)
+
+    def referenced_bytes(self) -> int:
+        """Sum of this version's chunk file sizes (shared files counted once
+        per chunk slot; identical chunks deduplicate on disk). For a v2
+        version: physical base + overlay bytes per slot."""
+        if self._slot_files is None:
+            return sum(ref.nbytes for ref in self._chunks)
+        return sum(ref.nbytes + (0 if s.overlay is None else s.overlay.nbytes)
+                   for ref, s in zip(self._chunks, self._slot_files))
+
+    def shares_chunk_with(self, other: DeepStoreVersion, index: int) -> bool:
+        """Same LOGICAL chunk bytes in slot `index` (v1: the same file)."""
+        return self._chunks[index].sha256 == other._chunks[index].sha256
+
+    # --- reads ---
+    def _slot_mapping(self, index: int) -> _SlotMapping:
+        """The read-only base mapping (and, for an overlaid v2 slot, the
+        validated overlay views) of slot `index`, from this handle's LRU
+        cache or freshly opened. Opening beyond `mapping_cache_chunks`
+        drops the cache's reference to the least recently used ENTRY;
+        nothing is closed by hand, so any view a reader still holds (and
+        any mapping an older handle caches) remains valid."""
+        with self._memmap_lock:
+            entry = self._memmaps.get(index)
+            if entry is not None:
+                self._memmaps.move_to_end(index)
+                return entry
+            ref = self._chunks[index]
+            slot = self.slot_files(index)
+            path = _chunk_path(self._store_dir, slot.base_sha256)
+            if not path.is_file():
+                raise ValueError(f"chunk {index} file is missing: {path}")
+            size = path.stat().st_size
+            if size != ref.nbytes:
+                raise ValueError(f"chunk {index} file {path} has {size} bytes, manifest says {ref.nbytes}")
+            overlay = None
+            if slot.overlay is not None:
+                overlay = _open_overlay(self._store_dir, self._header, ref, slot)
+            mm = np.memmap(path, dtype=_CHUNK_DTYPE, mode="r",
+                           shape=(ref.n_cells, self._header.n_voxels, self._header.n_classes))
+            entry = _SlotMapping(mm, overlay)
+            self._memmaps[index] = entry
+            _bump("chunk_memmaps_opened")
+            while len(self._memmaps) > self._mapping_cache_chunks:
+                self._memmaps.popitem(last=False)  # drop OUR reference only
+                _bump("chunk_memmaps_evicted")
+            return entry
+
+    def _memmap(self, index: int) -> np.memmap:
+        """The read-only mapping of chunk `index` when that file IS the
+        logical chunk (always for v1). Refused for an overlaid v2 slot so
+        that no caller can read a stale base as if it were the chunk."""
+        entry = self._slot_mapping(index)
+        if entry.overlay is not None:
+            raise ValueError(f"chunk {index} is an overlaid v2 slot; its base mapping is not the logical chunk")
+        return entry.base
+
+    def _materialize_into(self, index: int, out: np.ndarray) -> None:
+        """Write the logical chunk `index` into `out` (base copied directly
+        into the destination, then the overlay records assigned)."""
+        entry = self._slot_mapping(index)
+        np.copyto(out, entry.base)
+        if entry.overlay is not None:
+            entry.overlay.apply_all(out)
+            _bump_overlay("overlay_slot_materializations")
+
+    @property
+    def mapping_cache_chunks(self) -> int:
+        """This handle's declared cap on simultaneously cached mappings."""
+        return self._mapping_cache_chunks
+
+    @property
+    def cached_chunk_memmaps(self) -> int:
+        """Slots this handle currently caches (<= the cap). Views a caller
+        retains are the caller's, not counted here."""
+        with self._memmap_lock:
+            return len(self._memmaps)
+
+    @property
+    def mapped_bytes_cached(self) -> int:
+        """Bytes of the mappings (base + overlay) this handle currently references."""
+        with self._memmap_lock:
+            return sum(entry.nbytes for entry in self._memmaps.values())
+
+    @property
+    def mapped_bytes_bound(self) -> int:
+        """`mapping_cache_chunks * chunk_bytes_max` (v1), or `cap * (chunk_
+        bytes_max + largest overlay of this version)` (v2): the most this
+        handle's own cache can keep mapped."""
+        largest = 0
+        if self._slot_files is not None:
+            largest = max((s.overlay.nbytes for s in self._slot_files if s.overlay is not None), default=0)
+        return self._mapping_cache_chunks * (self._header.chunk_bytes_max + largest)
+
+    def with_mapping_cache(self, mapping_cache_chunks: int) -> DeepStoreVersion:
+        """The SAME version (same files, identity, provenance) through a new
+        handle with its own empty cache of the given cap. This handle and
+        its cache are untouched."""
+        return DeepStoreVersion(
+            self._store_dir, self._header, version_id=self._version_id,
+            parent_version_id=self._parent_version_id,
+            parent_manifest_digest=self._parent_manifest_digest, journal_digest=self._journal_digest,
+            manifest_digest=self._manifest_digest, chunks=self._chunks,
+            mapping_cache_chunks=mapping_cache_chunks, slot_files=self._slot_files,
+            logical_manifest_digest=None if self._slot_files is None else self._logical_manifest_digest,
+            logical_parent_manifest_digest=(None if self._slot_files is None
+                                            else self._logical_parent_manifest_digest),
+            overlay_max_bytes=self._overlay_max_bytes,
+        )
+
+    def release_mappings(self) -> int:
+        """Drop every cached mapping reference of this handle (views held
+        elsewhere stay valid). Returns the number dropped. Reads after
+        this reopen on demand."""
+        with self._memmap_lock:
+            n = len(self._memmaps)
+            self._memmaps.clear()
+        _bump("chunk_memmaps_evicted", n)
+        return n
+
+    def iter_chunks(self) -> Iterator[tuple[DeepChunkRef, np.ndarray]]:
+        """Yield `(ref, view)` for every chunk in cell order; `view` is
+        never writeable. For a v1 slot (and a v2 slot without overlay) it is
+        the READ-ONLY memmap `(n_cells, n_voxels, n_classes)`; for an
+        overlaid v2 slot it is a FRESH read-only materialized buffer of
+        `ref.nbytes` (immutable, so a retained block never changes).
+        The generator drops its own reference to a yielded buffer before
+        materializing the next one; a consumer that still holds the
+        previous block while asking for the next therefore has at most TWO
+        materialized buffers alive (bounded two-buffer overlap). A consumer
+        that collects the views owns them for as long as it keeps them;
+        this handle's own cache stays capped."""
+        for index in range(len(self._chunks)):
+            ref = self._chunks[index]
+            if self._slot_files is None or self._slot_files[index].overlay is None:
+                yield ref, self._memmap(index)
+                continue
+            block = np.empty((ref.n_cells, self._header.n_voxels, self._header.n_classes), dtype=np.float64)
+            self._materialize_into(index, block)
+            block.flags.writeable = False
+            yield ref, block
+            del block
+
+    def gather_columns(self, cells: Any, *, max_columns: int = DEFAULT_MAX_GATHER_COLUMNS) -> np.ndarray:
+        """Full logical columns `(k, n_voxels, n_classes)` host FP64 for
+        the flat cell indices `cells` (host or device integer array; a
+        device input is brought over by the counted `to_host`). A FRESH
+        array, never a view of the file. Refuses BEFORE allocating when
+        `k > max_columns`. Duplicated cells are allowed (reads only). For an
+        overlaid slot only the requested cells' base rows and their own
+        overlay records are read."""
+        max_columns = _require_int(max_columns, "max_columns", minimum=1)
+        idx = _host_int_vector(cells, "cells")
+        k = idx.shape[0]
+        if k > max_columns:
+            raise ValueError(
+                f"gather_columns: {k} cells requested, above max_columns={max_columns} "
+                f"({k * self._header.column_bytes} bytes would be allocated); gather in bounded batches"
+            )
+        if k and (idx.min() < 0 or idx.max() >= self._header.n_cells):
+            raise ValueError(f"gather_columns: cell index out of range [0, {self._header.n_cells})")
+        out = np.empty((k, self._header.n_voxels, self._header.n_classes), dtype=np.float64)
+        if k:
+            chunk_of = idx // self._header.chunk_columns
+            for chunk_index in np.unique(chunk_of):
+                sel = np.flatnonzero(chunk_of == chunk_index)
+                local = idx[sel] - self._chunks[int(chunk_index)].cell_start
+                entry = self._slot_mapping(int(chunk_index))
+                out[sel] = entry.base[local]
+                if entry.overlay is not None:
+                    entry.overlay.apply_rows(out, sel, local)
+        _bump("gather_calls")
+        _bump("columns_read", k)
+        _bump("bytes_read", k * self._header.column_bytes)
+        return out
+
+    def to_dense(self, *, max_bytes: int) -> np.ndarray:
+        """The full `(ny, nx, n_voxels, n_classes)` host array -- ONLY when
+        it fits the caller's explicit `max_bytes`, checked BEFORE the
+        allocation. For small differential tests; never a production path."""
+        max_bytes = _require_int(max_bytes, "max_bytes", minimum=1)
+        need = self._header.logical_bytes
+        if need > max_bytes:
+            raise ValueError(
+                f"to_dense refused: the dense array needs {need} bytes, above max_bytes={max_bytes}; "
+                "use gather_columns / iter_chunks for bounded access"
+            )
+        h = self._header
+        out = np.empty((h.n_cells, h.n_voxels, h.n_classes), dtype=np.float64)
+        for index, ref in enumerate(self._chunks):
+            self._materialize_into(index, out[ref.cell_start:ref.cell_start + ref.n_cells])
+            _bump("columns_read", ref.n_cells)
+            _bump("bytes_read", ref.nbytes)
+        return out.reshape(h.ny, h.nx, h.n_voxels, h.n_classes)
+
+    # --- writes (copy-on-write; this version is unchanged) ---
+    def apply_journal(
+        self,
+        journal: DeepJournal,
+        geometry: GeometrySpec,
+        mass_resolution_kg: float,
+        *,
+        max_records: int = DEFAULT_MAX_JOURNAL_RECORDS,
+        encoding: str = "full",
+        overlay_max_bytes: int | None = None,
+    ) -> DeepStoreVersion:
+        """Publish a NEW version equal to this one with every journal record
+        written in. This version, its files and the journal are not
+        modified.
+
+        NO-OP FAST PATH: a journal with zero records, once it has passed
+        the same validation as any other (header binding, canonical
+        dtypes/shapes, geometry binding, encoding options), returns THIS
+        EXACT handle: no store descriptor read, no directory scan, no file,
+        no new version and no journal-digest advance. A step whose window
+        changed but whose deep region did not therefore costs the store
+        nothing. An INVALID empty journal (wrong header, wrong dtype, wrong
+        class count) or an invalid encoding option is still refused before
+        the identity return.
+
+        Order of operations for a nonempty journal: validate the journal
+        (canonical, bounded, finite, nonnegative, capacity) -> refuse if
+        the touched chunks' bytes would exceed the store's
+        `max_store_bytes` (one directory scan; the active-journal cap is
+        kept) -> pass 1: for
+        each touched chunk, copy ONE chunk, write the records, run the
+        dense MAPLE data validator, discard -> pass 2: copy/write/seal/
+        publish each touched chunk file (temp + atomic replace,
+        deduplicated by content) -> write the manifest. A refusal in the
+        validation passes leaves no new file; an I/O failure in pass 2
+        can leave orphan content-addressed chunk files (never a manifest),
+        which is reported by `deep_store_report` and reclaimable by the
+        deferred explicit collection, never silently.
+
+        `encoding="full"` (default) is the unchanged v1 publication and is
+        REFUSED on a v2 parent. `encoding="overlay"` publishes a v2
+        manifest (module docstring); `overlay_max_bytes` (optional, only
+        with `"overlay"`) caps every slot's overlay below the default
+        fraction of the slot's raw bytes.
+        """
+        if not isinstance(journal, DeepJournal):
+            raise ValueError(f"apply_journal expects a DeepJournal, got {type(journal).__name__}")
+        max_records = _require_int(max_records, "max_records", minimum=0)
+        encoding, overlay_max_bytes = _resolve_encoding(encoding, overlay_max_bytes, self._header,
+                                                        operation="apply_journal")
+        journal.require_canonical(self._header)
+        if journal.n_records > max_records:
+            raise ValueError(f"journal has {journal.n_records} records, above max_records={max_records}")
+        self._header.require_geometry(geometry, operation="apply_journal")
+        h = self._header
+        if journal.n_records == 0:
+            return self  # exact identity: nothing to write, nothing scanned, nothing published
+        if encoding == "overlay":
+            return self._apply_journal_overlay(journal, geometry, mass_resolution_kg, overlay_max_bytes)
+        if self._format != 1:
+            raise ValueError(
+                "apply_journal refused: encoding='full' (v1) publication on a v2 overlay parent would hash a "
+                "physical v2 parent into a v1 manifest; a lineage that uses overlays stays v2. Nothing was written."
+            )
+        store = _read_store_json(self._store_dir)
+        cap = int(store["max_store_bytes"])
+
+        touched = np.unique(journal.cell_flat // h.chunk_columns)
+        new_bytes = sum(self._chunks[int(i)].nbytes for i in touched)
+        on_disk, _, _ = _scan_store_bytes(self._store_dir)
+        # CW-B106C1: the inherited `256 + 192 * n_chunks` under-bounds small
+        # shapes (the header JSON alone exceeds it); take the larger of it
+        # and the exact canonical size of this publication's v1 manifest
+        # (64-hex placeholders for the new digests, all integers known).
+        manifest_estimate = max(256 + 192 * h.n_chunks, self._full_manifest_size(touched))
+        if on_disk + new_bytes + manifest_estimate > cap:
+            raise ValueError(
+                f"apply_journal refused: publishing {len(touched)} chunk file(s) ({new_bytes} bytes) "
+                f"would raise the store from {on_disk} bytes above max_store_bytes={cap}; run the "
+                "explicit collection of unreferenced chunk files or raise the cap. Nothing was written."
+            )
+
+        # Pass 1: data validation of every modified chunk, one buffer at a time.
+        for chunk_index in touched:
+            buffer = self._modified_chunk_copy(int(chunk_index), journal)
+            _validate_block_data(buffer, h, geometry, mass_resolution_kg,
+                                 what=f"apply_journal: chunk {int(chunk_index)} after the journal")
+            del buffer
+
+        # Pass 2: seal and publish.
+        new_refs = list(self._chunks)
+        for chunk_index in touched:
+            buffer = self._modified_chunk_copy(int(chunk_index), journal)
+            new_refs[int(chunk_index)] = _seal_chunk(self._store_dir, buffer, self._chunks[int(chunk_index)])
+            del buffer
+
+        journal_digest = _sha256_bytes(bytes.fromhex(self._journal_digest) + journal.canonical_bytes())
+        return _publish_version(
+            self._store_dir, h, chunks=tuple(new_refs), version_id=self._version_id + 1,
+            parent_version_id=self._version_id, parent_manifest_digest=self._manifest_digest,
+            journal_digest=journal_digest, mapping_cache_chunks=self._mapping_cache_chunks,
+        )
+
+    def _full_manifest_size(self, touched: np.ndarray) -> int:
+        """EXACT byte size of the v1 manifest this `"full"` publication will
+        write: every field is known before any data read except the touched
+        chunks' digests and the journal digest, which are always 64 hex
+        characters (placeholders of the same length)."""
+        zero = "0" * 64
+        refs = list(self._chunks)
+        for i in touched:
+            ref = refs[int(i)]
+            refs[int(i)] = DeepChunkRef(ref.index, ref.cell_start, ref.n_cells, zero, ref.nbytes)
+        return len(_canonical_json_bytes(_v1_manifest_object(
+            self._header, chunks=tuple(refs), version_id=self._version_id + 1,
+            parent_version_id=self._version_id, parent_manifest_digest=self._manifest_digest, journal_digest=zero,
+        )))
+
+    def _modified_chunk_copy(self, chunk_index: int, journal: DeepJournal) -> np.ndarray:
+        ref = self._chunks[chunk_index]
+        buffer = np.empty((ref.n_cells, self._header.n_voxels, self._header.n_classes), dtype=np.float64)
+        self._materialize_into(chunk_index, buffer)
+        _bump("columns_read", ref.n_cells)
+        _bump("bytes_read", ref.nbytes)
+        lo, hi = _journal_slot_bounds(journal, ref)
+        if hi > lo:
+            buffer[journal.cell_flat[lo:hi] - ref.cell_start, journal.voxel[lo:hi]] = journal.values_kg[lo:hi]
+        return buffer
+
+    # --- overlay publication (CW-B106) ---
+    def _overlay_slot_state(self, index: int, journal: DeepJournal) -> tuple[np.ndarray, np.ndarray]:
+        """`(buffer, keys)`: the materialized slot after this journal (base
+        copied straight into the one buffer, old overlay then this slot's
+        journal records assigned -- journal wins) and the sorted unique
+        merged slot-local keys `local_cell * n_voxels + voxel` (old overlay
+        keys UNION this journal's keys; nothing dropped)."""
+        h = self._header
+        ref = self._chunks[index]
+        lo, hi = _journal_slot_bounds(journal, ref)
+        buffer = np.empty((ref.n_cells, h.n_voxels, h.n_classes), dtype=np.float64)
+        self._materialize_into(index, buffer)
+        _bump("columns_read", ref.n_cells)
+        _bump("bytes_read", ref.nbytes)
+        local = journal.cell_flat[lo:hi] - ref.cell_start
+        buffer[local, journal.voxel[lo:hi]] = journal.values_kg[lo:hi]
+        new_keys = local * np.int64(h.n_voxels) + journal.voxel[lo:hi]
+        overlay = self._slot_mapping(index).overlay
+        if overlay is None:
+            keys = new_keys  # canonical journal: already strictly increasing
+        else:
+            keys = np.union1d(overlay.local_keys(h.n_voxels), new_keys)
+        return buffer, keys
+
+    def _overlay_v2_slots(self) -> tuple[DeepSlotFiles, ...]:
+        if self._slot_files is not None:
+            return self._slot_files
+        return tuple(DeepSlotFiles(ref.sha256, None) for ref in self._chunks)
+
+    def _overlay_manifest_bound(self, touched: np.ndarray, overlay_max_bytes: int | None) -> int:
+        """PROVED upper bound on the v2 manifest size: the exact canonical
+        serialization of this publication's manifest in which every touched
+        slot carries an overlay entry with the LARGEST possible integers
+        (`nbytes` = the slot bound, `n_records` = cells * voxels) and every
+        digest a 64-hex placeholder. The actual manifest differs only in
+        digest VALUES (same length), in integers with no more digits, or in
+        `null` instead of an overlay object (shorter); every untouched
+        entry is serialized exactly. Bounded metadata only."""
+        h = self._header
+        zero = "0" * 64
+        slots = self._overlay_v2_slots()
+        chunk_json = [_v2_chunk_json(ref, slot) for ref, slot in zip(self._chunks, slots)]
+        for i in touched:
+            ref = self._chunks[int(i)]
+            chunk_json[int(i)] = {
+                "index": ref.index, "cell_start": ref.cell_start, "n_cells": ref.n_cells, "nbytes": ref.nbytes,
+                "logical_sha256": zero, "base_sha256": zero,
+                "overlay": {"sha256": zero, "nbytes": overlay_slot_bound_bytes(ref.nbytes, overlay_max_bytes),
+                            "n_records": ref.n_cells * h.n_voxels},
+            }
+        manifest = _v2_manifest_object(
+            h, chunk_json=chunk_json, version_id=self._version_id + 1, parent_version_id=self._version_id,
+            parent_manifest_digest=self._manifest_digest, journal_digest=zero,
+            overlay_max_bytes=overlay_max_bytes, logical_parent_manifest_digest=zero,
+            logical_manifest_digest=zero,
+        )
+        return len(_canonical_json_bytes(manifest))
+
+    def _apply_journal_overlay(self, journal: DeepJournal, geometry: GeometrySpec, mass_resolution_kg: float,
+                               overlay_max_bytes: int | None) -> DeepStoreVersion:
+        h = self._header
+        store = _read_store_json(self._store_dir)
+        cap = int(store["max_store_bytes"])
+        touched = np.unique(journal.cell_flat // h.chunk_columns)
+        # Conservative: each touched slot emits an overlay (<= its bound <
+        # its raw bytes) or a keyframe (= its raw bytes).
+        new_bytes = sum(self._chunks[int(i)].nbytes for i in touched)
+        on_disk, _, _ = _scan_store_bytes(self._store_dir)
+        manifest_estimate = self._overlay_manifest_bound(touched, overlay_max_bytes)
+        if on_disk + new_bytes + manifest_estimate > cap:
+            raise ValueError(
+                f"apply_journal refused: publishing {len(touched)} chunk file(s) ({new_bytes} bytes) "
+                f"would raise the store from {on_disk} bytes above max_store_bytes={cap}; run the "
+                "explicit collection of unreferenced chunk files or raise the cap. Nothing was written."
+            )
+        slots = self._overlay_v2_slots()
+
+        # Pass 1: validate EVERY touched slot and plan it; no file is written.
+        plan: list[tuple[int, bool, int, str]] = []  # (index, as_overlay, n_records, logical_sha256)
+        for chunk_index in touched:
+            index = int(chunk_index)
+            buffer, keys = self._overlay_slot_state(index, journal)
+            _validate_block_data(buffer, h, geometry, mass_resolution_kg,
+                                 what=f"apply_journal: chunk {index} after the journal")
+            ref = self._chunks[index]
+            as_overlay = (overlay_file_nbytes(ref.n_cells, keys.shape[0], h.n_classes)
+                          <= overlay_slot_bound_bytes(ref.nbytes, overlay_max_bytes))
+            plan.append((index, as_overlay, int(keys.shape[0]), _sha256_bytes(memoryview(buffer).cast("B"))))
+            del buffer, keys
+
+        # Pass 2: emit (overlay or keyframe), re-deriving and REQUIRING the plan.
+        new_refs = list(self._chunks)
+        new_slots = list(slots)
+        for index, as_overlay, n_records, logical in plan:
+            buffer, keys = self._overlay_slot_state(index, journal)
+            ref = self._chunks[index]
+            again = (overlay_file_nbytes(ref.n_cells, keys.shape[0], h.n_classes)
+                     <= overlay_slot_bound_bytes(ref.nbytes, overlay_max_bytes))
+            if (again != as_overlay or int(keys.shape[0]) != n_records
+                    or _sha256_bytes(memoryview(buffer).cast("B")) != logical):
+                raise RuntimeError(f"apply_journal: chunk {index} changed between validation and emission")
+            if as_overlay:
+                base = slots[index].base_sha256
+                data = _encode_overlay(h, ref, base_sha256=base, logical_sha256=logical, keys=keys, buffer=buffer)
+                digest = _sha256_bytes(data)
+                written = _write_bytes_once(_overlay_path(self._store_dir, digest), data, expected_sha256=digest)
+                _bump("bytes_written", written)
+                _bump_overlay("overlay_files_written" if written else "overlay_files_deduplicated")
+                _bump_overlay("overlay_bytes_written", written)
+                new_slots[index] = DeepSlotFiles(base, DeepOverlayRef(digest, len(data), n_records))
+                del data
+            else:
+                sealed = _seal_chunk(self._store_dir, buffer, ref)
+                _bump_overlay("keyframes_sealed")
+                new_slots[index] = DeepSlotFiles(sealed.sha256, None)
+            new_refs[index] = DeepChunkRef(index, ref.cell_start, ref.n_cells, logical, ref.nbytes)
+            del buffer, keys
+
+        journal_digest = _sha256_bytes(bytes.fromhex(self._journal_digest) + journal.canonical_bytes())
+        version = _publish_version_v2(
+            self._store_dir, h, chunks=tuple(new_refs), slots=tuple(new_slots), version_id=self._version_id + 1,
+            parent_version_id=self._version_id, parent_manifest_digest=self._manifest_digest,
+            logical_parent_manifest_digest=self._logical_manifest_digest, journal_digest=journal_digest,
+            overlay_max_bytes=overlay_max_bytes, mapping_cache_chunks=self._mapping_cache_chunks,
+        )
+        _bump_overlay("overlay_publications")
+        return version
+
+
+def _journal_slot_bounds(journal: DeepJournal, ref: DeepChunkRef) -> tuple[int, int]:
+    """`[lo, hi)` of the records of slot `ref` in a CANONICAL journal (keys
+    strictly increasing in `(cell_flat, voxel)`, checked by
+    `require_canonical` before any caller): two binary searches instead of a
+    whole-journal mask. Exactly the records `cell_start <= cell_flat <
+    cell_start + n_cells`, in journal order; `lo == hi` for an empty range."""
+    lo = int(np.searchsorted(journal.cell_flat, ref.cell_start, side="left"))
+    hi = int(np.searchsorted(journal.cell_flat, ref.cell_start + ref.n_cells, side="left"))
+    return lo, hi
+
+
+def _seal_chunk(store_dir: Path, buffer: np.ndarray, like: DeepChunkRef) -> DeepChunkRef:
+    """Digest a contiguous chunk buffer (no copy), publish it as a
+    content-addressed read-only file, return its reference."""
+    if not buffer.flags.c_contiguous or buffer.dtype != np.float64:
+        buffer = np.ascontiguousarray(buffer, dtype=np.float64)
+    view = memoryview(buffer).cast("B")
+    digest = _sha256_bytes(view)
+    written = _write_bytes_once(_chunk_path(store_dir, digest), view, expected_sha256=digest)
+    _bump("chunks_sealed")
+    _bump("bytes_written", written)
+    return DeepChunkRef(like.index, like.cell_start, like.n_cells, digest, buffer.nbytes)
+
+
+def _v1_manifest_object(
+    header: DeepStoreHeader,
+    *,
+    chunks: tuple[DeepChunkRef, ...],
+    version_id: int,
+    parent_version_id: int | None,
+    parent_manifest_digest: str | None,
+    journal_digest: str,
+) -> dict[str, Any]:
+    return {
+        "format": DEEP_STORE_FORMAT, "kind": "version", "header": header.to_json_dict(),
+        "header_digest": header.digest(), "version_id": int(version_id),
+        "parent_version_id": parent_version_id, "parent_manifest_digest": parent_manifest_digest,
+        "journal_digest": journal_digest, "chunks": [ref.to_json_dict() for ref in chunks],
+    }
+
+
+def _v2_manifest_object(
+    header: DeepStoreHeader,
+    *,
+    chunk_json: list[dict[str, Any]],
+    version_id: int,
+    parent_version_id: int | None,
+    parent_manifest_digest: str | None,
+    journal_digest: str,
+    overlay_max_bytes: int | None,
+    logical_parent_manifest_digest: str | None,
+    logical_manifest_digest: str,
+) -> dict[str, Any]:
+    return {
+        "format": DEEP_STORE_FORMAT_V2, "kind": "version", "header": header.to_json_dict(),
+        "header_digest": header.digest(), "version_id": int(version_id),
+        "parent_version_id": parent_version_id, "parent_manifest_digest": parent_manifest_digest,
+        "journal_digest": journal_digest, "chunks": chunk_json, "encoding": "overlay",
+        "overlay_max_bytes": overlay_max_bytes,
+        "logical_parent_manifest_digest": logical_parent_manifest_digest,
+        "logical_manifest_digest": logical_manifest_digest,
+    }
+
+
+def _logical_manifest_digest(
+    header: DeepStoreHeader,
+    *,
+    chunks: tuple[DeepChunkRef, ...],
+    version_id: int,
+    parent_version_id: int | None,
+    logical_parent_manifest_digest: str | None,
+    journal_digest: str,
+) -> str:
+    """L(V) of a v2 version: the digest of the canonical v1 manifest with
+    LOGICAL chunk digests and the LOGICAL parent digest (recursive)."""
+    return _sha256_bytes(_canonical_json_bytes(_v1_manifest_object(
+        header, chunks=chunks, version_id=version_id, parent_version_id=parent_version_id,
+        parent_manifest_digest=logical_parent_manifest_digest, journal_digest=journal_digest,
+    )))
+
+
+def _publish_version(
+    store_dir: Path,
+    header: DeepStoreHeader,
+    *,
+    chunks: tuple[DeepChunkRef, ...],
+    version_id: int,
+    parent_version_id: int | None,
+    parent_manifest_digest: str | None,
+    journal_digest: str,
+    mapping_cache_chunks: int = DEFAULT_MAPPING_CACHE_CHUNKS,
+) -> DeepStoreVersion:
+    manifest = _v1_manifest_object(
+        header, chunks=chunks, version_id=version_id, parent_version_id=parent_version_id,
+        parent_manifest_digest=parent_manifest_digest, journal_digest=journal_digest,
+    )
+    data = _canonical_json_bytes(manifest)
+    digest = _sha256_bytes(data)
+    written = _write_bytes_once(_manifest_path(store_dir, digest), data, expected_sha256=digest)
+    _bump("bytes_written", written)
+    _bump("versions_published")
+    return DeepStoreVersion(
+        store_dir, header, version_id=version_id, parent_version_id=parent_version_id,
+        parent_manifest_digest=parent_manifest_digest, journal_digest=journal_digest,
+        manifest_digest=digest, chunks=chunks, mapping_cache_chunks=mapping_cache_chunks,
+    )
+
+
+def _publish_version_v2(
+    store_dir: Path,
+    header: DeepStoreHeader,
+    *,
+    chunks: tuple[DeepChunkRef, ...],
+    slots: tuple[DeepSlotFiles, ...],
+    version_id: int,
+    parent_version_id: int,
+    parent_manifest_digest: str,
+    logical_parent_manifest_digest: str,
+    journal_digest: str,
+    overlay_max_bytes: int | None,
+    mapping_cache_chunks: int = DEFAULT_MAPPING_CACHE_CHUNKS,
+) -> DeepStoreVersion:
+    logical = _logical_manifest_digest(
+        header, chunks=chunks, version_id=version_id, parent_version_id=parent_version_id,
+        logical_parent_manifest_digest=logical_parent_manifest_digest, journal_digest=journal_digest,
+    )
+    manifest = _v2_manifest_object(
+        header, chunk_json=[_v2_chunk_json(ref, slot) for ref, slot in zip(chunks, slots)],
+        version_id=version_id, parent_version_id=parent_version_id,
+        parent_manifest_digest=parent_manifest_digest, journal_digest=journal_digest,
+        overlay_max_bytes=overlay_max_bytes, logical_parent_manifest_digest=logical_parent_manifest_digest,
+        logical_manifest_digest=logical,
+    )
+    data = _canonical_json_bytes(manifest)
+    digest = _sha256_bytes(data)
+    written = _write_bytes_once(_manifest_path(store_dir, digest), data, expected_sha256=digest)
+    _bump("bytes_written", written)
+    _bump("versions_published")
+    return DeepStoreVersion(
+        store_dir, header, version_id=version_id, parent_version_id=parent_version_id,
+        parent_manifest_digest=parent_manifest_digest, journal_digest=journal_digest,
+        manifest_digest=digest, chunks=chunks, mapping_cache_chunks=mapping_cache_chunks,
+        slot_files=slots, logical_manifest_digest=logical,
+        logical_parent_manifest_digest=logical_parent_manifest_digest, overlay_max_bytes=overlay_max_bytes,
+    )
+
+
+def _genesis_journal_digest(header: DeepStoreHeader) -> str:
+    return _sha256_bytes(b"maple-deep-store/1:genesis:" + header.digest().encode("ascii"))
+
+
+# ---------------------------------------------------------------------------
+# Streaming builder (version 0 of a store)
+# ---------------------------------------------------------------------------
+
+
+class DeepStoreBuilder:
+    """Build the genesis version of a store from a STREAM of column blocks
+    in cell order, holding at most ONE chunk buffer in memory.
+
+    Feed `add_columns(block)` with host (or device) blocks `(k, n_voxels,
+    n_classes)` FP64 -- row bands, tiles already flattened to cell order,
+    or any bounded block -- until exactly `header.n_cells` columns have
+    arrived, then `finish()`. Every block is validated with the dense MAPLE
+    validator (finite, nonnegative, no overfill, packed) BEFORE it enters
+    the buffer, so no invalid column is ever sealed. A refusal leaves the
+    store's existing versions intact; chunk files sealed before a later
+    refusal remain as content-addressed orphans (no manifest references
+    them) and are reported, never silently discarded or deleted here.
+    """
+
+    def __init__(
+        self,
+        store_dir: str | Path,
+        header: DeepStoreHeader,
+        geometry: GeometrySpec,
+        mass_resolution_kg: float,
+        *,
+        max_store_bytes: int,
+        mapping_cache_chunks: int = DEFAULT_MAPPING_CACHE_CHUNKS,
+    ) -> None:
+        if not isinstance(header, DeepStoreHeader):
+            raise ValueError("header must be a DeepStoreHeader")
+        header.require_geometry(geometry, operation="DeepStoreBuilder")
+        self._store_dir = Path(store_dir)
+        self._header = header
+        self._geometry = geometry
+        self._mass_resolution_kg = float(mass_resolution_kg)
+        self._max_store_bytes = _require_int(max_store_bytes, "max_store_bytes", minimum=1)
+        self._mapping_cache_chunks = _require_int(mapping_cache_chunks, "mapping_cache_chunks", minimum=1)
+        if header.logical_bytes > self._max_store_bytes:
+            raise ValueError(
+                f"max_store_bytes={self._max_store_bytes} cannot hold even the genesis version "
+                f"({header.logical_bytes} bytes)"
+            )
+        descriptor = _init_store_dir(self._store_dir, header, self._max_store_bytes)
+        # S1 correction 2: the PERSISTENT quota recorded in `store.json` is
+        # immutable and binds every builder that reopens the store; the
+        # caller's argument can only be STRICTER. A new store records the
+        # caller's quota, so the two agree there. (`apply_journal` reads the
+        # descriptor quota directly and `export_version` already takes the
+        # minimum of the destination descriptor and an explicit bound.)
+        self._persistent_max_store_bytes = int(descriptor["max_store_bytes"])
+        self._max_store_bytes = min(self._max_store_bytes, self._persistent_max_store_bytes)
+        if header.logical_bytes > self._max_store_bytes:
+            raise ValueError(
+                f"max_store_bytes={self._max_store_bytes} (the store's persistent quota, "
+                f"{self._persistent_max_store_bytes}, bounded by the caller's) cannot hold even the "
+                f"genesis version ({header.logical_bytes} bytes)"
+            )
+        self._on_disk, _, _ = _scan_store_bytes(self._store_dir)
+        self._buffer = np.empty((header.chunk_columns, header.n_voxels, header.n_classes), dtype=np.float64)
+        self._buffered = 0
+        self._cells_added = 0
+        self._refs: list[DeepChunkRef] = []
+        self._finished = False
+
+    @property
+    def cells_added(self) -> int:
+        return self._cells_added
+
+    @property
+    def chunk_buffer_bytes(self) -> int:
+        """The ONE transient buffer this builder owns."""
+        return int(self._buffer.nbytes)
+
+    def add_columns(self, block: Any) -> None:
+        if self._finished:
+            raise ValueError("DeepStoreBuilder already finished")
+        h = self._header
+        if not is_array(block):
+            raise ValueError(f"block must be an array, got {type(block).__name__}")
+        if is_device_array(block):
+            block = to_host(block)  # one counted D2H of this block only
+        if block.ndim != 3 or block.shape[1:] != (h.n_voxels, h.n_classes):
+            raise ValueError(
+                f"block must have shape (k, {h.n_voxels}, {h.n_classes}), got {block.shape}"
+            )
+        if block.dtype != np.float64:
+            raise ValueError(f"block must be float64, got {block.dtype}")
+        k = int(block.shape[0])
+        if k == 0:
+            return
+        if self._cells_added + k > h.n_cells:
+            raise ValueError(
+                f"block of {k} columns would exceed the store's {h.n_cells} cells "
+                f"({self._cells_added} already added)"
+            )
+        block = np.ascontiguousarray(block)
+        _validate_block_data(block, h, self._geometry, self._mass_resolution_kg,
+                             what=f"DeepStoreBuilder block at cell {self._cells_added}")
+        offset = 0
+        while offset < k:
+            room = h.chunk_columns - self._buffered
+            take = min(room, k - offset)
+            self._buffer[self._buffered:self._buffered + take] = block[offset:offset + take]
+            self._buffered += take
+            offset += take
+            self._cells_added += take
+            if self._buffered == h.chunk_columns:
+                self._seal_current()
+
+    def _seal_current(self) -> None:
+        h = self._header
+        index = len(self._refs)
+        start, n_cells = h.chunk_extent(index)
+        if n_cells != self._buffered:
+            raise ValueError(f"internal: chunk {index} expects {n_cells} columns, buffered {self._buffered}")
+        nbytes = n_cells * h.column_bytes
+        if self._on_disk + nbytes > self._max_store_bytes:
+            raise ValueError(
+                f"DeepStoreBuilder refused: sealing chunk {index} ({nbytes} bytes) would raise the "
+                f"store from {self._on_disk} bytes above max_store_bytes={self._max_store_bytes}"
+            )
+        like = DeepChunkRef(index, start, n_cells, "", nbytes)
+        ref = _seal_chunk(self._store_dir, self._buffer[:n_cells], like)
+        self._on_disk += ref.nbytes
+        self._refs.append(ref)
+        self._buffered = 0
+
+    def finish(self) -> DeepStoreVersion:
+        if self._finished:
+            raise ValueError("DeepStoreBuilder already finished")
+        h = self._header
+        if self._cells_added != h.n_cells:
+            raise ValueError(
+                f"DeepStoreBuilder.finish: {self._cells_added} of {h.n_cells} columns were added; "
+                "a version must hold every logical column (nothing is zero-filled implicitly)"
+            )
+        if self._buffered:
+            self._seal_current()
+        if len(self._refs) != h.n_chunks:
+            raise ValueError(f"internal: sealed {len(self._refs)} chunks, expected {h.n_chunks}")
+        # S1 correction 2: the genesis manifest counts against the quota exactly
+        # like a journal publication's manifest does (`apply_journal`); its size
+        # is known exactly here (every chunk digest is sealed). A refusal leaves
+        # the sealed chunks as reported orphans and publishes no manifest, so no
+        # accepted version ever exceeds the persistent quota. A manifest that
+        # already exists (an identical genesis republished) costs nothing.
+        genesis_digest = _genesis_journal_digest(h)
+        manifest_bytes = _canonical_json_bytes(_v1_manifest_object(
+            h, chunks=tuple(self._refs), version_id=0, parent_version_id=None,
+            parent_manifest_digest=None, journal_digest=genesis_digest,
+        ))
+        if (not _manifest_path(self._store_dir, _sha256_bytes(manifest_bytes)).exists()
+                and self._on_disk + len(manifest_bytes) > self._max_store_bytes):
+            raise ValueError(
+                f"DeepStoreBuilder refused: publishing the genesis manifest ({len(manifest_bytes)} bytes) "
+                f"would raise the store from {self._on_disk} bytes above max_store_bytes="
+                f"{self._max_store_bytes} (persistent quota {self._persistent_max_store_bytes}); the "
+                "sealed chunk files remain as reported orphans and no version was published"
+            )
+        self._finished = True
+        version = _publish_version(
+            self._store_dir, h, chunks=tuple(self._refs), version_id=0, parent_version_id=None,
+            parent_manifest_digest=None, journal_digest=genesis_digest,
+            mapping_cache_chunks=self._mapping_cache_chunks,
+        )
+        self._buffer = np.empty((0, h.n_voxels, h.n_classes), dtype=np.float64)
+        return version
+
+
+def build_deep_store_from_blocks(
+    store_dir: str | Path,
+    header: DeepStoreHeader,
+    blocks: Iterable[Any],
+    geometry: GeometrySpec,
+    mass_resolution_kg: float,
+    *,
+    max_store_bytes: int,
+    mapping_cache_chunks: int = DEFAULT_MAPPING_CACHE_CHUNKS,
+) -> DeepStoreVersion:
+    """`DeepStoreBuilder` over an iterable of blocks in cell order."""
+    builder = DeepStoreBuilder(store_dir, header, geometry, mass_resolution_kg,
+                               max_store_bytes=max_store_bytes, mapping_cache_chunks=mapping_cache_chunks)
+    for block in blocks:
+        builder.add_columns(block)
+    return builder.finish()
+
+
+# ---------------------------------------------------------------------------
+# Load / export / report
+# ---------------------------------------------------------------------------
+
+
+def load_version(
+    store_dir: str | Path,
+    manifest_digest: str,
+    *,
+    geometry: GeometrySpec,
+    mass_resolution_kg: float,
+    class_ids: Iterable[str] | None = None,
+    expected_header_digest: str | None = None,
+    verify_data: bool = True,
+    mapping_cache_chunks: int = DEFAULT_MAPPING_CACHE_CHUNKS,
+    check_parent_lineage: bool = False,
+) -> DeepStoreVersion:
+    """Rebuild a version handle from its content-addressed manifest and
+    REFUSE before returning anything usable if any of these fail:
+    manifest bytes hash to `manifest_digest`; format/kind; header parses
+    and binds to `geometry` (and to `class_ids` / `expected_header_digest`
+    when given); the store descriptor's header matches; the chunk table
+    covers every cell exactly once; EVERY chunk file exists with the
+    recorded size and SHA-256 (streamed read); and, with `verify_data`
+    (default), every chunk passes the dense MAPLE data validator.
+    `verify_data=False` is for callers that will run the trusted-boundary
+    column validation themselves immediately afterwards.
+
+    A v2 (overlay) manifest additionally proves LOCAL integrity without
+    any ancestor: its stored `logical_manifest_digest` is recomputed from
+    its own fields, every base and overlay file is size/SHA-256 verified
+    (each distinct file once), every overlay passes the structural guards
+    before it is applied, and EVERY overlaid slot's materialization hashes
+    to its recorded logical digest (regardless of `verify_data`). Lineage
+    beyond this manifest is NOT proved by default: `check_parent_lineage=
+    True` additionally requires the immediate parent manifest to be present
+    and hash-valid with the matching header, `version_id - 1` and logical
+    digest (one level; parent chunk files are not read)."""
+    store_dir = Path(store_dir)
+    if not _is_hex_digest(manifest_digest):
+        raise ValueError("manifest_digest must be a 64-hex SHA-256 digest")
+    path = _manifest_path(store_dir, manifest_digest)
+    if not path.is_file():
+        raise ValueError(f"no manifest {manifest_digest} in {store_dir}")
+    data = path.read_bytes()
+    if _sha256_bytes(data) != manifest_digest:
+        raise ValueError(f"manifest {path} does not hash to its own name; refused (tampered or corrupt)")
+    raw = json.loads(data)
+    if (not isinstance(raw, dict) or raw.get("format") not in (DEEP_STORE_FORMAT, DEEP_STORE_FORMAT_V2)
+            or raw.get("kind") != "version"):
+        raise ValueError(f"{path} is not a {DEEP_STORE_FORMAT} (or {DEEP_STORE_FORMAT_V2}) version manifest")
+    v2 = raw["format"] == DEEP_STORE_FORMAT_V2
+    expected_keys = {"format", "kind", "header", "header_digest", "version_id", "parent_version_id",
+                     "parent_manifest_digest", "journal_digest", "chunks"}
+    if v2:
+        expected_keys |= {"encoding", "overlay_max_bytes", "logical_parent_manifest_digest",
+                          "logical_manifest_digest"}
+    if set(raw) != expected_keys:
+        raise ValueError(f"{path}: manifest keys {sorted(raw)} != {sorted(expected_keys)}")
+    header = DeepStoreHeader.from_json_dict(raw["header"])
+    if raw["header_digest"] != header.digest():
+        raise ValueError(f"{path}: header_digest does not match its header")
+    if expected_header_digest is not None and header.digest() != expected_header_digest:
+        raise ValueError(f"{path}: header digest {header.digest()[:16]}... != expected "
+                         f"{expected_header_digest[:16]}...")
+    header.require_geometry(geometry, operation="load_version")
+    if class_ids is not None:
+        header.require_class_ids(class_ids, operation="load_version")
+    store = _read_store_json(store_dir)
+    if store["header_digest"] != header.digest():
+        raise ValueError(f"{path}: manifest header differs from the store descriptor's header")
+    version_id = raw["version_id"]
+    if isinstance(version_id, bool) or not isinstance(version_id, int) or version_id < 0:
+        raise ValueError(f"{path}: version_id must be a nonnegative integer")
+    parent_id = raw["parent_version_id"]
+    parent_digest = raw["parent_manifest_digest"]
+    if (parent_id is None) != (parent_digest is None):
+        raise ValueError(f"{path}: parent_version_id and parent_manifest_digest must both be set or both null")
+    if parent_id is not None and (isinstance(parent_id, bool) or not isinstance(parent_id, int) or parent_id < 0
+                                  or parent_id != version_id - 1 or not _is_hex_digest(parent_digest)):
+        raise ValueError(f"{path}: parent provenance is inconsistent with version_id={version_id}")
+    if v2 and (version_id < 1 or parent_id is None):
+        # CW-B106C1: genesis is always v1; refused here, before any chunk/overlay read.
+        raise ValueError(f"{path}: a v2 version must have version_id >= 1 and a nonnegative parent "
+                         f"(genesis is always v1); got version_id={version_id}, parent_version_id={parent_id}")
+    if not _is_hex_digest(raw["journal_digest"]):
+        raise ValueError(f"{path}: journal_digest is not a 64-hex digest")
+    if version_id == 0 and raw["journal_digest"] != _genesis_journal_digest(header):
+        raise ValueError(f"{path}: genesis journal digest does not match the header")
+    if v2:
+        version = _load_v2(store_dir, path, raw, header, manifest_digest=manifest_digest, version_id=version_id,
+                           parent_id=parent_id, parent_digest=parent_digest, geometry=geometry,
+                           mass_resolution_kg=mass_resolution_kg, verify_data=verify_data,
+                           mapping_cache_chunks=mapping_cache_chunks)
+        if check_parent_lineage:
+            _check_parent_link(store_dir, header, version)
+        _bump("versions_loaded")
+        return version
+    chunks = _chunk_refs_from_json(raw["chunks"], header)
+
+    # Every referenced chunk: existence, size, digest (streamed), then data.
+    for ref in chunks:
+        chunk_file = _chunk_path(store_dir, ref.sha256)
+        if not chunk_file.is_file():
+            raise ValueError(f"chunk {ref.index} file missing: {chunk_file}")
+        digest, size = _sha256_file(chunk_file)
+        if size != ref.nbytes:
+            raise ValueError(f"chunk {ref.index} file has {size} bytes, manifest says {ref.nbytes}")
+        if digest != ref.sha256:
+            raise ValueError(f"chunk {ref.index} file content does not hash to {ref.sha256}; refused")
+    version = DeepStoreVersion(
+        store_dir, header, version_id=version_id, parent_version_id=parent_id,
+        parent_manifest_digest=parent_digest, journal_digest=raw["journal_digest"],
+        manifest_digest=manifest_digest, chunks=chunks, mapping_cache_chunks=mapping_cache_chunks,
+    )
+    if verify_data:
+        for ref, view in version.iter_chunks():
+            _validate_block_data(np.asarray(view), header, geometry, mass_resolution_kg,
+                                 what=f"load_version: chunk {ref.index}")
+            _bump("columns_read", ref.n_cells)
+            _bump("bytes_read", ref.nbytes)
+    if check_parent_lineage and parent_digest is not None:
+        _check_parent_link(store_dir, header, version)
+    _bump("versions_loaded")
+    return version
+
+
+def _verify_file_once(path: Path, sha256: str, nbytes: int, *, what: str, seen: set[str]) -> None:
+    if path.name in seen:
+        return
+    if not path.is_file():
+        raise ValueError(f"{what} file missing: {path}")
+    if path.stat().st_size != nbytes:
+        raise ValueError(f"{what} file has {path.stat().st_size} bytes, manifest says {nbytes}")
+    digest, size = _sha256_file(path)
+    if size != nbytes:
+        raise ValueError(f"{what} file has {size} bytes, manifest says {nbytes}")
+    if digest != sha256:
+        raise ValueError(f"{what} file content does not hash to {sha256}; refused")
+    seen.add(path.name)
+
+
+def _load_v2(store_dir: Path, path: Path, raw: dict[str, Any], header: DeepStoreHeader, *, manifest_digest: str,
+             version_id: int, parent_id: int | None, parent_digest: str | None, geometry: GeometrySpec,
+             mass_resolution_kg: float, verify_data: bool, mapping_cache_chunks: int) -> DeepStoreVersion:
+    if raw["encoding"] != "overlay":
+        raise ValueError(f"{path}: v2 manifest encoding must be 'overlay', got {raw['encoding']!r}")
+    omb = raw["overlay_max_bytes"]
+    if omb is not None and (isinstance(omb, bool) or not isinstance(omb, int) or omb < 1):
+        raise ValueError(f"{path}: overlay_max_bytes must be null or a positive integer")
+    if header.n_voxels > OVERLAY_MAX_VOXELS:
+        raise ValueError(f"{path}: overlay manifests support n_voxels <= {OVERLAY_MAX_VOXELS}")
+    if parent_id is None:
+        raise ValueError(f"{path}: a v2 version must have a parent (genesis is always v1)")
+    logical_parent = raw["logical_parent_manifest_digest"]
+    logical = raw["logical_manifest_digest"]
+    if not _is_hex_digest(logical_parent) or not _is_hex_digest(logical):
+        raise ValueError(f"{path}: logical manifest digests must be 64-hex digests")
+    chunks, slots = _v2_chunk_refs_from_json(raw["chunks"], header)
+    recomputed = _logical_manifest_digest(
+        header, chunks=chunks, version_id=version_id, parent_version_id=parent_id,
+        logical_parent_manifest_digest=logical_parent, journal_digest=raw["journal_digest"],
+    )
+    if recomputed != logical:
+        raise ValueError(f"{path}: logical_manifest_digest does not match the manifest's own logical fields")
+    seen: set[str] = set()
+    for ref, slot in zip(chunks, slots):
+        _verify_file_once(_chunk_path(store_dir, slot.base_sha256), slot.base_sha256, ref.nbytes,
+                          what=f"chunk {ref.index} base", seen=seen)
+        if slot.overlay is not None:
+            _verify_file_once(_overlay_path(store_dir, slot.overlay.sha256), slot.overlay.sha256,
+                              slot.overlay.nbytes, what=f"chunk {ref.index} overlay", seen=seen)
+    version = DeepStoreVersion(
+        store_dir, header, version_id=version_id, parent_version_id=parent_id,
+        parent_manifest_digest=parent_digest, journal_digest=raw["journal_digest"],
+        manifest_digest=manifest_digest, chunks=chunks, mapping_cache_chunks=mapping_cache_chunks,
+        slot_files=slots, logical_manifest_digest=logical, logical_parent_manifest_digest=logical_parent,
+        overlay_max_bytes=omb,
+    )
+    for ref, view in version.iter_chunks():
+        if slots[ref.index].overlay is not None and _sha256_bytes(memoryview(view).cast("B")) != ref.sha256:
+            raise ValueError(f"load_version: chunk {ref.index} base+overlay does not hash to its logical "
+                             f"digest {ref.sha256}; refused")
+        if verify_data:
+            _validate_block_data(np.asarray(view), header, geometry, mass_resolution_kg,
+                                 what=f"load_version: chunk {ref.index}")
+            _bump("columns_read", ref.n_cells)
+            _bump("bytes_read", ref.nbytes)
+    return version
+
+
+def _check_parent_link(store_dir: Path, header: DeepStoreHeader, version: DeepStoreVersion) -> None:
+    """Optional ONE-level lineage check, metadata only (no parent chunk or
+    overlay file is opened and no further ancestor is visited). The
+    immediate parent manifest must be present and hash to its name, and its
+    own metadata must be locally valid exactly as `load_version` would
+    require of it (CW-B106C1): exact key schema for its format; a header
+    that parses AND whose digest equals both its declared `header_digest`
+    and this version's header; non-Boolean integer `version_id ==
+    version_id(child) - 1`; consistent parent id/digest; 64-hex digests;
+    genesis rules (a v1 parent at id 0 has no parent and the genesis
+    journal digest; a v2 parent has id >= 1); a fully parsed chunk table
+    (v1 or v2 rules); for a v2 parent `encoding`, `overlay_max_bytes` and a
+    recomputed logical digest. Finally the child's logical parent digest
+    must equal the parent's logical digest."""
+    parent_digest = version.parent_manifest_digest
+    if parent_digest is None:
+        return
+    ppath = _manifest_path(store_dir, parent_digest)
+    if not ppath.is_file():
+        raise ValueError(f"check_parent_lineage: parent manifest {parent_digest} is absent from {store_dir}")
+    pdata = ppath.read_bytes()
+    if _sha256_bytes(pdata) != parent_digest:
+        raise ValueError(f"check_parent_lineage: parent manifest {ppath} does not hash to its own name")
+    try:
+        praw = json.loads(pdata)
+    except ValueError as exc:
+        raise ValueError(f"check_parent_lineage: parent manifest {ppath} is not JSON") from exc
+    def fail(why: str) -> ValueError:
+        return ValueError(f"check_parent_lineage: parent manifest {ppath}: {why}")
+
+    if not isinstance(praw, dict) or praw.get("kind") != "version" or praw.get("format") not in (
+            DEEP_STORE_FORMAT, DEEP_STORE_FORMAT_V2):
+        raise fail("not a version manifest")
+    pv2 = praw["format"] == DEEP_STORE_FORMAT_V2
+    keys = {"format", "kind", "header", "header_digest", "version_id", "parent_version_id",
+            "parent_manifest_digest", "journal_digest", "chunks"}
+    if pv2:
+        keys |= {"encoding", "overlay_max_bytes", "logical_parent_manifest_digest", "logical_manifest_digest"}
+    if set(praw) != keys:
+        raise fail(f"keys {sorted(praw)} != {sorted(keys)}")
+    try:
+        pheader = DeepStoreHeader.from_json_dict(praw["header"])
+    except ValueError as exc:
+        raise fail(f"header does not parse ({exc})") from exc
+    if pheader.digest() != praw["header_digest"]:
+        raise fail("header_digest does not match its own header")
+    if pheader.digest() != header.digest():
+        raise fail("header differs from this version's header")
+    pid = praw["version_id"]
+    if isinstance(pid, bool) or not isinstance(pid, int) or pid < 0 or pid != version.version_id - 1:
+        raise fail(f"version_id {pid!r} is not the integer {version.version_id - 1}")
+    gid, gdigest = praw["parent_version_id"], praw["parent_manifest_digest"]
+    if (gid is None) != (gdigest is None):
+        raise fail("parent_version_id and parent_manifest_digest must both be set or both null")
+    if gid is not None and (isinstance(gid, bool) or not isinstance(gid, int) or gid < 0 or gid != pid - 1
+                            or not _is_hex_digest(gdigest)):
+        raise fail("parent provenance is inconsistent")
+    if not _is_hex_digest(praw["journal_digest"]):
+        raise fail("journal_digest is not a 64-hex digest")
+    if pid == 0 and (gid is not None or praw["journal_digest"] != _genesis_journal_digest(header)):
+        raise fail("invalid genesis provenance")
+    if not pv2:
+        _chunk_refs_from_json(praw["chunks"], header)
+        parent_logical = parent_digest
+    else:
+        if version.format_version == 1:
+            raise ValueError("check_parent_lineage: a v1 version on a v2 parent is not a valid lineage")
+        omb = praw["overlay_max_bytes"]
+        if praw["encoding"] != "overlay" or (omb is not None and (
+                isinstance(omb, bool) or not isinstance(omb, int) or omb < 1)):
+            raise fail("invalid encoding/overlay_max_bytes")
+        if pid < 1 or gid is None:
+            raise fail("a v2 version must have version_id >= 1 and a parent")
+        lpar, lself = praw["logical_parent_manifest_digest"], praw["logical_manifest_digest"]
+        if not _is_hex_digest(lpar) or not _is_hex_digest(lself):
+            raise fail("logical digests must be 64-hex digests")
+        pchunks, _ = _v2_chunk_refs_from_json(praw["chunks"], header)
+        parent_logical = _logical_manifest_digest(
+            header, chunks=pchunks, version_id=pid, parent_version_id=gid,
+            logical_parent_manifest_digest=lpar, journal_digest=praw["journal_digest"],
+        )
+        if parent_logical != lself:
+            raise ValueError("check_parent_lineage: parent logical digest does not match its own fields")
+    if parent_logical != version.logical_parent_manifest_digest:
+        raise ValueError("check_parent_lineage: logical parent digest does not match the parent manifest")
