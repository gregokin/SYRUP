+    ledger.pending_compensation_kg[...] = new_pending_comp_kg
+    ledger.numerical_residual_positive_kg[0] = new_residual_positive_kg
+    ledger.numerical_residual_positive_compensation_kg[0] = new_residual_positive_comp_kg
+    ledger.numerical_residual_negative_kg[0] = new_residual_negative_kg
+    ledger.numerical_residual_negative_compensation_kg[0] = new_residual_negative_comp_kg
+    ledger.actual_mass_positive_kg[0] = new_actual_positive_kg
+    ledger.actual_mass_positive_compensation_kg[0] = new_actual_positive_comp_kg
+    ledger.actual_mass_negative_kg[0] = new_actual_negative_kg
+    ledger.actual_mass_negative_compensation_kg[0] = new_actual_negative_comp_kg
+    ledger.n_physical_touches[...] = new_n_physical_touches
