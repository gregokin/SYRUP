@@ -0,0 +1,131 @@
+"""Opaque, immutable journal ownership for staged resident-window exchanges.
+
+A column carrying this marker is a LOGICALLY ACCEPTED state whose deep
+region is the bound immutable version OVERLAID by the bound journal, then
+the resident window, zero above; its deep metadata already describes that
+overlaid region and the exchange that produced the journal has already
+moved the mass (the journal is neither a reservoir nor uncounted mass).
+Only the DISK version lags: publication persists the already accepted
+values into a new immutable version and rebinds the column; it performs no
+exchange. This marker makes the lag explicit. Ordinary commits, exports,
+snapshots and the full validator refuse an unpublished column; transactions
+compose its journal. Publication rebinds the maintained height packets only
+when the final accepted transaction writes its version. No separate bed physics.
+"""
+from __future__ import annotations
+
+import dataclasses
+
+import numpy as np
+
+from maple.core.types.voxel import WindowedVoxelColumnState
+from maple.surface.voxels.deep_store import DEFAULT_MAX_JOURNAL_RECORDS, DeepJournal
+
+_FIELDS = ("window_kg", "base", "deep_by_class_kg", "deep_total_kg", "deep_room_kg")
+
+
+class PendingDeepBinding:
+    """Not a dataclass/container: backend walkers cannot move its host journal.
+
+    Attribute-immutable once constructed (CW-B15): `journal`, `version` and
+    `arrays` cannot be reassigned or deleted, so the only way to alter the
+    unpublished deep update is to write into the journal's own arrays, which
+    are read-only on the host and are inside the commit's snapshot/compare/
+    restore guard (`windowed_commit._commit_windowed_topography`).
+    """
+
+    __slots__ = ("_sealed", "arrays", "journal", "version")
+
+    def __setattr__(self, name, value):
+        if getattr(self, "_sealed", False):
+            raise AttributeError("PendingDeepBinding is immutable after construction")
+        object.__setattr__(self, name, value)
+
+    def __delattr__(self, name):
+        raise AttributeError("PendingDeepBinding is immutable after construction")
+
+    def __init__(self, column: WindowedVoxelColumnState, journal: DeepJournal):
+        journal.require_canonical(column.deep_store.header)
+        # Own arrays, genuinely immutable on the host. Caller records remain untouched.
+        self.journal = DeepJournal(
+            cell_flat=np.array(journal.cell_flat, copy=True),
+            voxel=np.array(journal.voxel, copy=True),
+            values_kg=np.array(journal.values_kg, copy=True),
+            header_digest=journal.header_digest,
+        )
+        for a in (self.journal.cell_flat, self.journal.voxel, self.journal.values_kg):
+            a.flags.writeable = False
+        self.version = column.deep_store
+        self.arrays = tuple(getattr(column, name) for name in _FIELDS)
+        self._sealed = True
+
+
+def validate_pending_binding(column: WindowedVoxelColumnState, *, operation: str) -> None:
+    if not isinstance(column, WindowedVoxelColumnState):
+        raise TypeError(f"{operation}: expected WindowedVoxelColumnState")
+    pending = column.pending_deep
+    if pending is None:
+        return
+    if not isinstance(pending, PendingDeepBinding):
+        raise ValueError(f"{operation}: invalid unpublished deep-journal marker")
+    if pending.version is not column.deep_store or any(
+            getattr(column, name) is not a for name, a in zip(_FIELDS, pending.arrays)):
+        raise ValueError(f"{operation}: unpublished journal belongs to different column arrays or version")
+    pending.journal.require_canonical(column.deep_store.header)
+
+
+def require_published_column(column: WindowedVoxelColumnState, *, operation: str) -> None:
+    validate_pending_binding(column, operation=operation)
+    if column.pending_deep is not None:
+        raise ValueError(f"{operation}: unpublished deep journal; validate the complete transaction before publication")
+
+
+def attach_pending_journal(column: WindowedVoxelColumnState, journal: DeepJournal) -> WindowedVoxelColumnState:
+    """Attach owned canonical records to arrays just produced by a transaction."""
+    if journal.n_records:
+        object.__setattr__(column, "pending_deep", PendingDeepBinding(column, journal))
+    else:
+        object.__setattr__(column, "pending_deep", None)
+    return column
+
+
+def publish_pending_column(column: WindowedVoxelColumnState, geometry, mass_resolution_kg: float,
+                           *, max_records: int = DEFAULT_MAX_JOURNAL_RECORDS, encoding: str = "full",
+                           overlay_max_bytes: int | None = None) -> WindowedVoxelColumnState:
+    """One final COW publication; original version and resident arrays retained.
+
+    `encoding` / `overlay_max_bytes` are forwarded unchanged to
+    `DeepStoreVersion.apply_journal` (default `"full"`: the v1 publication).
+    They are validated by the store's own parsers BEFORE the no-pending
+    identity return, so an unsupported option is refused on every call."""
+    from maple.surface.voxels.deep_store import _require_int, _resolve_encoding
+    from maple.surface.voxels.windowed_inventory import (
+        check_windowed_column_cheap,
+        require_fixed_windowed_capacity,
+    )
+    from maple.surface.voxels.windowed_prefix import rebind_prefix_packets
+
+    # S2 (foundation fix, same policy as every other public boundary): a
+    # geometry that enables growth is refused before any validation or
+    # publication; publication never adopts a policy the storage lacks.
+    require_fixed_windowed_capacity(geometry, operation="publish_pending_column")
+    check_windowed_column_cheap(column, geometry)
+    _require_int(max_records, "max_records", minimum=0)
+    _resolve_encoding(encoding, overlay_max_bytes, column.deep_store.header, operation="publish_pending_column")
+    pending = column.pending_deep
+    if pending is None:
+        return column
+    if column.height_packet is not None:
+        from maple.surface.voxels.windowed_prefix import require_prefix_packets
+
+        require_prefix_packets(column, operation="publish_pending_column")
+    new_version = column.deep_store.apply_journal(pending.journal, geometry, mass_resolution_kg,
+                                                  max_records=max_records, encoding=encoding,
+                                                  overlay_max_bytes=overlay_max_bytes)
+    rebound = dataclasses.replace(column, pending_deep=None, deep_store=new_version,
+                                  generation=new_version.version_id, manifest_digest=new_version.manifest_digest)
+    if column.window_cache is not None and column.window_cache.describes(rebound.window_kg):
+        object.__setattr__(rebound, "window_cache", column.window_cache)
+    if column.height_packet is not None:
+        rebound = rebind_prefix_packets(column, rebound)
+    return rebound
diff --git a/src/maple/surface/voxels/windowed_prefix.py b/src/maple/surface/voxels/windowed_prefix.py
new file mode 100644
index 0000000000000000000000000000000000000000..2e5389f0d55c77c815ef90de42bf2d415f3d12cb
--- /dev/null
+++ b/src/maple/surface/voxels/windowed_prefix.py
@@ -0,0 +1,307 @@
+"""Deep-prefix height packets bound to a resident-window column (CW-B3c).
+
+The committed height of a column is NumPy's contiguous FP64 pairwise sum
+of its `n_voxels * n_classes` terms (the dense `mass_kg.sum(axis=(-2,
+-1))`, accepted order `numpy_pairwise_order.ORDER_ID`). A windowed column
+cannot form that sum without reading the deep store, so each cell carries
+a bounded PACKET (`prefix_depth(n) + 8` FP64 words; 96 bytes per cell at
+306 voxels x 6 classes) from which the E1 module
+`maple.core.backend.prefix_cell_reductions` decodes the exact total from
+the packet plus the resident window, with no deep read.
+
+Authority: packets are DERIVED diagnostics of committed deep mass. They
+never enter a class budget and never substitute for the deep store. The
+decoded total is the routing-compatible committed height; the sequential
+class fold of `windowed_inventory` remains the inventory diagnostic and is
+NOT a routing height.
+
+Binding (strict): a `WindowedPrefixPackets` names ONE packet array object
+through the E1 `PrefixPacketBinding` (packet identity, base identity and
+a frozen copy of the base values, order id, NumPy version, geometry) and
+the deep-store identity it was encoded under (`manifest_digest`,
+`generation`). It is an OPAQUE object (not an array, dataclass, tuple,
+list or dict), so the backend tree walkers pass it through untouched and
+it can never act as a full host/device array facade; a converted column
+(`to_device_tree`) carries no packet until `move_prefix_packets` places
+one explicitly. Every consumer calls `require_prefix_packets` first,
+which refuses a missing, foreign, malformed or stale packet by name
+before any kernel.
+
+Lifecycle inside the exchange (`windowed_transfer`): a pure fast exchange
+with an unchanged base keeps the packet; an upward spill advances the
+affected cells' packets from the LEAVING window rows (host, counted, no
+deep read); a miss re-encodes only the gathered columns AFTER the pending
+journal overlay and the current exchange. The step result binds the new
+packet grid to the pending version; publication rebinds it to the new
+version digest/generation.
+
+If the E1 module is absent every entry point here raises
+`PrefixSupportUnavailable` naming it; nothing falls back to a Python loop
+or to the sequential fold.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+from typing import Any
+
+import numpy as np
+
+from maple.core.backend import array_namespace, is_array, namespace_name, to_device
+from maple.core.types.voxel import WindowedVoxelColumnState
+
+__all__ = [
+    "PrefixSupportUnavailable",
+    "WindowedPrefixPackets",
+    "attach_prefix_packets",
+    "encode_prefix_packets_for_block",
+    "move_prefix_packets",
+    "packet_terms_for",
+    "prefix_packets_report",
+    "prefix_support_available",
+    "rebind_prefix_packets",
+    "require_prefix_packets",
+    "windowed_committed_height_total_kg",
+]
+
+E1_MODULE = "maple.core.backend.prefix_cell_reductions"
+
+
+class PrefixSupportUnavailable(RuntimeError):
+    """The qualified E1 prefix module is not importable in this tree; the
+    windowed commit cannot form an exact committed height and refuses."""
+
+
+def _e1():
+    try:
+        import importlib
+
+        return importlib.import_module(E1_MODULE)
+    except ImportError as exc:
+        raise PrefixSupportUnavailable(
+            f"{E1_MODULE} is not available in this tree (the root copies the qualified E1 module after its "
+            f"freeze); exact windowed committed heights cannot be formed and the windowed commit refuses: {exc}"
+        ) from exc
+
+
+def prefix_support_available() -> bool:
+    try:
+        _e1()
+    except PrefixSupportUnavailable:
+        return False
+    return True
+
+
+def packet_terms_for(n_voxels: int, n_classes: int) -> int:
+    return int(_e1().packet_terms(int(n_voxels) * int(n_classes)))
+
+
+class WindowedPrefixPackets:
+    """OPAQUE, immutable binding of a packet grid `(ny, nx, P)` to one
+    windowed column's base array object and deep-store identity."""
+
+    __slots__ = ("_binding", "_generation", "_manifest_digest", "_packet", "_sealed")
+
+    def __init__(self, packet: Any, binding: Any, manifest_digest: str, generation: int) -> None:
+        self._packet = packet
+        self._binding = binding
+        self._manifest_digest = manifest_digest
+        self._generation = int(generation)
+        self._sealed = True
+
+    def __setattr__(self, name: str, value: Any) -> None:
+        if hasattr(self, "_sealed"):
+            raise AttributeError("WindowedPrefixPackets is immutable")
+        object.__setattr__(self, name, value)
+
+    @property
+    def packet(self) -> Any:
+        return self._packet
+
+    @property
+    def binding(self) -> Any:
+        return self._binding
+
+    @property
+    def manifest_digest(self) -> str:
+        return self._manifest_digest
+
+    @property
+    def generation(self) -> int:
+        return self._generation
+
+    @property
+    def packet_terms(self) -> int:
+        return int(self._packet.shape[-1])
+
+    @property
+    def nbytes(self) -> int:
+        return int(self._packet.nbytes)
+
+    def describes(self, column: WindowedVoxelColumnState) -> bool:
+        """True iff this packet grid was bound for exactly this column's
+        base array object and deep-store identity, and the binding still
+        names this packet object."""
+        return (
+            self._binding.describes(self._packet)
+            and self._binding.base.array is column.base
+            and self._manifest_digest == column.manifest_digest
+            and self._generation == int(column.generation)
+        )
+
+    def __repr__(self) -> str:
+        return (f"WindowedPrefixPackets(shape={tuple(self._packet.shape)}, generation={self._generation}, "
+                f"manifest={self._manifest_digest[:12]}...)")
+
+
+def encode_prefix_packets_for_block(block: np.ndarray, base: np.ndarray, window_voxels: int) -> np.ndarray:
+    """Packets `(k, P)` for a bounded HOST block of full logical columns
+    `(k, n_voxels, n_classes)` with their window bases (genesis bands /
+    chunks, miss re-encode). The block must be the TRUE logical column
+    (zero above `base + W`); the E1 encoder refuses otherwise."""
+    e1 = _e1()
+    return e1.encode_prefix(np.ascontiguousarray(block, dtype=np.float64),
+                            np.ascontiguousarray(base), window_voxels=int(window_voxels))
+
+
+def advance_prefix_packets_for_rows(packet_rows: np.ndarray, base: np.ndarray, new_base: np.ndarray,
+                                    leaving_window_rows: np.ndarray, *, n_voxels: int, n_classes: int,
+                                    window_voxels: int) -> np.ndarray:
+    """Packets after an UPWARD base shift from the leaving window rows
+    (host, bounded, no deep read) -- the E1 `advance_prefix` contract."""
+    e1 = _e1()
+    return e1.advance_prefix(np.ascontiguousarray(packet_rows, dtype=np.float64), np.ascontiguousarray(base),
+                             np.ascontiguousarray(new_base), np.ascontiguousarray(leaving_window_rows, dtype=np.float64),
+                             nv=int(n_voxels), nc=int(n_classes), window_voxels=int(window_voxels))
+
+
+def _with_packets(column: WindowedVoxelColumnState, packets: WindowedPrefixPackets) -> WindowedVoxelColumnState:
+    """A NEW column object (same arrays, same deep-store handle) carrying
+    `packets`; the window cache is carried over when it still describes the
+    same window array."""
+    new = dataclasses.replace(column)
+    cache = column.window_cache
+    if cache is not None and cache.describes(new.window_kg):
+        object.__setattr__(new, "window_cache", cache)
+    object.__setattr__(new, "height_packet", packets)
+    return new
+
+
+def attach_prefix_packets(column: WindowedVoxelColumnState, packet: Any) -> WindowedVoxelColumnState:
+    """Bind a packet grid `(ny, nx, P)` (in the column's namespace) to this
+    column's base array object and deep-store identity, and return a new
+    column object carrying it. The E1 binding freezes the packet on NumPy
+    (enforced read-only) and refuses shape/dtype/namespace/range problems
+    before building anything."""
+    e1 = _e1()
+    if not isinstance(column, WindowedVoxelColumnState):
+        raise TypeError("attach_prefix_packets requires a WindowedVoxelColumnState")
+    if not is_array(packet):
+        raise ValueError("packet must be an array")
+    if array_namespace(packet) is not array_namespace(column.window_kg):
+        raise ValueError(
+            "packet must live in the column's own namespace "
+            f"({namespace_name(array_namespace(column.window_kg))}); move it explicitly first"
+        )
+    _ny, _nx, width, nc = column.window_kg.shape
+    binding = e1.bind_prefix_packets(
+        packet, column.base, nv=int(column.n_voxels), nc=int(nc), window_voxels=int(width),
+        version=column.manifest_digest, generation=int(column.generation),
+    )
+    packets = WindowedPrefixPackets(packet, binding, column.manifest_digest, int(column.generation))
+    return _with_packets(column, packets)
+
+
+def rebind_prefix_packets(source: WindowedVoxelColumnState, target: WindowedVoxelColumnState) -> WindowedVoxelColumnState:
+    """Carry `source`'s packet grid onto `target` -- a column with the SAME
+    resident window and base values (e.g. the same column rebound to a
+    newly published deep-store version): the packet array object is
+    reused and bound afresh to `target`'s base object and identity. The
+    base values must be unchanged (the E1 binding copies and checks them)."""
+    packets = require_prefix_packets(source, operation="rebind_prefix_packets")
+    if array_namespace(target.window_kg) is not array_namespace(packets.packet):
+        raise ValueError("rebind_prefix_packets: target column and packet are in different namespaces")
+    if tuple(target.base.shape) != tuple(source.base.shape):
+        raise ValueError("rebind_prefix_packets: target base shape differs from the source")
+    return attach_prefix_packets(target, packets.packet)
+
+
+def move_prefix_packets(target: WindowedVoxelColumnState, source: WindowedVoxelColumnState, xp) -> WindowedVoxelColumnState:
+    """Place a COPY of `source`'s packet grid in namespace `xp` (counted
+    transfer) and bind it to `target` (the converted column, which carries
+    no packet after `to_device_tree`). `source` and its binding are
+    untouched."""
+    packets = require_prefix_packets(source, operation="move_prefix_packets")
+    moved = to_device(packets.packet, xp)
+    if moved is packets.packet:
+        moved = packets.packet.copy()
+    return attach_prefix_packets(target, moved)
+
+
+def require_prefix_packets(column: WindowedVoxelColumnState, *, operation: str) -> WindowedPrefixPackets:
+    """The packets of `column`, or a refusal by name: absent, foreign
+    object type, binding malformed (E1 cross-validation), bound to another
+    packet/base object, or encoded under a different deep-store version /
+    generation than the column is bound to. Metadata reads only."""
+    if not isinstance(column, WindowedVoxelColumnState):
+        raise TypeError(f"{operation}: expected a WindowedVoxelColumnState, got {type(column).__name__}")
+    packets = column.height_packet
+    if packets is None:
+        raise ValueError(
+            f"{operation}: the windowed column carries no prefix height packets; encode them at genesis "
+            "(windowed_column_from_dense/from_version with_prefix_packets=True) or attach_prefix_packets. "
+            "Nothing was mutated."
+        )
+    if not isinstance(packets, WindowedPrefixPackets):
+        raise ValueError(f"{operation}: height_packet is not a WindowedPrefixPackets (got {type(packets).__name__})")
+    try:
+        packets.binding.validate()
+    except Exception as exc:  # the E1 PrefixPacketError, re-labelled with the operation
+        raise ValueError(f"{operation}: malformed prefix packet binding: {exc}") from exc
+    if not packets.binding.describes(packets.packet):
+        raise ValueError(f"{operation}: the packet binding names a different packet object (foreign packet)")
+    if packets.binding.base.array is not column.base:
+        raise ValueError(
+            f"{operation}: the prefix packets were bound to a different base array object than this column's; "
+            "rebind (or re-encode) the packets for this column"
+        )
+    if packets.manifest_digest != column.manifest_digest or packets.generation != int(column.generation):
+        raise ValueError(
+            f"{operation}: stale prefix packets: bound to deep-store version {packets.manifest_digest[:12]}... "
+            f"(generation {packets.generation}) but the column is bound to {column.manifest_digest[:12]}... "
+            f"(generation {int(column.generation)}); rebind after publication or re-encode"
+        )
+    if packets.binding.version != column.manifest_digest or packets.binding.generation != int(column.generation):
+        raise ValueError(f"{operation}: the E1 binding's version/generation differ from the column's")
+    ny, nx, width, nc = column.window_kg.shape
+    if tuple(packets.packet.shape[:2]) != (int(ny), int(nx)):
+        raise ValueError(f"{operation}: packet grid shape {tuple(packets.packet.shape)} does not match the column")
+    if packets.binding.window_voxels != int(width) or packets.binding.nv != int(column.n_voxels) or packets.binding.nc != int(nc):
+        raise ValueError(f"{operation}: packet geometry does not match the column (W, n_voxels, n_classes)")
+    if array_namespace(packets.packet) is not array_namespace(column.window_kg):
+        raise ValueError(f"{operation}: packets and window are in different namespaces; move the packets explicitly")
+    return packets
+
+
+def windowed_committed_height_total_kg(column: WindowedVoxelColumnState, *, trusted: bool = False):
+    """The column's EXACT NumPy-order total mass `(ny, nx)` (the dense
+    `mass_kg.sum(axis=(-2, -1))`), decoded from the packets and the
+    resident window: compiled Numba on NumPy, RawKernel on CuPy
+    (`trusted=True` required there, by the E1 contract). No deep read, no
+    transfer; at most one counted base-value read. A derived diagnostic:
+    never a mass authority."""
+    packets = require_prefix_packets(column, operation="windowed_committed_height_total_kg")
+    e1 = _e1()
+    return e1.decode_height(column.window_kg, column.base, packets.packet, packets.binding,
+                            version=column.manifest_digest, generation=int(column.generation), trusted=trusted)
+
+
+def prefix_packets_report(column: WindowedVoxelColumnState) -> dict[str, Any]:
+    packets = column.height_packet
+    if packets is None:
+        return {"present": False}
+    summary = dict(packets.binding.summary()) if hasattr(packets.binding, "summary") else {}
+    summary.update({"present": True, "packet_bytes": packets.nbytes, "packet_terms": packets.packet_terms,
+                    "manifest_digest": packets.manifest_digest, "generation": packets.generation,
+                    "describes_column": packets.describes(column)})
+    return summary
diff --git a/src/maple/surface/voxels/windowed_snapshot.py b/src/maple/surface/voxels/windowed_snapshot.py
new file mode 100644
index 0000000000000000000000000000000000000000..98178a7a5b1a29eea412b4e0e385e6a78cf2bd3f
--- /dev/null
+++ b/src/maple/surface/voxels/windowed_snapshot.py
@@ -0,0 +1,201 @@
+"""Source-bound snapshots of actual MAPLE resident-window sediment state.
+
+Stores resident physical arrays and the immutable deep-version reference.
+Deep files remain in their versioned store and must be retained for restart;
+this format is not a portable archive or a dense/wind snapshot. No pickle,
+dynamic types, full dense column or independent sediment authority is used.
+Prefixes are persisted as derived metadata and independently re-encoded from
+bounded logical columns at save/load boundaries. All original versions remain.
+"""
+from __future__ import annotations
+
+import json
+import os
+import tempfile
+import zipfile
+from pathlib import Path
+
+import numpy as np
+
+from maple.core.backend import all_finite, any_true, array_namespace, to_host
+from maple.core.backend.cell_reductions import sum_per_cell_numpy_order
+from maple.core.types.active_layer import ActiveLayerState
+from maple.core.types.sediment_availability import SedimentAvailabilityState
+from maple.core.types.voxel import WindowedVoxelColumnState
+from maple.core.types.water import WaterState
+from maple.surface.active_layer.capacity import compute_active_layer_target_mass_kg
+from maple.surface.active_layer.validation import check_active_layer_state
+from maple.surface.voxels._numerics import le_within_tolerance_array
+from maple.surface.voxels.deep_store import load_version
+from maple.surface.voxels.windowed_inventory import (
+    gather_full_columns,
+    require_fixed_windowed_capacity,
+    validate_windowed_column_full,
+)
+from maple.surface.voxels.windowed_pending import require_published_column
+from maple.surface.voxels.windowed_prefix import (
+    attach_prefix_packets,
+    encode_prefix_packets_for_block,
+    require_prefix_packets,
+    windowed_committed_height_total_kg,
+)
+
+SCHEMA = 'maple-windowed-snapshot/1'
+COLUMN_ARRAYS = ('window_kg', 'base', 'deep_by_class_kg', 'deep_total_kg', 'deep_room_kg')
+OTHER_ARRAYS = ('prefix_packet', 'active_mass_kg', 'available_mass_kg', 'bound_mass_kg',
+                'water_depth_m', 'mobile_mass_kg')
+META_KEYS = {'schema', 'store_dir', 'manifest_digest', 'generation', 'header_digest',
+             'n_voxels', 'time_s', 'step', 'class_ids', 'provenance'}
+
+
+def validate_windowed_partition(column, active, geometry, mass_resolution_kg):
+    """The existing MAPLE active/voxel partition rules on streamed storage."""
+    require_published_column(column, operation='validate_windowed_partition')
+    validate_windowed_column_full(column, geometry, mass_resolution_kg)
+    check_active_layer_state(active, geometry, mass_resolution_kg)
+    if active.mass_kg.shape != column.deep_by_class_kg.shape:
+        raise ValueError('windowed active/voxel class geometry mismatch')
+    xp = array_namespace(column.window_kg, active.mass_kg)
+    a = sum_per_cell_numpy_order(active.mass_kg, trailing_axes=1)
+    v = windowed_committed_height_total_kg(column, trusted=True)
+    target = compute_active_layer_target_mass_kg(geometry)
+    at_target = le_within_tolerance_array(target, a, scale_kg=xp.maximum(target, a))
+    if any_true((v > 0) & ~at_target):
+        raise ValueError('active layer below target while subactive voxel sediment remains')
+    combined = v / geometry.bulk_density_kg_m3 / (geometry.dx_m*geometry.dy_m)
+    combined = combined + a / geometry.bulk_density_kg_m3 / (geometry.dx_m*geometry.dy_m)
+    if not all_finite(combined):
+        raise ValueError('combined windowed surface elevation is non-finite')
+    packets = require_prefix_packets(column, operation='validate_windowed_partition')
+    flat_base = column.base.reshape(-1)
+    flat_packet = packets.packet.reshape(geometry.ny*geometry.nx, -1)
+    # Bound all independent reconstruction by the actual store chunk width.
+    # Only the validated chunk references are needed here: gather_full_columns
+    # reads (and, for an overlaid slot, materializes) each chunk itself.
+    for ref in column.deep_store.chunks:
+        ids = np.arange(ref.cell_start, ref.cell_start+ref.n_cells, dtype=np.int64)
+        full = gather_full_columns(column, ids, max_columns=column.deep_store.header.chunk_columns)
+        base = np.asarray(to_host(flat_base[ref.cell_start:ref.cell_start+ref.n_cells]))
+        expected = encode_prefix_packets_for_block(full, base, column.window_voxels)
+        actual = np.asarray(to_host(flat_packet[ref.cell_start:ref.cell_start+ref.n_cells]))
+        if actual.tobytes() != expected.tobytes():
+            raise ValueError('snapshot prefix packet does not describe the actual logical column')
+
+
+def _validate_other(column, active, availability, water, geometry, mass_resolution_kg):
+    from maple.surface.availability.validation import check_sediment_availability_state
+    from maple.water import validate_water_state
+
+    validate_windowed_partition(column, active, geometry, mass_resolution_kg)
+    check_sediment_availability_state(availability, active, mass_resolution_kg)
+    validate_water_state(water, geometry.ny, geometry.nx, column.window_kg.shape[-1])
+
+
+def save_windowed_state_snapshot(column, active, time_s, path, *, step, geometry,
+                                 mass_resolution_kg, sediment_availability, water, provenance=None):
+    # S1 correction 1: the same fixed-capacity policy as the windowed
+    # constructors, decided BEFORE any validation, packet read or write.
+    require_fixed_windowed_capacity(geometry, operation='save_windowed_state_snapshot')
+    path = Path(path)
+    # CW-B15: `np.savez` appends '.npz' to a path that lacks it, so a check on
+    # the given path would test a different file from the one written. The
+    # suffix is therefore required, an existing target is refused, and the
+    # archive is published atomically (see `_publish_npz_no_clobber`).
+    if path.suffix != '.npz':
+        raise ValueError(f'windowed snapshot path must end in .npz, got {path.name!r}')
+    if path.exists() or path.is_symlink():
+        raise ValueError('windowed snapshot path already exists')
+    if isinstance(time_s, bool) or not np.isfinite(time_s) or time_s < 0:
+        raise ValueError('invalid windowed snapshot time')
+    if isinstance(step, bool) or not isinstance(step, int) or step < 0:
+        raise ValueError('invalid windowed snapshot step')
+    _validate_other(column, active, sediment_availability, water, geometry, mass_resolution_kg)
+    metadata = {'schema': SCHEMA, 'store_dir': str(column.deep_store.store_dir.resolve()),
+                'manifest_digest': column.manifest_digest, 'generation': column.generation,
+                'header_digest': column.deep_store.header.digest(), 'n_voxels': column.n_voxels,
+                'time_s': float(time_s), 'step': step, 'class_ids': list(column.deep_store.header.class_ids),
+                'provenance': {} if provenance is None else provenance}
+    arrays = {k: np.asarray(to_host(getattr(column,k))) for k in COLUMN_ARRAYS}
+    arrays.update({'prefix_packet': np.asarray(to_host(column.height_packet.packet)),
+                   'active_mass_kg': np.asarray(to_host(active.mass_kg)),
+                   'available_mass_kg': np.asarray(to_host(sediment_availability.available_mass_kg)),
+                   'bound_mass_kg': np.asarray(to_host(sediment_availability.bound_mass_kg)),
+                   'water_depth_m': np.asarray(to_host(water.depth_m)),
+                   'mobile_mass_kg': np.asarray(to_host(water.mobile_mass_by_cell_class_kg))})
+    _publish_npz_no_clobber(
+        path, metadata=np.array(json.dumps(metadata, sort_keys=True, allow_nan=False)), **arrays)
+
+
+def _publish_npz_no_clobber(path: Path, **arrays) -> None:
+    """Write the archive to a private temporary file in the destination
+    directory, flush and fsync it, then publish it under `path` with
+    `os.link`, which is atomic and fails if `path` already exists (an
+    `os.replace` would silently overwrite a file created after the
+    existence check). The temporary name is always removed. On any failure
+    no file exists at `path` that was not there before, and a pre-existing
+    file is never touched."""
+    fd, tmp_name = tempfile.mkstemp(prefix=f'.{path.name}.', suffix='.tmp', dir=path.parent)
+    tmp = Path(tmp_name)
+    try:
+        with os.fdopen(fd, 'wb') as handle:
+            np.savez(handle, **arrays)  # a file object: no suffix is appended
+            handle.flush()
+            os.fsync(handle.fileno())
+        try:
+            os.link(tmp, path)
+        except FileExistsError:
+            raise ValueError('windowed snapshot path already exists') from None
+    finally:
+        tmp.unlink(missing_ok=True)
+
+
+def load_windowed_state_snapshot(path, *, geometry, grain_classes, mass_resolution_kg, max_bytes):
+    # S1 correction 1: refused before the archive, the deep store or the
+    # packets are opened; a restored state never carries a growth policy
+    # the windowed storage does not implement.
+    require_fixed_windowed_capacity(geometry, operation='load_windowed_state_snapshot')
+    path = Path(path)
+    if path.is_symlink():
+        raise ValueError('windowed snapshot symlink refused')
+    if isinstance(max_bytes, bool) or not isinstance(max_bytes, int) or max_bytes < 1:
+        raise ValueError('snapshot byte bound must be a positive integer')
+    with zipfile.ZipFile(path) as archive:
+        if sum(i.file_size for i in archive.infolist()) > max_bytes:
+            raise ValueError('windowed snapshot exceeds bounded uncompressed size')
+    with np.load(path, allow_pickle=False) as archive:
+        if set(archive.files) != {'metadata', *COLUMN_ARRAYS, *OTHER_ARRAYS}:
+            raise ValueError('windowed snapshot fields mismatch')
+        metadata_array = archive['metadata']
+        if metadata_array.shape != () or metadata_array.dtype.kind != 'U':
+            raise ValueError('windowed snapshot metadata must be scalar text')
+        meta = json.loads(str(metadata_array.item()))
+        if set(meta) != META_KEYS or meta['schema'] != SCHEMA:
+            raise ValueError('windowed snapshot metadata mismatch')
+        arrays = {k: np.array(archive[k],copy=True,order='C') for k in (*COLUMN_ARRAYS,*OTHER_ARRAYS)}
+    ids = tuple(g.class_id for g in grain_classes.classes)
+    if meta['class_ids'] != list(ids):
+        raise ValueError('windowed snapshot class ordering differs')
+    if isinstance(meta['generation'], bool) or not isinstance(meta['generation'], int):
+        raise ValueError('windowed snapshot generation must be integer')
+    if isinstance(meta['time_s'], bool) or not np.isfinite(meta['time_s']) or meta['time_s'] < 0:
+        raise ValueError('windowed snapshot time invalid')
+    if isinstance(meta['step'], bool) or not isinstance(meta['step'], int) or meta['step'] < 0:
+        raise ValueError('windowed snapshot step invalid')
+    version = load_version(meta['store_dir'], meta['manifest_digest'], geometry=geometry,
+                           mass_resolution_kg=mass_resolution_kg, class_ids=ids,
+                           expected_header_digest=meta['header_digest'])
+    if meta['generation'] != version.version_id or meta['n_voxels'] != version.header.n_voxels:
+        raise ValueError('windowed snapshot version identity differs')
+    column = WindowedVoxelColumnState(**{k:arrays[k] for k in COLUMN_ARRAYS},n_voxels=meta['n_voxels'],
+                                      deep_store=version,generation=version.version_id,
+                                      manifest_digest=version.manifest_digest)
+    column = attach_prefix_packets(column,arrays['prefix_packet'])
+    active = ActiveLayerState(arrays['active_mass_kg'])
+    availability = SedimentAvailabilityState(arrays['available_mass_kg'],arrays['bound_mass_kg'])
+    water = WaterState(arrays['water_depth_m'],arrays['mobile_mass_kg'])
+    _validate_other(column,active,availability,water,geometry,mass_resolution_kg)
+    for a in arrays.values():
+        a.flags.writeable = False
+    return {'voxel_column':column,'active_layer':active,'sediment_availability':availability,
+            'water':water,'time_s':meta['time_s'],'step':meta['step'],'validated':True,
+            'restartable':True,'is_diagnostic':False,'provenance':meta['provenance']}
