index 0000000000000000000000000000000000000000..d8e3eefa0549eecc3990f4c03a87afd526b8a6db
--- /dev/null
+++ b/src/maple/surface/voxels/windowed_snapshot.py
@@ -0,0 +1,193 @@
+"""Source-bound snapshots of actual MAPLE resident-window sediment state.
+
+Stores resident physical arrays and the immutable deep-version reference.
+Deep files remain in their versioned store and must be retained for restart;
+this format is not a portable archive or a dense/wind snapshot. No pickle,
+dynamic types, full dense column or independent sediment authority is used.
+Prefixes are persisted as derived metadata and independently re-encoded from
+bounded logical columns at save/load boundaries. All original versions remain.
+"""
+from __future__ import annotations
+
+import json
+import os
+import tempfile
+import zipfile
+from pathlib import Path
+
+import numpy as np
+
+from maple.core.backend import all_finite, any_true, array_namespace, to_host
+from maple.core.backend.cell_reductions import sum_per_cell_numpy_order
+from maple.core.types.active_layer import ActiveLayerState
+from maple.core.types.sediment_availability import SedimentAvailabilityState
+from maple.core.types.voxel import WindowedVoxelColumnState
+from maple.core.types.water import WaterState
+from maple.surface.active_layer.capacity import compute_active_layer_target_mass_kg
+from maple.surface.active_layer.validation import check_active_layer_state
+from maple.surface.voxels._numerics import le_within_tolerance_array
+from maple.surface.voxels.deep_store import load_version
+from maple.surface.voxels.windowed_inventory import (
+    gather_full_columns,
+    validate_windowed_column_full,
+)
+from maple.surface.voxels.windowed_pending import require_published_column
+from maple.surface.voxels.windowed_prefix import (
+    attach_prefix_packets,
+    encode_prefix_packets_for_block,
+    require_prefix_packets,
+    windowed_committed_height_total_kg,
+)
+
+SCHEMA = 'maple-windowed-snapshot/1'
+COLUMN_ARRAYS = ('window_kg', 'base', 'deep_by_class_kg', 'deep_total_kg', 'deep_room_kg')
+OTHER_ARRAYS = ('prefix_packet', 'active_mass_kg', 'available_mass_kg', 'bound_mass_kg',
+                'water_depth_m', 'mobile_mass_kg')
+META_KEYS = {'schema', 'store_dir', 'manifest_digest', 'generation', 'header_digest',
+             'n_voxels', 'time_s', 'step', 'class_ids', 'provenance'}
+
+
+def validate_windowed_partition(column, active, geometry, mass_resolution_kg):
+    """The existing MAPLE active/voxel partition rules on streamed storage."""
+    require_published_column(column, operation='validate_windowed_partition')
+    validate_windowed_column_full(column, geometry, mass_resolution_kg)
+    check_active_layer_state(active, geometry, mass_resolution_kg)
+    if active.mass_kg.shape != column.deep_by_class_kg.shape:
+        raise ValueError('windowed active/voxel class geometry mismatch')
+    xp = array_namespace(column.window_kg, active.mass_kg)
+    a = sum_per_cell_numpy_order(active.mass_kg, trailing_axes=1)
+    v = windowed_committed_height_total_kg(column, trusted=True)
+    target = compute_active_layer_target_mass_kg(geometry)
+    at_target = le_within_tolerance_array(target, a, scale_kg=xp.maximum(target, a))
+    if any_true((v > 0) & ~at_target):
+        raise ValueError('active layer below target while subactive voxel sediment remains')
+    combined = v / geometry.bulk_density_kg_m3 / (geometry.dx_m*geometry.dy_m)
+    combined = combined + a / geometry.bulk_density_kg_m3 / (geometry.dx_m*geometry.dy_m)
+    if not all_finite(combined):
+        raise ValueError('combined windowed surface elevation is non-finite')
+    packets = require_prefix_packets(column, operation='validate_windowed_partition')
+    flat_base = column.base.reshape(-1)
+    flat_packet = packets.packet.reshape(geometry.ny*geometry.nx, -1)
+    # Bound all independent reconstruction by the actual store chunk width.
+    # Only the validated chunk references are needed here: gather_full_columns
+    # reads (and, for an overlaid slot, materializes) each chunk itself.
+    for ref in column.deep_store.chunks:
+        ids = np.arange(ref.cell_start, ref.cell_start+ref.n_cells, dtype=np.int64)
+        full = gather_full_columns(column, ids, max_columns=column.deep_store.header.chunk_columns)
+        base = np.asarray(to_host(flat_base[ref.cell_start:ref.cell_start+ref.n_cells]))
+        expected = encode_prefix_packets_for_block(full, base, column.window_voxels)
+        actual = np.asarray(to_host(flat_packet[ref.cell_start:ref.cell_start+ref.n_cells]))
+        if actual.tobytes() != expected.tobytes():
+            raise ValueError('snapshot prefix packet does not describe the actual logical column')
+
+
+def _validate_other(column, active, availability, water, geometry, mass_resolution_kg):
+    from maple.surface.availability.validation import check_sediment_availability_state
+    from maple.water import validate_water_state
+
+    validate_windowed_partition(column, active, geometry, mass_resolution_kg)
+    check_sediment_availability_state(availability, active, mass_resolution_kg)
+    validate_water_state(water, geometry.ny, geometry.nx, column.window_kg.shape[-1])
+
+
+def save_windowed_state_snapshot(column, active, time_s, path, *, step, geometry,
+                                 mass_resolution_kg, sediment_availability, water, provenance=None):
+    path = Path(path)
+    # CW-B15: `np.savez` appends '.npz' to a path that lacks it, so a check on
+    # the given path would test a different file from the one written. The
+    # suffix is therefore required, an existing target is refused, and the
+    # archive is published atomically (see `_publish_npz_no_clobber`).
+    if path.suffix != '.npz':
+        raise ValueError(f'windowed snapshot path must end in .npz, got {path.name!r}')
+    if path.exists() or path.is_symlink():
+        raise ValueError('windowed snapshot path already exists')
+    if isinstance(time_s, bool) or not np.isfinite(time_s) or time_s < 0:
+        raise ValueError('invalid windowed snapshot time')
+    if isinstance(step, bool) or not isinstance(step, int) or step < 0:
+        raise ValueError('invalid windowed snapshot step')
+    _validate_other(column, active, sediment_availability, water, geometry, mass_resolution_kg)
+    metadata = {'schema': SCHEMA, 'store_dir': str(column.deep_store.store_dir.resolve()),
+                'manifest_digest': column.manifest_digest, 'generation': column.generation,
+                'header_digest': column.deep_store.header.digest(), 'n_voxels': column.n_voxels,
+                'time_s': float(time_s), 'step': step, 'class_ids': list(column.deep_store.header.class_ids),
+                'provenance': {} if provenance is None else provenance}
+    arrays = {k: np.asarray(to_host(getattr(column,k))) for k in COLUMN_ARRAYS}
+    arrays.update({'prefix_packet': np.asarray(to_host(column.height_packet.packet)),
+                   'active_mass_kg': np.asarray(to_host(active.mass_kg)),
+                   'available_mass_kg': np.asarray(to_host(sediment_availability.available_mass_kg)),
+                   'bound_mass_kg': np.asarray(to_host(sediment_availability.bound_mass_kg)),
+                   'water_depth_m': np.asarray(to_host(water.depth_m)),
+                   'mobile_mass_kg': np.asarray(to_host(water.mobile_mass_by_cell_class_kg))})
+    _publish_npz_no_clobber(
+        path, metadata=np.array(json.dumps(metadata, sort_keys=True, allow_nan=False)), **arrays)
+
+
+def _publish_npz_no_clobber(path: Path, **arrays) -> None:
+    """Write the archive to a private temporary file in the destination
+    directory, flush and fsync it, then publish it under `path` with
+    `os.link`, which is atomic and fails if `path` already exists (an
+    `os.replace` would silently overwrite a file created after the
+    existence check). The temporary name is always removed. On any failure
+    no file exists at `path` that was not there before, and a pre-existing
+    file is never touched."""
+    fd, tmp_name = tempfile.mkstemp(prefix=f'.{path.name}.', suffix='.tmp', dir=path.parent)
+    tmp = Path(tmp_name)
+    try:
+        with os.fdopen(fd, 'wb') as handle:
+            np.savez(handle, **arrays)  # a file object: no suffix is appended
+            handle.flush()
+            os.fsync(handle.fileno())
+        try:
+            os.link(tmp, path)
+        except FileExistsError:
+            raise ValueError('windowed snapshot path already exists') from None
+    finally:
+        tmp.unlink(missing_ok=True)
+
+
+def load_windowed_state_snapshot(path, *, geometry, grain_classes, mass_resolution_kg, max_bytes):
+    path = Path(path)
+    if path.is_symlink():
+        raise ValueError('windowed snapshot symlink refused')
+    if isinstance(max_bytes, bool) or not isinstance(max_bytes, int) or max_bytes < 1:
+        raise ValueError('snapshot byte bound must be a positive integer')
+    with zipfile.ZipFile(path) as archive:
+        if sum(i.file_size for i in archive.infolist()) > max_bytes:
+            raise ValueError('windowed snapshot exceeds bounded uncompressed size')
+    with np.load(path, allow_pickle=False) as archive:
+        if set(archive.files) != {'metadata', *COLUMN_ARRAYS, *OTHER_ARRAYS}:
+            raise ValueError('windowed snapshot fields mismatch')
+        metadata_array = archive['metadata']
+        if metadata_array.shape != () or metadata_array.dtype.kind != 'U':
+            raise ValueError('windowed snapshot metadata must be scalar text')
+        meta = json.loads(str(metadata_array.item()))
+        if set(meta) != META_KEYS or meta['schema'] != SCHEMA:
+            raise ValueError('windowed snapshot metadata mismatch')
+        arrays = {k: np.array(archive[k],copy=True,order='C') for k in (*COLUMN_ARRAYS,*OTHER_ARRAYS)}
+    ids = tuple(g.class_id for g in grain_classes.classes)
+    if meta['class_ids'] != list(ids):
+        raise ValueError('windowed snapshot class ordering differs')
+    if isinstance(meta['generation'], bool) or not isinstance(meta['generation'], int):
+        raise ValueError('windowed snapshot generation must be integer')
+    if isinstance(meta['time_s'], bool) or not np.isfinite(meta['time_s']) or meta['time_s'] < 0:
+        raise ValueError('windowed snapshot time invalid')
+    if isinstance(meta['step'], bool) or not isinstance(meta['step'], int) or meta['step'] < 0:
+        raise ValueError('windowed snapshot step invalid')
+    version = load_version(meta['store_dir'], meta['manifest_digest'], geometry=geometry,
+                           mass_resolution_kg=mass_resolution_kg, class_ids=ids,
+                           expected_header_digest=meta['header_digest'])
+    if meta['generation'] != version.version_id or meta['n_voxels'] != version.header.n_voxels:
+        raise ValueError('windowed snapshot version identity differs')
+    column = WindowedVoxelColumnState(**{k:arrays[k] for k in COLUMN_ARRAYS},n_voxels=meta['n_voxels'],
+                                      deep_store=version,generation=version.version_id,
+                                      manifest_digest=version.manifest_digest)
+    column = attach_prefix_packets(column,arrays['prefix_packet'])
+    active = ActiveLayerState(arrays['active_mass_kg'])
+    availability = SedimentAvailabilityState(arrays['available_mass_kg'],arrays['bound_mass_kg'])
+    water = WaterState(arrays['water_depth_m'],arrays['mobile_mass_kg'])
+    _validate_other(column,active,availability,water,geometry,mass_resolution_kg)
+    for a in arrays.values():
+        a.flags.writeable = False
+    return {'voxel_column':column,'active_layer':active,'sediment_availability':availability,
+            'water':water,'time_s':meta['time_s'],'step':meta['step'],'validated':True,
+            'restartable':True,'is_diagnostic':False,'provenance':meta['provenance']}
