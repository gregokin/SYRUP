+"""Optional compiled, ordered Kahan arithmetic for compact ledger arrays.
+
+The existing four FP64 operations are preserved, without reassociation.
+Only matching C-contiguous FP64 inputs use this path. Broadcast, other dtype
+and layout cases retain the caller's original implementation. Outputs are
+new; input sums and compensation are never written.
+"""
+from __future__ import annotations
+
+import numpy as np
+
+from maple.core.backend import array_namespace
+
+_NUMBA_TRIED = False
+_NUMBA_KERNEL = None
+_CUDA_KERNEL = None
+
+
+def _ordered_flat(s, c, inc, out_s, out_c):
+    for j in range(s.size):
+        y = inc[j] - c[j]
+        t = s[j] + y
+        new_c = t - s[j]
+        new_c = new_c - y
+        out_s[j] = t
+        out_c[j] = new_c
+
+
+def _numba_kernel():
+    global _NUMBA_TRIED, _NUMBA_KERNEL
+    if not _NUMBA_TRIED:
+        try:
+            from numba import njit
+        except ImportError:
+            _NUMBA_TRIED = True
+            return None
+        _NUMBA_KERNEL = njit(cache=False, fastmath=False, nogil=True)(_ordered_flat)
+        _NUMBA_TRIED = True
+    return _NUMBA_KERNEL
+
+
+def kahan_compact(s, c, inc, *, reference):
+    """Run the same ordered arithmetic with two output allocations."""
+    operands = (s, c, inc)
+    if not all(getattr(v, 'dtype', None) == np.dtype('float64')
+               and getattr(v, 'shape', None) == s.shape
+               and v.flags.c_contiguous for v in operands):
+        return reference(s, c, inc)
+    xp = array_namespace(*operands)
+    if xp is np:
+        kernel = _numba_kernel()
+        if kernel is None:
+            return reference(s, c, inc)
+        out_s, out_c = np.empty(s.shape, dtype=np.float64), np.empty(s.shape, dtype=np.float64)
+        kernel(s.reshape(-1), c.reshape(-1), inc.reshape(-1), out_s.reshape(-1), out_c.reshape(-1))
+        return out_s, out_c
+    if xp.__name__ != 'cupy':
+        return reference(s, c, inc)
+    global _CUDA_KERNEL
+    if _CUDA_KERNEL is None:
+        _CUDA_KERNEL = xp.ElementwiseKernel(
+            'float64 s, float64 c, float64 inc', 'float64 out_s, float64 out_c',
+            '''double y = __dsub_rn(inc, c);
+               double t = __dadd_rn(s, y);
+               double next_c = __dsub_rn(t, s);
+               out_c = __dsub_rn(next_c, y);
+               out_s = t;''',
+            'maple_compact_ledger_ordered_kahan_f64')
+    return _CUDA_KERNEL(s, c, inc)
+
+
+# ---------------------------------------------------------------------------
+# CW-B18: the SAME ordered arithmetic written into PRIVATE owned buffers.
+#
+# Used only by `accumulate._accumulate_water_transfer_into_owned`, after it
+# has proven that `s` and `c` are freshly allocated, privately owned arrays
+# that no caller, callback or other field can see. Per element, both inputs
+# are read into locals BEFORE either output is stored, and the four
+# operations are exactly those of `_ordered_flat` / `_kahan_add`:
+#     y = inc - c;  t = s + y;  c' = (t - s) - y;  s' = t
+# so writing back into `s` and `c` cannot change any value. `inc` must not
+# share storage with `s` or `c` (the caller proves that too).
+# ---------------------------------------------------------------------------
+
+_NUMBA_INPLACE = None
+_NUMBA_INPLACE_TRIED = False
+_CUDA_INPLACE = None
+
+
+def _ordered_flat_inplace(s, c, inc):
+    for j in range(s.size):
+        s_j = s[j]
+        c_j = c[j]
+        y = inc[j] - c_j
+        t = s_j + y
+        new_c = t - s_j
+        new_c = new_c - y
+        s[j] = t
+        c[j] = new_c
+
+
+def _numba_inplace_kernel():
+    global _NUMBA_INPLACE, _NUMBA_INPLACE_TRIED
+    if not _NUMBA_INPLACE_TRIED:
+        try:
+            from numba import njit
+        except ImportError:
+            _NUMBA_INPLACE_TRIED = True
+            return None
+        _NUMBA_INPLACE = njit(cache=False, fastmath=False, nogil=True)(_ordered_flat_inplace)
+        _NUMBA_INPLACE_TRIED = True
+    return _NUMBA_INPLACE
+
+
+def inplace_kahan_available(xp) -> bool:
+    """Whether the owned in-place kernel exists for namespace `xp` (NumPy
+    with Numba, or CuPy). Callers fall back to the allocating path otherwise."""
+    if xp is np:
+        return _numba_inplace_kernel() is not None
+    return getattr(xp, "__name__", "") == "cupy"
+
+
+def kahan_compact_into_owned(s, c, inc) -> None:
+    """Write `kahan(s, c, inc)` into `s` and `c` (owned, C-contiguous FP64,
+    same shape as `inc`). Raises rather than falling back: eligibility is
+    decided by the caller before any write."""
+    for v in (s, c, inc):
+        if getattr(v, "dtype", None) != np.dtype("float64") or v.shape != s.shape or not v.flags.c_contiguous:
+            raise ValueError("kahan_compact_into_owned: operands must be matching C-contiguous float64")
+    xp = array_namespace(s, c, inc)
+    if xp is np:
+        kernel = _numba_inplace_kernel()
+        if kernel is None:
+            raise RuntimeError("kahan_compact_into_owned: Numba is not available")
+        kernel(s.reshape(-1), c.reshape(-1), inc.reshape(-1))
+        return
+    if getattr(xp, "__name__", "") != "cupy":
+        raise RuntimeError("kahan_compact_into_owned: unsupported namespace")
+    global _CUDA_INPLACE
+    if _CUDA_INPLACE is None:
+        _CUDA_INPLACE = xp.ElementwiseKernel(
+            'float64 inc', 'float64 s, float64 c',
+            '''const double s_j = s;
+               const double c_j = c;
+               const double y = __dsub_rn(inc, c_j);
+               const double t = __dadd_rn(s_j, y);
+               const double next_c = __dsub_rn(t, s_j);
+               c = __dsub_rn(next_c, y);
+               s = t;''',
+            'maple_compact_ledger_ordered_kahan_f64_owned')
+    _CUDA_INPLACE(inc, s, c)
