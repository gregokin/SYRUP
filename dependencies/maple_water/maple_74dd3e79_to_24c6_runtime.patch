+            xp = array_namespace(array)
+            process_slice = array[slot]
+            if rule == "nonpositive":
+                violation = process_slice > 0
+                if to_int(xp.count_nonzero(violation)):
+                    _raise_sign_violation(process_idx, rule, to_float(process_slice[violation].max()), name)
+            else:
+                violation = process_slice < 0
