+# --- Python reference (qualification and tests; also the encoder / advance when Numba is absent) --------------------------
+def _leaf_sum(get, start: int, n: int) -> float:
+    if n < LANES:
+        value = -0.0
+        for k in range(n):
+            value = value + get(start + k)
+        return value
+    r = [get(start + j) for j in range(LANES)]
+    end = n - n % LANES
+    for k in range(LANES, end, LANES):
+        for j in range(LANES):
+            r[j] = r[j] + get(start + k + j)
+    value = ((r[0] + r[1]) + (r[2] + r[3])) + ((r[4] + r[5]) + (r[6] + r[7]))
+    for k in range(end, n):
+        value = value + get(start + k)
+    return value
+
+
+def _tree_sum(get, start: int, n: int) -> float:
+    if n <= LEAF:
+        return _leaf_sum(get, start, n)
+    left = _half(n)
+    return _tree_sum(get, start, left) + _tree_sum(get, start + left, n - left)
+
+
+def _encode_leaf_reference(get, start: int, count: int, q: int, packet, levels: int) -> None:
+    """Leaf accumulators over the deep positions `[start, start + q)` of the leaf `[start, start + count)`."""
+    rounded = count - count % LANES
+    if count < LANES or q >= rounded:
+        if count < LANES:
+            value = -0.0
+            for k in range(q):
+                value = value + get(start + k)
+        else:
+            value = _leaf_sum(get, start, rounded)
+            for k in range(rounded, q):
+                value = value + get(start + k)
+        packet[levels] = value
+        return
+    for j in range(LANES):
+        if j >= q:
+            continue
+        value = get(start + j)
+        for k in range(j + LANES, q, LANES):
+            value = value + get(start + k)
+        packet[levels + j] = value
+
+
+def _encode_cell_reference(get, n: int, p: int, levels: int, packet) -> None:
+    start, count, level = 0, n, 0
+    while count > LEAF:
+        left = _half(count)
+        if p >= start + left:
+            packet[level] = _tree_sum(get, start, left)
+            start, count = start + left, count - left
+        else:
+            count = left
+        level += 1
+    _encode_leaf_reference(get, start, count, p - start, packet, levels)
+
+
+def _decode_leaf_reference(packet, levels: int, future, start: int, count: int, q: int) -> float:
+    rounded = count - count % LANES
+    if count < LANES or q >= rounded:
+        value = float(packet[levels])
+        for k in range(q, count):
+            value = value + future(start + k)
+        return value
+    r = [float(packet[levels + j]) if j < q else future(start + j) for j in range(LANES)]
+    for k in range(LANES, rounded, LANES):
+        for j in range(LANES):
+            if k + j >= q:
+                r[j] = r[j] + future(start + k + j)
+    value = ((r[0] + r[1]) + (r[2] + r[3])) + ((r[4] + r[5]) + (r[6] + r[7]))
+    for k in range(rounded, count):
+        value = value + future(start + k)
+    return value
+
+
+def _decode_node_reference(packet, levels: int, start: int, count: int, level: int, p: int, future, stop: int) -> float:
+    """The tree sum of node `[start, start + count)` from the packet path and the future accessor (no outer +0)."""
+    if count > LEAF:
+        left = _half(count)
+        if p >= start + left:
+            return float(packet[level]) + _decode_node_reference(packet, levels, start + left, count - left, level + 1,
+                                                                 p, future, stop)
+        right = 0.0 if start + left >= stop else _tree_sum(future, start + left, count - left)
+        return _decode_node_reference(packet, levels, start, left, level + 1, p, future, stop) + right
+    return _decode_leaf_reference(packet, levels, future, start, count, p - start)
+
+
+def _decode_cell_reference(packet, levels: int, n: int, p: int, window) -> float:
+    stop = p + len(window)
+
+    def future(i):
+        return float(window[i - p]) if i < stop else 0.0
+
+    return 0.0 + _decode_node_reference(packet, levels, 0, n, 0, p, future, stop)
+
+
+def _advance_cell_reference(old, levels: int, n: int, p: int, p2: int, leaving, new) -> None:
+    """New packet for prefix `p2 >= p` from the old packet and the leaving values `[p, p2)` (no deep read)."""
+    def lv(i):
+        return float(leaving[i - p])
+
+    shared = True  # the old boundary path still shares the current node
+    start, count, level = 0, n, 0
+    while count > LEAF:
+        left = _half(count)
+        if p2 >= start + left:
+            if shared and p >= start + left:
+                new[level] = old[level]
+            elif shared:
+                # the old path went left here: that left subtree is old-deep (packet path) plus leaving values
+                new[level] = _decode_node_reference(old, levels, start, left, level + 1, p, lv, p2)
+                shared = False
+            else:
+                new[level] = _tree_sum(lv, start, left)  # entirely leaving values
+            start, count = start + left, count - left
+        else:
+            count = left
+        level += 1
+    q2 = p2 - start
+    if not shared:
+        _encode_leaf_reference(lv, start, count, q2, new, levels)
+        return
+    q = p - start
+    rounded = count - count % LANES
+    if count < LANES or q >= rounded:
+        value = float(old[levels])
+        for k in range(q, q2):
+            value = value + lv(start + k)
+        new[levels] = value
+        return
+    r = [float(old[levels + j]) if j < q else (lv(start + j) if j < q2 else 0.0) for j in range(LANES)]
+    if q2 >= rounded:
+        for k in range(LANES, rounded, LANES):
+            for j in range(LANES):
+                if k + j >= q:
+                    r[j] = r[j] + lv(start + k + j)
+        value = ((r[0] + r[1]) + (r[2] + r[3])) + ((r[4] + r[5]) + (r[6] + r[7]))
+        for k in range(rounded, q2):
+            value = value + lv(start + k)
+        new[levels] = value
+        return
+    for k in range(LANES, rounded, LANES):
+        for j in range(LANES):
+            if q <= k + j < q2:
+                r[j] = r[j] + lv(start + k + j)
+    for j in range(LANES):
+        new[levels + j] = r[j] if j < q2 else 0.0
+
