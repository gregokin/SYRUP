+++ b/src/maple/water/windowed_transaction.py
@@ -0,0 +1,210 @@
+"""CW-B75 PRIVATE: one windowed water step pair -- pickup, an external transport callback, deposit -- in ONE frame.
+
+Not exported (no `__all__` entry, not imported by `maple.water`), no public flag on any public function.
+
+Why: the sequential coupling (public pickup call -> transport -> public deposit call) makes the deposit call copy
+the post-pickup column (window, totals, base, deep metadata, prefix packets) and allocate a fresh ledger from its
+first accumulation, while the post-pickup column and ledger stay alive in the caller. Here the post-pickup column
+and ledger are created and consumed inside this function only: they are never returned, published, or handed to the
+callback, so the deposit phase may ADOPT them (structural ownership by scoping -- no escaped ownership token, no
+identity or reference-count inference).
+
+Contract (`_apply_windowed_pickup_transport_deposit`)
+------------------------------------------------------
+Inputs: the caller's ACCEPTED state `voxel_column` (C0), `active_layer` (A0), `water` (W0), `ledger` (L0),
+`sediment_availability` (V0), `initial_available_fraction`; `pickup_holder` -- a ONE-element list holding the pickup
+`WaterProcessDemand`, popped here (single-use handoff, so neither the caller nor this frame keeps the requested
+pickup alive through the callback); `between` -- the transport callback; the public step's keyword options.
+
+Phase P: the PUBLIC step body (`windowed_step._apply_windowed_water_process_demand(..., _owned=None)`, i.e. exactly
+`apply_windowed_water_process_demand`) on (C0, A0, W0, L0, pickup demand): its validations, availability cap,
+begin, shared arithmetic, publication into a private result and `validate_water_process_result`. Then only the
+post-pickup column C_p, active layer A_p, ledger L_p, availability V_p and the accounting view are kept; the result
+object (with its post-pickup water, zero face flux, requested-removal reference and receipt) is released.
+
+Callback: `between(view)` with `view` a `PickupView` holding ONLY the actual removal per cell/class (borrowed;
+never written afterwards) and the class / scalar accounting reductions. It must return
+`(depth_m, mobile_kg, deposit_demand)` -- the depth and post-transport mobile pool of the deposit call's water and
+its `WaterProcessDemand`. Any exception (e.g. a transport rejection) propagates; nothing has been published and
+C0 / A0 / W0 / L0 / V0 / the deep store are untouched.
+
+Callback results: the new water is checked like `with_water` (`WaterState`, `resolve_operand_namespace` over the
+private post-pickup state, the new water and the initial available fraction, `validate_water_state`), then every
+returned array is refused if it shares memory with any private post-pickup array (column, active layer,
+availability, ledger).
+
+Phase D: the same shared body on (C_p, A_p, new water, L_p, deposit demand, V_p) with an internal owner: the
+working bed is adopted from C_p (`windowed_transfer._begin_owned_windowed_transaction`, every public begin rule),
+the first ledger accumulation donates into L_p when `_accumulate_water_transfer_into_owned` proves it (caller
+ledger L0 plus every caller, borrowed and callback array in the foreign set; exact allocating fallback
+otherwise), and the second accumulation is guarded against L0 and the same foreign set. Stage-9 publication and
+`validate_water_process_result` are unchanged; deep-store writes remain the caller's later publication.
+
+Returns `(view, deposit_result)`: the pickup view and the PUBLIC `WindowedWaterProcessResult` of the deposit
+phase (bound to the caller's deep-store version, pending journal, exactly as the sequential deposit call's).
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any
+
+from maple.core.backend import array_leaves, arrays_share_memory, is_array, resolve_operand_namespace
+from maple.core.types.water import WaterState
+from maple.surface.voxels.deep_store import DEFAULT_MAX_JOURNAL_RECORDS
+from maple.surface.voxels.windowed_transfer import DEFAULT_EXCHANGE_GATHER_COLUMNS, _begin_owned_windowed_transaction
+from maple.water.interfaces import WaterProcessDemand
+from maple.water.validation import validate_water_state
+from maple.water.windowed_step import _OWNER_HELD, WindowedWaterProcessResult, _apply_windowed_water_process_demand
+
+#: Accounting fields of the pickup result exposed to the callback (no state object, no donor array).
+PICKUP_VIEW_FIELDS = ("actual_removal_by_cell_class_kg", "requested_removal_by_class_kg",
+                      "actual_removal_by_class_kg", "availability_shortfall_by_class_kg", "shortfall_by_class_kg",
+                      "numerical_residual_by_class_kg", "numerical_residual_scalar_kg")
+
+
+class PairedTransactionError(ValueError):
+    """A paired-transaction contract refusal (handoff, callback result shape/type or aliasing)."""
+
+
+@dataclass(frozen=True, eq=False)
+class PickupView:
+    """What the transport callback may see of the pickup phase: the ACTUAL removal per cell/class (borrowed) and
+    the accounting reductions -- never a column, ledger, active layer, availability or water object."""
+
+    actual_removal_by_cell_class_kg: Any
+    requested_removal_by_class_kg: Any
+    actual_removal_by_class_kg: Any
+    availability_shortfall_by_class_kg: Any
+    shortfall_by_class_kg: Any
+    numerical_residual_by_class_kg: Any
+    numerical_residual_scalar_kg: Any
+
+
+class _DepositOwner:
+    """Internal (never escapes this module's frame): the deposit phase's adoption and donation rules."""
+
+    __slots__ = ("column", "caller_ledger", "ledger", "foreign", "caller_state", "first_blocker", "begin_mode",
+                 "availability")
+
+    def __init__(self, column, caller_ledger, ledger, foreign, caller_state, availability):
+        self.column, self.caller_ledger, self.ledger, self.foreign = column, caller_ledger, ledger, tuple(foreign)
+        self.caller_state = tuple(caller_state)
+        self.first_blocker = "not run"
+        self.begin_mode = "not run"
+        # CW-B79: the private post-pickup availability V_p (or None), held here instead of in the transaction frame
+        # or the deposit call's keyword arguments; handed over ONCE to the deposit body, which drops it after its
+        # last read.
+        self.availability = [availability]
+
+    def take_availability(self, placeholder):
+        if placeholder is not _OWNER_HELD:
+            raise PairedTransactionError("the owned deposit takes its availability only through the owner placeholder")
+        if not self.availability:
+            raise PairedTransactionError("the owner-held availability was already taken")
+        return self.availability.pop()
+
+    def begin(self, column, geometry, mass_resolution_kg, *, trust_window_cache, max_gather_columns,
+              max_journal_records):
+        from maple.surface.voxels.windowed_transfer import begin_windowed_transaction
+
+        if column is not self.column:
+            raise PairedTransactionError("the owned deposit begin accepts only the transaction's private column")
+        kwargs = dict(trust_window_cache=trust_window_cache, max_gather_columns=max_gather_columns,
+                      max_journal_records=max_journal_records)
+        # Adoption only of storage the caller's state cannot reach (phase P made private copies); any overlap
+        # with a caller array (memory ranges) takes the public copying begin instead -- identical bytes.
+        adoptable = [a for a in array_leaves(column.window_kg, column.window_cache, column.base,
+                                             column.deep_by_class_kg, column.deep_total_kg, column.deep_room_kg,
+                                             column.height_packet) if is_array(a)]
+        if any(arrays_share_memory(a, c) for a in adoptable for c in self.caller_state
+               if type(a) is type(c)):
+            self.begin_mode = "copy: private column shares storage with the caller's state"
+            return begin_windowed_transaction(column, geometry, mass_resolution_kg, **kwargs)
+        self.begin_mode = "owned"
+        return _begin_owned_windowed_transaction(column, geometry, mass_resolution_kg, **kwargs)
+
+    def first_accumulation(self, ledger, process, actual_kg, residual_kg, mass_resolution_kg, *, foreign_arrays):
+        from maple.coupling.sediment_ledger.accumulate import _accumulate_water_transfer_into_owned
+
+        if ledger is not self.ledger:
+            raise PairedTransactionError("the owned first accumulation accepts only the transaction's private ledger")
+        new_ledger, self.first_blocker = _accumulate_water_transfer_into_owned(
+            ledger, self.caller_ledger, process, actual_kg, residual_kg, mass_resolution_kg,
+            foreign_arrays=tuple(foreign_arrays) + self.foreign)
+        return new_ledger
+
+    def second_foreign(self):
+        # After a donation the private post-pickup ledger's arrays ARE the working ledger's; otherwise (fallback) it
+        # is a separate live private ledger and joins the foreign set.
+        extra = () if self.first_blocker is None else array_leaves(self.ledger)
+        return self.foreign + extra
+
+
+def _private_arrays(*objects):
+    return [a for a in array_leaves(*objects) if is_array(a)]
+
+
+def _apply_windowed_pickup_transport_deposit(
+    voxel_column, active_layer, water, ledger, pickup_holder, geometry, grain_classes, mass_resolution_kg, *,
+    between, sediment_availability=None, initial_available_fraction=None, adapter_name="prescribed",
+    detachment_integration="rate_times_dt", trust_window_cache=False,
+    max_gather_columns=DEFAULT_EXCHANGE_GATHER_COLUMNS, max_journal_records=DEFAULT_MAX_JOURNAL_RECORDS,
+):
+    """See the module docstring. PRIVATE; returns `(PickupView, WindowedWaterProcessResult)`."""
+    if not isinstance(pickup_holder, list) or len(pickup_holder) != 1:
+        raise PairedTransactionError("pickup_holder must be a one-element list (single-use handoff)")
+    if not callable(between):
+        raise PairedTransactionError("between must be callable")
+    options = dict(adapter_name=adapter_name, detachment_integration=detachment_integration,
+                   trust_window_cache=trust_window_cache, max_gather_columns=max_gather_columns,
+                   max_journal_records=max_journal_records)
+    # --- phase P: the public step, exactly ---------------------------------------------------------------------
+    result = _apply_windowed_water_process_demand(
+        voxel_column, active_layer, water, ledger, pickup_holder.pop(), geometry, grain_classes, mass_resolution_kg,
+        sediment_availability=sediment_availability, initial_available_fraction=initial_available_fraction,
+        _owned=None, **options)
+    view = PickupView(**{name: getattr(result, name) for name in PICKUP_VIEW_FIELDS})
+    column_p, layer_p, ledger_p = result.new_voxel_column, result.new_active_layer, result.new_ledger
+    availability_p = result.new_sediment_availability
+    del result  # post-pickup water, zero face flux, requested-removal reference, receipt: released before transport
+
+    # --- the external transport ----------------------------------------------------------------------------------
+    returned = between(view)
+    if not isinstance(returned, tuple) or len(returned) != 3:
+        raise PairedTransactionError("between must return (depth_m, mobile_kg, deposit_demand)")
+    depth_m, mobile_kg, deposit_demand = returned
+    del returned
+    if not isinstance(deposit_demand, WaterProcessDemand):
+        raise PairedTransactionError("between must return a WaterProcessDemand as the deposit demand")
+    # `with_water`'s checks of the new water, over the private post-pickup state
+    new_water = WaterState(depth_m, mobile_kg)
+    resolve_operand_namespace((column_p, layer_p, ledger_p, availability_p), new_water, initial_available_fraction)
+    validate_water_state(new_water, geometry.ny, geometry.nx, len(grain_classes.classes))
+    private = _private_arrays(column_p, layer_p, ledger_p, availability_p)
+    callback_arrays = _private_arrays(new_water, deposit_demand)
+    for a in callback_arrays:
+        for p in private:
+            if arrays_share_memory(a, p):
+                raise PairedTransactionError("a callback-returned array shares storage with the transaction's "
+                                             "private post-pickup state; refused before any deposit work")
+    # CW-B79: the loop names would otherwise keep the LAST checked arrays (the last private leaf is V_p's bound
+    # mass) alive through the deposit phase.
+    a = p = None
+    del private
+    # --- phase D: the same shared body with the internal owner ----------------------------------------------------
+    caller_state = array_leaves(voxel_column, active_layer, water, ledger, sediment_availability,
+                                initial_available_fraction)
+    owner = _DepositOwner(column_p, ledger, ledger_p,
+                          array_leaves(voxel_column, active_layer, water, sediment_availability,
+                                       initial_available_fraction, view, *callback_arrays),
+                          caller_state, availability_p)
+    del caller_state
+    del callback_arrays
+    del availability_p  # CW-B79: now held only by the owner (taken by the deposit body)
+    deposit = _apply_windowed_water_process_demand(
+        column_p, layer_p, new_water, ledger_p, deposit_demand, geometry, grain_classes, mass_resolution_kg,
+        sediment_availability=_OWNER_HELD, initial_available_fraction=initial_available_fraction,
+        _owned=owner, **options)
+    if not isinstance(deposit, WindowedWaterProcessResult):  # defensive; the shared body returns this type
+        raise PairedTransactionError("deposit phase did not return a WindowedWaterProcessResult")
+    return view, deposit
