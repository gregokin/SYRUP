+            value = -0.0
+            for k in range(n):
+                value = value + row[start + k]
+            return value
+        r = np.empty(8, np.float64)
+        for j in range(8):
+            r[j] = row[start + j]
+        end = n - n % 8
+        k = 8
+        while k < end:
+            for j in range(8):
+                r[j] = r[j] + row[start + k + j]
+            k += 8
+        value = ((r[0] + r[1]) + (r[2] + r[3])) + ((r[4] + r[5]) + (r[6] + r[7]))
+        for k in range(end, n):
+            value = value + row[start + k]
+        return value
+
+    @jit
+    def tree_row(row, start, n):
+        if n <= 128:
+            return leaf_row(row, start, n)
+        starts = np.empty(32, np.int64)
+        lengths = np.empty(32, np.int64)
+        left = np.empty(32, np.float64)
+        stage = np.empty(32, np.int64)
+        sp = 0
+        starts[0] = start
+        lengths[0] = n
+        stage[0] = 0
+        value = -0.0
+        while sp >= 0:
+            count = lengths[sp]
+            if count <= 128:
+                value = leaf_row(row, starts[sp], count)
+                sp -= 1
+            else:
+                half = (count // 2) - ((count // 2) % 8)
+                if stage[sp] == 0:
+                    stage[sp] = 1
+                    begin = starts[sp]
+                    sp += 1
+                    starts[sp] = begin
+                    lengths[sp] = half
+                    stage[sp] = 0
+                elif stage[sp] == 1:
+                    left[sp] = value
+                    stage[sp] = 2
+                    begin = starts[sp] + half
+                    sp += 1
+                    starts[sp] = begin
+                    lengths[sp] = count - half
+                    stage[sp] = 0
+                else:
+                    value = left[sp] + value
+                    sp -= 1
+        return value
+
+    @jit
+    def encode_leaf_row(row, start, count, q, packet, levels):
+        rounded = count - count % 8
+        if count < 8 or q >= rounded:
+            if count < 8:
+                value = -0.0
+                for k in range(q):
+                    value = value + row[start + k]
+            else:
+                value = leaf_row(row, start, rounded)
+                for k in range(rounded, q):
+                    value = value + row[start + k]
+            packet[levels] = value
+            return
+        for j in range(8):
+            if j >= q:
+                continue
+            value = row[start + j]
+            k = j + 8
+            while k < q:
+                value = value + row[start + k]
+                k += 8
+            packet[levels + j] = value
+
+    @jit
+    def encode_cells(columns2, base, nc, n, levels, packet2):
+        cells = packet2.shape[0]
+        for cell in range(cells):
+            row = columns2[cell]
+            packet = packet2[cell]
+            for j in range(packet.shape[0]):
+                packet[j] = 0.0
+            p = np.int64(base[cell]) * nc
+            start = 0
+            count = n
+            level = 0
+            while count > 128:
+                left = (count // 2) - ((count // 2) % 8)
+                if p >= start + left:
+                    packet[level] = tree_row(row, start, left)
+                    start = start + left
+                    count = count - left
+                else:
+                    count = left
+                level += 1
+            encode_leaf_row(row, start, count, p - start, packet, levels)
+
+    @jit
+    def advance_cells(old2, base, new_base, leaving2, nc, n, levels, new2):
+        cells = new2.shape[0]
+        for cell in range(cells):
+            old = old2[cell]
+            new = new2[cell]
+            for j in range(new.shape[0]):
+                new[j] = 0.0
+            lv = leaving2[cell]
+            p = np.int64(base[cell]) * nc
+            p2 = np.int64(new_base[cell]) * nc
+            shared = True
+            start = 0
+            count = n
+            level = 0
+            while count > 128:
+                left = (count // 2) - ((count // 2) % 8)
+                if p2 >= start + left:
+                    if shared and p >= start + left:
+                        new[level] = old[level]
+                    elif shared:
