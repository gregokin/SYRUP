+    # CW-B44: the full shortfall array is reported only as its class sum.
+    # It is the cap's own new array (`zeros_like` or `requested - capped`),
+    # never a caller or result array; the same reduction is taken here and
+    # the array is released.
+    availability_shortfall_by_class_kg = availability_shortfall.sum(axis=(0, 1))
+    del availability_shortfall
+
+    # --- working bed: the ONE window copy of this step ----------------------
