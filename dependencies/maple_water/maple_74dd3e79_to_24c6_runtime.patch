index 92cabd9477e636e12ae2172bba4022ff7ad2bc74..068f60926b9dcae0f0114e5ea18850accdd05404 100644
--- a/src/maple/surface/voxels/_numerics.py
+++ b/src/maple/surface/voxels/_numerics.py
@@ -359,3 +359,63 @@ def make_proportional_mass_vector(
     corrected = vector + xp.where(is_largest, residual[..., None], 0.0)
     correction_is_safe = xp.all(corrected >= 0.0, axis=-1, keepdims=True) & (weight_sum > 0)  # (..., 1)
     return xp.where(correction_is_safe, corrected, vector)
+
+
+def _make_proportional_mass_vector_device_scratch(
+    total_mass_kg: MapleArray, class_weights: MapleArray
+) -> MapleArray:
+    """CW-B96 PRIVATE (not exported): `make_proportional_mass_vector` for a
+    CuPy float64 C-contiguous `(..., n_classes)` class_weights and a
+    float64 C-contiguous `total_mass_kg` of shape `class_weights.shape[:-1]`,
+    holding at most two full class grids instead of four.
+
+    Every value is produced by the public function's own operation, on the
+    same operands, in the same order: the same weight sum, the same
+    `divide_where` CuPy branch (guarded denominator, quotient, 0.0 fill
+    where the row weight is not positive), the same product, argmax
+    one-hot, residual, `where`, sum, safety test and final selection. The
+    only difference is ownership: the quotient buffer is overwritten in
+    place by the fill and then the product (`proportions` is dead once
+    `vector` exists), and the `where` temporary is overwritten in place by
+    `vector + temporary` (`corrected`) and then by the final selection.
+    Only this function's own buffers are written; `total_mass_kg` and
+    `class_weights` are never mutated and the result aliases neither. No
+    scalar is read back to the host.
+
+    Any other input (NumPy, another dtype or layout, a broadcasting total)
+    is delegated unchanged to `make_proportional_mass_vector`.
+    """
+    xp = array_namespace(total_mass_kg, class_weights)
+    if (
+        xp is np
+        or not isinstance(total_mass_kg, xp.ndarray)
+        or not isinstance(class_weights, xp.ndarray)
+        or class_weights.ndim < 1
+        or class_weights.dtype != np.float64
+        or total_mass_kg.dtype != np.float64
+        or total_mass_kg.shape != class_weights.shape[:-1]
+        or not class_weights.flags.c_contiguous
+        or not total_mass_kg.flags.c_contiguous
+    ):
+        return make_proportional_mass_vector(total_mass_kg, class_weights)
+    weight_sum = class_weights.sum(axis=-1, keepdims=True)
+    has_weight = weight_sum > 0
+    # divide_where's CuPy branch: the quotient, then its zeros_like fill where the weight sum is not positive.
+    guarded_denominator = xp.where(has_weight, weight_sum, 1.0)
+    vector = class_weights / guarded_denominator
+    del guarded_denominator, weight_sum
+    xp.copyto(vector, 0.0, where=~has_weight)
+    xp.multiply(vector, total_mass_kg[..., None], out=vector)  # proportions * total_mass_kg[..., None]
+
+    n_classes = class_weights.shape[-1]
+    largest_idx = xp.argmax(class_weights, axis=-1)  # (...,)
+    is_largest = xp.arange(n_classes) == largest_idx[..., None]  # (..., n_classes) one-hot
+    del largest_idx
+
+    residual = total_mass_kg - vector.sum(axis=-1)  # (...,)
+    corrected = xp.where(is_largest, residual[..., None], 0.0)
+    del is_largest, residual
+    xp.add(vector, corrected, out=corrected)  # vector + where(...)
+    correction_is_safe = xp.all(corrected >= 0.0, axis=-1, keepdims=True) & has_weight  # (..., 1)
+    xp.copyto(corrected, vector, where=~correction_is_safe)  # where(correction_is_safe, corrected, vector)
+    return corrected
diff --git a/src/maple/surface/voxels/deep_store.py b/src/maple/surface/voxels/deep_store.py
