+# ---------------------------------------------------------------------------
+# Declared ordered reductions (elementwise adds only; same on every backend)
+# ---------------------------------------------------------------------------
+
+
+def sequential_prefix_by_class_reference(columns: MapleArray, n_prefix: MapleArray) -> MapleArray:
+    """`prefix[c, :] = ((columns[c, 0] + columns[c, 1]) + ...) + columns[c,
+    n_prefix[c] - 1]`, with `prefix[c] = 0` where `n_prefix[c] == 0`.
+    `columns` `(k, n_voxels, n_classes)`, `n_prefix` `(k,)` integers in
+    `[0, n_voxels]`. One elementwise add per voxel level, vectorised over
+    the `k` columns; the loop count is `max(n_prefix)`."""
+    xp = array_namespace(columns, n_prefix)
+    k, n_voxels, n_classes = columns.shape
+    prefix = xp.zeros((k, n_classes), dtype=np.float64)
+    if k == 0:
+        return prefix
+    n_max = to_int(n_prefix.max())  # one counted scalar read on a device input
+    if n_max > n_voxels:
+        raise ValueError(f"n_prefix exceeds n_voxels={n_voxels}")
+    for v in range(n_max):
+        active = (n_prefix > v)[:, None]
+        prefix = xp.where(active, prefix + columns[:, v, :], prefix)
+    return prefix
+
+
+def sequential_room_prefix_reference(voxel_totals: MapleArray, n_prefix: MapleArray, capacity_kg: float) -> MapleArray:
+    """`room[c] = ((r0 + r1) + ...) + r_{n_prefix[c]-1}` with `r_v =
+    max(capacity - voxel_totals[c, v], 0)`. `voxel_totals` `(k, n_voxels)`."""
+    xp = array_namespace(voxel_totals, n_prefix)
+    k, n_voxels = voxel_totals.shape
+    room = xp.zeros((k,), dtype=np.float64)
+    if k == 0:
+        return room
+    n_max = to_int(n_prefix.max())
+    if n_max > n_voxels:
+        raise ValueError(f"n_prefix exceeds n_voxels={n_voxels}")
+    for v in range(n_max):
+        active = n_prefix > v
+        room = xp.where(active, room + xp.maximum(capacity_kg - voxel_totals[:, v], 0.0), room)
+    return room
+
+
+def _host_prefix_compiled(columns,n_prefix):
+    # All other namespaces/shapes/types use the original public behavior.
+    if (not isinstance(columns,np.ndarray) or columns.dtype!=np.float64 or
+            not isinstance(n_prefix,np.ndarray) or n_prefix.dtype not in (np.dtype('int32'),np.dtype('int64')) or
+            n_prefix.ndim!=1 or columns.ndim not in (2,3) or columns.shape[0]!=n_prefix.shape[0]):
+        return None
+    if n_prefix.size and int(n_prefix.max())>columns.shape[1]:
+        raise ValueError(f"n_prefix exceeds n_voxels={columns.shape[1]}")
+    from maple.surface.voxels.windowed_metadata_numba import kernels
+
+    return kernels()
+
+
+def sequential_prefix_by_class(columns: MapleArray,n_prefix: MapleArray) -> MapleArray:
+    """The same declared ordered fold; compiled for bounded host metadata."""
+    compiled=_host_prefix_compiled(columns,n_prefix)
+    if compiled is not None and columns.ndim==3:
+        return compiled['by_class'](columns,n_prefix)
+    return sequential_prefix_by_class_reference(columns,n_prefix)
+
+
+def sequential_room_prefix(voxel_totals: MapleArray,n_prefix: MapleArray,capacity_kg: float) -> MapleArray:
+    """The same room fold with unchanged original per-voxel capacity test."""
+    compiled=_host_prefix_compiled(voxel_totals,n_prefix)
+    if (compiled is not None and voxel_totals.ndim==2
+            and isinstance(capacity_kg,(float,np.float64)) and np.isfinite(capacity_kg)):
+        return compiled['room'](voxel_totals,n_prefix,capacity_kg)
+    return sequential_room_prefix_reference(voxel_totals,n_prefix,capacity_kg)
+
+
+def sequential_class_fold(by_class: MapleArray) -> MapleArray:
+    """`((x[..., 0] + x[..., 1]) + x[..., 2]) + ...` over the trailing class
+    axis: the declared class total of this module (NOT the library's
+    `sum(axis=-1)`, whose grouping may differ between backends for 8 or
+    more classes)."""
+    n_classes = by_class.shape[-1]
+    if n_classes == 0:
+        raise ValueError("by_class has no class axis entries")
+    total = by_class[..., 0] + 0.0
+    for c in range(1, n_classes):
+        total = total + by_class[..., c]
+    return total
+
+
+def voxel_totals_for_window(window_kg: MapleArray) -> MapleArray:
+    """Per-slot totals `(ny, nx, W)` by the dense validator's own per-voxel
+    convention (`sum(axis=-1)`), for occupancy and room decisions."""
+    return window_kg.sum(axis=-1)
+
+
+# ---------------------------------------------------------------------------
+# Host metadata from full columns (construction and validation share it)
+# ---------------------------------------------------------------------------
+
+
+def _canonical_base(block: np.ndarray, window_voxels: int) -> tuple[np.ndarray, np.ndarray]:
+    """`(base, top)` for host columns `(k, n_voxels, n_classes)`: `top` is
+    the highest occupied voxel (-1 if empty), `base = clip(top - (W - 2),
+    0, n_voxels - W)` so that the top sits at slot `W - 2` with one empty
+    slot above and at least one slot below whenever the column allows."""
+    n_voxels = block.shape[1]
+    totals = block.sum(axis=-1)
+    occupied = totals > 0.0
+    has_any = occupied.any(axis=-1)
+    first_from_top = occupied[:, ::-1].argmax(axis=-1)
+    top = np.where(has_any, n_voxels - 1 - first_from_top, -1).astype(np.int64)
+    base = np.clip(top - (window_voxels - 2), 0, n_voxels - window_voxels).astype(np.int32)
+    return base, top
+
+
+def _metadata_from_columns(
+    block: np.ndarray, base: np.ndarray, window_voxels: int, capacity_kg: float
+) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
+    """`(window, deep_by_class, deep_total, deep_room)` of host columns for
+    the given `base` (any base in range; the window slots are copied)."""
+    k = block.shape[0]
+    slots = base.astype(np.int64)[:, None] + np.arange(window_voxels, dtype=np.int64)[None, :]
+    window = block[np.arange(k)[:, None], slots]  # (k, W, nc) copy
+    deep_by_class = sequential_prefix_by_class(block, base.astype(np.int64))
+    deep_room = sequential_room_prefix(block.sum(axis=-1), base.astype(np.int64), capacity_kg)
+    deep_total = sequential_class_fold(deep_by_class)
+    return window, deep_by_class, deep_total, deep_room
+
+
+def _overlay_full_columns(
+    deep_columns: np.ndarray, window_rows: np.ndarray, base_rows: np.ndarray
+) -> np.ndarray:
+    """Write the window over the version's stale entries and zero above:
+    the ONE definition of 'full logical column' for a windowed state.
+    `deep_columns` is a fresh host buffer `(k, n_voxels, n_classes)` and is
+    modified in place; `window_rows` `(k, W, n_classes)`; `base_rows` `(k,)`."""
+    k, n_voxels, _ = deep_columns.shape
+    window_voxels = window_rows.shape[1]
+    base64 = base_rows.astype(np.int64)
+    rows = np.arange(k)
+    for s in range(window_voxels):
+        deep_columns[rows, base64 + s] = window_rows[:, s]
+    above = np.arange(n_voxels)[None, :] >= (base64 + window_voxels)[:, None]
+    deep_columns[above] = 0.0
+    return deep_columns
+
+
+# ---------------------------------------------------------------------------
+# Construction
+# ---------------------------------------------------------------------------
+
+
+def windowed_column_from_dense(
+    column: VoxelColumnState,
+    geometry: GeometrySpec,
+    mass_resolution_kg: float,
+    *,
+    store_dir: str | Path,
+    class_ids: tuple[str, ...],
+    max_store_bytes: int,
+    datum_offset_m: float = 0.0,
+    window_voxels: int = DEFAULT_WINDOW_VOXELS,
+    chunk_columns: int = DEFAULT_CHUNK_COLUMNS,
+    rows_per_band: int | None = None,
+    with_prefix_packets: bool = False,
+) -> WindowedVoxelColumnState:
+    """Build a windowed column AND its genesis deep-store version from a
+    dense MAPLE column. The dense column is validated in full with the
+    existing dense validator FIRST (every column, before any file or array
+    is produced), then streamed to the deep store in row bands and reduced
+    to window/metadata band by band. The input is never mutated; a device
+    column is brought over band by band through the counted `to_host`
+    (one full-domain D2H in total -- this is a construction boundary, not
+    a step). Returns a HOST state bound to the published genesis version.
+
+    `with_prefix_packets=True` (CW-B3c) additionally encodes the exact
+    NumPy-order height packets band by band (bounded host encode, once at
+    genesis) and binds them to the returned column; refused with
+    `PrefixSupportUnavailable` when the E1 module is absent.
+    """
+    if not isinstance(with_prefix_packets, bool):
+        raise ValueError("with_prefix_packets must be a plain bool")
+    packet_grid = None
+    if with_prefix_packets:
+        from maple.surface.voxels.windowed_prefix import (
+            encode_prefix_packets_for_block,
+            packet_terms_for,
+        )
+    require_dense_voxel_column(column, operation="windowed_column_from_dense")
+    check_voxel_column_state(column, geometry, mass_resolution_kg)
+    mass = column.mass_kg
+    if mass.ndim != 4:
+        raise ValueError(f"dense column must be 4-D, got shape {mass.shape}")
+    ny, nx, n_voxels, n_classes = (int(s) for s in mass.shape)
+    if (ny, nx) != (geometry.ny, geometry.nx):
+        raise ValueError(f"dense column grid {(ny, nx)} != geometry {(geometry.ny, geometry.nx)}")
+    width = resolve_window_voxels(window_voxels, n_voxels)
+    header = DeepStoreHeader.from_geometry(
+        geometry, n_voxels=n_voxels, class_ids=tuple(class_ids), window_voxels=width,
+        datum_offset_m=datum_offset_m, chunk_columns=chunk_columns,
+    )
+    if rows_per_band is None:
+        rows_per_band = max(1, chunk_columns // nx)
+    rows_per_band = int(rows_per_band)
+    if rows_per_band < 1:
+        raise ValueError("rows_per_band must be >= 1")
+    capacity = max_voxel_mass_kg(geometry)
+
+    builder = DeepStoreBuilder(store_dir, header, geometry, mass_resolution_kg,
+                               max_store_bytes=max_store_bytes)
+    window = np.empty((ny, nx, width, n_classes), dtype=np.float64)
+    base = np.empty((ny, nx), dtype=np.int32)
+    deep_by_class = np.empty((ny, nx, n_classes), dtype=np.float64)
+    deep_total = np.empty((ny, nx), dtype=np.float64)
+    deep_room = np.empty((ny, nx), dtype=np.float64)
+    if with_prefix_packets:
+        packet_grid = np.empty((ny, nx, packet_terms_for(n_voxels, n_classes)), dtype=np.float64)
+    for r0 in range(0, ny, rows_per_band):
+        r1 = min(ny, r0 + rows_per_band)
+        band = to_host(mass[r0:r1])  # (rows, nx, nv, nc); a view on the host
+        block = np.ascontiguousarray(band).reshape((r1 - r0) * nx, n_voxels, n_classes)
+        builder.add_columns(block)
+        band_base, _ = _canonical_base(block, width)
+        w, d, t, r = _metadata_from_columns(block, band_base, width, capacity)
+        window[r0:r1] = w.reshape(r1 - r0, nx, width, n_classes)
+        base[r0:r1] = band_base.reshape(r1 - r0, nx)
+        deep_by_class[r0:r1] = d.reshape(r1 - r0, nx, n_classes)
+        deep_total[r0:r1] = t.reshape(r1 - r0, nx)
+        deep_room[r0:r1] = r.reshape(r1 - r0, nx)
+        if packet_grid is not None:
+            packet_grid[r0:r1] = encode_prefix_packets_for_block(block, band_base, width).reshape(r1 - r0, nx, -1)
+    version = builder.finish()
+    state = WindowedVoxelColumnState(
+        window_kg=window, base=base, deep_by_class_kg=deep_by_class, deep_total_kg=deep_total,
+        deep_room_kg=deep_room, n_voxels=n_voxels, deep_store=version,
+        generation=version.version_id, manifest_digest=version.manifest_digest,
+    )
+    if packet_grid is not None:
+        from maple.surface.voxels.windowed_prefix import attach_prefix_packets
+
+        state = attach_prefix_packets(state, packet_grid)
+    return state
+
+
+def windowed_column_from_version(
+    version: DeepStoreVersion,
+    geometry: GeometrySpec,
+    mass_resolution_kg: float,
+    *,
+    class_ids: tuple[str, ...] | None = None,
+    with_prefix_packets: bool = False,
+) -> WindowedVoxelColumnState:
+    """Build a HOST windowed state whose window and metadata are derived by
+    streaming an existing version chunk by chunk (the restart / trusted-
+    boundary construction). Every chunk is re-validated with the dense
+    validator as it is read. `W` is the header's recorded window width.
+    `with_prefix_packets=True` (CW-B3c) encodes the height packets chunk by
+    chunk in the same stream."""
+    if not isinstance(version, DeepStoreVersion):
+        raise ValueError("windowed_column_from_version expects a DeepStoreVersion")
+    if not isinstance(with_prefix_packets, bool):
+        raise ValueError("with_prefix_packets must be a plain bool")
+    packet_grid = None
+    if with_prefix_packets:
+        from maple.surface.voxels.windowed_prefix import (
+            encode_prefix_packets_for_block,
+            packet_terms_for,
+        )
+    header = version.header
+    header.require_geometry(geometry, operation="windowed_column_from_version")
+    if class_ids is not None:
+        header.require_class_ids(class_ids, operation="windowed_column_from_version")
+    ny, nx, n_voxels, n_classes = header.ny, header.nx, header.n_voxels, header.n_classes
+    width = header.window_voxels
+    capacity = max_voxel_mass_kg(geometry)
+    n_cells = ny * nx
+    window = np.empty((n_cells, width, n_classes), dtype=np.float64)
+    base = np.empty((n_cells,), dtype=np.int32)
+    deep_by_class = np.empty((n_cells, n_classes), dtype=np.float64)
+    deep_total = np.empty((n_cells,), dtype=np.float64)
+    deep_room = np.empty((n_cells,), dtype=np.float64)
+    if with_prefix_packets:
+        packet_grid = np.empty((n_cells, packet_terms_for(n_voxels, n_classes)), dtype=np.float64)
+    for ref, view in version.iter_chunks():
+        block = np.asarray(view)  # read-only view of the mapped file
+        check_voxel_column_state(
+            VoxelColumnState(mass_kg=block.reshape(1, ref.n_cells, n_voxels, n_classes)),
+            geometry, mass_resolution_kg,
+        )
+        sl = slice(ref.cell_start, ref.cell_start + ref.n_cells)
+        chunk_base, _ = _canonical_base(block, width)
+        w, d, t, r = _metadata_from_columns(block, chunk_base, width, capacity)
+        window[sl], base[sl], deep_by_class[sl], deep_total[sl], deep_room[sl] = w, chunk_base, d, t, r
+        if packet_grid is not None:
+            packet_grid[sl] = encode_prefix_packets_for_block(np.ascontiguousarray(block), chunk_base, width)
+    state = WindowedVoxelColumnState(
+        window_kg=window.reshape(ny, nx, width, n_classes), base=base.reshape(ny, nx),
+        deep_by_class_kg=deep_by_class.reshape(ny, nx, n_classes), deep_total_kg=deep_total.reshape(ny, nx),
+        deep_room_kg=deep_room.reshape(ny, nx), n_voxels=n_voxels, deep_store=version,
+        generation=version.version_id, manifest_digest=version.manifest_digest,
+    )
+    if packet_grid is not None:
+        from maple.surface.voxels.windowed_prefix import attach_prefix_packets
+
+        state = attach_prefix_packets(state, packet_grid.reshape(ny, nx, -1))
+    return state
+
+
+def with_window_cache(state: WindowedVoxelColumnState) -> WindowedVoxelColumnState:
+    """Attach derived per-slot totals bound to this exact `window_kg`
+    object (trust rule as `VoxelSurfaceCache`). The state's physical
+    fields are the same objects; only the optional cache is added."""
+    new = dataclasses.replace(state)
+    cache = VoxelWindowCache(window_totals_kg=voxel_totals_for_window(state.window_kg),
+                             binding=ArrayBinding(state.window_kg))
+    object.__setattr__(new, "window_cache", cache)
+    return new
+
+
+# ---------------------------------------------------------------------------
+# Validation
+# ---------------------------------------------------------------------------
+
+
+def check_windowed_column_cheap(
+    state: Any,
+    geometry: GeometrySpec,
+    *,
+    class_ids: tuple[str, ...] | None = None,
+) -> tuple[int, int, int, int]:
+    """The per-call validator, run before ANY fast operation. Host-side
+    metadata and binding checks first (type, header, geometry, class ids,
+    generation AND manifest digest), then shapes/dtypes/one namespace, then
+    ONE batched read of flags from the window's own namespace: finite,
+    nonnegative, `0 <= base <= n_voxels - W`, `base > 0 => slot 0 holds
+    mass`, `base == 0 => deep metadata exactly zero`. Returns `(ny, nx, W,
+    n_classes)`. Never allocates a domain-sized array on the host for a
+    device state."""
+    if not isinstance(state, WindowedVoxelColumnState):
+        raise TypeError(f"expected WindowedVoxelColumnState, got {type(state).__name__}")
+    from maple.surface.voxels.windowed_pending import validate_pending_binding
+
+    validate_pending_binding(state, operation="check_windowed_column_cheap")
+    version = state.deep_store
+    if not isinstance(version, DeepStoreVersion):
+        raise ValueError("deep_store must be a DeepStoreVersion handle")
+    header = version.header
+    if isinstance(state.generation, bool) or not isinstance(state.generation, (int, np.integer)):
+        raise ValueError("generation must be a non-Boolean integer")
+    if int(state.generation) != version.version_id:
+        raise ValueError(
+            f"generation {int(state.generation)} does not match the bound version id "
+            f"{version.version_id}; the window metadata belongs to another version"
+        )
+    if not isinstance(state.manifest_digest, str) or state.manifest_digest != version.manifest_digest:
+        raise ValueError(
+            "manifest_digest does not match the bound version's manifest; a sibling or unrelated "
+            "version was substituted under the same generation counter -- refused"
+        )
+    header.require_geometry(geometry, operation="check_windowed_column_cheap")
+    if class_ids is not None:
+        header.require_class_ids(class_ids, operation="check_windowed_column_cheap")
+    if isinstance(state.n_voxels, bool) or int(state.n_voxels) != header.n_voxels:
+        raise ValueError(f"n_voxels {state.n_voxels!r} != header n_voxels {header.n_voxels}")
+    n_voxels = header.n_voxels
+
+    arrays = {
+        "window_kg": state.window_kg, "base": state.base, "deep_by_class_kg": state.deep_by_class_kg,
+        "deep_total_kg": state.deep_total_kg, "deep_room_kg": state.deep_room_kg,
+    }
+    for name, arr in arrays.items():
+        if not is_array(arr):
+            raise ValueError(f"{name} must be an array, got {type(arr).__name__}")
+    if state.window_kg.ndim != 4:
+        raise ValueError(f"window_kg must be 4-D, got shape {state.window_kg.shape}")
+    ny, nx, width, n_classes = (int(s) for s in state.window_kg.shape)
+    if (ny, nx, n_classes) != (header.ny, header.nx, header.n_classes):
+        raise ValueError(
+            f"window_kg grid/classes {(ny, nx, n_classes)} != header {(header.ny, header.nx, header.n_classes)}"
+        )
+    if width != header.window_voxels:
+        raise ValueError(f"window width {width} != header window_voxels {header.window_voxels}")
+    expected = {
+        "window_kg": ((ny, nx, width, n_classes), np.float64), "base": ((ny, nx), np.int32),
+        "deep_by_class_kg": ((ny, nx, n_classes), np.float64), "deep_total_kg": ((ny, nx), np.float64),
+        "deep_room_kg": ((ny, nx), np.float64),
+    }
+    for name, (shape, dtype) in expected.items():
+        arr = arrays[name]
+        if tuple(arr.shape) != shape:
+            raise ValueError(f"{name} must have shape {shape}, got {tuple(arr.shape)}")
+        if arr.dtype != dtype:
+            raise ValueError(f"{name} must be {np.dtype(dtype)}, got {arr.dtype}")
+    xp = array_namespace(*arrays.values())  # one namespace or MixedArrayNamespaceError
+
+    slot0_total = state.window_kg[:, :, 0, :].sum(axis=-1)
+    base_zero = state.base == 0
+    flags = [
+        finite_flag(state.window_kg), negative_flag(state.window_kg),
+        finite_flag(state.deep_by_class_kg), negative_flag(state.deep_by_class_kg),
+        finite_flag(state.deep_total_kg), negative_flag(state.deep_total_kg),
+        finite_flag(state.deep_room_kg), negative_flag(state.deep_room_kg),
+        true_flag(state.base < 0), true_flag(state.base > n_voxels - width),
+        true_flag((state.base > 0) & (slot0_total <= 0.0)),
+        true_flag(base_zero & (state.deep_by_class_kg != 0.0).any(axis=-1)),
+        true_flag(base_zero & (state.deep_total_kg != 0.0)),
+        true_flag(base_zero & (state.deep_room_kg != 0.0)),
+    ]
+    results = read_flags(flags)
+    messages = [
+        "window_kg contains NaN or Inf", "window_kg contains negative mass",
+        "deep_by_class_kg contains NaN or Inf", "deep_by_class_kg contains negative mass",
+        "deep_total_kg contains NaN or Inf", "deep_total_kg contains negative mass",
+        "deep_room_kg contains NaN or Inf", "deep_room_kg contains negative mass",
+        "base contains a negative index", f"base exceeds n_voxels - W = {n_voxels - width}",
+        "base > 0 in a cell whose window slot 0 holds no mass (the top is not inside the window)",
+        "base == 0 in a cell with nonzero deep_by_class_kg", "base == 0 in a cell with nonzero deep_total_kg",
+        "base == 0 in a cell with nonzero deep_room_kg",
+    ]
+    expected_flags = [True, False, True, False, True, False, True, False] + [False] * 6
+    if not (len(results) == len(expected_flags) == len(messages)):
+        raise RuntimeError("internal: flag/message tables out of step")
+    for got, want, message in zip(results, expected_flags, messages):
+        if got != want:
+            raise ValueError(f"check_windowed_column_cheap ({namespace_name(xp)}): {message}")
+    return ny, nx, width, n_classes
+
+
+def validate_windowed_column_full(
+    state: WindowedVoxelColumnState,
+    geometry: GeometrySpec,
+    mass_resolution_kg: float,
+    *,
+    class_ids: tuple[str, ...] | None = None,
+) -> None:
+    """The trusted-boundary validator: the cheap checks, then a STREAMED
+    pass over the bound version in which, chunk by chunk, the full
+    logical columns are reconstructed (version below `base`, window
+    inside, zero above), validated with the dense MAPLE validator
+    (finite, nonnegative, no overfill, packed bottom-up), and the three
+    deep metadata fields are recomputed by the declared folds and
+    required BITWISE equal to the state's. The window is converted one
+    chunk-slice at a time (`to_host`, counted on a device state); the
+    window array must be C-contiguous so that the flat slicing is a view."""
+    ny, nx, width, n_classes = check_windowed_column_cheap(state, geometry, class_ids=class_ids)
+    from maple.surface.voxels.windowed_pending import require_published_column
+
+    require_published_column(state, operation="validate_windowed_column_full")
+    version: DeepStoreVersion = state.deep_store
+    n_voxels = version.header.n_voxels
+    capacity = max_voxel_mass_kg(geometry)
+    if not _c_contiguous(state.window_kg):
+        raise ValueError("window_kg must be C-contiguous for streamed validation (no hidden full copy)")
+    n_cells = ny * nx
+    window_flat = state.window_kg.reshape(n_cells, width, n_classes)
+    base_flat = state.base.reshape(n_cells)
+    deep_flat = state.deep_by_class_kg.reshape(n_cells, n_classes)
+    total_flat = state.deep_total_kg.reshape(n_cells)
+    room_flat = state.deep_room_kg.reshape(n_cells)
+    for ref, view in version.iter_chunks():
+        sl = slice(ref.cell_start, ref.cell_start + ref.n_cells)
+        window_rows = to_host(window_flat[sl])
+        base_rows = to_host(base_flat[sl])
+        full = np.empty((ref.n_cells, n_voxels, n_classes), dtype=np.float64)
+        np.copyto(full, view)
+        _overlay_full_columns(full, window_rows, base_rows)
+        try:
+            check_voxel_column_state(
+                VoxelColumnState(mass_kg=full.reshape(1, ref.n_cells, n_voxels, n_classes)),
+                geometry, mass_resolution_kg,
+            )
+        except ValueError as exc:
+            raise ValueError(f"validate_windowed_column_full: chunk {ref.index}: {exc}") from exc
+        _, d, t, r = _metadata_from_columns(full, base_rows, width, capacity)
+        for name, got, want in (
+            ("deep_by_class_kg", to_host(deep_flat[sl]), d),
+            ("deep_total_kg", to_host(total_flat[sl]), t),
+            ("deep_room_kg", to_host(room_flat[sl]), r),
+        ):
+            if np.ascontiguousarray(got).tobytes() != np.ascontiguousarray(want).tobytes():
+                diff = float(np.max(np.abs(np.asarray(got, dtype=np.float64) - want))) if want.size else 0.0
+                raise ValueError(
+                    f"validate_windowed_column_full: chunk {ref.index}: stored {name} is not bitwise the "
+                    f"declared fold over the bound version (max |diff| {diff:.3e} kg); the metadata "
+                    "belongs to a different version or was not produced by the declared arithmetic"
+                )
+
+
+def window_band_status(state: WindowedVoxelColumnState) -> dict[str, MapleArray]:
+    """Diagnostic flags (in the window's namespace) for the design's valid
+    band: `needs_spill` where the top sits in the last slot (`W - 1`) and
+    `base < n_voxels - W`; `needs_refill` where the top is slot 0 and
+    `base > 0`; `window_empty` where no slot holds mass. Flags only: no
+    rebase is performed in this slice."""
+    xp = array_namespace(state.window_kg, state.base)
+    totals = voxel_totals_for_window(state.window_kg)  # (ny, nx, W)
+    occupied = totals > 0.0
+    width = state.window_voxels
+    has_any = occupied.any(axis=-1)
+    first_from_top = occupied[:, :, ::-1].argmax(axis=-1)
+    top_slot = xp.where(has_any, width - 1 - first_from_top, -1)
+    return {
+        "top_slot": top_slot,
+        "window_empty": ~has_any,
+        "needs_spill": has_any & (top_slot == width - 1) & (state.base < state.n_voxels - width),
+        "needs_refill": has_any & (top_slot == 0) & (state.base > 0),
+    }
+
+
+def _c_contiguous(array: Any) -> bool:
+    flags = getattr(array, "flags", None)
+    return bool(flags is not None and flags.c_contiguous)
+
+
+# ---------------------------------------------------------------------------
+# Bounded gathers and the small dense fallback
+# ---------------------------------------------------------------------------
+
+
+def gather_full_columns(
+    state: WindowedVoxelColumnState,
+    cells: Any,
+    *,
+    max_columns: int = DEFAULT_MAX_GATHER_COLUMNS,
+) -> np.ndarray:
+    """Full logical columns `(k, n_voxels, n_classes)` host FP64 for the
+    flat cell indices `cells`: version below `base`, current window inside
+    its range, zero above. Bounded by `max_columns` (refused before any
+    allocation). The state is read only; the window rows are gathered in
+    the window's namespace and converted through the counted `to_host`."""
+    from maple.surface.voxels.windowed_pending import require_published_column
+
+    require_published_column(state, operation="gather_full_columns")
+    version: DeepStoreVersion = state.deep_store
+    if not isinstance(version, DeepStoreVersion):
+        raise ValueError("deep_store must be a DeepStoreVersion handle")
+    if state.manifest_digest != version.manifest_digest or int(state.generation) != version.version_id:
+        raise ValueError("gather_full_columns: state is not bound to its deep-store version (digest/generation)")
+    idx = _host_cells(cells, version.header.n_cells)
+    if idx.shape[0] > max_columns:
+        raise ValueError(f"gather_full_columns: {idx.shape[0]} cells above max_columns={max_columns}")
+    deep = version.gather_columns(idx, max_columns=max_columns)
+    ny, nx, width, n_classes = state.window_kg.shape
+    xp = array_namespace(state.window_kg, state.base)
+    device_idx = xp.asarray(idx)
+    window_rows = to_host(state.window_kg.reshape(ny * nx, width, n_classes)[device_idx])
+    base_rows = to_host(state.base.reshape(ny * nx)[device_idx])
+    return _overlay_full_columns(deep, window_rows, base_rows)
+
+
+def windowed_to_dense(state: WindowedVoxelColumnState, *, max_bytes: int) -> VoxelColumnState:
+    """A dense HOST `VoxelColumnState` equal to the windowed state's full
+    logical column set -- ONLY when `(ny, nx, n_voxels, n_classes) * 8`
+    bytes fits `max_bytes`, checked BEFORE allocation. The fallback truth
+    for small differential tests; never a production path."""
+    from maple.surface.voxels.windowed_pending import require_published_column
+
+    require_published_column(state, operation="windowed_to_dense")
+    version: DeepStoreVersion = state.deep_store
+    if not isinstance(version, DeepStoreVersion):
+        raise ValueError("deep_store must be a DeepStoreVersion handle")
+    if state.manifest_digest != version.manifest_digest or int(state.generation) != version.version_id:
+        raise ValueError("windowed_to_dense: state is not bound to its deep-store version (digest/generation)")
+    header = version.header
+    if isinstance(max_bytes, bool) or not isinstance(max_bytes, (int, np.integer)) or int(max_bytes) < 1:
+        raise ValueError("max_bytes must be a positive integer")
+    if header.logical_bytes > int(max_bytes):
+        raise ValueError(
+            f"windowed_to_dense refused: {header.logical_bytes} bytes needed, above max_bytes={int(max_bytes)}"
+        )
+    ny, nx, width, n_classes = state.window_kg.shape
+    if not _c_contiguous(state.window_kg):
+        raise ValueError("window_kg must be C-contiguous (no hidden full copy)")
+    n_cells = ny * nx
+    window_flat = state.window_kg.reshape(n_cells, width, n_classes)
+    base_flat = state.base.reshape(n_cells)
+    out = np.empty((n_cells, header.n_voxels, n_classes), dtype=np.float64)
+    for ref, view in version.iter_chunks():
+        sl = slice(ref.cell_start, ref.cell_start + ref.n_cells)
+        np.copyto(out[sl], view)
+        _overlay_full_columns(out[sl], to_host(window_flat[sl]), to_host(base_flat[sl]))
+    return VoxelColumnState(mass_kg=out.reshape(ny, nx, header.n_voxels, n_classes))
+
+
+def _host_cells(cells: Any, n_cells: int) -> np.ndarray:
+    if not is_array(cells):
+        raise ValueError(f"cells must be an integer array, got {type(cells).__name__}")
+    idx = to_host(cells)
+    if idx.ndim != 1 or idx.dtype.kind not in "iu" or idx.dtype == np.bool_:
+        raise ValueError(f"cells must be a 1-D integer array, got shape {idx.shape} dtype {idx.dtype}")
+    idx = idx.astype(np.int64, copy=False)
+    if idx.shape[0] and (idx.min() < 0 or idx.max() >= n_cells):
+        raise ValueError(f"cells out of range [0, {n_cells})")
+    return idx
+
+
+# ---------------------------------------------------------------------------
+# Inventories (declared folds; active layer added separately)
+# ---------------------------------------------------------------------------
+
+
+def column_mass_by_class_kg(state: WindowedVoxelColumnState) -> MapleArray:
+    """`(ny, nx, n_classes)`: `(((deep_by_class + window[0]) + window[1]) +
+    ...) + window[W-1]` in the window's namespace."""
+    acc = state.deep_by_class_kg + state.window_kg[:, :, 0, :]
+    for s in range(1, state.window_voxels):
+        acc = acc + state.window_kg[:, :, s, :]
+    return acc
+
+
+def column_total_mass_kg(state: WindowedVoxelColumnState) -> MapleArray:
+    """`(ny, nx)`: the declared class fold of `column_mass_by_class_kg`."""
+    return sequential_class_fold(column_mass_by_class_kg(state))
+
+
+def windowed_surface_elevation_m(
+    state: WindowedVoxelColumnState, geometry: GeometrySpec, active_layer: ActiveLayerState | None = None
+) -> MapleArray:
+    """Elevation above voxel 0's bottom face (the dense convention of
+    `diagnose_surface_state`; the header's `datum_offset_m` is NOT added
+    here, matching the dense diagnostic): `(column_total [+ active class
+    fold]) / (bulk_density * dx * dy)`. A derived reduction (bounded)."""
+    total = column_total_mass_kg(state)
+    if active_layer is not None:
+        total = total + sequential_class_fold(active_layer.mass_kg)
+    return total / geometry.bulk_density_kg_m3 / (geometry.dx_m * geometry.dy_m)
+
+
+def windowed_bed_inventory_by_class_kg(
+    state: WindowedVoxelColumnState, active_layer: ActiveLayerState
+) -> MapleArray:
+    """`(n_classes,)`: MAPLE's own staged fold applied to the window, the
+    deep prefix metadata and the active layer, added in that order. Same
+    policy as `bed_inventory_by_class_kg`, three parts instead of two;
+    cross-backend agreement is the staged fold's existing bounded
+    contract. The import is lazy and private because the fold lives in
+    the aeolian step module (a shared-helper promotion is a later upstream
+    item, recorded in the task report)."""
+    from maple.aeolian.flux.step import _staged_class_totals_kg
+
+    return (_staged_class_totals_kg(state.window_kg) + _staged_class_totals_kg(state.deep_by_class_kg)
+            + _staged_class_totals_kg(active_layer.mass_kg))
+
+
+def resident_reduction_bound_kg(state: WindowedVoxelColumnState, geometry: GeometrySpec) -> float:
+    """The MAXIMUM-TERM form of the existing summation contract, one scalar
+    for the whole domain: `summation_error_bound_kg(n_voxels + 1,
+    capacity)`.
+
+    Why capacity is a legitimate term scale: every term of a column's
+    class sum -- a deep voxel's class entry or a window entry -- is a
+    nonnegative part of ONE voxel whose total the overfill invariant
+    (`check_voxel_column_state`) keeps at or below capacity, so capacity
+    bounds every term of every cell and class, and `n_voxels + 1` bounds
+    the term count of either side (the dense `sum(axis=-2)` over
+    `n_voxels` terms, or the deep prefix carry plus `W` window slots).
+    It is the right statement for a domain-wide claim. It is NOT
+    operand-aware: an empty or almost-empty column inherits the physical
+    capacity, which is irrelevant to the roundoff its own tiny operands
+    can produce. For per-cell/class comparisons use
+    `resident_reduction_bound_by_cell_class_kg`. Neither function involves
+    `mass_resolution_kg`: summation roundoff and physical resolution are
+    different questions and are never conflated here. No new tolerance.
+    """
+    return summation_error_bound_kg(int(state.n_voxels) + 1, max_voxel_mass_kg(geometry))
+
+
+def resident_reduction_bound_by_cell_class_kg(
+    state: WindowedVoxelColumnState, geometry: GeometrySpec
+) -> MapleArray:
+    """The ACTUAL-OPERAND form of the same contract, `(ny, nx, n_classes)`
+    in the window's namespace: `summation_error_bound_kg(n_voxels + 1, s)`
+    with the per-cell/class term scale
+
+        s = max( max over window slots of the stored entry,
+                 min(capacity, deep_by_class_kg) )
+
+    computed from the RESIDENT data alone. Every term of that cell/class
+    sum is bounded by `s`: a window entry by the first operand; a deep
+    voxel's class entry by the class prefix of the nonnegative deep
+    entries it belongs to (never above the prefix) and by capacity. The
+    bound is exactly 0 for an empty column (a sum of exact zeros is
+    exact), proportional to the stored mass for a tiny one, and
+    class-specific (a trace class carries a trace bound). It is never
+    above `resident_reduction_bound_kg` except by the overfill tolerance a
+    stored entry may itself carry (at most 16 eps relative, the dense
+    validator's own allowance). The policy function is linear in
+    its scale, so this is `summation_error_bound_kg(n_voxels + 1, 1.0) *
+    s` -- the existing bound, not a new one."""
+    xp = array_namespace(state.window_kg, state.deep_by_class_kg)
+    capacity = max_voxel_mass_kg(geometry)
+    window_max = state.window_kg.max(axis=2)  # (ny, nx, n_classes)
+    deep_bound = xp.minimum(capacity, state.deep_by_class_kg)
+    scale = xp.maximum(window_max, deep_bound)
+    return summation_error_bound_kg(int(state.n_voxels) + 1, 1.0) * scale
+
+
+def resident_total_reduction_bound_by_cell_kg(
+    state: WindowedVoxelColumnState, geometry: GeometrySpec
+) -> MapleArray:
+    """Operand-scaled bound `(ny, nx)` for comparing `column_total_mass_kg`
+    with the dense `sum(axis=(-2, -1))`: every term of either reduction
+    (per-entry terms and the class-fold terms alike) is at most the
+    largest class mass of that column, and the term count of either side
+    is at most `n_classes * (n_voxels + 2)`. Exactly 0 for an empty
+    column. The `geometry` argument is accepted for interface symmetry
+    with the per-class form; the scale here is the column's own mass."""
+    del geometry  # the operand scale below needs no capacity
+    n_voxels = int(state.n_voxels)
+    n_classes = int(state.window_kg.shape[-1])
+    largest_class_mass = column_mass_by_class_kg(state).max(axis=-1)  # (ny, nx)
+    return summation_error_bound_kg(n_classes * (n_voxels + 2), 1.0) * largest_class_mass
+
+
+# ---------------------------------------------------------------------------
+# Byte accounting and the reduction-order probe
+# ---------------------------------------------------------------------------
+
+
+def windowed_storage_bytes(state: WindowedVoxelColumnState) -> dict[str, Any]:
+    """Resident array bytes (by field, in whatever namespace they live),
+    the logical dense size they stand for, and the deep store's own
+    separate disk / mapping / transient report."""
+    fields = {
+        "window_kg": int(state.window_kg.nbytes), "base": int(state.base.nbytes),
+        "deep_by_class_kg": int(state.deep_by_class_kg.nbytes), "deep_total_kg": int(state.deep_total_kg.nbytes),
+        "deep_room_kg": int(state.deep_room_kg.nbytes),
+    }
+    return {
+        "namespace": namespace_name(array_namespace(state.window_kg, state.base)),
+        "resident_bytes_by_field": fields,
+        "resident_bytes_total": sum(fields.values()),
+        "logical_dense_bytes": state.deep_store.header.logical_bytes,
+        "window_voxels": state.window_voxels,
+        "generation": int(state.generation),
+        "manifest_digest": state.manifest_digest,
+        "deep_store": deep_store_report(state.deep_store),
+    }
+
+
+def probe_sequential_axis_reduction(*, seed: int = 0, n_trials: int = 24) -> dict[str, Any]:
+    """Compare NumPy's `sum(axis=-2)` over `(k, n_voxels, n_classes)` arrays
+    with the explicit sequential prefix (`sequential_prefix_by_class`),
+    byte for byte, over varied magnitudes and memory layouts. Returns
+    counts per layout and the NumPy version; it CLAIMS nothing universal
+    -- the tests record it, and only a layout with zero mismatches in this
+    process is treated as bitwise-known for that NumPy."""
+    rng = np.random.default_rng(seed)
+    results: dict[str, dict[str, int]] = {}
+
+    def run(label: str, array: np.ndarray) -> None:
+        k, n_voxels, _ = array.shape
+        full = np.full((k,), n_voxels, dtype=np.int64)
+        agree = array.sum(axis=-2).tobytes() == sequential_prefix_by_class(array, full).tobytes()
+        entry = results.setdefault(label, {"trials": 0, "bitwise": 0})
+        entry["trials"] += 1
+        entry["bitwise"] += int(agree)
+
+    for _ in range(n_trials):
+        k = int(rng.integers(1, 40))
+        n_voxels = int(rng.integers(1, 307))
+        n_classes = int(rng.integers(1, 17))
+        uniform = rng.random((k, n_voxels, n_classes))
+        mixed = uniform * 10.0 ** rng.integers(-12, 4, size=(k, n_voxels, n_classes))
+        packed = np.where(rng.random((k, n_voxels, 1)) < 0.7, uniform * 12.5, 0.0)
+        for name, arr in (("uniform", uniform), ("mixed_magnitudes", mixed), ("packed_like", packed)):
+            run(f"{name}/c_contiguous", np.ascontiguousarray(arr))
+            run(f"{name}/f_order", np.asfortranarray(arr))
+            wide = np.ascontiguousarray(rng.random((k, 2 * n_voxels, n_classes)))
+            wide[:, ::2, :] = arr
+            run(f"{name}/strided_view", wide[:, ::2, :])
+    return {"numpy_version": np.__version__, "seed": seed, "n_trials": n_trials, "layouts": results}
diff --git a/src/maple/surface/voxels/windowed_metadata_numba.py b/src/maple/surface/voxels/windowed_metadata_numba.py
