diff --git a/src/maple/surface/topographic_commit/windowed_commit.py b/src/maple/surface/topographic_commit/windowed_commit.py
new file mode 100644
index 0000000000000000000000000000000000000000..e056e83a7a18912b8b8bb874944db0c5b009c9b4
--- /dev/null
+++ b/src/maple/surface/topographic_commit/windowed_commit.py
@@ -0,0 +1,660 @@
+"""The topographic-commit transaction on a RESIDENT-WINDOW bed (CW-B3c).
+
+`commit_windowed_topography` is `commit_topography` stage for stage --
+validate, reconcile the ledger against the physical inventory, the
+untrusted-callback window with snapshot/detect/restore, the avalanche
+accounting fold-in, the pre-commit diagnostics, the committed-elevation
+refresh, publication and the ledger clear -- with every dense-storage
+read replaced by the windowed storage interface:
+
+* inventory: the declared sequential fold of the deep prefix and the
+  window (`windowed_inventory.column_mass_by_class_kg`), dispatched
+  inside the SHARED `_physical_inventory_by_class_kg` /
+  `validate_reconciliation_context` so the reconciliation itself (same
+  touch-counted FP64 bound, same hard `mass_resolution_kg` cap, no new
+  tolerance) is the unchanged implementation;
+* committed height: the EXACT NumPy-order total decoded from the E1
+  prefix packets plus the resident window (`windowed_prefix`), never the
+  sequential fold and never a deep read; the active-layer thickness is
+  the dense diagnostic's own function, so the windowed committed
+  elevation is bitwise the dense `diagnose_combined_surface_state`
+  elevation of the same logical column;
+* baselines: `committed_voxel_mass_by_class_kg` is published from the
+  SAME declared fold, so later reconciliations compare like with like.
+  A dense-initialized baseline (depth-axis `sum`) differs from the fold
+  by the regrouping of the same terms; `windowed_committed_state_from_
+  dense_baseline` makes that transition EXPLICIT, once, at the windowed
+  genesis, under the existing `summation_error_bound_kg(n_voxels + 1,
+  scale)` contract -- it is never folded into the reconciliation
+  tolerance.
+
+What is refused up front (before any snapshot, callback or publication):
+a column without valid, bound, non-stale prefix packets; a real (non-
+identity) avalanche callback -- this slice supports the MAPLE avalanche
+configuration `enabled=False` truthfully (`make_avalanche_callback`
+returns the identity for it) and nothing else; any lifecycle stage
+callback that is neither the dense identity nor a WINDOWED stage marked
+by `windowed_lifecycle_stage` (a dense-only callback is refused by name,
+never identity-substituted); a non-bool history flag.
+
+What a windowed stage may do in this slice: read the bed and the height
+(the water-depth stage does exactly that) and return the bed UNCHANGED.
+A stage that returns a modified bed is refused; terrain-changing stages
+on windowed storage (avalanching) are a later task. Failure atomicity is
+the dense design: resident arrays snapshotted, compared after every
+stage, restored on any failure.
+
+Nothing here publishes a deep-store version: the deep store is unchanged
+by a commit (no journal is produced), the column's binding is required
+to be published (not pending) and is carried into the result unchanged.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+from collections.abc import Callable
+from dataclasses import dataclass
+from typing import Any
+
+import numpy as np
+
+from maple.core.backend import (
+    any_true,
+    array_namespace,
+    arrays_share_memory,
+    freeze,
+    freeze_is_enforced,
+    to_float,
+)
+from maple.core.parameters.geometry import GeometrySpec
+from maple.core.types.active_layer import ActiveLayerState
+from maple.core.types.ledger_reconciliation import LedgerReconciliationBaseline
+from maple.core.types.sediment_ledger import (
+    SedimentLedgerState,
+    process_index,
+    zeros_sediment_ledger_state,
+)
+from maple.core.types.topographic_commit import (
+    CommittedTopographyState,
+    committed_elevation_m,
+    validate_committed_topography_state,
+)
+from maple.core.types.voxel import WindowedVoxelColumnState
+from maple.coupling.sediment_ledger.accumulate import accumulate_process_transfer
+from maple.coupling.sediment_ledger.diagnostics import (
+    global_pending_mass_by_class_kg,
+    gross_physical_activity_for_process_by_class_kg,
+    numerical_residual_report,
+)
+from maple.coupling.sediment_ledger.validation import validate_ledger_state
+from maple.surface.active_layer.capacity import compute_active_layer_actual_thickness_m
+from maple.surface.active_layer.validation import check_active_layer_state
+from maple.surface.topographic_commit.commit import (
+    CommitResult,
+    _capture_exchange_history,
+    _reconcile_ledger_with_physical_state,
+    identity_avalanche_callback,
+    identity_lifecycle_stage,
+    ledger_is_empty,
+    reconciliation_baseline_after_commit,
+    resolve_reconciliation_reference_inventory_kg,
+    validate_reconciliation_context,
+)
+from maple.surface.voxels._numerics import summation_error_bound_kg
+from maple.surface.voxels.capacity import max_voxel_mass_kg
+from maple.surface.voxels.deep_store import DEFAULT_MAX_JOURNAL_RECORDS
+from maple.surface.voxels.windowed_inventory import (
+    check_windowed_column_cheap,
+    column_mass_by_class_kg,
+)
+from maple.surface.voxels.windowed_prefix import (
+    attach_prefix_packets,
+    prefix_packets_report,
+    require_prefix_packets,
+    windowed_committed_height_total_kg,
+)
+
+__all__ = [
+    "WINDOWED_STAGE_MARKER",
+    "WindowedCommitResult",
+    "WindowedLifecycleStageCallback",
+    "commit_windowed_topography",
+    "identity_windowed_lifecycle_stage",
+    "is_windowed_already_committed",
+    "windowed_committed_state_from_dense_baseline",
+    "windowed_committed_surface_elevation_m",
+    "windowed_lifecycle_stage",
+]
+
+WindowedLifecycleStageCallback = Callable[
+    [WindowedVoxelColumnState, ActiveLayerState, GeometrySpec, float],
+    tuple[WindowedVoxelColumnState, ActiveLayerState],
+]
+WINDOWED_STAGE_MARKER = "__maple_windowed_stage__"
+_STAGE_NAMES = ("water_callback", "routing_callback", "topographic_wind_callback", "vegetation_callback",
+                "stationary_solver_callback")
+_RESIDENT_FIELDS = ("window_kg", "base", "deep_by_class_kg", "deep_total_kg", "deep_room_kg")
+
+
+def windowed_lifecycle_stage(callback: WindowedLifecycleStageCallback) -> WindowedLifecycleStageCallback:
+    """Mark a callable as a WINDOWED lifecycle stage (it accepts a
+    `WindowedVoxelColumnState`). Unmarked non-identity callables are
+    refused by `commit_windowed_topography` before anything runs."""
+    setattr(callback, WINDOWED_STAGE_MARKER, True)
+    return callback
+
+
+@windowed_lifecycle_stage
+def identity_windowed_lifecycle_stage(column, active_layer, geometry, mass_resolution_kg):
+    return column, active_layer
+
+
+@dataclass(frozen=True)
+class WindowedCommitResult(CommitResult):
+    """A `CommitResult` whose `new_voxel_column` is a
+    `WindowedVoxelColumnState` (bound to the same, unchanged deep-store
+    version as the input), plus the exact-height provenance and the
+    optional exchange-history receipt (CW-D2-compatible field names)."""
+
+    committed_height_provenance: dict | None = None
+    pre_commit_n_physical_touches: Any = None
+    pre_commit_gross_physical_activity_kg: Any = None
+    exchange_history_receipt: dict | None = None
+
+
+def windowed_committed_surface_elevation_m(
+    column: WindowedVoxelColumnState, active_layer: ActiveLayerState, geometry: GeometrySpec, *,
+    trusted_packet: bool = False,
+):
+    """The EXACT combined surface elevation `(ny, nx)`: the NumPy-order
+    column total decoded from the packets, converted with the dense
+    diagnostic's own `mass / rho / area` expression (two divisions, in
+    that order), plus `compute_active_layer_actual_thickness_m`. Bitwise
+    the dense `diagnose_combined_surface_state(...).combined_elevation_m`
+    of the same logical column and layer. Refuses a column without valid
+    packets before any kernel."""
+    total_kg = windowed_committed_height_total_kg(column, trusted=trusted_packet)
+    cell_area_m2 = geometry.dx_m * geometry.dy_m
+    voxel_elevation_m = total_kg / geometry.bulk_density_kg_m3 / cell_area_m2
+    return voxel_elevation_m + compute_active_layer_actual_thickness_m(active_layer, geometry)
+
+
+def windowed_committed_state_from_dense_baseline(
+    committed_state: CommittedTopographyState,
+    column: WindowedVoxelColumnState,
+    active_layer: ActiveLayerState,
+    geometry: GeometrySpec,
+    *,
+    require_exact_height: bool = True,
+    trusted_packet: bool = False,
+) -> tuple[CommittedTopographyState, dict[str, Any]]:
+    """The ONE explicit regrouping event at a windowed genesis.
+
+    A committed state initialized from the dense column carries
+    `committed_voxel_mass_by_class_kg = mass_kg.sum(axis=-2)` (NumPy's
+    depth-axis reduction) while every windowed reconciliation forms the
+    inventory by the declared sequential fold. The two are the same terms
+    in a different grouping; their difference is bounded, per cell and
+    class, by the existing `summation_error_bound_kg(n_voxels + 1,
+    max(|dense|, |fold|))`. This function requires that bound to hold
+    (refusing otherwise -- a larger difference is not regrouping), then
+    returns a NEW committed state whose voxel baseline is the fold, with
+    the reference elevation, offset, active-layer baseline, time and
+    count untouched. With `require_exact_height` (default) it also
+    requires the packet-decoded committed elevation to be BITWISE the
+    state's `committed_elevation_m` (the reference was formed by the same
+    NumPy-order sum), so a wrong packet is refused here, before any
+    commit. Returns the state and a receipt (max regrouping difference,
+    bound, cells regrouped)."""
+    validate_committed_topography_state(committed_state)
+    check_windowed_column_cheap(column, geometry)
+    fold = column_mass_by_class_kg(column)
+    dense = committed_state.committed_voxel_mass_by_class_kg
+    if fold.shape != dense.shape:
+        raise ValueError("windowed_committed_state_from_dense_baseline: shape mismatch between the fold and the baseline")
+    xp = array_namespace(fold, dense)
+    scale = xp.maximum(xp.abs(fold), xp.abs(dense))
+    bound = summation_error_bound_kg(int(column.n_voxels) + 1, 1.0) * scale
+    diff = xp.abs(fold - dense)
+    if any_true(diff > bound):
+        raise ValueError(
+            "windowed_committed_state_from_dense_baseline: the windowed fold differs from the dense depth-sum "
+            "baseline by more than the declared regrouping bound (summation_error_bound_kg(n_voxels + 1, "
+            "scale)); this is not a regrouping of the same terms -- the column and the baseline do not describe "
+            f"the same bed (max |diff| {to_float(diff.max()):.6e} kg)"
+        )
+    receipt = {
+        "max_regrouping_difference_kg": to_float(diff.max()) if diff.size else 0.0,
+        "max_regrouping_bound_kg": to_float(bound.max()) if bound.size else 0.0,
+        "cells_regrouped": int(to_float((diff != 0.0).any(axis=-1).sum())),
+        "exact_height_checked": bool(require_exact_height),
+    }
+    if require_exact_height:
+        elevation = windowed_committed_surface_elevation_m(column, active_layer, geometry, trusted_packet=trusted_packet)
+        committed = committed_elevation_m(committed_state)
+        if any_true(elevation != committed):
+            worst = to_float(xp.abs(elevation - committed).max())
+            raise ValueError(
+                "windowed_committed_state_from_dense_baseline: the packet-decoded committed elevation is not "
+                f"bitwise the committed state's elevation (max |diff| {worst:.6e} m); the packets do not reproduce "
+                "the NumPy-order height of this bed -- refused"
+            )
+    new_state = dataclasses.replace(
+        committed_state,
+        committed_voxel_mass_by_class_kg=xp.array(fold, dtype=np.float64, copy=True, order="C"),
+    )
+    validate_committed_topography_state(new_state)
+    return new_state, receipt
+
+
+def _isolated_copy(column: WindowedVoxelColumnState) -> WindowedVoxelColumnState:
+    """A candidate column for a stage: copies of every resident array
+    (same deep-store handle and identity), packets bound afresh to the
+    copied base."""
+    candidate = dataclasses.replace(
+        column, window_kg=column.window_kg.copy(), base=column.base.copy(),
+        deep_by_class_kg=column.deep_by_class_kg.copy(), deep_total_kg=column.deep_total_kg.copy(),
+        deep_room_kg=column.deep_room_kg.copy(),
+    )
+    packets = column.height_packet
+    if packets is not None:
+        candidate = attach_prefix_packets(candidate, packets.packet.copy())
+    if column.pending_deep is not None:
+        from maple.surface.voxels.windowed_pending import attach_pending_journal
+
+        candidate = attach_pending_journal(candidate, column.pending_deep.journal)
+    return candidate
+
+
+def _resident_equal(a: WindowedVoxelColumnState, b: WindowedVoxelColumnState) -> bool:
+    for name in _RESIDENT_FIELDS:
+        if getattr(a, name).shape != getattr(b, name).shape or any_true(getattr(a, name) != getattr(b, name)):
+            return False
+    return True
+
+
+def _require_stage_callback(name: str, callback: Any) -> bool:
+    """True when the stage is the dense identity (logged as identity);
+    False for a marked windowed stage; refuses anything else."""
+    if callback is identity_lifecycle_stage or callback is identity_windowed_lifecycle_stage:
+        return True
+    if callable(callback) and getattr(callback, WINDOWED_STAGE_MARKER, False) is True:
+        return False
+    raise ValueError(
+        f"commit_windowed_topography: {name} is not a windowed lifecycle stage (it is neither the identity nor "
+        "marked by windowed_lifecycle_stage); a dense-only callback cannot run on a resident-window bed and is "
+        "refused rather than identity-substituted. Nothing was committed."
+    )
+
+
+def is_windowed_already_committed(
+    ledger: SedimentLedgerState,
+    committed_state: CommittedTopographyState,
+    column: WindowedVoxelColumnState,
+    active_layer: ActiveLayerState,
+    geometry: GeometrySpec,
+    mass_resolution_kg: float,
+    current_time_s: float,
+    *,
+    reconciliation_baseline: LedgerReconciliationBaseline | None = None,
+) -> bool:
+    """`is_already_committed` for a windowed bed: same time/empty-ledger/
+    exact-baseline conditions (the voxel baseline compared with the
+    declared fold), the shared context check, and -- instead of the dense
+    full partition scan -- the cheap windowed checks plus the active-layer
+    validator (the streamed deep validator is a trusted-boundary
+    operation, not a per-commit one)."""
+    from maple.surface.voxels.windowed_pending import require_published_column
+
+    require_published_column(column, operation="is_windowed_already_committed")
+    validate_ledger_state(ledger)
+    validate_committed_topography_state(committed_state)
+    if committed_state.last_commit_time_s != current_time_s:
+        return False
+    if not ledger_is_empty(ledger):
+        return False
+    validate_reconciliation_context(
+        ledger, column, active_layer, geometry, committed_state=committed_state,
+        reconciliation_baseline=reconciliation_baseline, current_time_s=current_time_s,
+        operation="is_windowed_already_committed", ledger_shape=ledger.pending_bed_mass_change_kg.shape,
+    )
+    committed_active = committed_state.committed_active_layer_mass_by_class_kg
+    if active_layer.mass_kg.shape != committed_active.shape or any_true(active_layer.mass_kg != committed_active):
+        return False
+    fold = column_mass_by_class_kg(column)
+    committed_voxel = committed_state.committed_voxel_mass_by_class_kg
+    if fold.shape != committed_voxel.shape or any_true(fold != committed_voxel):
+        return False
+    if reconciliation_baseline is not None and (
+        any_true(reconciliation_baseline.active_layer_mass_by_class_kg != committed_active)
+        or any_true(reconciliation_baseline.voxel_mass_by_class_kg != committed_voxel)
+    ):
+        return False
+    check_windowed_column_cheap(column, geometry)
+    check_active_layer_state(active_layer, geometry, mass_resolution_kg)
+    return True
+
+
+def _commit_windowed_topography(
+    ledger: SedimentLedgerState,
+    committed_state: CommittedTopographyState,
+    column: WindowedVoxelColumnState,
+    active_layer: ActiveLayerState,
+    geometry: GeometrySpec,
+    mass_resolution_kg: float,
+    current_time_s: float,
+    *,
+    avalanche_callback: Any = identity_avalanche_callback,
+    water_callback: Any = identity_lifecycle_stage,
+    routing_callback: Any = identity_lifecycle_stage,
+    topographic_wind_callback: Any = identity_lifecycle_stage,
+    vegetation_callback: Any = identity_lifecycle_stage,
+    stationary_solver_callback: Any = identity_lifecycle_stage,
+    reconciliation_baseline: LedgerReconciliationBaseline | None = None,
+    record_exchange_history: bool = False,
+    trusted_packet: bool = False,
+    staged: bool = False,
+) -> WindowedCommitResult:
+    """One topographic-commit transaction on a windowed bed. See the
+    module docstring for the stage list and the refusals. `trusted_packet`
+    is the E1 decode trust flag (required on CuPy, where the packet cannot
+    be made read-only). The input ledger, committed state, column, active
+    layer and deep store are left untouched."""
+    from maple.surface.voxels.windowed_pending import require_published_column
+
+    if not staged:
+        require_published_column(column, operation="commit_windowed_topography")
+    stage_log: list[str] = []
+
+    # --- Stage: validate transaction (everything refusable, before any work) ---
+    stage_log.append("validate_transaction")
+    ny, nx, n_classes = validate_ledger_state(ledger)
+    validate_committed_topography_state(committed_state)
+    if not isinstance(column, WindowedVoxelColumnState):
+        raise TypeError("commit_windowed_topography requires a WindowedVoxelColumnState")
+    check_windowed_column_cheap(column, geometry)
+    packets = require_prefix_packets(column, operation="commit_windowed_topography")
+    check_active_layer_state(active_layer, geometry, mass_resolution_kg)
+    if active_layer.mass_kg.shape != (ny, nx, n_classes) or column.window_kg.shape[-1] != n_classes:
+        raise ValueError("commit_windowed_topography: active layer / column class count does not match the ledger")
+    if not isinstance(record_exchange_history, bool):
+        raise ValueError(
+            f"record_exchange_history must be a plain bool, got {record_exchange_history!r}; nothing was committed"
+        )
+    if avalanche_callback is not identity_avalanche_callback:
+        raise ValueError(
+            "commit_windowed_topography supports the MAPLE avalanche configuration enabled=False only "
+            "(make_avalanche_callback returns identity_avalanche_callback for it); a real avalanche callback "
+            "cannot run on a resident-window bed in CW-B3c and is refused up front rather than identity-"
+            "substituted. Nothing was committed."
+        )
+    stage_callbacks = (water_callback, routing_callback, topographic_wind_callback, vegetation_callback,
+                       stationary_solver_callback)
+    stage_is_identity = [_require_stage_callback(name, cb) for name, cb in zip(_STAGE_NAMES, stage_callbacks)]
+    if isinstance(current_time_s, bool) or not isinstance(current_time_s, (int, float, np.floating)):
+        raise ValueError(f"current_time_s must be a non-Boolean real number, got {current_time_s!r}")
+    current_time_s = float(current_time_s)
+    if not np.isfinite(current_time_s):
+        raise ValueError(f"current_time_s must be finite, got {current_time_s!r}")
+    if current_time_s < committed_state.last_commit_time_s:
+        raise ValueError(
+            f"current_time_s ({current_time_s}) must not precede committed_state.last_commit_time_s "
+            f"({committed_state.last_commit_time_s})"
+        )
+    if committed_state.committed_active_layer_mass_by_class_kg.shape != (ny, nx, n_classes):
+        raise ValueError("committed_state's class-mass baseline shape does not match the ledger's")
+    avalanching_process_idx = process_index("avalanching")
+
+    # --- Stage: reconcile pending ledger accounting with physical state (SHARED) ---
+    stage_log.append("reconcile_pending_with_physical_state")
+    validate_reconciliation_context(
+        ledger, column, active_layer, geometry, committed_state=committed_state,
+        reconciliation_baseline=reconciliation_baseline, current_time_s=current_time_s,
+        operation="commit_windowed_topography", ledger_shape=(ny, nx, n_classes),
+    )
+    reference_inventory_kg, reference_label = resolve_reconciliation_reference_inventory_kg(
+        committed_state, reconciliation_baseline, baseline_validated=True,
+    )
+    _reconcile_ledger_with_physical_state(
+        ledger, reference_inventory_kg, column, active_layer, mass_resolution_kg,
+        reference_label=reference_label, ledger_shape=(ny, nx, n_classes),
+    )
+
+    # --- Untrusted-callback window: snapshot / freeze / detect / restore ---
+    # CW-B15: the ORIGINAL column's pending deep journal is the unpublished
+    # deep update this commit will hand to publication, so it is guarded
+    # exactly like the resident arrays: its three host arrays are snapshotted
+    # and compared BYTEWISE after every stage (a same-total class swap or an
+    # index change is detected even when the writeable flag is restored), and
+    # the identity of the binding object on the column is pinned. Flag
+    # enforcement is decided PER ARRAY: the journal is host NumPy (enforced)
+    # even when the resident arrays are CuPy (not enforceable).
+    pending_binding = column.pending_deep
+    names = [*_RESIDENT_FIELDS, "active", "packet"]
+    guarded = [getattr(column, name) for name in _RESIDENT_FIELDS] + [active_layer.mass_kg, packets.packet]
+    bytewise = [False] * len(guarded)
+    if pending_binding is not None:
+        journal = pending_binding.journal
+        names += ["pending_journal.cell_flat", "pending_journal.voxel", "pending_journal.values_kg"]
+        guarded += [journal.cell_flat, journal.voxel, journal.values_kg]
+        bytewise += [True, True, True]
+    snapshots = [arr.copy() for arr in guarded]
+    enforced = [freeze_is_enforced(arr) for arr in guarded]
+    original_writeable = [arr.flags.writeable if flag else True for arr, flag in zip(guarded, enforced)]
+
+    def _changed(arr, snapshot, exact_bytes: bool) -> bool:
+        if exact_bytes:
+            return arr.shape != snapshot.shape or arr.dtype != snapshot.dtype or arr.tobytes() != snapshot.tobytes()
+        return bool(any_true(arr != snapshot))
+
+    def _detect(stage_name: str) -> None:
+        if column.pending_deep is not pending_binding:
+            raise ValueError(
+                f"{stage_name} replaced the ORIGINAL column's pending deep-journal binding; the binding is being "
+                "restored and this commit rejected"
+            )
+        mutated = [name for name, arr, snap, exact in zip(names, guarded, snapshots, bytewise)
+                   if _changed(arr, snap, exact)]
+        if mutated:
+            raise ValueError(
+                f"{stage_name} mutated the ORIGINAL caller-owned array(s) {mutated} directly; the mutation is "
+                "being reverted and this commit rejected"
+            )
+
+    def _restore() -> None:
+        errors: list[BaseException] = []
+        if column.pending_deep is not pending_binding:
+            try:
+                object.__setattr__(column, "pending_deep", pending_binding)
+            except BaseException as exc:  # noqa: BLE001 -- restoration must not hide any failure type
+                exc.add_note("while restoring the pending deep-journal binding after a windowed commit-stage failure")
+                errors.append(exc)
+        for name, arr, snapshot, flag, writeable in zip(names, guarded, snapshots, enforced, original_writeable):
+            try:
+                if flag:
+                    arr.flags.writeable = True
+                arr[...] = snapshot
+                if flag:
+                    arr.flags.writeable = writeable
+            except BaseException as exc:  # noqa: BLE001 -- restoration must not hide any failure type
+                exc.add_note(f"while restoring {name} after a windowed commit-stage failure/mutation")
+                errors.append(exc)
+        if errors:
+            raise ExceptionGroup(f"{len(errors)} caller-buffer restoration(s) failed", errors)
+
+    def _reset_flags() -> None:
+        for arr, flag, writeable in zip(guarded, enforced, original_writeable):
+            if flag:
+                arr.flags.writeable = writeable
+
+    for arr in guarded:
+        freeze(arr)
+    try:
+        # --- Stage: avalanche (identity only in this slice) ---
+        stage_log.append("avalanche_callback(identity)")
+        stage_log.append("validate_avalanche_redistribution")
+        current_column, current_layer = column, active_layer
+        avalanche_applied = False
+        # --- Record the (zero) avalanche transfer through the SHARED ledger path ---
+        stage_log.append("record_avalanche_transfer")
+        zeros = array_namespace(active_layer.mass_kg).zeros((ny, nx, n_classes), dtype=np.float64)
+        ledger_with_avalanche = accumulate_process_transfer(ledger, avalanching_process_idx, zeros, zeros,
+                                                            mass_resolution_kg)
+        avalanche_diagnostics = {
+            "transfer_by_cell_class_kg": zeros,
+            "source_removed_by_class_kg": zeros.sum(axis=(0, 1)),
+            "destination_added_by_class_kg": zeros.sum(axis=(0, 1)),
+            "gross_moved_by_class_kg": zeros.sum(axis=(0, 1)),
+            "global_net_by_class_kg": zeros.sum(axis=(0, 1)),
+            "process_totals_by_class_kg": ledger_with_avalanche.process_totals_kg[avalanching_process_idx],
+            "gross_physical_activity_by_class_kg": gross_physical_activity_for_process_by_class_kg(
+                ledger_with_avalanche, avalanching_process_idx),
+        }
+        # --- Lifecycle stages on ISOLATED candidates; the bed must come back unchanged ---
+        for stage_name, callback, is_identity in zip(_STAGE_NAMES, stage_callbacks, stage_is_identity):
+            if is_identity:
+                stage_log.append(f"{stage_name}(identity)")
+                continue
+            candidate_column = _isolated_copy(current_column)
+            candidate_layer = ActiveLayerState(mass_kg=current_layer.mass_kg.copy())
+            out_column, out_layer = callback(candidate_column, candidate_layer, geometry, mass_resolution_kg)
+            _detect(stage_name)
+            if not isinstance(out_column, WindowedVoxelColumnState) or not isinstance(out_layer, ActiveLayerState):
+                raise ValueError(f"{stage_name} must return (WindowedVoxelColumnState, ActiveLayerState)")
+            if out_column.deep_store is not column.deep_store or out_column.manifest_digest != column.manifest_digest:
+                raise ValueError(f"{stage_name} returned a column bound to a different deep-store version")
+            check_windowed_column_cheap(out_column, geometry)
+            check_active_layer_state(out_layer, geometry, mass_resolution_kg)
+            for name in _RESIDENT_FIELDS:
+                if arrays_share_memory(getattr(out_column, name), getattr(column, name)):
+                    raise ValueError(f"{stage_name}'s returned {name} aliases the ORIGINAL caller array")
+            if arrays_share_memory(out_layer.mass_kg, active_layer.mass_kg):
+                raise ValueError(f"{stage_name}'s returned active_layer.mass_kg aliases the ORIGINAL caller array")
+            if not _resident_equal(out_column, current_column) or any_true(out_layer.mass_kg != current_layer.mass_kg):
+                raise ValueError(
+                    f"{stage_name} modified the bed; CW-B3c windowed lifecycle stages may only read the bed and "
+                    "the committed height (terrain-changing stages on windowed storage are a later task). "
+                    "Nothing was committed."
+                )
+            stage_log.append(stage_name)
+    except BaseException as forward_exc:
+        restore_error: BaseException | None = None
+        try:
+            _restore()
+        except BaseException as exc:  # noqa: BLE001
+            restore_error = exc
+        _reset_flags()
+        if restore_error is not None:
+            raise restore_error from forward_exc
+        raise
+    else:
+        _reset_flags()
+
+    # --- Pre-commit diagnostics (from the ledger including the zero fold-in) ---
+    pre_commit_residual_report = numerical_residual_report(ledger_with_avalanche)
+    pre_commit_pending_mass_by_class_kg = global_pending_mass_by_class_kg(ledger_with_avalanche)
+    pre_commit_process_totals_kg = ledger_with_avalanche.process_totals_kg
+    touches = gross = receipt = None
+    if record_exchange_history:
+        stage_log.append("capture_exchange_history")
+        touches, gross, receipt = _capture_exchange_history(ledger_with_avalanche)
+
+    # --- Refresh committed elevation: EXACT NumPy-order height from the packets ---
+    stage_log.append("refresh_committed_elevation")
+    elevation_m = windowed_committed_surface_elevation_m(current_column, current_layer, geometry,
+                                                        trusted_packet=trusted_packet)
+    previous_committed_elevation_m = committed_elevation_m(committed_state)
+    new_offset_m = elevation_m - committed_state.reference_elevation_m
+    new_committed_elevation_m = committed_state.reference_elevation_m + new_offset_m
+    committed_elevation_change_m = new_committed_elevation_m - previous_committed_elevation_m
+
+    baseline_xp = array_namespace(current_layer.mass_kg, current_column.window_kg)
+    new_active_layer_baseline = baseline_xp.array(current_layer.mass_kg, dtype=np.float64, copy=True, order="C")
+    new_voxel_baseline = baseline_xp.array(column_mass_by_class_kg(current_column), dtype=np.float64, copy=True,
+                                           order="C")
+
+    # --- Publish committed state ---
+    stage_log.append("publish_committed_state")
+    new_committed_state = CommittedTopographyState(
+        reference_elevation_m=committed_state.reference_elevation_m,
+        elevation_offset_m=new_offset_m,
+        committed_active_layer_mass_by_class_kg=new_active_layer_baseline,
+        committed_voxel_mass_by_class_kg=new_voxel_baseline,
+        last_commit_time_s=current_time_s,
+        commit_count=committed_state.commit_count + 1,
+    )
+
+    # --- Clear pending ledger LAST (representation and mapping preserved) ---
+    stage_log.append("clear_pending_ledger")
+    new_ledger = zeros_sediment_ledger_state(
+        ny=ny, nx=nx, n_classes=n_classes, namespace=baseline_xp,
+        present_processes=tuple(ledger.present_processes),
+    )
+
+    provenance = {
+        "height_source": "E1 prefix packets + resident window, NumPy contiguous pairwise order",
+        "packets": prefix_packets_report(current_column),
+        "capacity_kg": max_voxel_mass_kg(geometry),
+        "deep_store_reads_in_commit": 0,
+        "inventory_fold": "declared sequential fold (deep prefix + window slots); not the routing height",
+    }
+    return WindowedCommitResult(
+        new_committed_state=new_committed_state,
+        new_ledger=new_ledger,
+        new_voxel_column=current_column,
+        new_active_layer=current_layer,
+        avalanche_applied=avalanche_applied,
+        avalanche_diagnostics=avalanche_diagnostics,
+        committed_elevation_change_m=committed_elevation_change_m,
+        pre_commit_residual_report=pre_commit_residual_report,
+        pre_commit_pending_mass_by_class_kg=pre_commit_pending_mass_by_class_kg,
+        pre_commit_process_totals_kg=pre_commit_process_totals_kg,
+        commit_stage_log=tuple(stage_log),
+        new_reconciliation_baseline=(
+            None if reconciliation_baseline is None
+            else reconciliation_baseline_after_commit(new_committed_state, reconciliation_baseline, current_time_s)
+        ),
+        committed_height_provenance=provenance,
+        pre_commit_n_physical_touches=touches,
+        pre_commit_gross_physical_activity_kg=gross,
+        exchange_history_receipt=receipt,
+    )
+
+
+def commit_windowed_topography(*args, **kwargs) -> WindowedCommitResult:
+    """Public commit accepts only published deep storage. Dense semantics unchanged."""
+    if "staged" in kwargs:
+        raise TypeError("use stage_windowed_topography for unpublished transactions")
+    return _commit_windowed_topography(*args, **kwargs)
+
+
+def stage_windowed_topography(*args, **kwargs) -> WindowedCommitResult:
+    """Validate and derive an in-memory candidate, without deep-store publication.
+
+    Its returned column remains explicitly pending. Complete-event callers must
+    validate their prospective routing and all remaining step checks before
+    calling publish_staged_windowed_commit. A refusal leaves storage unchanged.
+    This stage does not turn an unpublished state into a restartable checkpoint.
+    """
+    if "staged" in kwargs:
+        raise TypeError("staged is an internal control")
+    return _commit_windowed_topography(*args, **kwargs, staged=True)
+
+
+def publish_staged_windowed_commit(result: WindowedCommitResult, geometry: GeometrySpec,
+                                   mass_resolution_kg: float, *,
+                                   max_records: int = DEFAULT_MAX_JOURNAL_RECORDS,
+                                   encoding: str = "full",
+                                   overlay_max_bytes: int | None = None) -> WindowedCommitResult:
+    """Publish an already validated candidate after its caller's final checks.
+
+    `max_records`, `encoding` (default `"full"`) and `overlay_max_bytes`
+    are forwarded unchanged to `publish_pending_column`."""
+    from maple.surface.voxels.windowed_pending import publish_pending_column
+
+    if not isinstance(result, WindowedCommitResult):
+        raise TypeError("expected WindowedCommitResult")
+    column = publish_pending_column(
+        result.new_voxel_column, geometry, mass_resolution_kg,
+        max_records=max_records, encoding=encoding, overlay_max_bytes=overlay_max_bytes)
+    return dataclasses.replace(result, new_voxel_column=column)
