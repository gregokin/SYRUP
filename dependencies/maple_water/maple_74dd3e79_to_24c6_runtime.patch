+        raise ValueError(
+            f"windowed column has {voxel_column.window_kg.shape[-1]} classes but grain_classes has {n_classes}"
+        )
+    # Every SUPPLIED optional demand term is validated BEFORE the working bed
+    # exists. CW-B67: an ABSENT term keeps its `None` sentinel here; the same
+    # helper builds its exact dense zero array immediately before the term's
+    # first numeric use (stage 4 / stage 7), so it is not live through erosion.
+    boundary_input = demand.boundary_input_by_cell_class_kg
+    if boundary_input is not None:
+        boundary_input = _optional_domain_array(
+            boundary_input, shape, "demand.boundary_input_by_cell_class_kg", xp)
+    requested_export = demand.boundary_export_by_cell_class_kg
+    if requested_export is not None:
+        requested_export = _optional_domain_array(
+            requested_export, shape, "demand.boundary_export_by_cell_class_kg", xp)
+    if sediment_availability is not None and initial_available_fraction is None:
+        raise ValueError(
+            "initial_available_fraction is required whenever sediment_availability is supplied"
+        )
