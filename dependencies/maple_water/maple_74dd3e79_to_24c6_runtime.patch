+_OWNED_DONOR_FIELDS = (
+    "pending_bed_mass_change_kg", "pending_compensation_kg",
+    "numerical_residual_positive_kg", "numerical_residual_positive_compensation_kg",
+    "numerical_residual_negative_kg", "numerical_residual_negative_compensation_kg",
+    "actual_mass_positive_kg", "actual_mass_positive_compensation_kg",
+    "actual_mass_negative_kg", "actual_mass_negative_compensation_kg",
+    "n_physical_touches",
