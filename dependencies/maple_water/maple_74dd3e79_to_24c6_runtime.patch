+    freeze(bed.window_totals_kg)
+    new_column = WindowedVoxelColumnState(
+        window_kg=bed.window_kg, base=bed.base, deep_by_class_kg=bed.deep_by_class_kg,
+        deep_total_kg=bed.deep_total_kg, deep_room_kg=bed.deep_room_kg, n_voxels=bed.n_voxels,
+        deep_store=voxel_column.deep_store, generation=voxel_column.generation,
+        manifest_digest=voxel_column.manifest_digest,
+    )
+    new_column = with_window_cache(new_column)
+    if bed.packet is not None:
+        # CW-B3c: bind the maintained packet grid to the NEW column (pending
+        # version identity; publication rebinds to the published one).
+        from maple.surface.voxels.windowed_prefix import attach_prefix_packets
+
+        new_column = attach_prefix_packets(new_column, bed.packet)
+    from maple.surface.voxels.windowed_pending import attach_pending_journal
+
+    new_column = attach_pending_journal(new_column, journal)
+    bed_change_by_class_kg = (new_layer.mass_kg - active_layer_mass_before).sum(axis=(0, 1)) + bed.voxel_delta_by_class_kg
+    bed_inventory_scale_kg = to_float(
+        bed.window_totals_kg.sum() + bed.deep_total_kg.sum() + new_layer.mass_kg.sum()
+    )
+    new_water = WaterState(depth_m=water.depth_m, mobile_mass_by_cell_class_kg=mobile_after)
+
+    transfers_delta = read_transfer_counters().delta(transfers_at_entry)
+    deep_now = read_deep_store_counters()
+    report = {key: value for key, value in bed.counters.items() if not key.endswith("_at_begin")}
+    report.update({
+        "journal_records": journal.n_records,
+        "journal_records_before_dedupe": bed.pending_records(),
+        "window_voxels": int(bed.window_kg.shape[2]),
+        "resident_window_bytes": int(bed.window_kg.nbytes),
+        "max_gather_columns": int(max_gather_columns),
+        "max_journal_records": int(max_journal_records),
+        "transient_bytes_estimate": int(
+            2 * bed.window_kg.nbytes + bed.window_totals_kg.nbytes
+            + bed.counters.get("miss_batch_bytes_peak", 0)
+        ),
+        "deep_store_counters_delta": {k: deep_now[k] - deep_at_entry[k] for k in deep_now},
+        # ACTUAL MAPLE transfer tallies for this step (to_host/to_device
+        # counted calls); the *_bytes_to_* keys above are the author's own
+        # sizes of what was asked to move and are identical on a host bed.
+        "transfer_counters_delta": dataclasses.asdict(transfers_delta),
+        "deep_writes_performed_here": 0,
+    })
+    receipt = WindowedExchangeReceipt(
+        journal if new_column.pending_deep is None else new_column.pending_deep.journal, report)
+
+    result = WindowedWaterProcessResult(
+        new_voxel_column=new_column,
+        new_active_layer=new_layer,
+        new_water=new_water,
+        new_ledger=working_ledger,
+        new_sediment_availability=working_availability,
+        adapter_name=adapter_name,
+        detachment_integration=detachment_integration,
+        requested_removal_by_cell_class_kg=requested_removal,
+        actual_removal_by_cell_class_kg=actual_removal,
+        deposition_by_cell_class_kg=deposited,
+        requested_removal_by_class_kg=requested_removal.sum(axis=(0, 1)),
+        actual_removal_by_class_kg=actual_removal.sum(axis=(0, 1)),
+        availability_shortfall_by_class_kg=availability_shortfall_by_class_kg,
+        shortfall_by_class_kg=shortfall_by_class_kg,
+        numerical_residual_by_class_kg=numerical_residual_by_class_kg,
+        deposited_mass_by_class_kg=deposited_mass_by_class_kg,
+        bed_change_by_class_kg=bed_change_by_class_kg,
+        mobile_mass_before_by_class_kg=mobile_before.sum(axis=(0, 1)),
+        mobile_mass_after_by_class_kg=mobile_after.sum(axis=(0, 1)),
+        boundary_input_by_class_kg=boundary_input_by_class_kg,
+        boundary_export_by_class_kg=boundary_export_by_class_kg,
+        face_flux=(demand.face_flux if demand.face_flux is not None
+                   else zero_face_flux(ny, nx, n_classes, namespace=xp)),
+        numerical_residual_scalar_kg=to_float(
+            erosion_replenishment_residual_sum_kg
+            + deposition_residual_sum_kg
+        ),
+        hydraulic_diagnostics=demand.hydraulic_diagnostics,
+        exchange_receipt=receipt,
+    )
+    validate_water_process_result(
+        result, ny=ny, nx=nx, n_classes=n_classes, mass_resolution_kg=mass_resolution_kg,
+        bed_inventory_scale_kg=bed_inventory_scale_kg,
+    )
+    return result
