+def _owned_donation_blocker(owned, caller_ledger, process, foreign_arrays) -> str | None:
+    """Why `owned` may NOT receive the second accumulation in place, or
+    None when every condition holds. Reads metadata, identities and memory
+    ranges only; writes nothing."""
+    from maple.core.backend import arrays_share_memory, is_array
+    from maple.core.types.sediment_ledger import CompactSedimentLedgerState
+    from maple.coupling.sediment_ledger._compact_kahan import inplace_kahan_available
+
+    water = process_index("water_erosion_deposition")
+    if isinstance(process, bool) or not isinstance(process, (int, np.integer)) or int(process) != water:
+        return "process is not water_erosion_deposition"
+    if type(owned) is not CompactSedimentLedgerState or tuple(owned.present_processes) != (water,):
+        return "donor is not a one-process (water) compact ledger"
+    if owned is caller_ledger:
+        return "donor is the caller's ledger"
+    donors = []
+    for name in _OWNED_DONOR_FIELDS:
+        arr = getattr(owned, name, None)
+        if not is_array(arr) or not arr.flags.c_contiguous:
+            return f"donor {name} is not a C-contiguous array"
+        if name == "n_physical_touches":
+            if arr.dtype.kind not in "iu":
+                return "donor touch counter is not an integer array"
+        elif arr.dtype != np.float64:
+            return f"donor {name} is not float64"
+        if isinstance(arr, np.ndarray) and not arr.flags.writeable:
+            return f"donor {name} is not writeable (frozen or a read-only view)"
+        donors.append((name, arr))
+    xp = array_namespace(*(arr for _, arr in donors))
+    if not inplace_kahan_available(xp):
+        return "no owned in-place kernel for this namespace"
+    for i, (name_a, a) in enumerate(donors):
+        for name_b, other in donors[i + 1:]:
+            if arrays_share_memory(a, other):
+                return f"donor {name_a} shares storage with donor {name_b}"
+    caller = [getattr(caller_ledger, name) for name in _ALL_LEDGER_ARRAY_FIELDS]
+    for name, arr in donors:
+        for other in (*caller, *foreign_arrays):
+            if not is_array(other) or array_namespace(other) is not xp:
+                continue  # a different backend cannot share storage
+            if arrays_share_memory(arr, other):
+                return f"donor {name} shares storage with a caller/foreign array"
+    return None
+
