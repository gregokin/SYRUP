index 0000000000000000000000000000000000000000..64b0f0f626e072d5d537a137805a1786199580e6
--- /dev/null
+++ b/src/maple/surface/voxels/windowed_transfer.py
@@ -0,0 +1,707 @@
+"""Surface exchange on a RESIDENT-WINDOW column (CW-B3b, correction 1): the
+actual MAPLE whole-column extraction/deposition kernels, applied through
+the `W`-voxel window where that is provably identical to the whole column
+and through bounded gathered full columns everywhere else.
+
+Nothing here is a new physical law. The arithmetic is exactly
+`_extract_surface_mixture_batched_inplace` /
+`_deposit_surface_mixture_batched_inplace` (surface/voxels/transfer.py),
+run (a) on the window array with the FULL column's summation bound
+(`n_voxels_for_bound = n_voxels`, the Phase 7e selective mechanism) for
+cells that pass the same exactness proof the dense selective entry uses,
+re-expressed on the resident window and its deep metadata, and (b) on
+real gathered full columns `(k, 1, n_voxels, n_classes)` for the rest, in
+batches of at most `max_gather_columns`.
+
+The working gather (correction 1 -- root-confirmed defect)
+---------------------------------------------------------
+A gathered full column is the TRUE current logical column of the
+transaction: the version's chunk data, THEN every pending journal record
+of this transaction for that cell applied in application order (a spill
+or an earlier miss in the same transaction has already moved voxels
+below the working base whose version copies are stale), THEN the current
+working window over `[base, base + W)`, THEN zero above. The previous
+revision omitted the pending-journal overlay, so a deposition miss after
+a spill in the same call read the STALE version composition of the
+just-spilled voxel (root: 14.2 kg of class mass moved between classes in
+one cell at step 7 of a 48-step 256-voxel/6-class run, with voxel totals
+unchanged, so packing alone could not see it). The overlay is applied to
+the bounded batch only, never to a full `(ny, nx, n_voxels, n_classes)`
+array, and never publishes anything.
+
+Exactness proofs (same as transfer.py's section comment, with the
+resident window in place of the dense top-aligned window)
+--------------------------------------------------------------
+Above `base + W` every logical voxel is exactly zero, and the kernels'
+cumulative sums over leading exact zeros are bitwise identical, so a
+kernel run on the window sees the same top-down cumulative masses and
+the same room the whole column would.
+
+* Extraction is run on the window iff the request is zero, OR `base ==
+  0` (the window IS the whole occupied column), OR the request is at most
+  the cumulative mass of slots `W-1 .. 1` (the terminal then lies above
+  slot 0, slot 0 is never drained, and the walk never reaches the deep
+  region). A request that would drain slot 0 with `base > 0` is a MISS:
+  the whole gathered column decides, exactly, and the window is rebased
+  afterwards. A zero request is skipped unless the window's top slot is
+  non-empty AND sits at the column top (`base + W == n_voxels`): only
+  then is the whole-column kernel's terminal (voxel `n_voxels - 1`) a
+  non-empty voxel on which its sub-roundoff reconciliation can act.
+* Deposition is run on the window iff no deep voxel below `base` has
+  room (`deep_room_kg > 0` is exactly "some deep voxel has room", a sum of
+  nonnegative terms being positive iff one term is), the request is an
+  exact fit in the window's room (`total - window_room <= bound`), and the
+  sub-bound rule holds (`base == 0` or slot 0 has zero room, so the
+  whole-column kernel's voxel-0 terminal for a sub-bound request behaves
+  identically). Everything else is a miss.
+* Spill (deposition only, before classification): a cell whose top sits
+  in the last slot while `base < n_voxels - W` shifts its window up by
+  one slot. Slot 0 is then at least two voxels below the top, hence full
+  by packing; it is appended to the deep prefix by the SAME sequential
+  extension the from-scratch fold performs (`prefix + slot0`, `room +
+  max(capacity - total0, 0)`), and journaled so the version receives the
+  authoritative copy. No deep read, mass unchanged.
+
+Rebase after a miss: `base' = clip(top' + 2 - W, 0, n_voxels - W)` (the
+dense `_surface_window` rule); the new window slice, deep prefix, room
+and total are recomputed from the gathered result column with the
+declared folds. Journal rule for a miss column: every voxel `v < base'`
+that is either at or above the OLD base (its version copy is stale, the
+window was authoritative) or whose value changed in the kernel. Across
+segments a later record to the same `(cell, voxel)` supersedes an earlier
+one, both in the working gather and in the published journal.
+
+Traffic and memory: fast cells and miss-batch exchange kernels run in the
+bed's own namespace. The deep store and journal stay host-only. Bounded
+miss columns cross through counted MAPLE helpers; request rows stay on
+the selected backend. Metadata and prefix work uses only touched rows.
+No whole-domain voxel array is uploaded or downloaded. One working
+window copy for the whole transaction; one `(k, n_voxels, n_classes)`
+batch at a time; journal records bounded by `n_voxels` per miss cell.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any
+
+import numpy as np
+
+from maple.core.backend import (
+    MapleArray,
+    array_namespace,
+    read_transfer_counters,
+    to_device,
+    to_host,
+    to_int,
+)
+from maple.core.parameters.geometry import GeometrySpec
+from maple.core.types.voxel import WindowedVoxelColumnState
+from maple.surface.voxels._numerics import summation_error_bound_kg
+from maple.surface.voxels.capacity import max_voxel_mass_kg
+from maple.surface.voxels.deep_store import (
+    DEFAULT_MAX_JOURNAL_RECORDS,
+    DeepJournal,
+    DeepStoreVersion,
+    JournalCapacityError,
+    read_deep_store_counters,
+)
+from maple.surface.voxels.transfer import (
+    BatchedMixtureTransferResult,
+    _deposit_surface_mixture_batched_inplace,
+    _extract_surface_mixture_batched_inplace,
+    record_selective_count,
+)
+from maple.surface.voxels.windowed_inventory import (
+    _overlay_full_columns,
+    check_windowed_column_cheap,
+    sequential_class_fold,
+    sequential_prefix_by_class,
+    sequential_room_prefix,
+)
+
+__all__ = [
+    "DEFAULT_EXCHANGE_GATHER_COLUMNS",
+    "MAX_EXCHANGE_GATHER_COLUMNS",
+    "WindowedWorkingBed",
+    "begin_windowed_transaction",
+    "gather_working_columns",
+    "windowed_deposit_inplace",
+    "windowed_extract_inplace",
+    "working_bed_journal",
+]
+
+#: Miss-batch bound for the exchange (root direction: 64-1024; the deep
+#: store's own gather default is a separate, unchanged API). Chastre
+#: (306 voxels, 6 classes): 256 columns = 3.8 MB per batch array.
+DEFAULT_EXCHANGE_GATHER_COLUMNS = 256
+MAX_EXCHANGE_GATHER_COLUMNS = 1024
+
+
+@dataclass
+class WindowedWorkingBed:
+    """The MUTABLE, transaction-private working copy of a windowed column.
+
+    Never exposed: `maple.water.windowed_step` creates it from the
+    caller's immutable state (one window copy, metadata copies), both
+    exchange calls mutate it, and only on success are its arrays frozen
+    into the result's new `WindowedVoxelColumnState`. The journal
+    segments are host data in application order.
+    """
+
+    xp: Any
+    geometry: GeometrySpec
+    mass_resolution_kg: float
+    n_voxels: int
+    version: DeepStoreVersion
+    window_kg: MapleArray  # (ny, nx, W, nc) working copy
+    window_totals_kg: MapleArray  # (ny, nx, W) maintained at touched slots
+    base: MapleArray  # (ny, nx) int32
+    deep_by_class_kg: MapleArray  # (ny, nx, nc)
+    deep_total_kg: MapleArray  # (ny, nx)
+    deep_room_kg: MapleArray  # (ny, nx)
+    voxel_delta_by_class_kg: MapleArray  # (nc,) stored-mass change over touched storage
+    max_gather_columns: int
+    max_journal_records: int
+    #: Working copy of the prefix height packets `(ny, nx, P)` in the bed's
+    #: namespace, or None when the input column carried none (CW-B3c).
+    #: Fast cells keep theirs; spills advance, misses re-encode, both on
+    #: the host for the touched rows only.
+    packet: MapleArray | None = None
+    journal_cells: list[np.ndarray] = field(default_factory=list)
+    journal_voxels: list[np.ndarray] = field(default_factory=list)
+    journal_values: list[np.ndarray] = field(default_factory=list)
+    counters: dict[str, Any] = field(default_factory=dict)
+
+    @property
+    def shape(self) -> tuple[int, int, int, int]:
+        ny, nx, width, nc = self.window_kg.shape
+        return int(ny), int(nx), int(width), int(nc)
+
+    def count(self, key: str, n: int = 1) -> None:
+        self.counters[key] = self.counters.get(key, 0) + int(n)
+
+    def pending_records(self) -> int:
+        return int(sum(int(c.shape[0]) for c in self.journal_cells))
+
+
+def begin_windowed_transaction(
+    column: WindowedVoxelColumnState,
+    geometry: GeometrySpec,
+    mass_resolution_kg: float,
+    *,
+    trust_window_cache: bool = False,
+    max_gather_columns: int = DEFAULT_EXCHANGE_GATHER_COLUMNS,
+    max_journal_records: int = DEFAULT_MAX_JOURNAL_RECORDS,
+) -> WindowedWorkingBed:
+    """Validate the caller's windowed column cheaply (binding included) and
+    copy its resident arrays ONCE into a working bed. The caller's arrays
+    are never written. Slot totals come from the column's window cache
+    when it describes this exact array and may be relied upon
+    (enforceably read-only, or `trust_window_cache`), else from one
+    class-axis reduction of the window."""
+    return _begin_windowed_transaction(column, geometry, mass_resolution_kg, trust_window_cache=trust_window_cache,
+                                       max_gather_columns=max_gather_columns,
+                                       max_journal_records=max_journal_records, owned=False)
+
+
+def _take_owned(array: MapleArray) -> MapleArray:
+    """CW-B75 PRIVATE: adopt an array of a transaction-PRIVATE column (never a caller's) as working storage without
+    a copy. NumPy: re-enable writes on a frozen array that owns its buffer; an array that is a view (cannot be
+    made writeable safely) is copied instead (same bytes). CuPy: no flag exists; the array is used as is."""
+    if isinstance(array, np.ndarray):
+        if not array.flags.writeable:
+            if array.base is not None:
+                return array.copy()
+            array.flags.writeable = True
+        return array
+    return array
+
+
+def _begin_owned_windowed_transaction(
+    column: WindowedVoxelColumnState,
+    geometry: GeometrySpec,
+    mass_resolution_kg: float,
+    *,
+    trust_window_cache: bool = False,
+    max_gather_columns: int = DEFAULT_EXCHANGE_GATHER_COLUMNS,
+    max_journal_records: int = DEFAULT_MAX_JOURNAL_RECORDS,
+) -> WindowedWorkingBed:
+    """CW-B75 PRIVATE: `begin_windowed_transaction` on a column that only the paired transaction
+    (`maple.water.windowed_transaction`) can reach -- its own phase-P result column, never returned, published or
+    passed to a callback. EVERY validation, cap and journal rule of the public begin runs unchanged and in order;
+    only the resident arrays are ADOPTED instead of copied (`_take_owned`). The window-cache validity is decided by
+    the public predicate BEFORE the window is made writeable; a CuPy column without trust takes the exact
+    `window.sum(axis=-1)` of the public begin."""
+    return _begin_windowed_transaction(column, geometry, mass_resolution_kg, trust_window_cache=trust_window_cache,
+                                       max_gather_columns=max_gather_columns,
+                                       max_journal_records=max_journal_records, owned=True)
+
+
+def _begin_windowed_transaction(
+    column: WindowedVoxelColumnState,
+    geometry: GeometrySpec,
+    mass_resolution_kg: float,
+    *,
+    trust_window_cache: bool,
+    max_gather_columns: int,
+    max_journal_records: int,
+    owned: bool,
+) -> WindowedWorkingBed:
+    """The shared body of the public and the private owned begin (CW-B75): identical statements except the
+    four storage acquisitions, which copy (public) or adopt (`owned`)."""
+    _ny, _nx, _width, nc = check_windowed_column_cheap(column, geometry)
+    if isinstance(max_gather_columns, bool) or not isinstance(max_gather_columns, (int, np.integer)):
+        raise ValueError("max_gather_columns must be an integer")
+    if not (1 <= int(max_gather_columns) <= MAX_EXCHANGE_GATHER_COLUMNS):
+        raise ValueError(
+            f"max_gather_columns must lie in [1, {MAX_EXCHANGE_GATHER_COLUMNS}], got {int(max_gather_columns)}"
+        )
+    if isinstance(max_journal_records, bool) or not isinstance(max_journal_records, (int, np.integer)) or max_journal_records < 0:
+        raise ValueError("max_journal_records must be a nonnegative integer")
+    if column.pending_deep is not None and column.pending_deep.journal.n_records > max_journal_records:
+        raise ValueError("prior pending journal exceeds max_journal_records")
+    xp = array_namespace(column.window_kg, column.base, column.deep_by_class_kg,
+                         column.deep_total_kg, column.deep_room_kg)
+    if owned:
+        # CW-B75: the cache predicate is read while the private window is still frozen (it decides exactly as the
+        # public begin would on this column), THEN the window is adopted.
+        cache = column.valid_window_cache(trusted=trust_window_cache)
+        window = _take_owned(column.window_kg)
+    else:
+        window = column.window_kg.copy()
+        record_selective_count("whole_mass_copy_entries", window.size)
+        cache = column.valid_window_cache(trusted=trust_window_cache)
+    if cache is not None:
+        totals = _take_owned(cache.window_totals_kg) if owned else cache.window_totals_kg.copy()
+        record_selective_count("cache_hits", 1)
+    else:
+        totals = window.sum(axis=-1)
+        record_selective_count("cache_rebuilds", 1)
+        record_selective_count("cache_rebuild_mass_entries", window.size)
+    take = _take_owned if owned else (lambda array: array.copy())
+    bed = WindowedWorkingBed(
+        xp=xp, geometry=geometry, mass_resolution_kg=float(mass_resolution_kg),
+        n_voxels=int(column.n_voxels), version=column.deep_store, window_kg=window,
+        window_totals_kg=totals, base=take(column.base), deep_by_class_kg=take(column.deep_by_class_kg),
+        deep_total_kg=take(column.deep_total_kg), deep_room_kg=take(column.deep_room_kg),
+        voxel_delta_by_class_kg=xp.zeros((nc,), dtype=np.float64),
+        max_gather_columns=int(max_gather_columns), max_journal_records=int(max_journal_records),
+    )
+    # Prior unpublished writes precede all writes in this call. Last write wins.
+    if column.pending_deep is not None:
+        journal = column.pending_deep.journal
+        bed.journal_cells.append(journal.cell_flat)
+        bed.journal_voxels.append(journal.voxel)
+        bed.journal_values.append(journal.values_kg)
+    if not owned:
+        bed.count("window_copy_entries", window.size)
+    if column.height_packet is not None:
+        # CW-B3c: a column that carries packets must carry VALID, bound,
+        # non-stale ones -- refused here, before any mutation.
+        from maple.surface.voxels.windowed_prefix import require_prefix_packets
+
+        packets = require_prefix_packets(column, operation="begin_windowed_transaction")
+        if owned:  # CW-B75: the validated private packet grid is adopted, not copied
+            bed.packet = _take_owned(packets.packet)
+        else:
+            bed.packet = packets.packet.copy()
+            bed.count("packet_copy_bytes", int(bed.packet.nbytes))
+    bed.counters["transfer_counters_at_begin"] = read_transfer_counters()
+    bed.counters["deep_store_counters_at_begin"] = read_deep_store_counters()
+    return bed
+
+
+# ---------------------------------------------------------------------------
+# Host-side helpers: the working gather, miss publication, spill, journal
+# ---------------------------------------------------------------------------
+
+
+def _down(bed: WindowedWorkingBed, array: MapleArray, key: str) -> np.ndarray:
+    """Counted device->host of exactly `array` (a bounded batch row set)."""
+    host = to_host(array)
+    bed.count(key, int(host.nbytes))
+    return host
+
+
+def _up(bed: WindowedWorkingBed, array: np.ndarray, key: str) -> MapleArray:
+    """Counted host->device of exactly `array` (identity on a host bed)."""
+    moved = to_device(array, bed.xp)
+    bed.count(key, int(array.nbytes))
+    return moved
+
+
+def _apply_pending_records(bed: WindowedWorkingBed, cells_flat: np.ndarray, columns: np.ndarray) -> int:
+    """Overlay every pending journal record of this transaction whose cell
+    lies in the (sorted) batch onto `columns` `(k, n_voxels, nc)` in
+    application order, so a later record to the same voxel wins. Returns
+    the number of records applied. Bounded by the batch and the pending
+    record count; nothing else is touched."""
+    k = int(cells_flat.shape[0])
+    if k == 0 or not bed.journal_cells:
+        return 0
+    applied = 0
+    for seg_cells, seg_voxels, seg_values in zip(bed.journal_cells, bed.journal_voxels, bed.journal_values):
+        idx = np.searchsorted(cells_flat, seg_cells)
+        safe = np.minimum(idx, k - 1)
+        hit = (idx < k) & (cells_flat[safe] == seg_cells)
+        if not np.any(hit):
+            continue
+        columns[idx[hit], seg_voxels[hit]] = seg_values[hit]
+        applied += int(np.count_nonzero(hit))
+    return applied
+
+
+def gather_working_columns(bed: WindowedWorkingBed, cells_flat: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    """The TRUE current logical columns `(k, n_voxels, nc)` of the working
+    bed on the HOST, for SORTED flat cell indices (at most
+    `max_gather_columns`): version data, then this transaction's pending
+    journal records in application order, then the working window inside
+    `[base, base + W)`, then zero above. Returns `(columns, base_rows)`.
+    Only the batch's window and base rows cross the bus (counted)."""
+    ny, nx, width, nc = bed.shape
+    if cells_flat.ndim != 1 or (cells_flat.shape[0] > 1 and np.any(np.diff(cells_flat) <= 0)):
+        raise ValueError("gather_working_columns requires strictly increasing flat cell indices")
+    deep = bed.version.gather_columns(cells_flat, max_columns=bed.max_gather_columns)
+    applied = _apply_pending_records(bed, cells_flat, deep)
+    device_idx = _up(bed, cells_flat, "index_bytes_to_device")
+    window_rows = _down(bed, bed.window_kg.reshape(ny * nx, width, nc)[device_idx], "window_row_bytes_to_host")
+    base_rows = _down(bed, bed.base.reshape(ny * nx)[device_idx], "metadata_bytes_to_host")
+    k = int(cells_flat.shape[0])
+    bed.count("deep_columns_gathered", k)
+    bed.count("deep_read_bytes", k * bed.n_voxels * nc * 8)
+    bed.count("pending_records_applied_to_gathers", applied)
+    return _overlay_full_columns(deep, window_rows, base_rows), base_rows
+
+
+def _publish_miss_columns(
+    bed: WindowedWorkingBed,
+    rows: Any,
+    cols: Any,
+    cells_flat: np.ndarray,
+    before: np.ndarray,
+    after: np.ndarray,
+    old_base: np.ndarray,
+) -> None:
+    """Rebase the miss columns onto their canonical window, write the new
+    window rows and deep metadata into the working bed (counted H2D on a
+    device bed), append the journal records, and account the stored-mass
+    delta over the whole column."""
+    _ny, _nx, width, _nc = bed.shape
+    nv = bed.n_voxels
+    k = after.shape[0]
+    capacity = max_voxel_mass_kg(bed.geometry)
+    totals_after = after.sum(axis=-1)  # (k, nv)
+    occupied = totals_after > 0.0
+    has_any = occupied.any(axis=-1)
+    top = np.where(has_any, nv - 1 - occupied[:, ::-1].argmax(axis=-1), -1).astype(np.int64)
+    new_base = np.clip(top + 2 - width, 0, nv - width).astype(np.int32)
+    slots = new_base.astype(np.int64)[:, None] + np.arange(width, dtype=np.int64)[None, :]
+    new_window = np.ascontiguousarray(after[np.arange(k)[:, None], slots])  # (k, W, nc)
+    deep_by_class = sequential_prefix_by_class(after, new_base.astype(np.int64))
+    deep_room = sequential_room_prefix(totals_after, new_base.astype(np.int64), capacity)
+    deep_total = sequential_class_fold(deep_by_class)
+    # Journal: v < base' and (v >= old_base or changed), in cell/voxel order.
+    v_idx = np.arange(nv, dtype=np.int64)
+    changed = (after != before).any(axis=-1)  # (k, nv)
+    record = (v_idx[None, :] < new_base[:, None]) & ((v_idx[None, :] >= old_base[:, None]) | changed)
+    ci, vi = np.nonzero(record)
+    if ci.size:
+        _require_journal_room(bed, int(ci.size))
+        bed.journal_cells.append(cells_flat[ci].astype(np.int64))
+        bed.journal_voxels.append(vi.astype(np.int64))
+        bed.journal_values.append(np.ascontiguousarray(after[ci, vi], dtype=np.float64))
+        bed.count("journal_records", int(ci.size))
+    if bed.packet is not None:
+        # CW-B3c: re-encode ONLY these columns from the true result column
+        # (pending overlay and the current exchange already applied).
+        from maple.surface.voxels.windowed_prefix import encode_prefix_packets_for_block
+
+        new_packet_rows = encode_prefix_packets_for_block(after, new_base, width)
+        bed.packet[rows, cols] = _up(bed, new_packet_rows, "packet_bytes_to_device")
+        bed.count("packet_rows_encoded", k)
+    bed.voxel_delta_by_class_kg += _up(bed, (after - before).sum(axis=(0, 1)), "metadata_bytes_to_device")
+    bed.window_kg[rows, cols] = _up(bed, new_window, "window_row_bytes_to_device")
+    bed.window_totals_kg[rows, cols] = _up(bed, new_window.sum(axis=-1), "metadata_bytes_to_device")
+    bed.base[rows, cols] = _up(bed, new_base, "metadata_bytes_to_device")
+    bed.deep_by_class_kg[rows, cols] = _up(bed, deep_by_class, "metadata_bytes_to_device")
+    bed.deep_total_kg[rows, cols] = _up(bed, deep_total, "metadata_bytes_to_device")
+    bed.deep_room_kg[rows, cols] = _up(bed, deep_room, "metadata_bytes_to_device")
+    bed.count("miss_cells", k)
+    bed.count("rebased_cells", int(np.count_nonzero(new_base != old_base.astype(np.int32))))
+
+
+def _spill_before_deposition(bed: WindowedWorkingBed, request_total: MapleArray) -> int:
+    """Shift the window up by one slot for cells whose top fills the last
+    slot, `base < n_voxels - W`, and a positive request is pending. Slot 0
+    (full by packing) joins the deep prefix by sequential extension on
+    the host and is journaled. Returns the number of spilled cells."""
+    xp = bed.xp
+    _ny, nx, width, _nc = bed.shape
+    nv = bed.n_voxels
+    if width >= nv:
+        return 0
+    needs = (bed.window_totals_kg[:, :, -1] > 0.0) & (bed.base < nv - width) & (request_total > 0.0)
+    n = to_int(xp.count_nonzero(needs))
+    if n == 0:
+        return 0
+    _require_journal_room(bed, n)
+    rows, cols = xp.nonzero(needs)
+    capacity = max_voxel_mass_kg(bed.geometry)
+    leaving = _down(bed, bed.window_kg[rows, cols], "window_row_bytes_to_host")  # (n, W, nc) OLD window rows
+    slot0 = np.ascontiguousarray(leaving[:, 0, :])  # (n, nc)
+    deep_host = _down(bed, bed.deep_by_class_kg[rows, cols], "metadata_bytes_to_host")
+    room_host = _down(bed, bed.deep_room_kg[rows, cols], "metadata_bytes_to_host")
+    base_host_native = _down(bed, bed.base[rows, cols], "metadata_bytes_to_host")
+    base_host = base_host_native.astype(np.int64)
+    rows_host = _down(bed, rows, "index_bytes_to_host").astype(np.int64)
+    cols_host = _down(bed, cols, "index_bytes_to_host").astype(np.int64)
+    new_deep = deep_host + slot0  # the sequential prefix extended by one voxel
+    new_room = room_host + np.maximum(capacity - slot0.sum(axis=-1), 0.0)
+    new_total = sequential_class_fold(new_deep)
+    if bed.packet is not None:
+        # CW-B3c: advance the packets of the spilled cells from the LEAVING
+        # window rows (host, bounded, no deep read).
+        from maple.surface.voxels.windowed_prefix import advance_prefix_packets_for_rows
+
+        old_packet = _down(bed, bed.packet[rows, cols], "packet_bytes_to_host")
+        new_packet = advance_prefix_packets_for_rows(
+            old_packet, base_host_native, (base_host_native + 1).astype(base_host_native.dtype), leaving,
+            n_voxels=nv, n_classes=slot0.shape[-1], window_voxels=width,
+        )
+        bed.packet[rows, cols] = _up(bed, new_packet, "packet_bytes_to_device")
+        bed.count("packet_rows_advanced", n)
+    bed.journal_cells.append(rows_host * nx + cols_host)
+    bed.journal_voxels.append(base_host)
+    bed.journal_values.append(np.ascontiguousarray(slot0, dtype=np.float64))
+    bed.count("journal_records", int(n))
+    # Shift the window and totals up by one slot (new last slot empty).
+    shifted = bed.window_kg[rows, cols][:, 1:, :]
+    bed.window_kg[rows, cols, :-1, :] = shifted
+    bed.window_kg[rows, cols, -1, :] = 0.0
+    shifted_totals = bed.window_totals_kg[rows, cols][:, 1:]
+    bed.window_totals_kg[rows, cols, :-1] = shifted_totals
+    bed.window_totals_kg[rows, cols, -1] = 0.0
+    bed.base[rows, cols] = bed.base[rows, cols] + 1
+    bed.deep_by_class_kg[rows, cols] = _up(bed, new_deep, "metadata_bytes_to_device")
+    bed.deep_room_kg[rows, cols] = _up(bed, new_room, "metadata_bytes_to_device")
+    bed.deep_total_kg[rows, cols] = _up(bed, new_total, "metadata_bytes_to_device")
+    bed.count("spilled_cells", n)
+    return n
+
+
+def _require_journal_room(bed: WindowedWorkingBed, n: int) -> None:
+    """Hard append cap before allocating new record arrays or concatenating.
+
+    Counts application-order records, including repeats. Never truncates or
+    discards a write; final last-write deduplication cannot hide excess peak
+    storage. Only private scratch may have changed when this refusal occurs.
+    Raises the structured `JournalCapacityError` (a `ValueError` with the
+    unchanged message) carrying the current/new/maximum record counts.
+    """
+    current = bed.pending_records()
+    if current + n > bed.max_journal_records:
+        raise JournalCapacityError(f"pending journal exceeds max_journal_records={bed.max_journal_records}",
+                                   current_records=current, new_records=n, max_records=bed.max_journal_records)
+
+
+def working_bed_journal(bed: WindowedWorkingBed) -> DeepJournal:
+    """The transaction's journal as ONE canonical `DeepJournal` bound to the
+    version's header. Records are in application order; a later write to
+    the same `(cell, voxel)` supersedes an earlier one (ordered
+    semantics), so the canonical set keeps the LAST value -- the same rule
+    `gather_working_columns` applies to the working columns."""
+    header = bed.version.header
+    if not bed.journal_cells:
+        return DeepJournal.from_records(np.zeros((0,), np.int64), np.zeros((0,), np.int64),
+                                        np.zeros((0, header.n_classes)), header=header)
+    _require_journal_room(bed, 0)
+    cells = np.concatenate(bed.journal_cells)
+    voxels = np.concatenate(bed.journal_voxels)
+    values = np.concatenate(bed.journal_values, axis=0)
+    key = cells * np.int64(header.n_voxels) + voxels
+    order = np.argsort(key, kind="stable")
+    key_sorted = key[order]
+    last = np.ones(key_sorted.shape, dtype=bool)
+    last[:-1] = key_sorted[1:] != key_sorted[:-1]
+    keep = order[last]
+    return DeepJournal.from_records(cells[keep], voxels[keep], values[keep], header=header, max_records=bed.max_journal_records)
+
+
+# ---------------------------------------------------------------------------
+# Result assembly and the two cell groups
+# ---------------------------------------------------------------------------
+
+
+def _assemble(xp, ny, nx, nc, requested_total, groups) -> BatchedMixtureTransferResult:
+    actual = xp.zeros((ny, nx, nc), dtype=np.float64)
+    total = xp.zeros((ny, nx), dtype=np.float64)
+    shortfall = xp.zeros((ny, nx), dtype=np.float64)
+    residual = xp.zeros((ny, nx), dtype=np.float64)
+    limited = xp.zeros((ny, nx), dtype=bool)
+    for rows, cols, result in groups:
+        actual[rows, cols] = to_device(result.actual_mass_by_class_kg[:, 0], xp)
+        total[rows, cols] = to_device(result.actual_total_mass_kg[:, 0], xp)
+        shortfall[rows, cols] = to_device(result.shortfall_total_mass_kg[:, 0], xp)
+        residual[rows, cols] = to_device(result.numerical_residual_total_mass_kg[:, 0], xp)
+        limited[rows, cols] = to_device(result.limited[:, 0], xp)
+    return BatchedMixtureTransferResult(
+        actual_mass_by_class_kg=actual, actual_total_mass_kg=total, requested_total_mass_kg=requested_total,
+        shortfall_total_mass_kg=shortfall, numerical_residual_total_mass_kg=residual, limited=limited,
+    )
+
+
+def _run_miss_batches(bed: WindowedWorkingBed, kernel, miss: MapleArray, request: MapleArray, groups: list) -> None:
+    """Bounded gathered columns through the actual kernel on the bed backend.
+    Host storage/prefix bookkeeping sees only gathered rows; requests remain
+    in their original namespace. No complete voxel grid is allocated."""
+    xp = bed.xp
+    _ny, nx, _width, _nc = bed.shape
+    rows_all, cols_all = xp.nonzero(miss)
+    rows_h = _down(bed, rows_all, "index_bytes_to_host").astype(np.int64)
+    cols_h = _down(bed, cols_all, "index_bytes_to_host").astype(np.int64)
+    n = int(rows_h.shape[0])
+    bed.counters.setdefault("request_row_bytes_to_host", 0)
+    for start in range(0, n, bed.max_gather_columns):
+        stop = min(n, start + bed.max_gather_columns)
+        rows_b, cols_b = rows_all[start:stop], cols_all[start:stop]
+        cells_flat = rows_h[start:stop] * nx + cols_h[start:stop]
+        before, old_base = gather_working_columns(bed, cells_flat)
+        # Run the ACTUAL MAPLE kernel in the bed's own namespace. Host-only
+        # misses differed by one ULP from the CuPy dense kernel in a six-class
+        # deep-column fixture. Only a bounded full-column batch crosses the bus;
+        # the domain remains resident and no whole voxel grid is formed.
+        sub = _up(bed, before.copy()[:, None], "miss_column_bytes_to_device")
+        request_b = request[rows_b, cols_b][:, None]
+        result_b = kernel(sub, request_b, bed.geometry, bed.mass_resolution_kg)
+        after = _down(bed, sub[:, 0], "miss_column_bytes_to_host")
+        _publish_miss_columns(bed, rows_b, cols_b, cells_flat, before, after, old_base.astype(np.int64))
+        groups.append((rows_b, cols_b, result_b))
+        bed.count("miss_batches", 1)
+        bed.counters["miss_batch_bytes_peak"] = max(bed.counters.get("miss_batch_bytes_peak", 0), 3 * int(sub.nbytes))
+
+
+def _run_fast_cells(bed: WindowedWorkingBed, kernel, fast: MapleArray, n_fast: int, request, groups: list,
+                    *, all_fast: bool) -> BatchedMixtureTransferResult | None:
+    """Window kernel on the provably exact cells with the FULL column bound.
+    With every cell fast and none skipped the kernel runs directly on the
+    whole working window (no gather); otherwise on the gathered subset."""
+    xp = bed.xp
+    ny, nx, width, nc = bed.shape
+    nv = bed.n_voxels
+    if all_fast:
+        before = bed.window_kg.copy()
+        result = kernel(bed.window_kg, request, bed.geometry, bed.mass_resolution_kg, n_voxels_for_bound=nv)
+        bed.window_totals_kg[...] = bed.window_kg.sum(axis=-1)
+        # CW-B17: the stored-mass delta is formed IN the private `before`
+        # buffer (same elementwise IEEE subtraction, same C-contiguous shape,
+        # so the reduction below sees identical bytes in identical order);
+        # `before` is never read again and is released here.
+        before = xp.subtract(bed.window_kg, before, out=before)
+        bed.voxel_delta_by_class_kg += before.sum(axis=(0, 1, 2))
+        del before
+        bed.count("fast_cells", ny * nx)
+        bed.count("fast_kernel_entries", ny * nx * width * nc)
+        return result
+    if n_fast == 0:
+        return None
+    rows, cols = xp.nonzero(fast)
+    sub = bed.window_kg[rows, cols][:, None]  # (k, 1, W, nc) copy
+    before = sub.copy()
+    result = kernel(sub, request[rows, cols][:, None], bed.geometry, bed.mass_resolution_kg,
+                    n_voxels_for_bound=nv)
+    bed.window_kg[rows, cols] = sub[:, 0]
+    bed.window_totals_kg[rows, cols] = sub[:, 0].sum(axis=-1)
+    # CW-B17: delta in the private `before` buffer (see the all-fast path);
+    # `sub` and `before` are private gathers, released after their last use.
+    before = xp.subtract(sub, before, out=before)
+    bed.voxel_delta_by_class_kg += before.sum(axis=(0, 1, 2))
+    del sub, before
+    groups.append((rows, cols, result))
+    bed.count("fast_cells", n_fast)
+    bed.count("fast_kernel_entries", n_fast * width * nc)
+    return None
+
+
+# ---------------------------------------------------------------------------
+# Public kernels on the working bed
+# ---------------------------------------------------------------------------
+
+
+def windowed_extract_inplace(bed: WindowedWorkingBed, requested_total_mass_kg: MapleArray) -> BatchedMixtureTransferResult:
+    """`_extract_surface_mixture_batched_inplace`, cell for cell, on the
+    working bed (see the module docstring for the proof). `requested_
+    total_mass_kg` is `(ny, nx)`, finite, nonnegative, in the bed's
+    namespace. Mutates the working bed; the caller's state is untouched."""
+    xp = bed.xp
+    ny, nx, width, nc = bed.shape
+    nv = bed.n_voxels
+    request = requested_total_mass_kg
+    totals = bed.window_totals_kg
+    topdown_cum = xp.cumsum(totals[..., ::-1], axis=-1)  # (ny, nx, W), slot W-1 first
+    above_slot0 = topdown_cum[..., -2] if width > 1 else xp.zeros((ny, nx), dtype=np.float64)
+    zero_request = request == 0.0
+    top_slot_nonempty = totals[..., -1] != 0.0
+    at_column_top = (bed.base + width) == nv
+    active = (~zero_request) | (top_slot_nonempty & at_column_top)
+    exact = zero_request | (bed.base == 0) | (request <= above_slot0)
+    miss = active & ~exact
+    fast = active & exact
+    n_miss = to_int(xp.count_nonzero(miss))
+    n_active = to_int(xp.count_nonzero(active))
+    n_fast = n_active - n_miss
+    bed.count("extract_calls", 1)
+    bed.count("extract_cells_skipped", ny * nx - n_active)
+    bed.count("extract_cells_fast", n_fast)
+    bed.count("extract_cells_miss", n_miss)
+    groups: list = []
+    kernel = _extract_surface_mixture_batched_inplace
+    if n_miss:
+        _run_miss_batches(bed, kernel, miss, request, groups)
+    whole = _run_fast_cells(bed, kernel, fast, n_fast, request, groups,
+                            all_fast=(n_miss == 0 and n_active == ny * nx))
+    if whole is not None:
+        return whole
+    return _assemble(xp, ny, nx, nc, request, groups)
+
+
+def windowed_deposit_inplace(bed: WindowedWorkingBed, request: MapleArray) -> BatchedMixtureTransferResult:
+    """`_deposit_surface_mixture_batched_inplace`, cell for cell, on the
+    working bed: spill, then classification, then miss batches FIRST (a
+    capacity refusal raises before any fast window is written; the
+    working bed is private either way), then fast window cells. `request`
+    is `(ny, nx, nc)`, canonical, in the bed's namespace."""
+    xp = bed.xp
+    ny, nx, _width, nc = bed.shape
+    nv = bed.n_voxels
+    capacity = max_voxel_mass_kg(bed.geometry)
+    total_mass_kg = request.sum(axis=-1)  # the kernel's own expression
+    _spill_before_deposition(bed, total_mass_kg)
+    totals = bed.window_totals_kg
+    room_by_slot = xp.maximum(capacity - totals, 0.0)
+    window_total_room = xp.cumsum(room_by_slot, axis=-1)[..., -1]
+    room_error_bound = summation_error_bound_kg(nv, capacity)
+    deep_room_present = bed.deep_room_kg > 0.0
+    fits_window = (total_mass_kg - window_total_room) <= room_error_bound
+    sub_bound = (total_mass_kg > 0.0) & (total_mass_kg <= room_error_bound)
+    sub_bound_identical = (bed.base == 0) | (room_by_slot[..., 0] == 0.0)
+    exact = (~deep_room_present) & fits_window & ((~sub_bound) | sub_bound_identical)
+    active = total_mass_kg != 0.0
+    miss = active & ~exact
+    fast = active & exact
+    n_miss = to_int(xp.count_nonzero(miss))
+    n_active = to_int(xp.count_nonzero(active))
+    n_fast = n_active - n_miss
+    bed.count("deposit_calls", 1)
+    bed.count("deposit_cells_skipped", ny * nx - n_active)
+    bed.count("deposit_cells_fast", n_fast)
+    bed.count("deposit_cells_miss", n_miss)
+    groups: list = []
+    kernel = _deposit_surface_mixture_batched_inplace
+    if n_miss:
+        _run_miss_batches(bed, kernel, miss, request, groups)
+    whole = _run_fast_cells(bed, kernel, fast, n_fast, request, groups,
+                            all_fast=(n_miss == 0 and n_active == ny * nx))
+    if whole is not None:
+        return whole
+    return _assemble(xp, ny, nx, nc, total_mass_kg, groups)
