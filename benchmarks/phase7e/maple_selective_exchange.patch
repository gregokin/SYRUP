+class ArrayBinding:
+    """Identity binding of derived metadata to ONE exact array object
+    (Phase 7e). Deliberately neither an array, a dataclass, a tuple, a list
+    nor a dict, so the backend tree walkers pass it through untouched.
+
+    It holds an ordinary (strong) reference: the binding only ever lives
+    inside the `VoxelColumnState` that owns that very array, so it retains
+    nothing the column does not already retain. It is never carried into
+    another column: `VoxelColumnState.surface_cache` is `init=False`, so
+    `dataclasses.replace`, `to_host_tree`/`to_device_tree`, snapshot
+    restore and every ordinary constructor produce a column WITHOUT a
+    cache. (CuPy arrays are not weak-referenceable, so a weak binding
+    could not be backend-neutral; dropping at construction is what keeps
+    an old bed from being retained.)
+    """
+
+    __slots__ = ("array",)
+
+    def __init__(self, array: Any) -> None:
+        self.array = array
+
+
+def _is_enforced_read_only(array: Any) -> bool:
+    """True only for a NumPy array whose writeable flag is cleared -- the
+    one backend where in-place mutation is genuinely refused by the
+    interpreter (same rule as `maple.core.backend.is_frozen`, restated
+    here to keep `core/types` free of backend imports)."""
+    return isinstance(array, np.ndarray) and not array.flags.writeable
+
+
+@dataclass(frozen=True)
+class VoxelSurfaceCache:
+    """Per-cell voxel totals of ONE exact `VoxelColumnState.mass_kg` array
+    (Phase 7e SYRUP candidate; see surface/voxels/transfer.py, "Selective
+    exchange").
+
+    `voxel_totals_kg` `(ny, nx, n_voxels)` FP64 is bit-identical to
+    `mass_kg.sum(axis=-1)` of the bound array: the surface-exchange kernels
+    maintain it by rewriting exactly the entries of the voxels they
+    touched, with the same per-voxel class-axis reduction. `binding` names
+    the array object.
+
+    TRUST BOUNDARY. Identity alone cannot detect an in-place write into a
+    writable array, so a cache is only USED when `describes(mass_kg)` holds
+    AND either the array is enforceably read-only (NumPy, frozen by the
+    exchange routine that built the cache) or the calling transaction
+    declares `trusted=True` because it owns the whole chain of states
+    between the exchange that built the cache and this one (the water step
+    does so for its internal erosion -> deposition hand-off; a scheduler
+    that keeps states immutable may do so across steps). An ordinary public
+    caller with a writable array therefore never has a cache trusted on its
+    behalf: the totals are rebuilt from the mass array. `validate_voxel_
+    surface_cache` (transfer.py) recomputes and compares bitwise for
+    trusted boundaries, full-state validation and tests. Derived data, never
+    persisted; a snapshot or checkpoint restores a column without it.
+    """
+
+    voxel_totals_kg: np.ndarray  # (ny, nx, n_voxels) fp64, read-only where enforceable
+    binding: ArrayBinding
+
+    def describes(self, mass_kg: Any) -> bool:
+        return self.binding.array is mass_kg
 
 
