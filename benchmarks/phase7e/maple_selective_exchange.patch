+
+def _deposit_surface_mixture_selective_inplace(
+    mass: MapleArray,
+    request: MapleArray,
+    geometry: GeometrySpec,
+    mass_resolution_kg: float,
+    voxel_totals_kg: MapleArray,
+    *,
+    voxel_delta_by_class_kg: MapleArray | None = None,
+) -> BatchedMixtureTransferResult:
+    """`_deposit_surface_mixture_batched_inplace`, cell for cell, through
+    per-cell surface windows where provably identical, whole gathered
+    columns elsewhere (deep floating-point room included), and nothing for
+    zero requests. Same contract and atomicity as the whole-domain kernel:
+    a capacity refusal raises before `mass` or the totals are touched."""
+    xp = array_namespace(mass, request, voxel_totals_kg)
+    ny, nx, n_voxels, _n_classes = mass.shape
+    window = min(SELECTIVE_WINDOW_VOXELS, n_voxels)
+    if window == n_voxels:
+        return _whole_column_with_totals("deposit", _deposit_surface_mixture_batched_inplace, mass, request,
+                                         geometry, mass_resolution_kg, voxel_totals_kg, voxel_delta_by_class_kg)
+    capacity = max_voxel_mass_kg(geometry)
+    room_by_voxel = xp.maximum(capacity - voxel_totals_kg, 0.0)  # (ny, nx, n_voxels) metadata pass
+    start, index = _surface_window(voxel_totals_kg, window)
+    room_error_bound = summation_error_bound_kg(n_voxels, capacity)
+    total_mass_kg = request.sum(axis=-1)  # the kernel's own expression
+    window_room = _gather_window(room_by_voxel, index)
+    window_total_room = xp.cumsum(window_room, axis=-1)[..., -1]  # the kernel's `total_room` on the window
+    below_window = xp.arange(n_voxels)[None, None, :] < start[..., None]
+    deep_room = xp.any(below_window & (room_by_voxel > 0.0), axis=-1)
+    fits_window = (total_mass_kg - window_total_room) <= room_error_bound
+    sub_bound = (total_mass_kg > 0.0) & (total_mass_kg <= room_error_bound)
+    sub_bound_identical = (start == 0) | (window_room[..., 0] == 0.0)
+    exact = (~deep_room) & fits_window & ((~sub_bound) | sub_bound_identical)
+    active = total_mass_kg != 0.0  # a zero request places nothing anywhere
+    return _selective_exchange(
+        "deposit", _deposit_surface_mixture_batched_inplace, mass, request, total_mass_kg, active, exact, index,
+        geometry, mass_resolution_kg, voxel_totals_kg, ny * nx * n_voxels, voxel_delta_by_class_kg,
+    )
