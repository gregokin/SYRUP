+# ---------------------------------------------------------------------------
+# Selective (surface-window) exchange with cached voxel totals -- Phase 7e
+# SYRUP candidate.
+#
+# Ordinary surface exchange only touches the voxels at the top of each
+# column: extraction drains downward from the uppermost occupied voxel,
+# deposition fills upward from the first voxel with room. The batched
+# kernels above are nevertheless written over the WHOLE (ny, nx, n_voxels,
+# n_classes) array, so every call reads, compares and rewrites every voxel
+# of every column and allocates several full-size temporaries.
+#
+# The `_selective_inplace` entry points below instead work from the
+# per-cell VOXEL TOTALS `(ny, nx, n_voxels)` -- metadata the exchange
+# routines carry across calls in `VoxelColumnState.surface_cache`, bound
+# to the exact mass array it describes and trusted only under the rule in
+# core/types/voxel.py (enforceably read-only array, or a transaction that
+# owns the state chain). The totals are built from the mass array ONCE
+# when a column arrives without a usable cache (first exchange after a
+# case load, a topographic commit, a checkpoint restore, a backend
+# conversion, any `dataclasses.replace`, or a writable array) and are
+# thereafter rewritten only at the voxels an exchange touched, with the
+# same per-voxel class-axis reduction the full build uses, so they stay
+# bit-identical to `mass_kg.sum(axis=-1)` of the array they describe.
+#
+# From those totals each call: (1) SKIPS every cell on which the kernel
+# provably has no effect and reports zeros for it -- a zero extraction
+# request whose top window voxel is empty (the whole-column kernel's
+# terminal is then an empty voxel and it removes nothing; a zero request
+# at a NON-empty top allocated voxel is NOT skipped, so the established
+# sub-roundoff reconciliation of that case is preserved), or a zero
+# deposition request (the kernel places nothing); (2) gathers, for the
+# remaining cells, a top-aligned window of `SELECTIVE_WINDOW_VOXELS`
+# physically contiguous voxels (the uppermost occupied voxel, the one
+# below it, the empty one above it, clipped to the column) and runs the
+# UNCHANGED batched kernel on it with the full column's summation bound,
+# which is exact -- not approximately equal -- to the whole-column kernel
+# for every cell passing a per-cell validity test; (3) gathers the WHOLE
+# columns of the cells that fail the test and runs the same kernel on
+# them (per-cell independent arithmetic), so the combined result equals
+# the whole-domain call cell for cell. Nothing is netted or delayed; the
+# callers refresh the active layer and availability exactly as before.
+#
+# Validity tests:
+#   extraction: request == 0, OR the window's own cumulative mass covers
+#     the request (terminal and everything above it inside the window;
+#     cumulative sums over leading empties are bit-identical), OR the window
+#     starts at voxel 0 (both calls see the whole occupied column);
+#   deposition: no voxel BELOW the window has nonzero room -- INCLUDING the
+#     floating-point room a nominally full deep voxel can carry, which the
+#     whole-column kernel does fill and which therefore routes that cell to
+#     the exact whole-column path -- AND the request is an exact fit inside
+#     the window (`request - window_room <= bound`), AND a sub-bound request
+#     (whole-column terminal: voxel 0) either starts the window at voxel 0
+#     or meets a first window voxel with zero room exactly as voxel 0 has.
+#
+# Optional `voxel_delta_by_class_kg` accumulators receive the per-class sum
+# of (stored mass after - before) over exactly the touched voxels: an
+# independent measurement of the bed change from the stored arrays, for
+# the trusted transaction path that replaces full inventory scans.
+#
+# Both entry points run unchanged on NumPy and CuPy; each call makes two
+# counted host reads (active and fallback cell counts). `selective_
+# statistics` distinguishes metadata passes, kernel voxel-entry accesses,
+# whole-array copies, cache rebuilds (full mass reads) and inventory scans.
+# ---------------------------------------------------------------------------
+
+#: Voxels per cell gathered on the fast path: the top occupied voxel, one
+#: below (a take that empties the top voxel continues there) and one above
+#: (a fill that completes the top voxel continues there).
+SELECTIVE_WINDOW_VOXELS = 3
+
+#: Host-integer diagnostic counters; reset with `reset_selective_statistics`.
+selective_statistics: dict[str, int] = {}
+
+_DIRECTION_KEYS = ("calls", "cells_skipped", "cells_fast", "cells_fallback", "kernel_entries_fast",
+                   "kernel_entries_fallback", "metadata_entries")
+_GLOBAL_KEYS = ("cache_hits", "cache_rebuilds", "cache_rebuild_mass_entries", "metadata_copy_entries",
+                "whole_mass_copy_entries", "inventory_scans", "inventory_scan_entries",
+                "touched_delta_bed_changes", "window_voxels")
+
+
+def reset_selective_statistics() -> None:
+    for direction in ("extract", "deposit"):
+        for key in _DIRECTION_KEYS:
+            selective_statistics[f"{direction}_{key}"] = 0
+    for key in _GLOBAL_KEYS:
+        selective_statistics[key] = 0
+
+
+def record_selective_count(key: str, n: int) -> None:
+    selective_statistics[key] = selective_statistics.get(key, 0) + int(n)
+
+
+reset_selective_statistics()
+
+
+def voxel_totals_for_exchange(column: VoxelColumnState, *, trusted: bool = False) -> MapleArray:
+    """A WRITABLE copy of the per-cell voxel totals of `column.mass_kg`:
+    from the column's cache when it describes this exact array and may be
+    relied upon (`VoxelColumnState.valid_surface_cache`; one `(ny, nx,
+    n_voxels)` metadata copy), otherwise rebuilt from the mass array (one
+    full read of every voxel entry, counted as a rebuild)."""
+    cache = column.valid_surface_cache(trusted=trusted)
+    if cache is not None:
+        record_selective_count("cache_hits", 1)
+        record_selective_count("metadata_copy_entries", cache.voxel_totals_kg.size)
+        return cache.voxel_totals_kg.copy()
+    mass = column.mass_kg
+    record_selective_count("cache_rebuilds", 1)
+    record_selective_count("cache_rebuild_mass_entries", mass.size)
+    return mass.sum(axis=-1)
+
+
+def column_with_surface_cache(mass_kg: MapleArray, voxel_totals_kg: MapleArray) -> VoxelColumnState:
+    """Wrap a mass array an exchange routine has JUST produced with the
+    totals its kernels maintained for it. Both arrays are frozen (read-only
+    where the backend enforces it) so the identity binding cannot be
+    silently invalidated by an in-place write; `voxel_totals_kg` must be
+    bit-identical to `mass_kg.sum(axis=-1)` (true by construction for the
+    selective kernels; `validate_voxel_surface_cache` checks it).
+
+    Internal constructor for exchange routines. Attaching a cache to an
+    array that other code may still write, or with totals that were not
+    maintained by these kernels, is a contract violation this function
+    cannot detect."""
+    freeze(mass_kg)
+    freeze(voxel_totals_kg)
+    column = VoxelColumnState(mass_kg=mass_kg)
+    object.__setattr__(column, "surface_cache", VoxelSurfaceCache(voxel_totals_kg, ArrayBinding(mass_kg)))
+    return column
+
+
+def validate_voxel_surface_cache(column: VoxelColumnState, *, trusted: bool = True) -> bool:
+    """Recompute the totals from the mass array and require bitwise
+    agreement with a present, bound cache (trusted or not: this IS the
+    independent check). Returns False when no bound cache is attached;
+    raises ValueError on a mismatch. A full read, for trusted boundaries,
+    full-state validation, checkpoints and tests."""
+    cache = column.valid_surface_cache(trusted=trusted)
+    if cache is None:
+        return False
+    xp = array_namespace(column.mass_kg, cache.voxel_totals_kg)
+    recomputed = column.mass_kg.sum(axis=-1)
+    if cache.voxel_totals_kg.shape != recomputed.shape or not to_bool(
+        xp.all(cache.voxel_totals_kg == recomputed)
+    ):
+        raise ValueError(
+            "VoxelSurfaceCache totals disagree with mass_kg.sum(axis=-1) of the array they are bound to; "
+            "the bound array was mutated in place or the cache was not maintained by the exchange kernels"
+        )
+    return True
+
+
+def _record_selective(direction, n_skipped, n_fast, n_fallback, window, n_voxels, n_classes, metadata_entries):
+    record_selective_count(f"{direction}_calls", 1)
+    record_selective_count(f"{direction}_cells_skipped", n_skipped)
+    record_selective_count(f"{direction}_cells_fast", n_fast)
+    record_selective_count(f"{direction}_cells_fallback", n_fallback)
+    record_selective_count(f"{direction}_kernel_entries_fast", n_fast * window * n_classes)
+    record_selective_count(f"{direction}_kernel_entries_fallback", n_fallback * n_voxels * n_classes)
+    record_selective_count(f"{direction}_metadata_entries", metadata_entries)
+    selective_statistics["window_voxels"] = window
+
+
+def _surface_window(voxel_totals: MapleArray, window: int) -> tuple[MapleArray, MapleArray]:
+    """Per-cell top-aligned window of `window` ascending voxel indices.
+
+    `start` is `top + 2 - window` clipped into `[0, n_voxels - window]`
+    (`top` = uppermost occupied voxel, -1 for an empty column), so the
+    window holds the top voxel, the one below it and the empty one above
+    it wherever the column allows. Returns `(start (ny, nx), index (ny, nx,
+    window))`, integer arrays in the totals' own namespace."""
+    xp = array_namespace(voxel_totals)
+    n_voxels = voxel_totals.shape[-1]
+    occupied = voxel_totals > 0.0
+    any_occupied = xp.any(occupied, axis=-1)
+    top = xp.where(any_occupied, n_voxels - 1 - xp.argmax(occupied[..., ::-1], axis=-1), -1)
+    start = xp.clip(top + 2 - window, 0, n_voxels - window)
+    return start, start[..., None] + xp.arange(window)
+
+
+def _flat_voxel_index(index: MapleArray, nx: int, n_voxels: int) -> MapleArray:
+    """Flat (cell * n_voxels + voxel) indices of a `(ny, nx, window)` window
+    index into the contiguous `(ny * nx * n_voxels, ...)` view."""
+    xp = array_namespace(index)
+    ny, nx_, _window = index.shape
+    cell = (xp.arange(ny)[:, None] * nx_ + xp.arange(nx_)[None, :]) * n_voxels
+    return (cell[..., None] + index).reshape(-1)
+
+
+def _gather_window(per_voxel: MapleArray, index: MapleArray) -> MapleArray:
+    """`take_along_axis(per_voxel, index, -1)` for a `(ny, nx, n_voxels)` array,
+    through the flat index when the array is contiguous (cheaper on NumPy)."""
+    xp = array_namespace(per_voxel, index)
+    if per_voxel.flags["C_CONTIGUOUS"]:
+        flat = _flat_voxel_index(index, per_voxel.shape[1], per_voxel.shape[2])
+        return per_voxel.reshape(-1)[flat].reshape(index.shape)
+    return xp.take_along_axis(per_voxel, index, axis=-1)
+
+
+def _class_delta(after: MapleArray, before: MapleArray) -> MapleArray:
+    """Per-class sum of stored-mass change over every leading axis."""
+    return (after - before).sum(axis=tuple(range(after.ndim - 1)))
+
+
+def _assemble(xp, shape_cells, n_classes, groups):
+    """Scatter per-group `(k, 1, ...)` kernel results into whole-domain
+    result arrays; cells in no group (skipped) keep zeros / False."""
+    actual = xp.zeros((*shape_cells, n_classes), dtype=np.float64)
+    total = xp.zeros(shape_cells, dtype=np.float64)
+    shortfall = xp.zeros(shape_cells, dtype=np.float64)
+    residual = xp.zeros(shape_cells, dtype=np.float64)
+    limited = xp.zeros(shape_cells, dtype=bool)
+    for rows, cols, result in groups:
+        actual[rows, cols] = result.actual_mass_by_class_kg[:, 0]
+        total[rows, cols] = result.actual_total_mass_kg[:, 0]
+        shortfall[rows, cols] = result.shortfall_total_mass_kg[:, 0]
+        residual[rows, cols] = result.numerical_residual_total_mass_kg[:, 0]
+        limited[rows, cols] = result.limited[:, 0]
+    return actual, total, shortfall, residual, limited
+
+
+def _selective_exchange(direction, kernel, mass, request, cell_total_request, active, exact, index, geometry,
+                        mass_resolution_kg, voxel_totals_kg, metadata_entries, voxel_delta_by_class_kg):
+    """Shared skip / gather / kernel / scatter body of the two selective
+    entries. Fallback cells (whole columns) run FIRST on their gathered
+    copy, so a kernel refusal (the deposit capacity gate) raises before
+    `mass` or the totals are touched; fast cells (windows) follow; both
+    groups are scattered back and the totals rewritten at exactly the
+    touched voxels; skipped cells are never gathered."""
+    xp = array_namespace(mass)
+    ny, nx, n_voxels, n_classes = mass.shape
+    window = index.shape[-1]
+    fallback = active & ~exact
+    fast = active & exact
+    n_fallback = to_int(xp.count_nonzero(fallback))
+    n_active = to_int(xp.count_nonzero(active))
+    n_fast = n_active - n_fallback
+    n_skipped = ny * nx - n_active
+    contiguous = mass.flags["C_CONTIGUOUS"] and voxel_totals_kg.flags["C_CONTIGUOUS"]
+    if n_fallback == 0 and n_skipped == 0:
+        # Every cell is active and provably exact on its window: gather and
+        # scatter all windows through ONE flat index into the contiguous
+        # (cells * voxels, classes) view and run the kernel directly on the
+        # (ny, nx, window, n_classes) array -- no cell index arrays, no
+        # result assembly.
+        if contiguous:
+            flat = _flat_voxel_index(index, nx, n_voxels)
+            mass2d = mass.reshape(-1, n_classes)
+            sub = mass2d[flat].reshape(ny, nx, window, n_classes)
+            before = sub.copy() if voxel_delta_by_class_kg is not None else None
+            result = kernel(sub, request, geometry, mass_resolution_kg, n_voxels_for_bound=n_voxels)
+            mass2d[flat] = sub.reshape(-1, n_classes)
+            voxel_totals_kg.reshape(-1)[flat] = sub.sum(axis=-1).reshape(-1)
+        else:
+            index4 = index[..., None]
+            sub = xp.take_along_axis(mass, index4, axis=2)
+            before = sub.copy() if voxel_delta_by_class_kg is not None else None
+            result = kernel(sub, request, geometry, mass_resolution_kg, n_voxels_for_bound=n_voxels)
+            xp.put_along_axis(mass, index4, sub, axis=2)
+            xp.put_along_axis(voxel_totals_kg, index, sub.sum(axis=-1), axis=2)
+        if before is not None:
+            stored = (mass2d[flat].reshape(sub.shape) if contiguous else
+                      xp.take_along_axis(mass, index[..., None], axis=2))
+            voxel_delta_by_class_kg += _class_delta(stored, before)
+        _record_selective(direction, 0, n_fast, 0, window, n_voxels, n_classes, metadata_entries)
+        return result
+    classes = xp.arange(n_classes)
+    groups = []
+    deltas = []
+    # --- whole-column kernel on the active cells the window cannot prove exact ---
+    if n_fallback:
+        rows_b, cols_b = xp.nonzero(fallback)
+        sub_b = mass[rows_b, cols_b][:, None]  # (k, 1, n_voxels, n_classes) copy
+        before_b = sub_b.copy() if voxel_delta_by_class_kg is not None else None
+        result_b = kernel(sub_b, request[rows_b, cols_b][:, None], geometry, mass_resolution_kg)
+        groups.append((rows_b, cols_b, result_b))
+    # --- window kernel on the active, provably exact cells --------------------
+    if n_fast:
+        rows_g, cols_g = xp.nonzero(fast)
+        index_g = index[rows_g, cols_g]  # (k, window)
+        if contiguous:
+            flat_g = (((rows_g * nx + cols_g) * n_voxels)[:, None] + index_g).reshape(-1)
+            mass2d = mass.reshape(-1, n_classes)
+            sub_g = mass2d[flat_g].reshape(n_fast, 1, window, n_classes)
+        else:
+            where_g = (rows_g[:, None, None], cols_g[:, None, None], index_g[:, :, None], classes[None, None, :])
+            sub_g = mass[where_g][:, None]
+        before_g = sub_g.copy() if voxel_delta_by_class_kg is not None else None
+        result_g = kernel(sub_g, request[rows_g, cols_g][:, None], geometry, mass_resolution_kg,
+                          n_voxels_for_bound=n_voxels)
+        groups.append((rows_g, cols_g, result_g))
+    # --- publish: mass, then the totals at exactly the touched voxels ----------
+    if n_fallback:
+        mass[rows_b, cols_b] = sub_b[:, 0]
+        voxel_totals_kg[rows_b, cols_b] = sub_b[:, 0].sum(axis=-1)
+        if before_b is not None:
+            deltas.append(_class_delta(mass[rows_b, cols_b][:, None], before_b))
+    if n_fast:
+        if contiguous:
+            mass2d[flat_g] = sub_g.reshape(-1, n_classes)
+            voxel_totals_kg.reshape(-1)[flat_g] = sub_g.sum(axis=-1).reshape(-1)
+        else:
+            mass[where_g] = sub_g[:, 0]
+            voxel_totals_kg[rows_g[:, None], cols_g[:, None], index_g] = sub_g[:, 0].sum(axis=-1)
+        if before_g is not None:
+            stored_g = (mass2d[flat_g].reshape(sub_g.shape) if contiguous else mass[where_g][:, None])
+            deltas.append(_class_delta(stored_g, before_g))
+    for delta in deltas:
+        voxel_delta_by_class_kg += delta
+    actual, total, shortfall, residual, limited = _assemble(xp, (ny, nx), n_classes, groups)
+    _record_selective(direction, n_skipped, n_fast, n_fallback, window, n_voxels, n_classes, metadata_entries)
+    return BatchedMixtureTransferResult(
+        actual_mass_by_class_kg=actual,
+        actual_total_mass_kg=total,
+        requested_total_mass_kg=cell_total_request,
+        shortfall_total_mass_kg=shortfall,
+        numerical_residual_total_mass_kg=residual,
+        limited=limited,
+    )
+
+
+def _whole_column_with_totals(direction, kernel, mass, request, geometry, mass_resolution_kg, voxel_totals_kg,
+                              voxel_delta_by_class_kg):
+    """Columns too short for a window: the whole-column kernel, then the
+    totals rebuilt from the (small) mass array."""
+    ny, nx, n_voxels, n_classes = mass.shape
+    before = mass.copy() if voxel_delta_by_class_kg is not None else None
+    result = kernel(mass, request, geometry, mass_resolution_kg)
+    voxel_totals_kg[...] = mass.sum(axis=-1)
+    if before is not None:
+        voxel_delta_by_class_kg += _class_delta(mass, before)
+    _record_selective(direction, 0, 0, ny * nx, n_voxels, n_voxels, n_classes, 0)
+    return result
+
+
+def _extract_surface_mixture_selective_inplace(
+    mass: MapleArray,
+    requested_total_mass_kg: MapleArray,
+    geometry: GeometrySpec,
+    mass_resolution_kg: float,
+    voxel_totals_kg: MapleArray,
+    *,
+    voxel_delta_by_class_kg: MapleArray | None = None,
+) -> BatchedMixtureTransferResult:
+    """`_extract_surface_mixture_batched_inplace`, cell for cell, through
+    per-cell surface windows where provably identical, whole gathered
+    columns elsewhere, and nothing at all for provably no-effect cells (see
+    the section comment). Mutates `mass` AND `voxel_totals_kg` (equal to
+    `mass.sum(axis=-1)` on entry and again on exit) in place on success;
+    nothing is touched if a kernel raises."""
+    xp = array_namespace(mass, requested_total_mass_kg, voxel_totals_kg)
+    ny, nx, n_voxels, _n_classes = mass.shape
+    window = min(SELECTIVE_WINDOW_VOXELS, n_voxels)
+    if window == n_voxels:
+        return _whole_column_with_totals("extract", _extract_surface_mixture_batched_inplace, mass,
+                                         requested_total_mass_kg, geometry, mass_resolution_kg, voxel_totals_kg,
+                                         voxel_delta_by_class_kg)
+    start, index = _surface_window(voxel_totals_kg, window)
+    window_totals = _gather_window(voxel_totals_kg, index)  # (ny, nx, window), ascending voxels
+    # EXACTLY the kernel's own `total_column_mass_kg` for the window.
+    window_cumulative = xp.cumsum(window_totals[..., ::-1], axis=-1)[..., -1]
+    zero_request = requested_total_mass_kg == 0.0
+    # A zero request only acts (sub-roundoff reconciliation) when the top
+    # allocated voxel -- the kernel's terminal -- is itself non-empty; with
+    # an empty top window voxel the kernel provably removes nothing.
+    active = ~(zero_request & (window_totals[..., -1] == 0.0))
+    exact = zero_request | (window_cumulative >= requested_total_mass_kg) | (start == 0)
+    return _selective_exchange(
+        "extract", _extract_surface_mixture_batched_inplace, mass, requested_total_mass_kg,
