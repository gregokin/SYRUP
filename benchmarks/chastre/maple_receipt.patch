+                    (deposit_result.numerical_residual_total_mass_kg, -1.0),
+                    (deposit_result.shortfall_total_mass_kg, -1.0),
+                )
+                for value in (sign * element for element in np.asarray(array, dtype=np.float64).ravel().tolist())
+            )
+        )
         if identity_gap > bound_kg:
             violations.append(
-                "initial-fill mass reconciliation: requested "
-                f"({requested} kg) != actual + residual + shortfall "
-                f"({actual + residual + shortfall} kg), gap {identity_gap} kg exceeds the "
