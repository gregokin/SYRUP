    "text": "\"\"\"Full frozen Numba benchmark with low-overhead component wall timers.\"\"\"\nimport functools\nimport json\nimport time\nfrom pathlib import Path\nimport maple_syrup.sediment_event as event\nfrom maple_syrup.benchmark_experiment import run_plot1_matched_benchmark\n\nstats={}\noriginals={}\nfor name in ['coupled_step','sediment_physics_step','transport_step','apply_bed_demand','with_water']:\n fn=getattr(event,name);originals[name]=fn\n def wrap(fn=fn,name=name):\n  @functools.wraps(fn)\n  def measured(*args,**kwargs):\n   row=stats.setdefault(name,{'calls':0,'wall_s':0.0})\n   label=name\n   if name=='apply_bed_demand':\n    label='maple_pickup' if row['calls']%2==0 else 'maple_deposit_export'\n   start=time.perf_counter()\n   try:return fn(*args,**kwargs)\n   finally:\n    elapsed=time.perf_counter()-start\n    row['calls']+=1;row['wall_s']+=elapsed\n    if label!=name:\n     sub=stats.setdefault(label,{'calls':0,'wall_s':0.0});sub['calls']+=1;sub['wall_s']+=elapsed\n  return measured\n setattr(event,name,wrap())\ntry:\n r=run_plot1_matched_benchmark('outputs/plot1','outputs/phase7b/performance_numba',applied_rainfall_csv='outputs/phase7/mahleran_reference_audit/applied_rainfall.csv',reference_run_dir='outputs/phase7/mahleran_deterministic_ksat_run',max_dt_s=1,implementation='numba')\nfinally:\n for name,fn in originals.items():setattr(event,name,fn)\nassert r.result.n_rejected_attempts==0\nassert stats['apply_bed_demand']['calls']==2*r.result.n_accepted_steps\nreport={'scope':__doc__,'component_timers':stats,'summary_performance':r.summary['performance'],'source':r.summary['provenance'],'accepted_steps':r.result.n_accepted_steps,'closed':r.result.closure(),'note':'pickup and deposit/export alternate in this fixed benchmark; subrows overlap apply_bed_demand total. No cProfile overhead, wrappers around five phase boundaries only.'}\nPath('agent_handoffs/tasks/phase7b_performance/component_times.json').write_text(json.dumps(report,indent=2,default=lambda x:x.tolist() if hasattr(x,'tolist') else str(x))+'\\n')\nprint(json.dumps(stats,indent=2))\n"
  }
